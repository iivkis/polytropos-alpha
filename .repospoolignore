# RepoSpool is a small first-pass architecture context, not a full source
# mirror. All omitted files remain in GitHub and must be read on demand.
# Rules use Git's gitignore syntax and apply only to .repospool.

# CI, lockfiles, and verbose task wiring are available in Git.
/.github/
/Cargo.lock
/flake.lock
/Taskfile.yml

# The normative design/roadmap is large; preserve their locations in README.
# Read these original documents from Git before changes to VeriNeural.
/docs/verineural/

# Keep a compact public API + Semantic IR / model composition slice.
# Full backends (GPU/CUDA, proof generation, numeric verification, exporters),
# auxiliary runtime and implementation tests remain individually retrievable.
/crates/verineural/tests/
/crates/verineural/examples/
/crates/verineural/src/tests.rs
/crates/verineural/src/bin/
/crates/verineural/src/*.rs
# Split GPU backend implementation is available on demand, not first-pass context.
/crates/verineural/src/gpu/
!/crates/verineural/src/lib.rs
!/crates/verineural/src/ir.rs
!/crates/verineural/src/model.rs
!/crates/verineural/src/tensor.rs
!/crates/verineural/src/modules.rs
!/crates/verineural/src/primitive.rs
!/crates/verineural/src/consumer.rs
!/crates/verineural/src/symbolic.rs
!/crates/verineural/src/temporal.rs
!/crates/verineural/src/autodiff.rs

# Keep the compact formal semantics (Basic, Memory); the more detailed Lean
# numerical/special/fusion models can be consulted for proof-specific work.
/lean/VeriNeural/*.lean
!/lean/VeriNeural/Basic.lean
!/lean/VeriNeural/Memory.lean

# Keep lab Cargo manifests, short READMEs and representative consumer code.
# No datasets, generated evidence, giant reports, or test suites.
/labs/*/tests/
/labs/*/data/
/labs/*/artifacts/
/labs/*/EXPERIMENT_RESULTS.md
/labs/*/examples/
# Historical rotating-matrices implementation is available from Git on demand.
# The first-pass snapshot retains the active Torus16 and coupled-field consumers.
/labs/rotating-matrices-0.1.0/src/
/labs/consumer-acceptance-0.1.0/src/
/labs/xor-0.1.0/src/

# Torus16's massive experiment journal and checkpoint/training helpers are
# secondary to the consumer IR definitions and EMA4 model builder.
/labs/torus16-mix-0.1.0/README.md
/labs/torus16-mix-0.1.0/V0.2_TRANSITION.md
/labs/torus16-mix-0.1.0/src/*.rs
!/labs/torus16-mix-0.1.0/src/lib.rs
!/labs/torus16-mix-0.1.0/src/ema4.rs
