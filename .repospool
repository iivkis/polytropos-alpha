//! Consumer architecture is defined in src/lib.rs; the reusable library
//! owns all CLI arguments, proof checks, GPU lowering and bundle publication.
fn main() -> Result<(), Box<dyn std::error::Error>> {
    let model = coupled_field_lab::architecture()?;
    verineural::certified_example_main(&model, env!("CARGO_MANIFEST_DIR"))
}

FILE	labs/coupled-field-0.1.0/examples/stage9_architecture.rs
//! Stage 9 end-to-end research lab. All artifacts live under one explicit
//! root, defaulting to this lab package. This is an integrity-checked evidence
//! bundle, NOT a certified IEEE-754 or CUDA JIT/SASS equivalence proof.

use coupled_field_lab::build;
use std::error::Error;
use std::fs;
use std::io;
use std::path::{Path, PathBuf};
use std::process::Command;
use verineural::{
    GpuEngine, GpuLaunchConfig, GpuProgram, LeanProgram, LeanProofEngine, ProofGoal, ReluFusion,
    TranslationPlan, snapshot_architecture,
};

const FILES: [&str; 18] = [
    "architecture.identity",
    "semantic.ir",
    "architecture.dot",
    "architecture.png",
    "architecture.lean",
    "composition.lean",
    "parameters.bits",
    "inputs.bits",
    "output.bits",
    "report.txt",
    "gpu/baseline/graph.ll",
    "gpu/baseline/graph.ptx",
    "gpu/baseline/translation.plan",
    "gpu/baseline/translation.report",
    "gpu/fused/graph.ll",
    "gpu/fused/graph.ptx",
    "gpu/fused/translation.plan",
    "gpu/fused/translation.report",
];

fn failed(reason: impl Into<String>) -> io::Error {
    io::Error::other(reason.into())
}
fn fingerprint(path: &Path) -> Result<String, Box<dyn Error>> {
    let output = Command::new("sha256sum").arg(path).output()?;
    if !output.status.success() {
        return Err(failed("sha256sum failed").into());
    }
    let text = String::from_utf8(output.stdout)?;
    let sum = text.split_whitespace().next().unwrap_or("");
    if sum.len() != 64 || !sum.bytes().all(|b| b.is_ascii_hexdigit()) {
        return Err(failed("invalid SHA-256 checksum").into());
    }
    Ok(sum.to_owned())
}

fn checksums(root: &Path) -> Result<String, Box<dyn Error>> {
    let mut contents = String::new();
    for name in FILES {
        contents.push_str(&format!("{}  {name}\n", fingerprint(&root.join(name))?));
    }
    Ok(contents)
}

// Do not accept a syntactically valid, but unrelated, Lean theorem.
// Both the source and the transitive axiom dependencies are rechecked.
fn verify_lean_evidence(
    root: &Path,
    file: &str,
    expected: &LeanProgram,
) -> Result<(), Box<dyn Error>> {
    let path = root.join(file);
    if fs::read_to_string(&path)? != expected.source() {
        return Err(failed("saved Lean source differs from current Rust architecture").into());
    }
    let proof = LeanProofEngine::default();
    proof.check_file(&path)?;
    proof.audit_file(&path, expected.theorem_names())?;
    Ok(())
}

/// The lab declares this predicate once in ModelBuilder; consumers must not
/// reconstruct a potentially different theorem from an ad-hoc graph walk.
fn composition_goal(lab: &coupled_field_lab::Lab) -> Result<&ProofGoal, Box<dyn Error>> {
    lab.model
        .proof_goals()
        .get("coupled_branch_lower_bound")
        .ok_or_else(|| failed("missing declared coupled branch proof obligation").into())
}

fn verified_bundle(
    root: &Path,
    lab: &coupled_field_lab::Lab,
    program: &GpuProgram,
    expected: &[i64],
) -> Result<(), Box<dyn Error>> {
    let identity = format!(
        "id={}\nversion={}\n",
        lab.metadata().id,
        lab.metadata().version
    );
    if fs::read_to_string(root.join("architecture.identity"))? != identity {
        return Err(failed("bundle belongs to another architecture id/version").into());
    }
    let snapshot = snapshot_architecture(lab.graph(), lab.output(), program, &lab.metadata())?;
    snapshot.verify(root)?;
    if fs::read_to_string(root.join("inputs.bits"))? != lab.inputs_bits()
        || fs::read_to_string(root.join("parameters.bits"))? != lab.parameters_bits()
    {
        return Err(failed("saved parameter values or inputs have changed").into());
    }
    let expected_bits = expected
        .iter()
        .map(|&x| format!("{:08x}\n", (x as f32).to_bits()))
        .collect::<String>();
    if fs::read_to_string(root.join("output.bits"))? != expected_bits {
        return Err(failed("saved GPU output differs from exact Int oracle").into());
    }
    let proof = LeanProofEngine::default().generate_global_nonnegative(
        lab.graph(),
        lab.output(),
        &lab.source_nodes(),
    )?;
    if !proof
        .theorem_names()
        .iter()
        .any(|name| name == "architecture_global_nonnegative")
    {
        return Err(failed("architecture-level Lean obligation absent").into());
    }
    verify_lean_evidence(root, "architecture.lean", &proof)?;
    let relational =
        LeanProofEngine::default().generate_goal(lab.graph(), composition_goal(lab)?)?;
    verify_lean_evidence(root, "composition.lean", &relational)?;
    for label in ["baseline", "fused"] {
        let dir = root.join("gpu").join(label);
        let llvm = fs::read_to_string(dir.join("graph.ll"))?;
        let ptx = fs::read_to_string(dir.join("graph.ptx"))?;
        let saved = fs::read_to_string(dir.join("translation.plan"))?;
        let plan = TranslationPlan::from_text(&saved)?;
        let report = plan.validate(&llvm, &ptx)?;
        if fs::read_to_string(dir.join("translation.report"))? != report.to_text() {
            return Err(failed(format!("{label} translation evidence no longer validates")).into());
        }
        // Offline verification binds the full IR-derived expected plan, not
        // only a self-consistent set of saved LLVM/PTX/plan strings.
        let fusion = if label == "fused" {
            ReluFusion::Experimental
        } else {
            ReluFusion::Disabled
        };
        let original = GpuEngine::default()
            .with_launch_config(GpuLaunchConfig::new(256, fusion)?)
            .compile(lab.graph(), lab.output())?;
        if original.translation_plan()?.to_text() != saved || original.llvm_ir() != llvm {
            return Err(failed(format!(
                "{label} code/plan diverged from current Rust graph"
            ))
            .into());
        }
    }
    let report = format!(
        "architecture={}\nversion={}\nsemantic_ir_sha256={}\n\
         global_property=architecture_global_nonnegative\n\
         lean=proven-under-declared-nonnegative-input-assumptions\n\
         composition_property=architecture_property_coupled_branch_lower_bound\n\
         composition_lean=proven-ideal-Int-two-branch-bound\n\
         numeric_oracle=checked-integer-within-2^24\n\
         gpu=baseline-fused-bitwise-tested\n\
         translation=per-kernel-llvm-ptx-structural-validated\n\
         cuda_jit_sass=trusted-not-proven\n\
         parameter_values=explicitly-pinned-in-manifest\n\
         artifact_root=explicit-lab-local\n",
        lab.metadata().id,
        lab.metadata().version,
        snapshot.ir_sha256,
    );
    if fs::read_to_string(root.join("report.txt"))? != report {
        return Err(failed("assurance report mismatch").into());
    }
    if fs::read_to_string(root.join("SHA256SUMS"))? != checksums(root)? {
        return Err(failed("SHA-256 manifest is missing, incomplete or stale").into());
    }
    println!(
        "Stage 9 offline verification: Semantic IR, DOT, 15+ metadata attributes, Lean, baseline/fused translation, exact integer outputs and 18 SHA-256 artifacts PASS"
    );
    Ok(())
}

fn main() -> Result<(), Box<dyn Error>> {
    let mut verify = false;
    let mut root = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
    let args = std::env::args().skip(1).collect::<Vec<_>>();
    let mut index = 0;
    while index < args.len() {
        match args[index].as_str() {
            "--verify" => verify = true,
            "--artifact-root" => {
                index += 1;
                let path = args
                    .get(index)
                    .ok_or_else(|| failed("--artifact-root needs a path"))?;
                root = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join(path);
            }
            other => return Err(failed(format!("unknown Stage 9 argument: {other}")).into()),
        }
        index += 1;
    }
    let lab = build()?;
    let expected = lab.exact_integer_output()?;
    // The independently declared source assumptions are validated for the
    // specific tensor values. The Lean theorem remains conditional.
    for (id, t) in &lab.inputs {
        t.validate_domain(lab.graph().node(*id)?.domain)?;
    }
    let baseline =
        GpuEngine::default().with_launch_config(GpuLaunchConfig::new(256, ReluFusion::Disabled)?);
    let fused = GpuEngine::default()
        .with_launch_config(GpuLaunchConfig::new(256, ReluFusion::Experimental)?);
    let base_plan = baseline.compile(lab.graph(), lab.output())?;
    if verify {
        verified_bundle(&root, &lab, &base_plan, &expected)?;
        return Ok(());
    }
    fs::create_dir_all(&root)?;
    let identity = format!(
        "id={}\nversion={}\n",
        lab.metadata().id,
        lab.metadata().version
    );
    if root.join("architecture.identity").exists()
        && fs::read_to_string(root.join("architecture.identity"))? != identity
    {
        return Err(failed("different architecture already owns selected artifact root").into());
    }
    // A failed rerun must not leave a stale successful certificate.
    let _ = fs::remove_file(root.join("SHA256SUMS"));
    let _ = fs::remove_file(root.join("report.txt"));
    let proof = LeanProofEngine::default().generate_global_nonnegative(
        lab.graph(),
        lab.output(),
        &lab.source_nodes(),
    )?;
    if !proof
        .theorem_names()
        .iter()
        .any(|name| name == "architecture_global_nonnegative")
    {
        return Err(failed("architecture-level Lean obligation absent").into());
    }
    let (checked, _audit) =
        LeanProofEngine::default().verify_certified(&proof, &root.join("architecture.lean"))?;
    if checked.theorem_names.is_empty() {
        return Err(failed("Lean returned no checked theorems").into());
    }
    let relational =
        LeanProofEngine::default().generate_goal(lab.graph(), composition_goal(&lab)?)?;
    LeanProofEngine::default().verify_certified(&relational, &root.join("composition.lean"))?;
    let snapshot = snapshot_architecture(lab.graph(), lab.output(), &base_plan, &lab.metadata())?;
    snapshot.write(&root)?;
    fs::write(root.join("architecture.identity"), identity)?;
    fs::write(root.join("inputs.bits"), lab.inputs_bits())?;
    fs::write(root.join("parameters.bits"), lab.parameters_bits())?;
    let wanted = expected
        .iter()
        .map(|&x| (x as f32).to_bits())
        .collect::<Vec<_>>();
    for (label, engine, program) in [
        ("baseline", &baseline, base_plan.clone()),
        ("fused", &fused, fused.compile(lab.graph(), lab.output())?),
    ] {
        let actual = engine.execute(&program, &lab.inputs, &root.join("gpu").join(label))?;
        if actual
            .values()
            .iter()
            .map(|x| x.to_bits())
            .collect::<Vec<_>>()
            != wanted
        {
            return Err(
                failed(format!("{label} GPU disagrees with checked integer oracle")).into(),
            );
        }
        if label == "fused" && program.removed_kernel_count() == 0 {
            return Err(failed("experimental fusion was not exercised").into());
        }
        println!(
            "Stage 9 {label}: {} exact integer values match independent i64 oracle; kernels={}, removed={}",
            wanted.len(),
            program.translation_plan()?.kernels.len(),
            program.removed_kernel_count()
        );
    }
    fs::write(
        root.join("output.bits"),
        wanted
            .iter()
            .map(|x| format!("{x:08x}\n"))
            .collect::<String>(),
    )?;
    fs::write(
        root.join("report.txt"),
        format!(
            "architecture={}\nversion={}\nsemantic_ir_sha256={}\n\
         global_property=architecture_global_nonnegative\n\
         lean=proven-under-declared-nonnegative-input-assumptions\n\
         composition_property=architecture_property_coupled_branch_lower_bound\n\
         composition_lean=proven-ideal-Int-two-branch-bound\n\
         numeric_oracle=checked-integer-within-2^24\n\
         gpu=baseline-fused-bitwise-tested\n\
         translation=per-kernel-llvm-ptx-structural-validated\n\
         cuda_jit_sass=trusted-not-proven\n\
         parameter_values=explicitly-pinned-in-manifest\n\
         artifact_root=explicit-lab-local\n",
            lab.metadata().id,
            lab.metadata().version,
            snapshot.ir_sha256
        ),
    )?;
    fs::write(root.join("SHA256SUMS"), checksums(&root)?)?;
    verified_bundle(&root, &lab, &base_plan, &expected)?;
    println!(
        "Stage 9 manifest SHA256 (pin externally): {}",
        fingerprint(&root.join("SHA256SUMS"))?
    );
    println!(
        "Stage 9 guarantee: global ideal-Int nonnegative theorem under explicit input assumptions; concrete GPU FP32 exact-integer probes; structural translation validation; CUDA JIT/SASS still trusted"
    );
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn stage9_rejects_swapped_lean_source_before_accepting_certificate() {
        let lab = build().unwrap();
        let expected = LeanProofEngine::default()
            .generate_global_nonnegative(lab.graph(), lab.output(), &lab.source_nodes())
            .unwrap();
        let root = std::env::temp_dir().join(format!(
            "verineural-stage9-proof-replay-{}-{:?}",
            std::process::id(),
            std::thread::current().id()
        ));
        fs::create_dir_all(&root).unwrap();
        fs::write(
            root.join("architecture.lean"),
            format!("{}\n-- swapped\n", expected.source()),
        )
        .unwrap();
        // No Lean installation is needed for this negative case: comparing
        // against the independently regenerated Rust proof fails first.
        assert!(verify_lean_evidence(&root, "architecture.lean", &expected).is_err());
        fs::remove_dir_all(root).unwrap();
    }
}

FILE	labs/coupled-field-0.1.0/src/lib.rs
//! Independent Stage 9 research consumer: a coupled, two-level spatial field.
//! This is NOT a prescribed VeriNeural architecture, neural language model
//! or an implementation of training/state updates. It exercises nested module
//! boundaries, parameter sharing, fork/fan-in and a global ideal-Int theorem.

use std::error::Error;
use verineural::{
    ArchitectureMetadata, Domain, Model, ModelBuilder, ModelError, NeuralError, NeuralGraph,
    NodeId, Operation, Predicate, ProofGoal, ProofGoalKind, Shape, Tensor, ValueRef,
};

fn field() -> Shape {
    Shape::new(vec![1, 4]).expect("valid field shape")
}
fn channel() -> Shape {
    Shape::new(vec![4]).expect("valid channel shape")
}

/// Consumer-defined primitive: every GPU/Lean operation still comes from VeriNeural.
fn boundary_response(g: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
    let product = g.mul(inputs[0], inputs[1])?;
    let biased = g.bias_add(product, inputs[2])?;
    g.relu(biased)
}

/// CoupledUnit(a,b,c,p,q) := Relu(Boundary(a,b,p) + Boundary(b,c,q)).
fn coupled_unit(g: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
    let left = g.compose_inferred(
        "boundary_response",
        "1.0",
        &[inputs[0], inputs[1], inputs[3]],
        boundary_response,
    )?;
    let right = g.compose_inferred(
        "boundary_response",
        "1.0",
        &[inputs[1], inputs[2], inputs[4]],
        boundary_response,
    )?;
    let merged = g.add(left, right)?;
    g.relu(merged)
}

/// Rotate the fields; reuse the two shared parameter sources for both branches.
fn coupled_field(g: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
    let left = g.compose_inferred("coupled_unit", "1.0", inputs, coupled_unit)?;
    let right = g.compose_inferred(
        "coupled_unit",
        "1.0",
        &[inputs[0], inputs[2], inputs[1], inputs[4], inputs[3]],
        coupled_unit,
    )?;
    let merged = g.add(left, right)?;
    g.relu(merged)
}

/// Named sources, outputs and independent Lean goals share one Semantic IR.
pub fn architecture() -> Result<Model, ModelError> {
    let mut m = ModelBuilder::new("coupled-field", "0.1.0");
    let x = m.input("x", [1, 4], Domain::NonNegativeFinite)?;
    let y = m.input("y", [1, 4], Domain::NonNegativeFinite)?;
    let z = m.input("z", [1, 4], Domain::NonNegativeFinite)?;
    let p = m.parameter("p", [4], Domain::NonNegativeFinite)?;
    let q = m.parameter("q", [4], Domain::NonNegativeFinite)?;
    let result = m.block("coupled_field", &[x, y, z, p, q], coupled_field)?;

    // Expose the two actual branches for multi-output planning, without
    // changing the existing single-root Stage 9 execution/evidence profile.
    let root = m.graph_mut().node(result)?;
    if !matches!(root.operation, Operation::Relu) {
        return Err(ModelError::Invalid("expected output ReLU".into()));
    }
    let merge_id = root.inputs[0];
    let merge = m.graph_mut().node(merge_id)?;
    if !matches!(merge.operation, Operation::Add) || merge.inputs.len() != 2 {
        return Err(ModelError::Invalid("expected two-branch Add".into()));
    }
    let left = merge.inputs[0];
    let right = merge.inputs[1];
    if !matches!(m.graph_mut().node(right)?.operation, Operation::Relu) {
        return Err(ModelError::Invalid("right branch must be a ReLU".into()));
    }
    m.output("final", result)?;
    m.output("left", left)?;
    m.output("right", right)?;
    m.proof_goal(ProofGoal {
        name: "coupled_branch_lower_bound".into(),
        output: result,
        kind: ProofGoalKind::Predicate(Predicate::pointwise_le(
            ValueRef::Node(left),
            ValueRef::Output,
        )),
    })?;
    m.finish()
}

/// Concrete parameters and values are tiny nonnegative integers and exactly
/// representable in binary32. All nonnegative facts used by Lean remain
/// explicit caller assumptions, verified for this particular input vector.
pub fn build() -> Result<Lab, Box<dyn Error>> {
    let model = architecture()?;
    let mut inputs = model.bind([
        ("x", Tensor::new(field(), vec![1., 2., 3., 4.])?),
        ("y", Tensor::new(field(), vec![2., 1., 0., 1.])?),
        ("z", Tensor::new(field(), vec![0., 1., 2., 1.])?),
        ("p", Tensor::new(channel(), vec![1., 0., 1., 0.])?),
        ("q", Tensor::new(channel(), vec![0., 2., 0., 1.])?),
    ])?;
    inputs.sort_by_key(|(id, _)| id.index());
    Ok(Lab { model, inputs })
}

pub struct Lab {
    pub model: Model,
    pub inputs: Vec<(NodeId, Tensor<f32>)>,
}

impl Lab {
    pub fn graph(&self) -> &NeuralGraph {
        self.model.graph()
    }

    pub fn output(&self) -> NodeId {
        self.model
            .output("final")
            .expect("architecture declares final")
    }

    pub fn source_nodes(&self) -> [NodeId; 5] {
        ["x", "y", "z", "p", "q"].map(|name| {
            self.model
                .source(name)
                .expect("architecture declares every source")
                .0
        })
    }

    pub fn metadata(&self) -> ArchitectureMetadata {
        self.model.metadata("architecture_global_nonnegative")
    }

    pub fn inputs_bits(&self) -> String {
        let roles = self.metadata().input_roles;
        self.inputs
            .iter()
            .map(|(id, t)| {
                format!(
                    "node={} role={} shape={:?} bits={}\n",
                    id.index(),
                    roles.get(&id.index()).expect("all source roles declared"),
                    t.shape().dims(),
                    t.values()
                        .iter()
                        .map(|x| format!("{:08x}", x.to_bits()))
                        .collect::<Vec<_>>()
                        .join(",")
                )
            })
            .collect()
    }
    pub fn parameters_bits(&self) -> String {
        let roles = self.metadata().input_roles;
        self.inputs
            .iter()
            .filter(|(id, _)| roles.get(&id.index()).is_some_and(|s| s == "parameter"))
            .map(|(id, t)| {
                format!(
                    "node={} bits={}\n",
                    id.index(),
                    t.values()
                        .iter()
                        .map(|x| format!("{:08x}", x.to_bits()))
                        .collect::<Vec<_>>()
                        .join(",")
                )
            })
            .collect()
    }
    /// Independent Int forward pass over all live nodes, with checked +/-2^24
    /// integer-exact intermediate bounds. Not host f32 math.
    pub fn exact_integer_output(&self) -> Result<Vec<i64>, Box<dyn Error>> {
        use verineural::Operation;
        let mut values: Vec<Vec<i64>> = Vec::new();
        for (idx, node) in self.graph().nodes().iter().enumerate() {
            let result = match &node.operation {
                Operation::Input => {
                    let t = &self
                        .inputs
                        .iter()
                        .find(|(id, _)| id.index() == idx)
                        .ok_or("source input missing")?
                        .1;
                    t.values()
                        .iter()
                        .map(|&v| {
                            if !v.is_finite() || v < 0.0 || v.fract() != 0.0 || v > 16_777_216.0 {
                                Err("nonexact or negative source input")
                            } else {
                                Ok(v as i64)
                            }
                        })
                        .collect::<Result<Vec<_>, _>>()?
                }
                Operation::Add => {
                    let a = &values[node.inputs[0].index()];
                    let b = &values[node.inputs[1].index()];
                    a.iter()
                        .zip(b)
                        .map(|(x, y)| x.checked_add(*y).ok_or("i64 add overflow"))
                        .collect::<Result<Vec<_>, _>>()?
                }
                Operation::Mul => {
                    let a = &values[node.inputs[0].index()];
                    let b = &values[node.inputs[1].index()];
                    a.iter()
                        .zip(b)
                        .map(|(x, y)| x.checked_mul(*y).ok_or("i64 mul overflow"))
                        .collect::<Result<Vec<_>, _>>()?
                }
                Operation::BiasAdd => {
                    let a = &values[node.inputs[0].index()];
                    let b = &values[node.inputs[1].index()];
                    a.iter()
                        .enumerate()
                        .map(|(i, x)| x.checked_add(b[i % b.len()]).ok_or("i64 bias add overflow"))
                        .collect::<Result<Vec<_>, _>>()?
                }
                Operation::Relu => values[node.inputs[0].index()]
                    .iter()
                    .map(|v| (*v).max(0))
                    .collect(),
                Operation::Reshape(_) => values[node.inputs[0].index()].clone(),
                _ => return Err("unsupported lab integer operation".into()),
            };
            if result.iter().any(|&x| x.unsigned_abs() > 16_777_216) {
                return Err("lab integer operation outside exact FP32 profile".into());
            }
            values.push(result);
        }
        let output = values[self.output().index()].clone();
        if output != [4, 10, 8, 12] {
            return Err("lab oracle regression".into());
        }
        Ok(output)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use verineural::{GpuEngine, LeanProofEngine};

    #[test]
    fn nested_architecture_has_independent_global_property_and_exact_oracle() {
        let lab = build().unwrap();
        assert_eq!(lab.graph().modules().len(), 7);
        assert_eq!(lab.graph().nodes().len(), 23);
        assert_eq!(lab.source_nodes()[3], lab.model.source("p").unwrap().0);
        assert_eq!(lab.source_nodes()[4], lab.model.source("q").unwrap().0);
        assert_eq!(lab.model.outputs().len(), 3);
        let compiler = verineural::ArchitectureAutoCompiler::new(
            LeanProofEngine::default(),
            GpuEngine::default(),
        );
        let plan = lab
            .model
            .plan(&compiler, verineural::GpuRequirement::AllOutputs)
            .unwrap();
        assert_eq!(plan.outputs.len(), 3);
        assert!(plan.outputs.contains(&lab.output()));
        assert_eq!(plan.goals.len(), 1);
        assert_eq!(plan.goals[0].0, "coupled_branch_lower_bound");
        assert!(
            plan.goals[0]
                .1
                .source()
                .contains("theorem architecture_property_coupled_branch_lower_bound")
        );
        assert!(plan.shared_gpu.is_some());
        assert_eq!(lab.exact_integer_output().unwrap(), [4, 10, 8, 12]);
        let proof = LeanProofEngine::default()
            .generate_global_nonnegative(lab.graph(), lab.output(), &lab.source_nodes())
            .unwrap();
        assert!(
            proof
                .source()
                .contains("theorem architecture_global_nonnegative")
        );
        // Each of the five input lemmas must expose exactly one used
        // hypothesis, with the remaining positional binders explicitly unused.
        for source in 0..5 {
            let marker = format!("theorem node_{source}_nonnegative ");
            let declaration = proof
                .source()
                .split(&marker)
                .nth(1)
                .expect("source nonnegativity theorem")
                .split(" := by")
                .next()
                .expect("theorem declaration");
            for hypothesis in 0..5 {
                let binder = if source == hypothesis {
                    format!("(h_{hypothesis} :")
                } else {
                    format!("(_h_{hypothesis} :")
                };
                assert!(
                    declaration.contains(&binder),
                    "node {source} binder {hypothesis}"
                );
            }
        }
        assert!(
            !proof
                .source()
                .contains("set_option linter.unusedVariables false")
        );
        let gpu = GpuEngine::default()
            .compile(lab.graph(), lab.output())
            .unwrap();
        assert!(!gpu.translation_plan().unwrap().kernels.is_empty());
        let snapshot =
            verineural::snapshot_architecture(lab.graph(), lab.output(), &gpu, &lab.metadata())
                .unwrap();
        assert_eq!(snapshot.dot.matches("subgraph cluster_m").count(), 7);
        assert!(snapshot.dot.contains(r#"vn_role="parameter""#));
        // Module port metadata is stored once per normalized module scope.
        assert_eq!(
            snapshot.dot.matches("vn_input_ports=").count(),
            lab.graph().modules().len()
        );
        assert_eq!(
            snapshot.dot.matches("vn_output_ports=").count(),
            lab.graph().modules().len()
        );
        // The renderer should draw only real IR dependencies. Port identity
        // remains in the cluster label and the explicit typed port mappings.
        let real_edges: usize = lab
            .graph()
            .nodes()
            .iter()
            .map(|node| node.inputs.len())
            .sum();
        assert_eq!(snapshot.dot.matches(" -> ").count(), real_edges);
        assert_eq!(snapshot.dot.matches("vn_semantic_dst=").count(), real_edges);
        // The first boundary module declares x, y and shared parameter p.
        // Quoted names are escaped because this metadata lives inside DOT.
        assert!(snapshot.dot.contains(
            r#"vn_input_ports="[(\"input_0\", 0), (\"input_1\", 1), (\"input_2\", 3)]""#
        ));
        assert!(!snapshot.dot.contains("module_interface"));
        assert!(!snapshot.dot.contains("module_input_port"));
        assert!(
            snapshot
                .dot
                .contains(r#"vn_output_ports="[(\"output\", 7)]""#)
        );
        assert!(
            snapshot
                .dot
                .contains(r#"label="BOUNDARY RESPONSE  ·  m0\ninput_0:n0"#)
        );
        let has_edge = |source: &str, destination: &str| {
            let prefix = format!("{source} -> {destination} [");
            snapshot
                .dot
                .lines()
                .any(|line| line.trim_start().starts_with(&prefix))
        };
        assert!(has_edge("n0", "n5"));
        assert!(has_edge("n3", "n6"));
        assert!(!has_edge("n0", "m6_in0"));
        assert!(snapshot.dot.contains("vn_semantic_src=\"n0\""));
        assert!(snapshot.dot.contains("vn_visual_src=\"n0\""));
        assert!(!snapshot.dot.contains("rank=same;"));
        assert!(snapshot.dot.contains("fillcolor=\"#FFF1DB\""));
        assert!(snapshot.dot.contains(r#"style="rounded,filled""#));
        assert!(snapshot.dot.contains("dpi=180"));
        assert!(snapshot.dot.contains("splines=spline"));
        assert!(snapshot.dot.contains("concentrate=false"));
        assert!(snapshot.dot.contains("mclimit=4"));
        assert!(!snapshot.dot.contains("headport="));
        assert!(!snapshot.dot.contains("tailport="));
        assert!(snapshot.dot.contains("constraint=\"false\""));
        assert!(snapshot.dot.contains("constraint=\"true\""));
        assert!(snapshot.dot.contains("vn_ir_sha256="));
    }

    #[test]
    fn bad_inferred_component_rolls_back_and_preserves_sources() {
        let mut model = ModelBuilder::new("bad", "1");
        let x = model.input("x", [1, 3], Domain::NonNegativeFinite).unwrap();
        let y = model.input("y", [1, 4], Domain::NonNegativeFinite).unwrap();
        let z = model.input("z", [1, 4], Domain::NonNegativeFinite).unwrap();
        let p = model
            .parameter("p", [4], Domain::NonNegativeFinite)
            .unwrap();
        let q = model
            .parameter("q", [4], Domain::NonNegativeFinite)
            .unwrap();
        assert!(matches!(
            model.block("coupled_field", &[x, y, z, p, q], coupled_field),
            Err(ModelError::Neural(NeuralError::ShapeMismatch { .. }))
        ));
        assert_eq!(model.graph_mut().modules().len(), 0);
        assert_eq!(model.graph_mut().nodes().len(), 5);
    }

    #[test]
    fn changed_parameter_must_revalidate_its_contract() {
        let mut lab = build().unwrap();
        let id = lab.inputs[3].0;
        lab.inputs[3].1 = Tensor::new(channel(), vec![-1., 0., 1., 0.]).unwrap();
        assert!(
            lab.inputs[3]
                .1
                .validate_domain(lab.graph().node(id).unwrap().domain)
                .is_err()
        );
        assert!(lab.exact_integer_output().is_err());
    }
}

