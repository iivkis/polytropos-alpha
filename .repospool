FILE	crates/verineural/src/model.rs
//! Named, architecture-neutral façade over the single Semantic Neural IR.
//! Role labels are metadata, not new IR operations or runtime mutability.
use crate::{
    ArchitectureAutoCompiler, ArchitectureMetadata, ArchitectureProofTask, AutoBuildError,
    AutoBuildPlan, AutoBuildReport, CertifiedBuildConfig, Domain, FP32Policy, GpuRequirement,
    NeuralError, NeuralGraph, NodeId, Operation, Predicate, ProofGoal, ProofGoalKind, Shape,
    Tensor, ValueRef,
};
use std::collections::{BTreeMap, BTreeSet};
use std::error::Error;
use std::fmt;

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum SourceRole {
    Input,
    Parameter,
    State,
}

impl SourceRole {
    pub const fn as_str(self) -> &'static str {
        match self {
            Self::Input => "input",
            Self::Parameter => "parameter",
            Self::State => "state",
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub enum ModelError {
    Invalid(String),
    Neural(NeuralError),
}

impl fmt::Display for ModelError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::Invalid(message) => write!(f, "invalid model: {message}"),
            Self::Neural(error) => write!(f, "{error}"),
        }
    }
}

impl Error for ModelError {
    fn source(&self) -> Option<&(dyn Error + 'static)> {
        match self {
            Self::Neural(error) => Some(error),
            _ => None,
        }
    }
}

impl From<NeuralError> for ModelError {
    fn from(value: NeuralError) -> Self {
        Self::Neural(value)
    }
}

fn valid_name(name: &str) -> bool {
    let mut chars = name.chars();
    matches!(chars.next(), Some(c) if c.is_ascii_alphabetic() || c == '_')
        && chars.all(|c| c.is_ascii_alphanumeric() || c == '_')
}

fn valid_identity(name: &str) -> bool {
    !name.is_empty()
        && name
            .bytes()
            .all(|c| c.is_ascii_alphanumeric() || b"-._".contains(&c))
}

fn identity_shape(shape: &Shape) -> String {
    format!(
        "[{}]",
        shape
            .dims()
            .iter()
            .map(usize::to_string)
            .collect::<Vec<_>>()
            .join(", ")
    )
}

fn identity_domain(domain: Domain) -> &'static str {
    match domain {
        Domain::Any => "Any",
        Domain::Finite => "Finite",
        Domain::NonNegativeFinite => "NonNegativeFinite",
    }
}

fn identity_node(node: NodeId) -> String {
    format!("NodeId {{ index: {} }}", node.index())
}

fn identity_value_ref(value: &ValueRef) -> String {
    match value {
        ValueRef::Input(port) => format!("Input({port})"),
        ValueRef::Output => "Output".to_owned(),
        ValueRef::Node(node) => format!("Node({})", identity_node(*node)),
    }
}

fn identity_predicate(predicate: &Predicate) -> String {
    match predicate {
        Predicate::Nonnegative(value) => {
            format!("Nonnegative({})", identity_value_ref(value))
        }
        Predicate::Equal(left, right) => format!(
            "Equal({}, {})",
            identity_value_ref(left),
            identity_value_ref(right)
        ),
        Predicate::PointwiseLe(left, right) => format!(
            "PointwiseLe({}, {})",
            identity_value_ref(left),
            identity_value_ref(right)
        ),
    }
}

fn identity_goal_kind(kind: &ProofGoalKind) -> String {
    match kind {
        ProofGoalKind::Nonnegative { assumptions } => format!(
            "Nonnegative {{ assumptions: [{}] }}",
            assumptions
                .iter()
                .map(|&node| identity_node(node))
                .collect::<Vec<_>>()
                .join(", ")
        ),
        ProofGoalKind::EqualTo { other } => {
            format!("EqualTo {{ other: {} }}", identity_node(*other))
        }
        ProofGoalKind::Predicate(predicate) => {
            format!("Predicate({})", identity_predicate(predicate))
        }
    }
}

/// Consumer model declaration; all tensor operations use NeuralGraph.
pub struct ModelBuilder {
    id: String,
    version: String,
    graph: NeuralGraph,
    sources: BTreeMap<String, (NodeId, SourceRole)>,
    outputs: BTreeMap<String, NodeId>,
    next_states: BTreeMap<String, NodeId>,
    goals: BTreeMap<String, ProofGoal>,
}

impl ModelBuilder {
    pub fn new(id: impl Into<String>, version: impl Into<String>) -> Self {
        Self::with_policy(id, version, FP32Policy::strict())
    }

    pub fn with_policy(
        id: impl Into<String>,
        version: impl Into<String>,
        policy: FP32Policy,
    ) -> Self {
        Self {
            id: id.into(),
            version: version.into(),
            graph: NeuralGraph::new(policy),
            sources: BTreeMap::new(),
            outputs: BTreeMap::new(),
            next_states: BTreeMap::new(),
            goals: BTreeMap::new(),
        }
    }

    fn insert_source(
        &mut self,
        name: impl Into<String>,
        dims: impl Into<Vec<usize>>,
        domain: Domain,
        role: SourceRole,
    ) -> Result<NodeId, ModelError> {
        let name = name.into();
        if !valid_name(&name)
            || self.sources.contains_key(&name)
            || self.outputs.contains_key(&name)
        {
            return Err(ModelError::Invalid(format!(
                "bad or duplicate source name: {name}"
            )));
        }
        let shape = Shape::new(dims)?;
        let node = self.graph.input(shape, domain);
        self.sources.insert(name, (node, role));
        Ok(node)
    }

    /// Input domains are hypotheses checked against actual bound values.
    pub fn input(
        &mut self,
        name: impl Into<String>,
        dims: impl Into<Vec<usize>>,
        domain: Domain,
    ) -> Result<NodeId, ModelError> {
        self.insert_source(name, dims, domain, SourceRole::Input)
    }

    /// Parameters are named IR sources; updates and optimizers are not implied.
    pub fn parameter(
        &mut self,
        name: impl Into<String>,
        dims: impl Into<Vec<usize>>,
        domain: Domain,
    ) -> Result<NodeId, ModelError> {
        self.insert_source(name, dims, domain, SourceRole::Parameter)
    }

    /// State is an explicit named source, not a mutable IR operation.
    pub fn state(
        &mut self,
        name: impl Into<String>,
        dims: impl Into<Vec<usize>>,
        domain: Domain,
    ) -> Result<NodeId, ModelError> {
        self.insert_source(name, dims, domain, SourceRole::State)
    }

    /// A pure graph transition: the next value must satisfy the state contract.
    pub fn next_state(&mut self, name: &str, next: NodeId) -> Result<(), ModelError> {
        let (source, role) = self
            .sources
            .get(name)
            .copied()
            .ok_or_else(|| ModelError::Invalid(format!("unknown state: {name}")))?;
        if role != SourceRole::State || self.next_states.contains_key(name) {
            return Err(ModelError::Invalid(format!(
                "not a state or duplicate transition: {name}"
            )));
        }
        let before = self.graph.node(source)?;
        let after = self.graph.node(next)?;
        if before.shape != after.shape {
            return Err(ModelError::Neural(NeuralError::ShapeMismatch {
                expected: before.shape.clone(),
                actual: after.shape.clone(),
            }));
        }
        if after.dtype != before.dtype {
            return Err(ModelError::Neural(NeuralError::DTypeMismatch {
                operation: "next_state",
                expected: before.dtype,
                actual: after.dtype,
            }));
        }
        if !after.domain.satisfies(before.domain) {
            return Err(ModelError::Neural(NeuralError::DomainNotEstablished {
                required: before.domain,
                actual: after.domain,
            }));
        }
        self.next_states.insert(name.to_owned(), next);
        Ok(())
    }

    /// Atomic, capture-checked block; output contract inferred from the IR.
    /// Independent mathematical properties must use explicit proof goals.
    pub fn block<F>(
        &mut self,
        name: &'static str,
        inputs: &[NodeId],
        build: F,
    ) -> Result<NodeId, ModelError>
    where
        F: FnOnce(&mut NeuralGraph, &[NodeId]) -> Result<NodeId, NeuralError>,
    {
        if !valid_name(name) {
            return Err(ModelError::Invalid(format!("invalid block name: {name}")));
        }
        Ok(self
            .graph
            .compose_inferred(name, "model-block-v1", inputs, build)?)
    }

    /// Atomic named multi-output block with inferred structural contracts.
    pub fn block_multi<F>(
        &mut self,
        name: &'static str,
        inputs: &[(&'static str, NodeId)],
        output_names: &[&'static str],
        build: F,
    ) -> Result<BTreeMap<String, NodeId>, ModelError>
    where
        F: FnOnce(&mut NeuralGraph, &[NodeId]) -> Result<Vec<NodeId>, NeuralError>,
    {
        if !valid_name(name)
            || inputs.iter().any(|(port, _)| !valid_name(port))
            || output_names.iter().any(|port| !valid_name(port))
        {
            return Err(ModelError::Invalid(format!(
                "invalid multi-block name: {name}"
            )));
        }
        let ids = self.graph.compose_multi_inferred(
            name,
            "model-multi-block-v1",
            inputs,
            output_names,
            build,
        )?;
        Ok(output_names
            .iter()
            .zip(ids)
            .map(|(&name, id)| (name.to_owned(), id))
            .collect())
    }

    pub fn output(&mut self, name: impl Into<String>, id: NodeId) -> Result<(), ModelError> {
        let name = name.into();
        if !valid_name(&name)
            || self.sources.contains_key(&name)
            || self.outputs.contains_key(&name)
        {
            return Err(ModelError::Invalid(format!(
                "bad or duplicate output name: {name}"
            )));
        }
        self.graph.node(id)?;
        self.outputs.insert(name, id);
        Ok(())
    }

    /// Registers an obligation, not a proven conclusion.
    pub fn proof_goal(&mut self, goal: ProofGoal) -> Result<(), ModelError> {
        if !valid_name(&goal.name) || self.goals.contains_key(&goal.name) {
            return Err(ModelError::Invalid(format!(
                "bad or duplicate goal: {}",
                goal.name
            )));
        }
        self.graph.node(goal.output)?;
        self.goals.insert(goal.name.clone(), goal);
        Ok(())
    }

    pub fn graph_mut(&mut self) -> &mut NeuralGraph {
        &mut self.graph
    }

    pub fn finish(self) -> Result<Model, ModelError> {
        if !valid_identity(&self.id) || !valid_identity(&self.version) {
            return Err(ModelError::Invalid(
                "id/version must use ASCII alphanumeric, - . _".into(),
            ));
        }
        if self.outputs.is_empty() {
            return Err(ModelError::Invalid(
                "at least one output is required".into(),
            ));
        }
        let registered: BTreeSet<_> = self.sources.values().map(|(id, _)| id.index()).collect();
        if self.graph.nodes().iter().any(|node| {
            matches!(node.operation, Operation::Input) && !registered.contains(&node.id.index())
        }) {
            return Err(ModelError::Invalid(
                "all graph source inputs must have a registered model name".into(),
            ));
        }
        for (name, (_, role)) in &self.sources {
            if *role == SourceRole::State && !self.next_states.contains_key(name) {
                return Err(ModelError::Invalid(format!("missing next_state: {name}")));
            }
        }
        let roots: Vec<_> = self
            .outputs
            .values()
            .chain(self.next_states.values())
            .copied()
            .collect();
        let scope = self.graph.dependency_scope(&roots)?;
        for goal in self.goals.values() {
            if !scope.contains(&goal.output.index()) {
                return Err(ModelError::Invalid(format!(
                    "disconnected proof goal: {}",
                    goal.name
                )));
            }
        }
        Ok(Model {
            id: self.id,
            version: self.version,
            graph: self.graph,
            sources: self.sources,
            outputs: self.outputs,
            next_states: self.next_states,
            goals: self.goals,
        })
    }
}

/// Finished model, with the original graph and deterministic named roots.
pub struct Model {
    id: String,
    version: String,
    graph: NeuralGraph,
    sources: BTreeMap<String, (NodeId, SourceRole)>,
    outputs: BTreeMap<String, NodeId>,
    next_states: BTreeMap<String, NodeId>,
    goals: BTreeMap<String, ProofGoal>,
}

impl Model {
    pub fn graph(&self) -> &NeuralGraph {
        &self.graph
    }

    pub fn output(&self, name: &str) -> Option<NodeId> {
        self.outputs.get(name).copied()
    }

    pub fn source(&self, name: &str) -> Option<(NodeId, SourceRole)> {
        self.sources.get(name).copied()
    }

    pub(crate) fn sources(&self) -> &BTreeMap<String, (NodeId, SourceRole)> {
        &self.sources
    }

    pub fn outputs(&self) -> &BTreeMap<String, NodeId> {
        &self.outputs
    }

    /// Explicit transition mapping, with no hidden mutation in Semantic IR.
    pub fn state_links(&self) -> &BTreeMap<String, NodeId> {
        &self.next_states
    }

    pub(crate) fn execution_roots(&self) -> Vec<NodeId> {
        let mut ids = BTreeSet::new();
        self.outputs
            .values()
            .chain(self.next_states.values())
            .copied()
            .filter(|id| ids.insert(id.index()))
            .collect()
    }

    pub fn proof_goals(&self) -> &BTreeMap<String, ProofGoal> {
        &self.goals
    }

    /// State is metadata on a pure source, not a side-effecting graph operation.
    pub fn metadata(&self, global_property: impl Into<String>) -> ArchitectureMetadata {
        ArchitectureMetadata {
            id: self.id.clone(),
            version: self.version.clone(),
            input_roles: self
                .sources
                .values()
                .map(|(node, role)| (node.index(), role.as_str().to_owned()))
                .collect(),
            global_property: global_property.into(),
        }
    }

    /// Match every named source exactly once, checking shape and declared domain.
    /// Returns ordinary NodeId/Tensor bindings for existing execution APIs.
    pub fn bind<K: Into<String>>(
        &self,
        values: impl IntoIterator<Item = (K, Tensor<f32>)>,
    ) -> Result<Vec<(NodeId, Tensor<f32>)>, ModelError> {
        let mut supplied = BTreeMap::new();
        let mut seen = BTreeSet::new();
        for (name, tensor) in values {
            let name = name.into();
            if !self.sources.contains_key(&name) || !seen.insert(name.clone()) {
                return Err(ModelError::Invalid(format!(
                    "unknown or repeated binding: {name}"
                )));
            }
            supplied.insert(name, tensor);
        }
        let mut ordered = Vec::with_capacity(self.sources.len());
        for (name, (id, _)) in &self.sources {
            let tensor = supplied
                .remove(name)
                .ok_or_else(|| ModelError::Invalid(format!("missing source binding: {name}")))?;
            let node = self.graph.node(*id)?;
            if tensor.shape() != &node.shape {
                return Err(ModelError::Neural(NeuralError::ShapeMismatch {
                    expected: node.shape.clone(),
                    actual: tensor.shape().clone(),
                }));
            }
            tensor.validate_domain(node.domain)?;
            ordered.push((*id, tensor));
        }
        Ok(ordered)
    }

    /// Stable identity binds id/version, named sources/roles, outputs and
    /// obligations. It deliberately excludes graph allocation identity and
    /// Rust Debug formatting. SHA256SUMS separately binds canonical IR bytes.
    fn certified_identity(&self) -> String {
        let mut identity = format!(
            "verineural-certified-model-v1\nid={}\nversion={}\n",
            self.id, self.version
        );
        for (name, (node, role)) in &self.sources {
            let source = self
                .graph
                .node(*node)
                .expect("finished model source exists");
            identity.push_str(&format!(
                "source={name};node={};role={};shape={};domain={}\n",
                node.index(),
                role.as_str(),
                identity_shape(&source.shape),
                identity_domain(source.domain)
            ));
        }
        for (name, output) in &self.outputs {
            identity.push_str(&format!("output={name};node={}\n", output.index()));
        }
        for (name, next) in &self.next_states {
            identity.push_str(&format!("next_state={name};node={}\n", next.index()));
        }
        for (name, goal) in &self.goals {
            identity.push_str(&format!(
                "goal={name};node={};kind={}\n",
                goal.output.index(),
                identity_goal_kind(&goal.kind)
            ));
        }
        identity
    }

    /// Fail closed: certify every declared goal with Lean kernel + axiom audit,
    /// require GPU lowering for every output, then atomically publish evidence.
    /// The result explicitly does not certify CUDA/IEEE-754 machine semantics.
    pub fn certify(&self, config: CertifiedBuildConfig) -> Result<AutoBuildReport, AutoBuildError> {
        self.certify_with(&ArchitectureAutoCompiler::default(), config)
    }

    pub fn certify_with(
        &self,
        compiler: &ArchitectureAutoCompiler,
        config: CertifiedBuildConfig,
    ) -> Result<AutoBuildReport, AutoBuildError> {
        let outputs = self.execution_roots();
        let tasks: Vec<_> = self
            .goals
            .values()
            .cloned()
            .map(ArchitectureProofTask::Goal)
            .collect();
        let root = config.resolved_root();
        let identity = self.certified_identity();
        crate::certified::preflight_root(&root, &identity)?;
        let report = compiler.build_identified(&self.graph, &outputs, &tasks, &root, &identity)?;
        crate::certified::publish_root(&root, &identity)?;
        crate::certified::verify_root(&root, &identity)?;
        Ok(report)
    }

    /// Verify the complete current-source bundle without CUDA or GPU execution.
    /// To establish authenticity, pass a digest pinned outside the bundle.
    pub fn verify_certified(
        &self,
        config: CertifiedBuildConfig,
        pinned_sha256: Option<&str>,
    ) -> Result<AutoBuildReport, AutoBuildError> {
        self.verify_certified_with(&ArchitectureAutoCompiler::default(), config, pinned_sha256)
    }

    pub fn verify_certified_with(
        &self,
        compiler: &ArchitectureAutoCompiler,
        config: CertifiedBuildConfig,
        pinned_sha256: Option<&str>,
    ) -> Result<AutoBuildReport, AutoBuildError> {
        let outputs = self.execution_roots();
        let tasks: Vec<_> = self
            .goals
            .values()
            .cloned()
            .map(ArchitectureProofTask::Goal)
            .collect();
        let root = config.resolved_root();
        let identity = self.certified_identity();
        let report = compiler.verify_identified(
            &self.graph,
            &outputs,
            &tasks,
            &root,
            pinned_sha256,
            &identity,
        )?;
        crate::certified::verify_root(&root, &identity)?;
        Ok(report)
    }

    /// Reuse ArchitectureAutoCompiler; planned Lean goals are not certified.
    pub fn plan(
        &self,
        compiler: &ArchitectureAutoCompiler,
        gpu_requirement: GpuRequirement,
    ) -> Result<AutoBuildPlan, AutoBuildError> {
        let outputs = self.execution_roots();
        let tasks: Vec<_> = self
            .goals
            .values()
            .cloned()
            .map(ArchitectureProofTask::Goal)
            .collect();
        compiler.plan(&self.graph, &outputs, &tasks, gpu_requirement)
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn named_dense_block_infers_shape_roles_and_bindings() {
        let mut builder = ModelBuilder::new("dense", "0.1.0");
        let x = builder.input("x", [4, 2], Domain::Finite).unwrap();
        let w = builder
            .parameter("weights", [2, 3], Domain::Finite)
            .unwrap();
        let b = builder.parameter("bias", [3], Domain::Finite).unwrap();
        let y = builder
            .block("dense_layer", &[x, w, b], |g, p| {
                let product = g.matmul(p[0], p[1])?;
                let shifted = g.bias_add(product, p[2])?;
                g.relu(shifted)
            })
            .unwrap();
        builder.output("prediction", y).unwrap();
        builder
            .proof_goal(ProofGoal::nonnegative("positive", y, vec![]))
            .unwrap();
        let model = builder.finish().unwrap();
        assert_eq!(model.graph().node(y).unwrap().shape.dims(), &[4, 3]);
        // A finite-input MatMul may overflow FP32; ReLU cannot promise finite output.
        assert_eq!(model.graph().node(y).unwrap().domain, Domain::Any);
        assert_eq!(model.graph().modules().len(), 1);
        assert_eq!(
            model
                .metadata("architecture_global_nonnegative")
                .input_roles[&w.index()],
            "parameter"
        );
        let bound = model
            .bind([
                (
                    "bias",
                    Tensor::new(Shape::new(vec![3]).unwrap(), vec![0.0; 3]).unwrap(),
                ),
                (
                    "weights",
                    Tensor::new(Shape::new(vec![2, 3]).unwrap(), vec![1.0; 6]).unwrap(),
                ),
                (
                    "x",
                    Tensor::new(Shape::new(vec![4, 2]).unwrap(), vec![1.0; 8]).unwrap(),
                ),
            ])
            .unwrap();
        assert_eq!(bound.len(), 3);
    }

    #[test]
    fn certified_identity_is_independent_of_graph_allocation_history() {
        fn build_identity() -> String {
            let mut builder = ModelBuilder::new("stable_ident", "1");
            let x = builder.input("x", [2], Domain::NonNegativeFinite).unwrap();
            let y = builder.graph_mut().relu(x).unwrap();
            builder.output("y", y).unwrap();
            builder
                .proof_goal(ProofGoal {
                    name: "ordered".into(),
                    output: y,
                    kind: ProofGoalKind::Predicate(Predicate::pointwise_le(
                        ValueRef::Node(x),
                        ValueRef::Output,
                    )),
                })
                .unwrap();
            builder.finish().unwrap().certified_identity()
        }

        let first = build_identity();
        let _unrelated = NeuralGraph::default();
        let second = build_identity();
        assert_eq!(first, second);
        assert!(!first.contains("graph:"));
        assert!(first.contains("Predicate(PointwiseLe(Node(NodeId { index: 0 }), Output))"));
    }

    #[test]
    fn certificate_identity_tracks_named_contracts_not_absolute_paths() {
        let mut builder = ModelBuilder::new("ident", "0.1.0");
        let x = builder
            .input("input", [2], Domain::NonNegativeFinite)
            .unwrap();
        let y = builder
            .block("nonnegative", &[x], |g, p| g.relu(p[0]))
            .unwrap();
        builder.output("value", y).unwrap();
        builder
            .proof_goal(ProofGoal::nonnegative("nonnegative_goal", y, vec![]))
            .unwrap();
        let model = builder.finish().unwrap();
        let declaration = model.certified_identity();
        assert!(declaration.contains("id=ident\nversion=0.1.0"));
        assert!(declaration.contains("source=input;node=0;role=input"));
        assert!(declaration.contains("goal=nonnegative_goal;node=1"));
        assert!(!declaration.contains("/tmp/"));
    }

    #[test]
    fn certified_plan_rejects_unsupported_gpu_operations() {
        let mut builder = ModelBuilder::new("unsupported", "1");
        // Sqrt requires a nonnegative input; the test targets GPU lowering,
        // not the independent input-domain contract.
        let x = builder.input("x", [2], Domain::NonNegativeFinite).unwrap();
        let y = builder.graph_mut().sqrt(x).unwrap();
        builder.output("y", y).unwrap();
        let model = builder.finish().unwrap();
        assert!(matches!(
            model.plan(
                &ArchitectureAutoCompiler::default(),
                GpuRequirement::AllOutputs
            ),
            Err(AutoBuildError::Gpu(_)) | Err(AutoBuildError::Proof(_))
        ));
    }

    #[test]
    fn hidden_capture_is_rejected_without_partial_commit() {
        let mut builder = ModelBuilder::new("capture", "1");
        let x = builder.input("x", [2], Domain::Finite).unwrap();
        let hidden = builder.input("hidden", [2], Domain::Finite).unwrap();
        assert!(matches!(
            builder.block("bad", &[x], |g, p| g.add(p[0], hidden)),
            Err(ModelError::Neural(NeuralError::ContractViolation { .. }))
        ));
        assert_eq!(builder.graph_mut().nodes().len(), 2);
        let y = builder.block("good", &[x], |g, p| g.relu(p[0])).unwrap();
        builder.output("out", y).unwrap();
        assert!(builder.finish().is_ok());
    }

    #[test]
    fn graph_mut_cannot_sneak_unnamed_sources_past_binding_checks() {
        let mut builder = ModelBuilder::new("source_registry", "1");
        builder.input("x", [1], Domain::Finite).unwrap();
        let rogue = builder
            .graph_mut()
            .input(Shape::new(vec![1]).unwrap(), Domain::Finite);
        builder.output("out", rogue).unwrap();
        assert!(matches!(builder.finish(), Err(ModelError::Invalid(_))));
    }

    #[test]
    fn rejects_duplicate_source_and_missing_or_invalid_bindings() {
        let mut builder = ModelBuilder::new("checked", "1");
        let x = builder.input("x", [1], Domain::NonNegativeFinite).unwrap();
        assert!(matches!(
            builder.parameter("x", [1], Domain::Finite),
            Err(ModelError::Invalid(_))
        ));
        builder.output("out", x).unwrap();
        let model = builder.finish().unwrap();
        assert!(matches!(
            model.bind([] as [(&str, Tensor<f32>); 0]),
            Err(ModelError::Invalid(_))
        ));
        assert!(matches!(
            model.bind([(
                "x",
                Tensor::new(Shape::new(vec![1]).unwrap(), vec![-1.0]).unwrap()
            )]),
            Err(ModelError::Neural(NeuralError::ValueOutsideDomain { .. }))
        ));
    }
}

FILE	crates/verineural/src/modules.rs
//! Stage 6 neural building blocks expressed entirely through Semantic Neural IR.
//!
//! These modules have checked *shape* contracts; f32 overflow and backend
//! lowering remain outside the current Lean proof boundary.

use crate::{MathContract, NeuralError, NeuralGraph, NeuralModule, NodeId, PortContract, Shape};

/// Dense layer Y = X * W + bias, with row-wise bias broadcast.
pub struct Dense {
    contract: MathContract,
}

impl Dense {
    /// X is [batch, inputs], W is [inputs, outputs], bias is [outputs].
    pub fn new(batch: usize, inputs: usize, outputs: usize) -> Result<Self, NeuralError> {
        let x = Shape::new(vec![batch, inputs])?;
        let w = Shape::new(vec![inputs, outputs])?;
        let bias = Shape::new(vec![outputs])?;
        let y = Shape::new(vec![batch, outputs])?;
        Ok(Self {
            contract: MathContract::new(
                vec![
                    PortContract::any(x),
                    PortContract::any(w),
                    PortContract::any(bias),
                ],
                PortContract::any(y),
            ),
        })
    }
}

impl NeuralModule for Dense {
    fn name(&self) -> &'static str {
        "dense"
    }

    fn contract(&self) -> &MathContract {
        &self.contract
    }

    fn build(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        let product = graph.matmul(inputs[0], inputs[1])?;
        graph.bias_add(product, inputs[2])
    }
}

/// Elementwise residual connection Y = X + F(X), with no broadcasting.
pub struct ResidualAdd {
    contract: MathContract,
}

impl ResidualAdd {
    pub fn new(shape: Shape) -> Self {
        Self {
            contract: MathContract::new(
                vec![
                    PortContract::any(shape.clone()),
                    PortContract::any(shape.clone()),
                ],
                PortContract::any(shape),
            ),
        }
    }
}

impl NeuralModule for ResidualAdd {
    fn name(&self) -> &'static str {
        "residual_add"
    }

    fn contract(&self) -> &MathContract {
        &self.contract
    }

    fn build(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        graph.add(inputs[0], inputs[1])
    }
}

/// Residual two-layer FFN:
/// X + (ReLU(X W1 + b1) W2 + b2)
///
/// The five inputs are X, W1, b1, W2 and b2 in that order.
/// This is a forward-only composable primitive, not a Transformer or training
/// implementation. All weights are explicit graph inputs, not hidden constants.
pub struct ResidualFfn {
    contract: MathContract,
}

impl ResidualFfn {
    pub fn new(batch: usize, features: usize, hidden: usize) -> Result<Self, NeuralError> {
        let x = Shape::new(vec![batch, features])?;
        let w1 = Shape::new(vec![features, hidden])?;
        let b1 = Shape::new(vec![hidden])?;
        let w2 = Shape::new(vec![hidden, features])?;
        let b2 = Shape::new(vec![features])?;
        Ok(Self {
            contract: MathContract::new(
                vec![
                    PortContract::any(x.clone()),
                    PortContract::any(w1),
                    PortContract::any(b1),
                    PortContract::any(w2),
                    PortContract::any(b2),
                ],
                PortContract::any(x),
            ),
        })
    }
}

impl NeuralModule for ResidualFfn {
    fn name(&self) -> &'static str {
        "residual_ffn"
    }

    fn contract(&self) -> &MathContract {
        &self.contract
    }

    fn build(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        let first = graph.matmul(inputs[0], inputs[1])?;
        let first = graph.bias_add(first, inputs[2])?;
        let activated = graph.relu(first)?;
        let projected = graph.matmul(activated, inputs[3])?;
        let projected = graph.bias_add(projected, inputs[4])?;
        graph.add(inputs[0], projected)
    }
}

FILE	crates/verineural/src/primitive.rs
//! Versioned consumer-defined composite primitives lowered through typed Semantic IR.
//! This DSL deliberately cannot wrap opaque host callbacks or pretend to certify
//! unsupported backend operations.
use crate::{MathContract, NeuralError, NeuralGraph, NeuralModule, NodeId, Operation, Shape};

#[derive(Clone, Debug, PartialEq, Eq)]
pub enum PrimitiveExpr {
    Port(usize),
    Apply(Operation, Vec<PrimitiveExpr>),
}

// Inherent fluent methods are part of the consumer DSL's stable API.
// std::ops traits would require consumers to import the traits for method syntax.
#[allow(clippy::should_implement_trait)]
impl PrimitiveExpr {
    pub const fn port(index: usize) -> Self {
        Self::Port(index)
    }

    pub fn apply(operation: Operation, inputs: impl IntoIterator<Item = Self>) -> Self {
        Self::Apply(operation, inputs.into_iter().collect())
    }

    pub fn add(self, rhs: Self) -> Self {
        Self::apply(Operation::Add, [self, rhs])
    }

    pub fn mul(self, rhs: Self) -> Self {
        Self::apply(Operation::Mul, [self, rhs])
    }

    pub fn matmul(self, rhs: Self) -> Self {
        Self::apply(Operation::MatMul, [self, rhs])
    }

    pub fn bias_add(self, bias: Self) -> Self {
        Self::apply(Operation::BiasAdd, [self, bias])
    }

    pub fn relu(self) -> Self {
        Self::apply(Operation::Relu, [self])
    }

    pub fn positive_mask(self) -> Self {
        Self::apply(Operation::PositiveMask, [self])
    }

    pub fn select_positive(self, when_positive: Self, otherwise: Self) -> Self {
        Self::apply(Operation::SelectPositive, [self, when_positive, otherwise])
    }

    pub fn sqrt(self) -> Self {
        Self::apply(Operation::Sqrt, [self])
    }

    pub fn reshape(self, shape: Shape) -> Self {
        Self::apply(Operation::Reshape(shape), [self])
    }

    /// General row-major axis reduction, not a specialized neural block.
    pub fn reduce_sum(self, axis: usize) -> Self {
        Self::apply(Operation::ReduceSum { axis }, [self])
    }

    fn lower(&self, graph: &mut NeuralGraph, ports: &[NodeId]) -> Result<NodeId, NeuralError> {
        match self {
            Self::Port(index) => ports.get(*index).copied().ok_or(NeuralError::InvalidNode),
            Self::Apply(operation, inputs) => {
                let ids = inputs
                    .iter()
                    .map(|e| e.lower(graph, ports))
                    .collect::<Result<Vec<_>, _>>()?;
                graph.apply(operation.clone(), &ids)
            }
        }
    }
}

/// A versioned composite declaration lowered entirely through existing typed
/// operations. It reduces consumer boilerplate, but does not extend the atomic
/// operation set.
#[derive(Clone, Debug)]
pub struct PrimitiveSpec {
    pub id: &'static str,
    pub version: &'static str,
    pub contract: MathContract,
    pub expression: PrimitiveExpr,
}

impl PrimitiveSpec {
    pub fn new(
        id: &'static str,
        version: &'static str,
        contract: MathContract,
        expression: PrimitiveExpr,
    ) -> Result<Self, NeuralError> {
        if id.is_empty() || version.is_empty() {
            return Err(NeuralError::ContractViolation {
                module: id,
                detail: "primitive id and version must be nonempty",
            });
        }
        Ok(Self {
            id,
            version,
            contract,
            expression,
        })
    }

    pub fn apply(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        graph.apply_module(self, inputs)
    }
}

impl NeuralModule for PrimitiveSpec {
    fn name(&self) -> &'static str {
        self.id
    }
    fn contract(&self) -> &MathContract {
        &self.contract
    }
    fn semantic_version(&self) -> &'static str {
        self.version
    }
    fn build(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        self.expression.lower(graph, inputs)
    }
}

/// A small total elementwise mathematical language. Every argument has the
/// same shape. This AST, not a Rust callback, is the semantic source of truth.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum PointwiseExpr {
    Input(usize),
    Add(Box<Self>, Box<Self>),
    Mul(Box<Self>, Box<Self>),
    Sub(Box<Self>, Box<Self>),
    Div(Box<Self>, Box<Self>),
    Exp(Box<Self>),
    Sqrt(Box<Self>),
    Relu(Box<Self>),
}

// Preserve the same fluent expression-building API as PrimitiveExpr.
#[allow(clippy::should_implement_trait)]
impl PointwiseExpr {
    pub fn input(index: usize) -> Self {
        Self::Input(index)
    }

    pub fn add(self, rhs: Self) -> Self {
        Self::Add(Box::new(self), Box::new(rhs))
    }

    pub fn mul(self, rhs: Self) -> Self {
        Self::Mul(Box::new(self), Box::new(rhs))
    }

    pub fn sub(self, rhs: Self) -> Self {
        Self::Sub(Box::new(self), Box::new(rhs))
    }
    pub fn div(self, rhs: Self) -> Self {
        Self::Div(Box::new(self), Box::new(rhs))
    }
    pub fn exp(self) -> Self {
        Self::Exp(Box::new(self))
    }
    pub fn sqrt(self) -> Self {
        Self::Sqrt(Box::new(self))
    }
    pub fn relu(self) -> Self {
        Self::Relu(Box::new(self))
    }

    pub(crate) fn has_ideal_int_semantics(&self) -> bool {
        match self {
            Self::Input(_) => true,
            Self::Add(a, b) | Self::Mul(a, b) => {
                a.has_ideal_int_semantics() && b.has_ideal_int_semantics()
            }
            Self::Relu(a) => a.has_ideal_int_semantics(),
            Self::Sub(..) | Self::Div(..) | Self::Exp(..) | Self::Sqrt(..) => false,
        }
    }

    fn valid(&self, arity: usize, remaining_depth: usize) -> bool {
        if remaining_depth == 0 {
            return false;
        }
        match self {
            Self::Input(index) => *index < arity,
            Self::Add(a, b) | Self::Mul(a, b) | Self::Sub(a, b) | Self::Div(a, b) => {
                a.valid(arity, remaining_depth - 1) && b.valid(arity, remaining_depth - 1)
            }
            Self::Relu(a) | Self::Exp(a) | Self::Sqrt(a) => a.valid(arity, remaining_depth - 1),
        }
    }

    /// Canonical, unambiguous expression encoding for semantic fingerprints.
    pub fn canonical(&self) -> String {
        match self {
            Self::Input(port) => format!("arg:{port}"),
            Self::Add(a, b) => format!("add({},{})", a.canonical(), b.canonical()),
            Self::Mul(a, b) => format!("mul({},{})", a.canonical(), b.canonical()),
            Self::Sub(a, b) => format!("sub({},{})", a.canonical(), b.canonical()),
            Self::Div(a, b) => format!("div({},{})", a.canonical(), b.canonical()),
            Self::Exp(a) => format!("exp({})", a.canonical()),
            Self::Sqrt(a) => format!("sqrt({})", a.canonical()),
            Self::Relu(a) => format!("relu({})", a.canonical()),
        }
    }

    /// The Lean interpretation is derived entirely from this same AST.
    /// The caller provides graph-specific, validated tensor references.
    pub(crate) fn lean(&self, input: &impl Fn(usize) -> String) -> String {
        match self {
            // A substituted graph term may itself be an application with
            // named arguments (for example matmul). Keep it atomic when
            // an enclosing pointwise operator consumes it.
            Self::Input(port) => format!("({})", input(*port)),
            Self::Add(a, b) => {
                format!("(VeriNeural.add {} {})", a.lean(input), b.lean(input))
            }
            Self::Mul(a, b) => {
                format!("(VeriNeural.mul {} {})", a.lean(input), b.lean(input))
            }
            Self::Relu(a) => format!("(VeriNeural.relu {})", a.lean(input)),
            Self::Sub(..) | Self::Div(..) | Self::Exp(..) | Self::Sqrt(..) => {
                unreachable!(
                    "unsupported pointwise expression must be rejected before Lean generation"
                )
            }
        }
    }

    /// Independent ideal-Int theorem rule for an unconditional final ReLU.
    /// All other expressions require a different proof rule: fail closed.
    pub(crate) fn nonnegative_lean(&self, input: &impl Fn(usize) -> String) -> Option<String> {
        if !self.has_ideal_int_semantics() {
            return None;
        }
        match self {
            Self::Relu(inner) => Some(format!("VeriNeural.relu_nonnegative {}", inner.lean(input))),
            _ => None,
        }
    }

    fn evaluate(&self, input: &impl Fn(usize) -> f32) -> f32 {
        match self {
            Self::Input(port) => input(*port),
            Self::Add(a, b) => a.evaluate(input) + b.evaluate(input),
            Self::Mul(a, b) => a.evaluate(input) * b.evaluate(input),
            Self::Sub(a, b) => a.evaluate(input) - b.evaluate(input),
            Self::Div(a, b) => a.evaluate(input) / b.evaluate(input),
            Self::Exp(a) => a.evaluate(input).exp(),
            Self::Sqrt(a) => a.evaluate(input).sqrt(),
            Self::Relu(inner) => {
                let value = inner.evaluate(input);
                if value.is_nan() || value > 0.0 {
                    value
                } else {
                    0.0
                }
            }
        }
    }
}

/// A genuine single IR operation defined by a consumer, not a pre-expanded
/// neural module. Only supported pointwise AST semantics can be registered.
/// Lean models the ideal integer expression; GPU and FP32 proof backends reject
/// this operation until they implement corresponding verified lowerings.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct PointwiseSpec {
    id: &'static str,
    version: &'static str,
    arity: usize,
    expression: PointwiseExpr,
}

impl PointwiseSpec {
    pub fn new(
        id: &'static str,
        version: &'static str,
        arity: usize,
        expression: PointwiseExpr,
    ) -> Result<Self, NeuralError> {
        if id.is_empty() || version.is_empty() || arity == 0 {
            return Err(NeuralError::ContractViolation {
                module: id,
                detail: "pointwise primitive requires id, version and at least one input",
            });
        }
        // Bounds recursion and artifact sizes; never execute opaque Rust code.
        if !expression.valid(arity, 64) {
            return Err(NeuralError::ContractViolation {
                module: id,
                detail: "expression refers to an invalid input or exceeds 63 levels",
            });
        }
        Ok(Self {
            id,
            version,
            arity,
            expression,
        })
    }

    pub fn id(&self) -> &'static str {
        self.id
    }
    pub fn version(&self) -> &'static str {
        self.version
    }
    pub const fn arity(&self) -> usize {
        self.arity
    }
    pub fn expression(&self) -> &PointwiseExpr {
        &self.expression
    }

    pub fn apply(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        graph.apply(Operation::Pointwise(self.clone()), inputs)
    }

    /// Host reference only, not a floating-point certification or GPU backend.
    pub fn evaluate_host(
        &self,
        inputs: &[crate::Tensor<f32>],
    ) -> Result<crate::Tensor<f32>, NeuralError> {
        let shapes = inputs
            .iter()
            .map(|tensor| tensor.shape().clone())
            .collect::<Vec<_>>();
        let output_shape = Operation::Pointwise(self.clone()).infer_shape(&shapes)?;
        let values = (0..output_shape.element_count())
            .map(|element| {
                self.expression
                    .evaluate(&|port| inputs[port].values()[element])
            })
            .collect::<Vec<_>>();
        crate::Tensor::new(output_shape, values)
    }
}

#[cfg(test)]
mod lean_term_tests {
    use super::PointwiseExpr;

    #[test]
    fn substituted_matmul_application_is_one_lean_argument() {
        let matmul = "VeriNeural.matmul (m := 2) (k := 2) (n := 2) p_0 p_1";
        let input = |_port| matmul.to_owned();
        let relu = PointwiseExpr::input(0).relu();
        assert_eq!(relu.lean(&input), format!("(VeriNeural.relu ({matmul}))"));
        assert_eq!(
            relu.nonnegative_lean(&input),
            Some(format!("VeriNeural.relu_nonnegative ({matmul})"))
        );

        // Parenthesization must hold for multiple substituted operands too.
        let sum = PointwiseExpr::input(0).add(PointwiseExpr::input(1));
        assert_eq!(
            sum.lean(&input),
            format!("(VeriNeural.add ({matmul}) ({matmul}))")
        );
    }
}

FILE	crates/verineural/src/symbolic.rs
//! Symbolic shape contracts resolved to validated concrete binary32 Tensor IR.
//!
//! This is static specialization, not dynamic tensor shapes or polymorphic GPU
//! kernels. An instance is lowered to the existing concrete NeuralModule DAG:
//! Lean/GPU never receive unresolved symbolic dimensions.

use std::collections::BTreeMap;

use crate::{
    ContractClaim, Domain, MathContract, NeuralError, NeuralGraph, NeuralModule, NodeId,
    PortContract, Shape,
};

#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Dimension {
    Fixed(usize),
    Symbol(&'static str),
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct SymbolicShape {
    pub dims: Vec<Dimension>,
}

impl SymbolicShape {
    pub fn new(dims: Vec<Dimension>) -> Self {
        Self { dims }
    }
}

/// Binary32, contiguous row-major port; shape is specialized before lowering.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct SymbolicPort {
    pub shape: SymbolicShape,
    pub domain: Domain,
}

impl SymbolicPort {
    pub fn new(shape: SymbolicShape, domain: Domain) -> Self {
        Self { shape, domain }
    }
}

/// Restrictions on a named dimension; all bounds refer to positive sizes.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum DimensionConstraint {
    AtLeast(&'static str, usize),
    AtMost(&'static str, usize),
    MultipleOf(&'static str, usize),
}

/// A declared, reusable contract for concrete specializations.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct ParametricSignature {
    pub inputs: Vec<SymbolicPort>,
    pub output: SymbolicPort,
    pub constraints: Vec<DimensionConstraint>,
    pub claims: Vec<ContractClaim>,
}

/// Bindings are immutable records of the actual positive dimensions.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct DimensionBindings {
    values: BTreeMap<&'static str, usize>,
}

impl DimensionBindings {
    pub fn get(&self, symbol: &str) -> Option<usize> {
        self.values.get(symbol).copied()
    }

    pub fn values(&self) -> &BTreeMap<&'static str, usize> {
        &self.values
    }
}

fn valid_symbol(name: &str) -> bool {
    let Some(first) = name.bytes().next() else {
        return false;
    };
    first.is_ascii_alphabetic()
        && name
            .bytes()
            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_')
}

fn violation(module: &'static str, detail: &'static str) -> NeuralError {
    NeuralError::ContractViolation { module, detail }
}

impl ParametricSignature {
    /// Bind every repeated symbol across input axes, check explicit constraints,
    /// and resolve the output. Unbound outputs or unknown constraint symbols
    /// are errors, not implicit free dimensions.
    pub fn specialize(
        &self,
        owner: &'static str,
        actual_inputs: &[Shape],
    ) -> Result<(MathContract, DimensionBindings), NeuralError> {
        if actual_inputs.len() != self.inputs.len() {
            return Err(violation(owner, "symbolic module input arity mismatch"));
        }
        let mut bindings = BTreeMap::new();
        for (actual, expected) in actual_inputs.iter().zip(&self.inputs) {
            if actual.rank() != expected.shape.dims.len() {
                return Err(violation(owner, "symbolic tensor rank mismatch"));
            }
            for (&size, dimension) in actual.dims().iter().zip(&expected.shape.dims) {
                match dimension {
                    Dimension::Fixed(0) => {
                        return Err(violation(owner, "zero symbolic constant dimension"));
                    }
                    Dimension::Fixed(expected_size) if size != *expected_size => {
                        return Err(violation(owner, "fixed dimension mismatch"));
                    }
                    Dimension::Symbol(name) => {
                        if !valid_symbol(name) {
                            return Err(violation(owner, "invalid dimension symbol name"));
                        }
                        if let Some(&previous) = bindings.get(name) {
                            if previous != size {
                                return Err(violation(owner, "symbolic dimension mismatch"));
                            }
                        } else {
                            bindings.insert(*name, size);
                        }
                    }
                    Dimension::Fixed(_) => {}
                }
            }
        }

        for constraint in &self.constraints {
            let (symbol, limit) = match *constraint {
                DimensionConstraint::AtLeast(symbol, limit)
                | DimensionConstraint::AtMost(symbol, limit)
                | DimensionConstraint::MultipleOf(symbol, limit) => (symbol, limit),
            };
            let Some(&actual) = bindings.get(symbol) else {
                return Err(violation(owner, "constraint uses unbound dimension symbol"));
            };
            if limit == 0 {
                return Err(violation(
                    owner,
                    "dimension constraint requires positive bound",
                ));
            }
            let satisfied = match *constraint {
                DimensionConstraint::AtLeast(..) => actual >= limit,
                DimensionConstraint::AtMost(..) => actual <= limit,
                DimensionConstraint::MultipleOf(..) => actual % limit == 0,
            };
            if !satisfied {
                return Err(violation(owner, "symbolic dimension constraint violated"));
            }
        }

        let output_dims = self
            .output
            .shape
            .dims
            .iter()
            .map(|dim| match dim {
                Dimension::Fixed(0) => Err(violation(owner, "zero symbolic constant dimension")),
                Dimension::Fixed(size) => Ok(*size),
                Dimension::Symbol(symbol) => {
                    if !valid_symbol(symbol) {
                        return Err(violation(owner, "invalid dimension symbol name"));
                    }
                    bindings
                        .get(symbol)
                        .copied()
                        .ok_or_else(|| violation(owner, "output uses unbound dimension symbol"))
                }
            })
            .collect::<Result<Vec<_>, _>>()?;
        let output = Shape::new(output_dims)?;
        let requires = actual_inputs
            .iter()
            .zip(&self.inputs)
            .map(|(actual, declared)| PortContract::new(actual.clone(), declared.domain))
            .collect::<Vec<_>>();
        let mut contract =
            MathContract::new(requires, PortContract::new(output, self.output.domain));
        contract.claims.clone_from(&self.claims);
        Ok((contract, DimensionBindings { values: bindings }))
    }
}

/// One consumer module with one symbolic interface, specialized per invocation.
/// Only the supported concrete graph DSL can be emitted by build().
pub trait ParametricModule {
    fn name(&self) -> &'static str;
    fn semantic_version(&self) -> &'static str;
    fn signature(&self) -> &ParametricSignature;
    fn build(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError>;
}

struct BoundModule<'a, M: ParametricModule> {
    module: &'a M,
    contract: MathContract,
}

impl<M: ParametricModule> NeuralModule for BoundModule<'_, M> {
    fn name(&self) -> &'static str {
        self.module.name()
    }
    fn semantic_version(&self) -> &'static str {
        self.module.semantic_version()
    }
    fn contract(&self) -> &MathContract {
        &self.contract
    }
    fn build(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        self.module.build(graph, inputs)
    }
}

impl NeuralGraph {
    /// Resolve a symbolic consumer interface to a concrete module instance.
    /// All failures preserve the graph, including hidden captures and post-
    /// condition failures, because apply_module commits transactionally.
    pub fn apply_parametric_module<M: ParametricModule>(
        &mut self,
        module: &M,
        inputs: &[NodeId],
    ) -> Result<(NodeId, DimensionBindings), NeuralError> {
        let shapes = inputs
            .iter()
            .map(|&input| Ok(self.node(input)?.shape.clone()))
            .collect::<Result<Vec<_>, NeuralError>>()?;
        let (contract, bindings) = module.signature().specialize(module.name(), &shapes)?;
        let bounded = BoundModule { module, contract };
        let output = self.apply_module(&bounded, inputs)?;
        Ok((output, bindings))
    }
}

FILE	crates/verineural/src/temporal.rs
//! Finite-window unroll of any named recurrent Model into one ordinary IR DAG.
//! Shared parameters, explicit state edges and one supervised scalar VJP.
use crate::{
    DType, Domain, Model, NeuralError, NeuralGraph, NodeId, Operation, SourceRole, Tensor,
};
use std::collections::{BTreeMap, BTreeSet};
use std::error::Error;
use std::fmt;

#[derive(Debug)]
pub enum TemporalError {
    Neural(NeuralError),
    Invalid(String),
}
impl From<NeuralError> for TemporalError {
    fn from(e: NeuralError) -> Self {
        Self::Neural(e)
    }
}
impl fmt::Display for TemporalError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::Neural(e) => write!(f, "{e}"),
            Self::Invalid(e) => write!(f, "invalid temporal unroll: {e}"),
        }
    }
}
impl Error for TemporalError {}

pub struct TemporalUnroll {
    graph: NeuralGraph,
    parameters: BTreeMap<String, NodeId>,
    initial_states: BTreeMap<String, NodeId>,
    inputs: Vec<BTreeMap<String, NodeId>>,
    outputs: Vec<NodeId>,
    cotangents: Vec<NodeId>,
    terminal_states: BTreeMap<String, NodeId>,
    objective: NodeId,
}
impl TemporalUnroll {
    pub fn graph(&self) -> &NeuralGraph {
        &self.graph
    }
    pub fn parameters(&self) -> &BTreeMap<String, NodeId> {
        &self.parameters
    }
    pub fn initial_states(&self) -> &BTreeMap<String, NodeId> {
        &self.initial_states
    }
    pub fn inputs(&self) -> &[BTreeMap<String, NodeId>] {
        &self.inputs
    }
    pub fn outputs(&self) -> &[NodeId] {
        &self.outputs
    }
    pub fn cotangents(&self) -> &[NodeId] {
        &self.cotangents
    }
    pub fn terminal_states(&self) -> &BTreeMap<String, NodeId> {
        &self.terminal_states
    }
    pub fn objective(&self) -> NodeId {
        self.objective
    }

    /// Strictly checks all named parameter and state sources, every timestep
    /// input and cotangent. No silent default tensors or duplicate bindings.
    pub fn bindings(
        &self,
        base: &[(String, Tensor<f32>)],
        steps: &[Vec<(String, Tensor<f32>)>],
        cotangents: &[Tensor<f32>],
    ) -> Result<Vec<(NodeId, Tensor<f32>)>, TemporalError> {
        if steps.len() != self.inputs.len() || cotangents.len() != self.inputs.len() {
            return Err(TemporalError::Invalid(
                "step/cotangent count mismatch".into(),
            ));
        }
        let mut base_values = BTreeMap::new();
        for (name, value) in base {
            if base_values.insert(name.as_str(), value).is_some() {
                return Err(TemporalError::Invalid("duplicate base binding".into()));
            }
        }
        let expected = self
            .parameters
            .keys()
            .chain(self.initial_states.keys())
            .map(String::as_str)
            .collect::<BTreeSet<_>>();
        if base_values.keys().copied().collect::<BTreeSet<_>>() != expected {
            return Err(TemporalError::Invalid(
                "missing or extra base binding".into(),
            ));
        }
        let mut bound = Vec::new();
        for (name, &node) in self.parameters.iter().chain(self.initial_states.iter()) {
            bound.push((node, (*base_values[name.as_str()]).clone()));
        }
        for (t, values) in steps.iter().enumerate() {
            let mut supplied = BTreeMap::new();
            for (name, value) in values {
                if supplied.insert(name.as_str(), value).is_some() {
                    return Err(TemporalError::Invalid("duplicate step input".into()));
                }
            }
            let expected = self.inputs[t]
                .keys()
                .map(String::as_str)
                .collect::<BTreeSet<_>>();
            if supplied.keys().copied().collect::<BTreeSet<_>>() != expected {
                return Err(TemporalError::Invalid(format!(
                    "missing or extra timestep source at {t}"
                )));
            }
            for (name, &node) in &self.inputs[t] {
                bound.push((node, (*supplied[name.as_str()]).clone()));
            }
            bound.push((self.cotangents[t], cotangents[t].clone()));
        }
        for (id, tensor) in &bound {
            let node = self.graph.node(*id)?;
            if tensor.shape() != &node.shape {
                return Err(TemporalError::Invalid(
                    "source tensor shape mismatch".into(),
                ));
            }
            tensor.validate_domain(node.domain)?;
        }
        Ok(bound)
    }
}

/// Unroll 1..=16 steps. Parameter nodes are shared; state feedback connects
/// pure prior-step producers to new consumers. A new initial state is an explicit
/// truncated-BPTT boundary (no gradient into a previous window).
/// The scalar objective is sum_t dot(output[t], cotangent[t]).
pub fn unroll_model(
    model: &Model,
    output_name: &str,
    steps: usize,
) -> Result<TemporalUnroll, TemporalError> {
    unroll_model_impl(model, output_name, steps, false)
}

/// Opt-in temporal common-subgraph reuse for computations depending ONLY on
/// named parameters. Within one BPTT window parameters are immutable: a
/// parameter-only node has the same value at every step. We materialize it
/// once and reuse its NodeId, including for all consumers and reverse-mode AD.
///
/// No state, token input, or state-dependent computation is hoisted. This
/// transformation changes the training IR/fingerprint; consumers must not
/// silently resume a checkpoint produced by the unoptimized unroll.
/// Mathematical equivalence does not imply identical FP32 AD reductions.
pub fn unroll_model_hoisted(
    model: &Model,
    output_name: &str,
    steps: usize,
) -> Result<TemporalUnroll, TemporalError> {
    unroll_model_impl(model, output_name, steps, true)
}

fn unroll_model_impl(
    model: &Model,
    output_name: &str,
    steps: usize,
    hoist_parameter_only: bool,
) -> Result<TemporalUnroll, TemporalError> {
    if !(1..=16).contains(&steps) {
        return Err(TemporalError::Invalid(
            "window length must be 1..=16".into(),
        ));
    }
    let root = model
        .output(output_name)
        .ok_or_else(|| TemporalError::Invalid("unknown supervised output".into()))?;
    let output = model.graph().node(root)?;
    if output.dtype != DType::F32 || output.shape.rank() != 2 || output.shape.dims()[0] != 1 {
        return Err(TemporalError::Invalid(
            "supervised output must be F32 [1,N]".into(),
        ));
    }
    let old_nodes = model.graph().nodes();
    let source_by_id = model
        .sources()
        .iter()
        .map(|(name, &(id, role))| (id.index(), (name.clone(), role)))
        .collect::<BTreeMap<_, _>>();
    if source_by_id.len() != model.sources().len() {
        return Err(TemporalError::Invalid(
            "duplicate named source nodes".into(),
        ));
    }
    // Only node values transitively determined by Parameter sources may be
    // reused. Build the predicate on the original topological model graph.
    // Recurrent State and timestep Input sources are always variant.
    let mut parameter_only = vec![false; old_nodes.len()];
    if hoist_parameter_only {
        for node in old_nodes {
            parameter_only[node.id.index()] = if matches!(node.operation, Operation::Input) {
                source_by_id
                    .get(&node.id.index())
                    .is_some_and(|(_, role)| *role == SourceRole::Parameter)
            } else {
                node.inputs
                    .iter()
                    .all(|id| parameter_only.get(id.index()) == Some(&true))
            };
        }
    }
    let mut cached_parameter_only = vec![None; old_nodes.len()];
    let mut graph = NeuralGraph::new(model.graph().policy());
    let mut params = BTreeMap::new();
    let mut initial = BTreeMap::new();
    for (name, &(id, role)) in model.sources() {
        if role == SourceRole::Input {
            continue;
        }
        let node = model.graph().node(id)?;
        let src = graph.input(node.shape.clone(), node.domain);
        match role {
            SourceRole::Parameter => {
                params.insert(name.clone(), src);
            }
            SourceRole::State => {
                initial.insert(name.clone(), src);
            }
            SourceRole::Input => unreachable!(),
        }
    }
    let mut previous = initial.clone();
    let mut step_inputs = Vec::new();
    let mut outputs = Vec::new();
    let mut cotangents = Vec::new();
    let mut objective = None;
    for _ in 0..steps {
        let mut mapping: Vec<Option<NodeId>> = vec![None; old_nodes.len()];
        let mut inputs = BTreeMap::new();
        for node in old_nodes {
            let index = node.id.index();
            // Cache hits are permitted only for parameter-only nodes.
            // All other nodes follow exactly the historical builder path.
            let new = if hoist_parameter_only && let Some(reused) = cached_parameter_only[index] {
                reused
            } else if matches!(node.operation, Operation::Input) {
                let (name, role) = source_by_id
                    .get(&node.id.index())
                    .ok_or_else(|| TemporalError::Invalid("unregistered original input".into()))?;
                match role {
                    SourceRole::Parameter => params[name],
                    SourceRole::State => previous[name],
                    SourceRole::Input => {
                        let src = graph.input(node.shape.clone(), node.domain);
                        inputs.insert(name.clone(), src);
                        src
                    }
                }
            } else {
                let ids = node
                    .inputs
                    .iter()
                    .map(|id| {
                        mapping[id.index()].ok_or_else(|| {
                            TemporalError::Invalid("original nodes not in topological order".into())
                        })
                    })
                    .collect::<Result<Vec<_>, _>>()?;
                graph.apply(node.operation.clone(), &ids)?
            };
            if hoist_parameter_only && parameter_only[index] {
                cached_parameter_only[index] = Some(new);
            }
            mapping[node.id.index()] = Some(new);
        }
        let logits = mapping[root.index()]
            .ok_or_else(|| TemporalError::Invalid("missing remapped model output".into()))?;
        let seed = graph.input(output.shape.clone(), Domain::Finite);
        let transposed = graph.permute(seed, &[1, 0])?;
        let scalar = graph.matmul(logits, transposed)?;
        objective = Some(match objective {
            None => scalar,
            Some(sum) => graph.add(sum, scalar)?,
        });
        let mut next = BTreeMap::new();
        for (name, &old) in model.state_links() {
            next.insert(
                name.clone(),
                mapping[old.index()]
                    .ok_or_else(|| TemporalError::Invalid("missing remapped transition".into()))?,
            );
        }
        if next.len() != initial.len() {
            return Err(TemporalError::Invalid(
                "missing temporal state transition".into(),
            ));
        }
        previous = next;
        step_inputs.push(inputs);
        outputs.push(logits);
        cotangents.push(seed);
    }
    Ok(TemporalUnroll {
        graph,
        parameters: params,
        initial_states: initial,
        inputs: step_inputs,
        outputs,
        cotangents,
        terminal_states: previous,
        objective: objective.expect("nonempty checked window"),
    })
}

FILE	crates/verineural/src/tensor.rs
use crate::{ArgMaxTieBreak, DType, Domain, NeuralError, Operation};

/// Validated, immutable tensor dimensions. An empty dimension list is a scalar.
#[derive(Clone, Debug, PartialEq, Eq, Hash)]
pub struct Shape(Vec<usize>);

impl Shape {
    pub fn new(dims: impl Into<Vec<usize>>) -> Result<Self, NeuralError> {
        let dims = dims.into();
        if dims.contains(&0) {
            return Err(NeuralError::ZeroDimension);
        }
        dims.iter()
            .try_fold(1usize, |acc, &d| acc.checked_mul(d))
            .ok_or(NeuralError::ElementCountOverflow)?;
        Ok(Self(dims))
    }

    pub fn dims(&self) -> &[usize] {
        &self.0
    }

    pub fn rank(&self) -> usize {
        self.0.len()
    }

    pub fn element_count(&self) -> usize {
        // Checked on construction and immutable afterwards.
        self.0.iter().product()
    }

    /// Canonical contiguous row-major strides in elements.
    pub fn row_major_strides(&self) -> Vec<usize> {
        let mut strides = vec![0; self.0.len()];
        let mut stride = 1usize;
        for axis in (0..self.0.len()).rev() {
            strides[axis] = stride;
            stride = stride
                .checked_mul(self.0[axis])
                .expect("Shape::new already validated element count");
        }
        strides
    }
}

/// Shape information for a tensor. Custom implementations are revalidated.
pub trait TensorShape: Clone {
    fn dims(&self) -> &[usize];
}

impl TensorShape for Shape {
    fn dims(&self) -> &[usize] {
        self.dims()
    }
}

/// Owned host tensor. Shape and number of elements are checked at construction.
#[derive(Clone, Debug, PartialEq)]
pub struct Tensor<T, S: TensorShape = Shape> {
    shape: S,
    values: Vec<T>,
}

/// Runtime value preserving the Semantic IR element type across host/device
/// boundaries. Index tensors use host `usize`, while the supported CUDA ABI
/// stores them as checked nonnegative i32 values.
#[derive(Clone, Debug, PartialEq)]
pub enum TensorValue {
    F32(Tensor<f32>),
    Index(Tensor<usize>),
}

impl TensorValue {
    pub const fn dtype(&self) -> DType {
        match self {
            Self::F32(_) => DType::F32,
            Self::Index(_) => DType::Index,
        }
    }

    pub fn shape(&self) -> &Shape {
        match self {
            Self::F32(tensor) => tensor.shape(),
            Self::Index(tensor) => tensor.shape(),
        }
    }

    pub const fn as_f32(&self) -> Option<&Tensor<f32>> {
        match self {
            Self::F32(tensor) => Some(tensor),
            Self::Index(_) => None,
        }
    }

    pub const fn as_index(&self) -> Option<&Tensor<usize>> {
        match self {
            Self::F32(_) => None,
            Self::Index(tensor) => Some(tensor),
        }
    }

    pub fn into_f32(self) -> Option<Tensor<f32>> {
        match self {
            Self::F32(tensor) => Some(tensor),
            Self::Index(_) => None,
        }
    }

    pub fn into_index(self) -> Option<Tensor<usize>> {
        match self {
            Self::F32(_) => None,
            Self::Index(tensor) => Some(tensor),
        }
    }
}

fn unravel_index(mut index: usize, dims: &[usize]) -> Vec<usize> {
    let mut coords = vec![0; dims.len()];
    for axis in (0..dims.len()).rev() {
        coords[axis] = index % dims[axis];
        index /= dims[axis];
    }
    coords
}

fn ravel_index(coords: &[usize], dims: &[usize]) -> usize {
    coords
        .iter()
        .zip(dims)
        .fold(0usize, |flat, (&coord, &dim)| flat * dim + coord)
}

impl<T, S: TensorShape> Tensor<T, S> {
    pub fn new(shape: S, values: Vec<T>) -> Result<Self, NeuralError> {
        let checked = Shape::new(shape.dims().to_vec())?;
        if checked.element_count() != values.len() {
            return Err(NeuralError::DataLengthMismatch {
                expected: checked.element_count(),
                actual: values.len(),
            });
        }
        Ok(Self { shape, values })
    }

    pub fn shape(&self) -> &S {
        &self.shape
    }

    pub fn values(&self) -> &[T] {
        &self.values
    }

    pub fn into_values(self) -> Vec<T> {
        self.values
    }
}

impl<T> Tensor<T> {
    /// Construct a tensor without creating a Shape separately.
    pub fn from_vec(dims: impl Into<Vec<usize>>, values: Vec<T>) -> Result<Self, NeuralError> {
        Self::new(Shape::new(dims)?, values)
    }

    /// Copy borrowed values into a shape-validated tensor.
    pub fn from_slice(dims: impl Into<Vec<usize>>, values: &[T]) -> Result<Self, NeuralError>
    where
        T: Clone,
    {
        Self::from_vec(dims, values.to_vec())
    }

    /// Create a tensor filled with T::default(), zero for numeric types.
    pub fn zeros(dims: impl Into<Vec<usize>>) -> Result<Self, NeuralError>
    where
        T: Default + Clone,
    {
        let shape = Shape::new(dims)?;
        Self::new(shape.clone(), vec![T::default(); shape.element_count()])
    }
}

impl<T: Clone> Tensor<T> {
    /// Reorder axes in row-major order. `axes[output_axis] = input_axis`.
    pub fn permute(&self, axes: &[usize]) -> Result<Self, NeuralError> {
        let operation = Operation::Permute {
            axes: axes.to_vec(),
        };
        let shape = operation.infer_shape(std::slice::from_ref(&self.shape))?;
        let mut values = Vec::with_capacity(self.values.len());
        for output_index in 0..shape.element_count() {
            let output_coords = unravel_index(output_index, shape.dims());
            let mut input_coords = vec![0; self.shape.rank()];
            for (output_axis, &input_axis) in axes.iter().enumerate() {
                input_coords[input_axis] = output_coords[output_axis];
            }
            values.push(self.values[ravel_index(&input_coords, self.shape.dims())].clone());
        }
        Self::new(shape, values)
    }

    /// Explicit right-aligned broadcast; singleton input axes repeat.
    pub fn broadcast_to(&self, output: Shape) -> Result<Self, NeuralError> {
        let op = Operation::BroadcastTo(output);
        let shape = op.infer_shape(std::slice::from_ref(&self.shape))?;
        let offset = shape.rank() - self.shape.rank();
        let mut values = Vec::with_capacity(shape.element_count());
        for index in 0..shape.element_count() {
            let out = unravel_index(index, shape.dims());
            let coords = self
                .shape
                .dims()
                .iter()
                .enumerate()
                .map(
                    |(axis, &width)| {
                        if width == 1 { 0 } else { out[offset + axis] }
                    },
                )
                .collect::<Vec<_>>();
            values.push(self.values[ravel_index(&coords, self.shape.dims())].clone());
        }
        Self::new(shape, values)
    }

    /// Reverse one row-major axis without changing shape.
    pub fn reverse_axis(&self, axis: usize) -> Result<Self, NeuralError> {
        let operation = Operation::ReverseAxis { axis };
        let shape = operation.infer_shape(std::slice::from_ref(&self.shape))?;
        let mut values = Vec::with_capacity(self.values.len());
        for output_index in 0..shape.element_count() {
            let mut input_coords = unravel_index(output_index, shape.dims());
            input_coords[axis] = shape.dims()[axis] - 1 - input_coords[axis];
            values.push(self.values[ravel_index(&input_coords, self.shape.dims())].clone());
        }
        Self::new(shape, values)
    }

    /// Static contiguous slice of one row-major axis.
    pub fn slice_axis(&self, axis: usize, start: usize, len: usize) -> Result<Self, NeuralError> {
        let operation = Operation::SliceAxis { axis, start, len };
        let shape = operation.infer_shape(std::slice::from_ref(&self.shape))?;
        let mut values = Vec::with_capacity(shape.element_count());
        for output_index in 0..shape.element_count() {
            let mut input_coords = unravel_index(output_index, shape.dims());
            input_coords[axis] += start;
            values.push(self.values[ravel_index(&input_coords, self.shape.dims())].clone());
        }
        Self::new(shape, values)
    }

    /// Concatenate two tensors along one axis.
    pub fn concat(&self, rhs: &Self, axis: usize) -> Result<Self, NeuralError> {
        let operation = Operation::Concat { axis };
        let shape = operation.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        let left_width = self.shape.dims()[axis];
        let mut values = Vec::with_capacity(shape.element_count());
        for output_index in 0..shape.element_count() {
            let output_coords = unravel_index(output_index, shape.dims());
            if output_coords[axis] < left_width {
                values.push(self.values[ravel_index(&output_coords, self.shape.dims())].clone());
            } else {
                let mut right_coords = output_coords;
                right_coords[axis] -= left_width;
                values.push(rhs.values[ravel_index(&right_coords, rhs.shape.dims())].clone());
            }
        }
        Self::new(shape, values)
    }

    /// Select one lane from an axis using a one-element host index tensor.
    pub fn take(&self, index: &Tensor<usize>, axis: usize) -> Result<Self, NeuralError> {
        let operation = Operation::Take { axis };
        let shape = operation.infer_shape(&[self.shape.clone(), index.shape.clone()])?;
        let selected = index.values[0];
        let bound = self.shape.dims()[axis];
        if selected >= bound {
            return Err(NeuralError::IndexOutOfBounds {
                axis,
                index: selected,
                bound,
            });
        }
        let mut values = Vec::with_capacity(shape.element_count());
        for output_index in 0..shape.element_count() {
            let output_coords = unravel_index(output_index, shape.dims());
            let mut input_coords = Vec::with_capacity(self.shape.rank());
            let mut output_axis = 0;
            for input_axis in 0..self.shape.rank() {
                if input_axis == axis {
                    input_coords.push(selected);
                } else {
                    input_coords.push(output_coords[output_axis]);
                    output_axis += 1;
                }
            }
            values.push(self.values[ravel_index(&input_coords, self.shape.dims())].clone());
        }
        Self::new(shape, values)
    }
}

impl Tensor<f32> {
    /// Independently validate concrete input values against a graph assumption.
    pub fn validate_domain(&self, domain: Domain) -> Result<(), NeuralError> {
        for (index, &v) in self.values.iter().enumerate() {
            let valid = match domain {
                Domain::Any => true,
                Domain::Finite => v.is_finite(),
                Domain::NonNegativeFinite => v.is_finite() && v >= 0.0,
            };
            if !valid {
                return Err(NeuralError::ValueOutsideDomain {
                    index,
                    required: domain,
                });
            }
        }
        Ok(())
    }

    /// Pure host reference calculation. Not a certified FP32 kernel.
    pub fn add(&self, rhs: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::Add.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        let values = self
            .values
            .iter()
            .zip(&rhs.values)
            .map(|(&a, &b)| a + b)
            .collect();
        Self::new(shape, values)
    }

    /// Pure elementwise host reference calculation, without broadcasting.
    pub fn mul(&self, rhs: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::Mul.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        let values = self
            .values
            .iter()
            .zip(&rhs.values)
            .map(|(&a, &b)| a * b)
            .collect();
        Self::new(shape, values)
    }

    /// Elementwise subtraction, without implicit broadcasting.
    pub fn sub(&self, rhs: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::Add.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        Self::new(
            shape,
            self.values
                .iter()
                .zip(&rhs.values)
                .map(|(&a, &b)| a - b)
                .collect(),
        )
    }

    /// Elementwise division (including IEEE NaN/inf on zero denominator).
    pub fn div(&self, rhs: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::Mul.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        Self::new(
            shape,
            self.values
                .iter()
                .zip(&rhs.values)
                .map(|(&a, &b)| a / b)
                .collect(),
        )
    }

    /// Elementwise exponential. Host f32 reference, not certified.
    pub fn exp(&self) -> Result<Self, NeuralError> {
        Self::new(
            self.shape.clone(),
            self.values.iter().map(|x| x.exp()).collect(),
        )
    }

    /// Add one rank-1 bias vector to every matrix row.
    pub fn bias_add(&self, rhs: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::BiasAdd.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        let columns = shape.dims()[1];
        let values = self
            .values
            .iter()
            .enumerate()
            .map(|(i, &x)| x + rhs.values[i % columns])
            .collect();
        Self::new(shape, values)
    }

    /// Matrix multiplication of two rank-2 tensors. Accumulates left to right.
    pub fn matmul(&self, rhs: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::MatMul.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        let [m, k] = self.shape.dims() else {
            unreachable!("shape checked above")
        };
        let n = rhs.shape.dims()[1];
        let mut values = vec![0.0f32; shape.element_count()];
        for row in 0..*m {
            for col in 0..n {
                let mut sum = 0.0f32;
                for inner in 0..*k {
                    sum += self.values[row * *k + inner] * rhs.values[inner * n + col];
                }
                values[row * n + col] = sum;
            }
        }
        Self::new(shape, values)
    }

    /// Canonical 0/1 positive mask: NaN and signed zero both take false.
    /// This host operation is a reference, not an IEEE/GPU proof.
    pub fn positive_mask(&self) -> Self {
        Self {
            shape: self.shape.clone(),
            values: self
                .values
                .iter()
                .map(|&v| if v > 0.0 { 1.0 } else { 0.0 })
                .collect(),
        }
    }

    /// Select the original binary32 payload from one branch, without arithmetic,
    /// using a strict positive comparison. The result has the branches' shape.
    pub fn select_positive(&self, yes: &Self, no: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::SelectPositive.infer_shape(&[
            self.shape.clone(),
            yes.shape.clone(),
            no.shape.clone(),
        ])?;
        let values = self
            .values
            .iter()
            .zip(&yes.values)
            .zip(&no.values)
            .map(
                |((&mask, &on_true), &on_false)| {
                    if mask > 0.0 { on_true } else { on_false }
                },
            )
            .collect();
        Self::new(shape, values)
    }

    /// Elementwise max(x, 0), preserving NaN instead of silently hiding it.
    pub fn relu(&self) -> Self {
        Self {
            shape: self.shape.clone(),
            values: self
                .values
                .iter()
                .map(|&v| if v.is_nan() || v > 0.0 { v } else { 0.0 })
                .collect(),
        }
    }

    /// Reject negative and non-finite arguments, as specified by the IR domain.
    pub fn sqrt(&self) -> Result<Self, NeuralError> {
        self.validate_domain(Domain::NonNegativeFinite)?;
        Self::new(
            self.shape.clone(),
            self.values.iter().map(|v| v.sqrt()).collect(),
        )
    }

    /// Deterministic row-major argmax. Equal maxima keep the first lane. NaN
    /// never replaces a numeric best; an initial NaN is replaced by the first
    /// numeric lane. If every lane is NaN, the first lane wins.
    pub fn argmax(
        &self,
        axis: usize,
        tie_break: ArgMaxTieBreak,
    ) -> Result<Tensor<usize>, NeuralError> {
        let operation = Operation::ArgMax { axis, tie_break };
        let shape = operation.infer_shape(std::slice::from_ref(&self.shape))?;
        let width = self.shape.dims()[axis];
        let inner = self.shape.dims()[axis + 1..].iter().product::<usize>();
        let mut values = Vec::with_capacity(shape.element_count());
        for output_index in 0..shape.element_count() {
            let outer = output_index / inner;
            let suffix = output_index % inner;
            let mut best = 0usize;
            let mut best_value = self.values[(outer * width) * inner + suffix];
            for lane in 1..width {
                let candidate = self.values[(outer * width + lane) * inner + suffix];
                match tie_break {
                    ArgMaxTieBreak::First => {
                        if !candidate.is_nan() && (best_value.is_nan() || candidate > best_value) {
                            best = lane;
                            best_value = candidate;
                        }
                    }
                }
            }
            values.push(best);
        }
        Tensor::new(shape, values)
    }

    /// Row-major sum over any axis, with an explicit left-to-right f32 fold.
    /// This is a host reference, NOT a proof of its rounding or GPU behavior.
    pub fn reduce_sum(&self, axis: usize) -> Result<Self, NeuralError> {
        let output_shape =
            Operation::ReduceSum { axis }.infer_shape(std::slice::from_ref(&self.shape))?;
        let width = self.shape.dims()[axis];
        let inner = self.shape.dims()[axis + 1..].iter().product::<usize>();
        let mut values = Vec::with_capacity(output_shape.element_count());
        for index in 0..output_shape.element_count() {
            let outer = index / inner;
            let suffix = index % inner;
            let mut sum = 0.0f32;
            for lane in 0..width {
                sum += self.values[(outer * width + lane) * inner + suffix];
            }
            values.push(sum);
        }
        Self::new(output_shape, values)
    }

    /// Deterministic maximum, preserving NaN and taking the first maximum
    /// on ties. f32 semantics are reference-only until a backend is audited.
    pub fn reduce_max(&self, axis: usize) -> Result<Self, NeuralError> {
        let output_shape =
            Operation::ReduceMax { axis }.infer_shape(std::slice::from_ref(&self.shape))?;
        let width = self.shape.dims()[axis];
        let inner = self.shape.dims()[axis + 1..].iter().product::<usize>();
        let mut values = Vec::with_capacity(output_shape.element_count());
        for index in 0..output_shape.element_count() {
            let outer = index / inner;
            let suffix = index % inner;
            let mut best = self.values[(outer * width) * inner + suffix];
            for lane in 1..width {
                let candidate = self.values[(outer * width + lane) * inner + suffix];
                if candidate.is_nan() || (!best.is_nan() && candidate > best) {
                    best = candidate;
                }
            }
            values.push(best);
        }
        Self::new(output_shape, values)
    }

    /// Same values, new dimensions with the same element count.
    pub fn reshape(self, shape: Shape) -> Result<Self, NeuralError> {
        Operation::Reshape(shape.clone()).infer_shape(std::slice::from_ref(&self.shape))?;
        Self::new(shape, self.values)
    }
}

FILE	flake.nix
{
  description = "polytropos-alpha: Rust, LLVM NVPTX, CUDA, Lean 4, Graphviz and Task development environment";

  # Keep the project's existing nixpkgs / flake.lock pin.
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";
  inputs.repospool = {
    url = "github:iivkis/repospool/3f7ff9570c9302690b21b96be84e7adb95b6990a";
    inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = { self, nixpkgs, repospool }:
    let
      # VeriNeural currently targets NVIDIA GPU development on Linux x86_64.
      system = "x86_64-linux";
      pkgs = import nixpkgs {
        inherit system;
        config.allowUnfree = true;
      };
    in
    {
      devShells.${system}.default = pkgs.mkShell {
        packages = (with pkgs; [
          git
          rustc
          cargo
          rustfmt
          clippy

          go-task
          coreutils # sha256sum for evidence manifests
          binutils
          graphviz # dot renderer for architecture.dot -> architecture.png

          llvmPackages.llvm
          llvmPackages.clang
          cmake
          ninja
          pkg-config

          lean4

          cudaPackages.cuda_nvcc
          cudaPackages.cuda_cudart
          cudaPackages.nsight_systems
          cudaPackages.nsight_compute
        ]) ++ [ repospool.packages.${system}.default ];

        shellHook = ''
          # nvcc and native CUDA runtime come from pinned nixpkgs;
          # libcuda.so.1 must come from the host NVIDIA driver.
          export CUDA_LIB_DIR="${pkgs.cudaPackages.cuda_cudart}/lib"
          export NVCC="${pkgs.cudaPackages.cuda_nvcc}/bin/nvcc"
          # GeForce RTX 5060 (Blackwell, compute capability 12.0).
          # Note: VeriNeural's current GpuEngine default arch is set in Rust.
          export CUDA_ARCH=120

          cuda_driver_dir=""
          if test -f /usr/lib/wsl/lib/libcuda.so.1; then
            cuda_driver_dir="/usr/lib/wsl/lib"
          elif test -f /run/opengl-driver/lib/libcuda.so.1; then
            cuda_driver_dir="/run/opengl-driver/lib"
          fi

          if test -n "$cuda_driver_dir"; then
            export CUDA_DRIVER_LIB_DIR="$cuda_driver_dir"
            # Host driver must win over CUDA toolkit stubs / other libcuda copies.
            if test -n "$LD_LIBRARY_PATH"; then
              export LD_LIBRARY_PATH="$cuda_driver_dir:$CUDA_LIB_DIR:$LD_LIBRARY_PATH"
            else
              export LD_LIBRARY_PATH="$cuda_driver_dir:$CUDA_LIB_DIR"
            fi
            if test -x "$cuda_driver_dir/nvidia-smi"; then
              export PATH="$cuda_driver_dir:$PATH"
            elif test -x /run/opengl-driver/bin/nvidia-smi; then
              export PATH="/run/opengl-driver/bin:$PATH"
            fi
            echo "CUDA driver libraries: $cuda_driver_dir"
          else
            unset CUDA_DRIVER_LIB_DIR
            if test -n "$LD_LIBRARY_PATH"; then
              export LD_LIBRARY_PATH="$CUDA_LIB_DIR:$LD_LIBRARY_PATH"
            else
              export LD_LIBRARY_PATH="$CUDA_LIB_DIR"
            fi
            echo "CUDA driver libraries not found in WSL/NixOS host paths; GPU tasks may fail"
          fi
          unset cuda_driver_dir

          echo "VeriNeural devShell: Rust / LLVM / Lean 4 / CUDA / Graphviz / Task"
          echo "GPU execution requires a compatible host NVIDIA driver."
          echo "nsys=$(command -v nsys || echo unavailable)"
          echo "ncu=$(command -v ncu || echo unavailable)"
          echo "dot=$(command -v dot || echo unavailable)"
          echo "repospool=$(command -v repospool || echo unavailable)"
          echo "Use 'task --list' to see local commands."
        '';
      };
    };
}

