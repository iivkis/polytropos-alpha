    fn build(
        &self,
        graph: &mut NeuralGraph,
        inputs: &[NodeId],
    ) -> Result<NodeId, verineural::NeuralError> {
        graph.mul(inputs[0], inputs[1])
    }
}

struct GlobalNonnegativeMatMul {
