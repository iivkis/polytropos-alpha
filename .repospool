const PTX_PROFILES: [&str; 14] = [
    "baseline",
    "fused",
    "baseline_matmul",
    "fused_matmul",
    "baseline_rne",
    "fused_rne",
    "baseline_rne_matmul",
    "fused_rne_matmul",
    "baseline_fma",
    "fused_fma",
    "baseline_subnormal",
    "fused_subnormal",
    "baseline_special",
    "fused_special",
];

/// Recheck the actually saved PTX/LLVM pairs, not only the Rust generator.
/// Static opcode/rounding checks are not a PTX-to-SASS translation proof.
fn fp32_contraction_report(root: &Path) -> Result<String, Box<dyn Error>> {
    let mut report = String::from("scope=LLVM-inline-PTX-vs-emitted-PTX\n");
    report.push_str("guarantee=static-rounded-add-mul-opcodes-and-no-PTX-FMA\n");
    report.push_str("machine_fp32_sass_jit=trusted-not-proven\n");
    for profile in PTX_PROFILES {
        let dir = root.join(profile);
        let llvm = fs::read_to_string(dir.join("graph.ll"))?;
        let ptx = fs::read_to_string(dir.join("graph.ptx"))?;
        let audit = audit_fp32_ptx(&llvm, &ptx)?;
        report.push_str(&format!(
            "{profile}:add.rn.f32={} mul.rn.f32={} fma=0\n",
            audit.rounded_adds, audit.rounded_muls
        ));
    }
    Ok(report)
}

const SPECIAL_PROBE_LANES: usize = 13;

/// Validate *saved* observed GPU bits against the independent narrow bit oracle.
/// NaN payload/sign can vary; for all other cases exact bits are required.
/// Every returned line is checked again by offline verification.
fn special_values_report(root: &Path) -> Result<String, Box<dyn Error>> {
    let inputs = fs::read_to_string(root.join("special_inputs.bits"))?;
    let baseline = fs::read_to_string(root.join("special_baseline_output.bits"))?;
    let fused = fs::read_to_string(root.join("special_fused_output.bits"))?;
    let input_lines = inputs.lines().collect::<Vec<_>>();
    let baseline_lines = baseline.lines().collect::<Vec<_>>();
    let fused_lines = fused.lines().collect::<Vec<_>>();
    if input_lines.len() != SPECIAL_PROBE_LANES
        || baseline_lines.len() != SPECIAL_PROBE_LANES
        || fused_lines.len() != SPECIAL_PROBE_LANES
    {
        return Err(io::Error::other("special FP32 evidence row count mismatch").into());
    }
    let parse = |word: &str| -> Result<u32, Box<dyn Error>> {
        if word.len() != 8 || !word.bytes().all(|byte| byte.is_ascii_hexdigit()) {
            return Err(io::Error::other("invalid special FP32 hex word").into());
        }
        Ok(u32::from_str_radix(word, 16)?)
    };
    let mut report = String::from(
        "model=restricted-exceptional-binary32-bit-oracle\n\
         comparison=exact-bits-or-quiet-nan-class\n\
         operations=Mul,BiasAdd,Relu\n\
         nan_payload=unconstrained\n\
         signaling_nan=unsupported\n\
         cuda_jit_sass=trusted-not-proven\n",
    );
    for lane in 0..SPECIAL_PROBE_LANES {
        let tokens = input_lines[lane].split_whitespace().collect::<Vec<_>>();
        if tokens.len() != 3 {
            return Err(io::Error::other("invalid special FP32 input row").into());
        }
        let lhs = parse(tokens[0])?;
        let rhs = parse(tokens[1])?;
        let bias = parse(tokens[2])?;
        let expected = special_mul_bias_relu_boundary(lhs, rhs, bias)
            .ok_or_else(|| io::Error::other("special FP32 oracle rejected a probe lane"))?;
        let baseline_bits = parse(baseline_lines[lane])?;
        let fused_bits = parse(fused_lines[lane])?;
        if !expected.accepts(baseline_bits) || !expected.accepts(fused_bits) {
            return Err(io::Error::other(format!(
                "special FP32 GPU bits mismatch at lane {lane}: expected={}, baseline={baseline_bits:08x}, fused={fused_bits:08x}",
                expected.description()
            )).into());
        }
        report.push_str(&format!(
            "lane={lane} lhs={lhs:08x} rhs={rhs:08x} bias={bias:08x} expected={} baseline={baseline_bits:08x} fused={fused_bits:08x}\n",
            expected.description(),
        ));
    }
    Ok(report)
}

/// Offline translation validation reconstructs and rechecks each complete
/// kernel plan against saved LLVM/PTX. The plan itself is integrity-pinned,
/// but correspondence between serialized plan and original Rust IR remains
/// an explicitly trusted evidence-generation step.
fn translation_summary(root: &Path) -> Result<String, Box<dyn Error>> {
    let mut summary = String::from(
        "scope=Semantic-IR-derived-kernel-plan-vs-saved-LLVM-and-PTX\n\
         validator=per-kernel-structural-rejection\n\
         lean=separate-ideal-Int-and-bounded-dyadic-proofs\n\
         gpu=concrete-oracle-tested-on-local-run\n\
         fp32-translation-semantic-proof=not-proven\n\
         cuda-jit-sass-hardware=trusted\n",
    );
    for profile in PTX_PROFILES {
        let dir = root.join(profile);
        let plan = TranslationPlan::from_text(&fs::read_to_string(dir.join("translation.plan"))?)?;
        let llvm = fs::read_to_string(dir.join("graph.ll"))?;
        let ptx = fs::read_to_string(dir.join("graph.ptx"))?;
        let report = plan.validate(&llvm, &ptx)?;
        if fs::read_to_string(dir.join("translation.report"))? != report.to_text() {
            return Err(io::Error::other(format!(
                "Stage 8 {profile}: saved translation report does not match evidence"
            ))
            .into());
        }
        summary.push_str(&format!(
            "{profile}:kernels={} add.rn.f32={} mul.rn.f32={} relu_guards={} status=structural-pass\n",
            report.kernel_count, report.rounded_adds, report.rounded_muls, report.relu_guards
        ));
    }
    Ok(summary)
}

fn sha256(path: &Path) -> Result<String, Box<dyn Error>> {
    let output = Command::new("sha256sum").arg(path).output()?;
    if !output.status.success() {
        return Err(io::Error::other("sha256sum failed").into());
    }
    Ok(String::from_utf8(output.stdout)?
        .split_whitespace()
        .next()
        .ok_or_else(|| io::Error::other("missing SHA-256 digest"))?
        .to_owned())
}

fn verify(root: &Path) -> Result<(), Box<dyn Error>> {
    let manifest = root.join("SHA256SUMS");
    // Reject stale or truncated manifests even if their own old hashes still
    // verify. A successful previous Stage 8 version is not a current success.
    let manifest_text = fs::read_to_string(&manifest)?;
    let manifest_lines = manifest_text.lines().collect::<Vec<_>>();
    if manifest_lines.len() != FILES.len()
        || manifest_lines.iter().zip(FILES).any(|(line, expected)| {
            let Some((digest, path)) = line.split_once("  ") else {
                return true;
            };
            digest.len() != 64
                || !digest.bytes().all(|byte| byte.is_ascii_hexdigit())
                || path != expected
        })
    {
        return Err(io::Error::other("Stage 8 manifest file list is stale or incomplete").into());
    }
    if let Ok(pinned) = std::env::var("VERINEURAL_STAGE8_SHA256") {
        if sha256(&manifest)? != pinned {
            return Err(io::Error::other("Stage 8 externally pinned hash mismatch").into());
        }
    }
    let checked = Command::new("sha256sum")
        .arg("--check")
        .arg("SHA256SUMS")
        .current_dir(root)
        .output()?;
    if !checked.status.success() {
        return Err(io::Error::other(format!(
            "Stage 8 manifest rejected: {}",
            String::from_utf8_lossy(&checked.stderr)
        ))
        .into());
    }
    LeanProofEngine::default().check_file(&root.join("numeric.lean"))?;
    LeanProofEngine::default().check_file(&root.join("numeric_matmul.lean"))?;
    LeanProofEngine::default().check_file(&root.join("numeric_rne.lean"))?;
    LeanProofEngine::default().check_file(&root.join("numeric_rne_matmul.lean"))?;
    LeanProofEngine::default().check_file(&root.join("numeric_range.lean"))?;
    LeanProofEngine::default().check_file(&root.join("numeric_threshold.lean"))?;
    LeanProofEngine::default().check_file(&root.join("numeric_subnormal.lean"))?;
    LeanProofEngine::default().check_file(&root.join("numeric_special.lean"))?;
    LeanProofEngine::default().check_file(&root.join("numeric_architecture.lean"))?;
    LeanProofEngine::default().check_file(&root.join("numeric_architecture_dag.lean"))?;
    LeanProofEngine::default().check_file(&root.join("numeric_nested.lean"))?;
    LeanProofEngine::default().check_file(&root.join("numeric_nested_deep.lean"))?;
    LeanProofEngine::default().check_file(&root.join("architecture_property.lean"))?;
    LeanProofEngine::default().check_file(&root.join("architecture_property_nested.lean"))?;
    LeanProofEngine::default().check_file(&root.join("architecture_property_matmul_bias.lean"))?;
    if fs::read_to_string(root.join("fp32_contraction_report.txt"))?
        != fp32_contraction_report(root)?
    {
        return Err(io::Error::other("saved Stage 8 FP32 PTX audit report mismatch").into());
    }
    if fs::read_to_string(root.join("translation_summary.txt"))? != translation_summary(root)? {
        return Err(
            io::Error::other("saved Stage 8 translation validation summary mismatch").into(),
        );
    }
    if fs::read_to_string(root.join("special_evidence.txt"))? != special_values_report(root)? {
        return Err(io::Error::other("saved Stage 8 special FP32 evidence mismatch").into());
    }
    println!("Stage 8: saved Lean sources and SHA-256 artifact manifest PASS");
    println!(
        "Scope: ideal integer ranges, concrete dyadic RNE traces, and reusable bounded RNE/module contracts; not machine FP32 certification"
    );
    Ok(())
}

/// Generate and check one Lean artifact as a single ordered operation.
/// Saved-artifact verification is handled separately by verify().
fn write_checked_lean(path: &Path, source: &str) -> Result<(), Box<dyn Error>> {
    fs::write(path, source)?;
    LeanProofEngine::default().check_file(path)?;
    Ok(())
}

struct GlobalAddModule {
    contract: MathContract,
}

impl GlobalAddModule {
    fn new(shape: Shape) -> Self {
        let any = |shape| PortContract::new(shape, Domain::Any);
        Self {
            contract: MathContract::new(vec![any(shape.clone()), any(shape.clone())], any(shape)),
        }
    }
}

impl NeuralModule for GlobalAddModule {
    fn name(&self) -> &'static str {
        "global_add"
    }

    fn contract(&self) -> &MathContract {
        &self.contract
    }

    fn build(
        &self,
        graph: &mut NeuralGraph,
        inputs: &[NodeId],
    ) -> Result<NodeId, verineural::NeuralError> {
        graph.add(inputs[0], inputs[1])
    }
}

struct GlobalMulModule {
    contract: MathContract,
}

impl GlobalMulModule {
    fn new(shape: Shape) -> Self {
        let any = |shape| PortContract::new(shape, Domain::Any);
        Self {
            contract: MathContract::new(vec![any(shape.clone()), any(shape.clone())], any(shape)),
        }
    }
}

impl NeuralModule for GlobalMulModule {
