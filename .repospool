FILE	crates/verineural/src/model.rs
//! Named, architecture-neutral façade over the single Semantic Neural IR.
//! Role labels are metadata, not new IR operations or runtime mutability.
use crate::{
    ArchitectureAutoCompiler, ArchitectureMetadata, ArchitectureProofTask, AutoBuildError,
    AutoBuildPlan, AutoBuildReport, CertifiedBuildConfig, Domain, FP32Policy, GpuRequirement,
    NeuralError, NeuralGraph, NodeId, Operation, Predicate, ProofGoal, ProofGoalKind, Shape,
    Tensor, ValueRef,
};
use std::collections::{BTreeMap, BTreeSet};
use std::error::Error;
use std::fmt;

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum SourceRole {
    Input,
    Parameter,
    State,
}

impl SourceRole {
    pub const fn as_str(self) -> &'static str {
        match self {
            Self::Input => "input",
            Self::Parameter => "parameter",
            Self::State => "state",
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub enum ModelError {
    Invalid(String),
    Neural(NeuralError),
}

impl fmt::Display for ModelError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::Invalid(message) => write!(f, "invalid model: {message}"),
            Self::Neural(error) => write!(f, "{error}"),
        }
    }
}

impl Error for ModelError {
    fn source(&self) -> Option<&(dyn Error + 'static)> {
        match self {
            Self::Neural(error) => Some(error),
            _ => None,
        }
    }
}

impl From<NeuralError> for ModelError {
    fn from(value: NeuralError) -> Self {
        Self::Neural(value)
    }
}

fn valid_name(name: &str) -> bool {
    let mut chars = name.chars();
    matches!(chars.next(), Some(c) if c.is_ascii_alphabetic() || c == '_')
        && chars.all(|c| c.is_ascii_alphanumeric() || c == '_')
}

fn valid_identity(name: &str) -> bool {
    !name.is_empty()
        && name
            .bytes()
            .all(|c| c.is_ascii_alphanumeric() || b"-._".contains(&c))
}

fn identity_shape(shape: &Shape) -> String {
    format!(
        "[{}]",
        shape
            .dims()
            .iter()
            .map(usize::to_string)
            .collect::<Vec<_>>()
            .join(", ")
    )
}

fn identity_domain(domain: Domain) -> &'static str {
    match domain {
        Domain::Any => "Any",
        Domain::Finite => "Finite",
        Domain::NonNegativeFinite => "NonNegativeFinite",
    }
}

fn identity_node(node: NodeId) -> String {
    format!("NodeId {{ index: {} }}", node.index())
}

fn identity_value_ref(value: &ValueRef) -> String {
    match value {
        ValueRef::Input(port) => format!("Input({port})"),
        ValueRef::Output => "Output".to_owned(),
        ValueRef::Node(node) => format!("Node({})", identity_node(*node)),
    }
}

fn identity_predicate(predicate: &Predicate) -> String {
    match predicate {
        Predicate::Nonnegative(value) => {
            format!("Nonnegative({})", identity_value_ref(value))
        }
        Predicate::Equal(left, right) => format!(
            "Equal({}, {})",
            identity_value_ref(left),
            identity_value_ref(right)
        ),
        Predicate::PointwiseLe(left, right) => format!(
            "PointwiseLe({}, {})",
            identity_value_ref(left),
            identity_value_ref(right)
        ),
    }
}

fn identity_goal_kind(kind: &ProofGoalKind) -> String {
    match kind {
        ProofGoalKind::Nonnegative { assumptions } => format!(
            "Nonnegative {{ assumptions: [{}] }}",
            assumptions
                .iter()
                .map(|&node| identity_node(node))
                .collect::<Vec<_>>()
                .join(", ")
        ),
        ProofGoalKind::EqualTo { other } => {
            format!("EqualTo {{ other: {} }}", identity_node(*other))
        }
        ProofGoalKind::Predicate(predicate) => {
            format!("Predicate({})", identity_predicate(predicate))
        }
    }
}

/// Consumer model declaration; all tensor operations use NeuralGraph.
pub struct ModelBuilder {
    id: String,
    version: String,
    graph: NeuralGraph,
    sources: BTreeMap<String, (NodeId, SourceRole)>,
    outputs: BTreeMap<String, NodeId>,
    next_states: BTreeMap<String, NodeId>,
    goals: BTreeMap<String, ProofGoal>,
}

impl ModelBuilder {
    pub fn new(id: impl Into<String>, version: impl Into<String>) -> Self {
        Self::with_policy(id, version, FP32Policy::strict())
    }

    pub fn with_policy(
        id: impl Into<String>,
        version: impl Into<String>,
        policy: FP32Policy,
    ) -> Self {
        Self {
            id: id.into(),
            version: version.into(),
            graph: NeuralGraph::new(policy),
            sources: BTreeMap::new(),
            outputs: BTreeMap::new(),
            next_states: BTreeMap::new(),
            goals: BTreeMap::new(),
        }
    }

    fn insert_source(
        &mut self,
        name: impl Into<String>,
        dims: impl Into<Vec<usize>>,
        domain: Domain,
        role: SourceRole,
    ) -> Result<NodeId, ModelError> {
        let name = name.into();
        if !valid_name(&name)
            || self.sources.contains_key(&name)
            || self.outputs.contains_key(&name)
        {
            return Err(ModelError::Invalid(format!(
                "bad or duplicate source name: {name}"
            )));
        }
        let shape = Shape::new(dims)?;
        let node = self.graph.input(shape, domain);
        self.sources.insert(name, (node, role));
        Ok(node)
    }

    /// Input domains are hypotheses checked against actual bound values.
    pub fn input(
        &mut self,
        name: impl Into<String>,
        dims: impl Into<Vec<usize>>,
        domain: Domain,
    ) -> Result<NodeId, ModelError> {
        self.insert_source(name, dims, domain, SourceRole::Input)
    }

    /// Parameters are named IR sources; updates and optimizers are not implied.
    pub fn parameter(
        &mut self,
        name: impl Into<String>,
        dims: impl Into<Vec<usize>>,
        domain: Domain,
    ) -> Result<NodeId, ModelError> {
        self.insert_source(name, dims, domain, SourceRole::Parameter)
    }

    /// State is an explicit named source, not a mutable IR operation.
    pub fn state(
        &mut self,
        name: impl Into<String>,
        dims: impl Into<Vec<usize>>,
        domain: Domain,
    ) -> Result<NodeId, ModelError> {
        self.insert_source(name, dims, domain, SourceRole::State)
    }

    /// A pure graph transition: the next value must satisfy the state contract.
    pub fn next_state(&mut self, name: &str, next: NodeId) -> Result<(), ModelError> {
        let (source, role) = self
            .sources
            .get(name)
            .copied()
            .ok_or_else(|| ModelError::Invalid(format!("unknown state: {name}")))?;
        if role != SourceRole::State || self.next_states.contains_key(name) {
            return Err(ModelError::Invalid(format!(
                "not a state or duplicate transition: {name}"
            )));
        }
        let before = self.graph.node(source)?;
        let after = self.graph.node(next)?;
        if before.shape != after.shape {
            return Err(ModelError::Neural(NeuralError::ShapeMismatch {
                expected: before.shape.clone(),
                actual: after.shape.clone(),
            }));
        }
        if after.dtype != before.dtype {
            return Err(ModelError::Neural(NeuralError::DTypeMismatch {
                operation: "next_state",
                expected: before.dtype,
                actual: after.dtype,
            }));
        }
        if !after.domain.satisfies(before.domain) {
            return Err(ModelError::Neural(NeuralError::DomainNotEstablished {
                required: before.domain,
                actual: after.domain,
            }));
        }
        self.next_states.insert(name.to_owned(), next);
        Ok(())
    }

    /// Atomic, capture-checked block; output contract inferred from the IR.
    /// Independent mathematical properties must use explicit proof goals.
    pub fn block<F>(
        &mut self,
        name: &'static str,
        inputs: &[NodeId],
        build: F,
    ) -> Result<NodeId, ModelError>
    where
        F: FnOnce(&mut NeuralGraph, &[NodeId]) -> Result<NodeId, NeuralError>,
    {
        if !valid_name(name) {
            return Err(ModelError::Invalid(format!("invalid block name: {name}")));
        }
        Ok(self
            .graph
            .compose_inferred(name, "model-block-v1", inputs, build)?)
    }

    /// Atomic named multi-output block with inferred structural contracts.
    pub fn block_multi<F>(
        &mut self,
        name: &'static str,
        inputs: &[(&'static str, NodeId)],
        output_names: &[&'static str],
        build: F,
    ) -> Result<BTreeMap<String, NodeId>, ModelError>
    where
        F: FnOnce(&mut NeuralGraph, &[NodeId]) -> Result<Vec<NodeId>, NeuralError>,
    {
        if !valid_name(name)
            || inputs.iter().any(|(port, _)| !valid_name(port))
            || output_names.iter().any(|port| !valid_name(port))
        {
            return Err(ModelError::Invalid(format!(
                "invalid multi-block name: {name}"
            )));
        }
        let ids = self.graph.compose_multi_inferred(
            name,
            "model-multi-block-v1",
            inputs,
            output_names,
            build,
        )?;
        Ok(output_names
            .iter()
            .zip(ids)
            .map(|(&name, id)| (name.to_owned(), id))
            .collect())
    }

    pub fn output(&mut self, name: impl Into<String>, id: NodeId) -> Result<(), ModelError> {
        let name = name.into();
        if !valid_name(&name)
            || self.sources.contains_key(&name)
            || self.outputs.contains_key(&name)
        {
            return Err(ModelError::Invalid(format!(
                "bad or duplicate output name: {name}"
            )));
        }
        self.graph.node(id)?;
        self.outputs.insert(name, id);
        Ok(())
    }

    /// Registers an obligation, not a proven conclusion.
    pub fn proof_goal(&mut self, goal: ProofGoal) -> Result<(), ModelError> {
        if !valid_name(&goal.name) || self.goals.contains_key(&goal.name) {
            return Err(ModelError::Invalid(format!(
                "bad or duplicate goal: {}",
                goal.name
            )));
        }
        self.graph.node(goal.output)?;
        self.goals.insert(goal.name.clone(), goal);
        Ok(())
    }

    pub fn graph_mut(&mut self) -> &mut NeuralGraph {
        &mut self.graph
    }

    pub fn finish(self) -> Result<Model, ModelError> {
        if !valid_identity(&self.id) || !valid_identity(&self.version) {
            return Err(ModelError::Invalid(
                "id/version must use ASCII alphanumeric, - . _".into(),
            ));
        }
        if self.outputs.is_empty() {
            return Err(ModelError::Invalid(
                "at least one output is required".into(),
            ));
        }
        let registered: BTreeSet<_> = self.sources.values().map(|(id, _)| id.index()).collect();
        if self.graph.nodes().iter().any(|node| {
            matches!(node.operation, Operation::Input) && !registered.contains(&node.id.index())
        }) {
            return Err(ModelError::Invalid(
                "all graph source inputs must have a registered model name".into(),
            ));
        }
        for (name, (_, role)) in &self.sources {
            if *role == SourceRole::State && !self.next_states.contains_key(name) {
                return Err(ModelError::Invalid(format!("missing next_state: {name}")));
            }
        }
        let roots: Vec<_> = self
            .outputs
            .values()
            .chain(self.next_states.values())
            .copied()
            .collect();
        let scope = self.graph.dependency_scope(&roots)?;
        for goal in self.goals.values() {
            if !scope.contains(&goal.output.index()) {
                return Err(ModelError::Invalid(format!(
                    "disconnected proof goal: {}",
                    goal.name
                )));
            }
        }
        Ok(Model {
            id: self.id,
            version: self.version,
            graph: self.graph,
            sources: self.sources,
            outputs: self.outputs,
            next_states: self.next_states,
            goals: self.goals,
        })
    }
}

/// Finished model, with the original graph and deterministic named roots.
pub struct Model {
    id: String,
    version: String,
    graph: NeuralGraph,
    sources: BTreeMap<String, (NodeId, SourceRole)>,
    outputs: BTreeMap<String, NodeId>,
    next_states: BTreeMap<String, NodeId>,
    goals: BTreeMap<String, ProofGoal>,
}

impl Model {
    pub fn graph(&self) -> &NeuralGraph {
        &self.graph
    }

    pub fn output(&self, name: &str) -> Option<NodeId> {
        self.outputs.get(name).copied()
    }

    pub fn source(&self, name: &str) -> Option<(NodeId, SourceRole)> {
        self.sources.get(name).copied()
    }

    pub(crate) fn sources(&self) -> &BTreeMap<String, (NodeId, SourceRole)> {
        &self.sources
    }

    pub fn outputs(&self) -> &BTreeMap<String, NodeId> {
        &self.outputs
    }

    /// Explicit transition mapping, with no hidden mutation in Semantic IR.
    pub fn state_links(&self) -> &BTreeMap<String, NodeId> {
        &self.next_states
    }

    pub(crate) fn execution_roots(&self) -> Vec<NodeId> {
        let mut ids = BTreeSet::new();
        self.outputs
            .values()
            .chain(self.next_states.values())
            .copied()
            .filter(|id| ids.insert(id.index()))
            .collect()
    }

    pub fn proof_goals(&self) -> &BTreeMap<String, ProofGoal> {
        &self.goals
    }

    /// State is metadata on a pure source, not a side-effecting graph operation.
    pub fn metadata(&self, global_property: impl Into<String>) -> ArchitectureMetadata {
        ArchitectureMetadata {
            id: self.id.clone(),
            version: self.version.clone(),
            input_roles: self
                .sources
                .values()
                .map(|(node, role)| (node.index(), role.as_str().to_owned()))
                .collect(),
            global_property: global_property.into(),
        }
    }

    /// Match every named source exactly once, checking shape and declared domain.
    /// Returns ordinary NodeId/Tensor bindings for existing execution APIs.
    pub fn bind<K: Into<String>>(
        &self,
        values: impl IntoIterator<Item = (K, Tensor<f32>)>,
    ) -> Result<Vec<(NodeId, Tensor<f32>)>, ModelError> {
        let mut supplied = BTreeMap::new();
        let mut seen = BTreeSet::new();
        for (name, tensor) in values {
            let name = name.into();
            if !self.sources.contains_key(&name) || !seen.insert(name.clone()) {
                return Err(ModelError::Invalid(format!(
                    "unknown or repeated binding: {name}"
                )));
            }
            supplied.insert(name, tensor);
        }
        let mut ordered = Vec::with_capacity(self.sources.len());
        for (name, (id, _)) in &self.sources {
            let tensor = supplied
                .remove(name)
                .ok_or_else(|| ModelError::Invalid(format!("missing source binding: {name}")))?;
            let node = self.graph.node(*id)?;
            if tensor.shape() != &node.shape {
                return Err(ModelError::Neural(NeuralError::ShapeMismatch {
                    expected: node.shape.clone(),
                    actual: tensor.shape().clone(),
                }));
            }
            tensor.validate_domain(node.domain)?;
            ordered.push((*id, tensor));
        }
        Ok(ordered)
    }

    /// Stable identity binds id/version, named sources/roles, outputs and
    /// obligations. It deliberately excludes graph allocation identity and
    /// Rust Debug formatting. SHA256SUMS separately binds canonical IR bytes.
    fn certified_identity(&self) -> String {
        let mut identity = format!(
            "verineural-certified-model-v1\nid={}\nversion={}\n",
            self.id, self.version
        );
        for (name, (node, role)) in &self.sources {
            let source = self
                .graph
                .node(*node)
                .expect("finished model source exists");
            identity.push_str(&format!(
                "source={name};node={};role={};shape={};domain={}\n",
                node.index(),
                role.as_str(),
                identity_shape(&source.shape),
                identity_domain(source.domain)
            ));
        }
        for (name, output) in &self.outputs {
            identity.push_str(&format!("output={name};node={}\n", output.index()));
        }
        for (name, next) in &self.next_states {
            identity.push_str(&format!("next_state={name};node={}\n", next.index()));
        }
        for (name, goal) in &self.goals {
            identity.push_str(&format!(
                "goal={name};node={};kind={}\n",
                goal.output.index(),
                identity_goal_kind(&goal.kind)
            ));
        }
        identity
    }

    /// Fail closed: certify every declared goal with Lean kernel + axiom audit,
    /// require GPU lowering for every output, then atomically publish evidence.
    /// The result explicitly does not certify CUDA/IEEE-754 machine semantics.
    pub fn certify(&self, config: CertifiedBuildConfig) -> Result<AutoBuildReport, AutoBuildError> {
        self.certify_with(&ArchitectureAutoCompiler::default(), config)
    }

    pub fn certify_with(
        &self,
        compiler: &ArchitectureAutoCompiler,
        config: CertifiedBuildConfig,
    ) -> Result<AutoBuildReport, AutoBuildError> {
        let outputs = self.execution_roots();
        let tasks: Vec<_> = self
            .goals
            .values()
            .cloned()
            .map(ArchitectureProofTask::Goal)
            .collect();
        let root = config.resolved_root();
        let identity = self.certified_identity();
        crate::certified::preflight_root(&root, &identity)?;
        let report = compiler.build_identified(&self.graph, &outputs, &tasks, &root, &identity)?;
        crate::certified::publish_root(&root, &identity)?;
        crate::certified::verify_root(&root, &identity)?;
        Ok(report)
    }

    /// Verify the complete current-source bundle without CUDA or GPU execution.
    /// To establish authenticity, pass a digest pinned outside the bundle.
    pub fn verify_certified(
        &self,
        config: CertifiedBuildConfig,
        pinned_sha256: Option<&str>,
    ) -> Result<AutoBuildReport, AutoBuildError> {
        self.verify_certified_with(&ArchitectureAutoCompiler::default(), config, pinned_sha256)
    }

    pub fn verify_certified_with(
        &self,
        compiler: &ArchitectureAutoCompiler,
        config: CertifiedBuildConfig,
        pinned_sha256: Option<&str>,
    ) -> Result<AutoBuildReport, AutoBuildError> {
        let outputs = self.execution_roots();
        let tasks: Vec<_> = self
            .goals
            .values()
            .cloned()
            .map(ArchitectureProofTask::Goal)
            .collect();
        let root = config.resolved_root();
        let identity = self.certified_identity();
        let report = compiler.verify_identified(
            &self.graph,
            &outputs,
            &tasks,
            &root,
            pinned_sha256,
            &identity,
        )?;
        crate::certified::verify_root(&root, &identity)?;
        Ok(report)
    }

    /// Reuse ArchitectureAutoCompiler; planned Lean goals are not certified.
    pub fn plan(
        &self,
        compiler: &ArchitectureAutoCompiler,
        gpu_requirement: GpuRequirement,
    ) -> Result<AutoBuildPlan, AutoBuildError> {
        let outputs = self.execution_roots();
        let tasks: Vec<_> = self
            .goals
            .values()
            .cloned()
            .map(ArchitectureProofTask::Goal)
            .collect();
        compiler.plan(&self.graph, &outputs, &tasks, gpu_requirement)
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn named_dense_block_infers_shape_roles_and_bindings() {
        let mut builder = ModelBuilder::new("dense", "0.1.0");
        let x = builder.input("x", [4, 2], Domain::Finite).unwrap();
        let w = builder
            .parameter("weights", [2, 3], Domain::Finite)
            .unwrap();
        let b = builder.parameter("bias", [3], Domain::Finite).unwrap();
        let y = builder
            .block("dense_layer", &[x, w, b], |g, p| {
                let product = g.matmul(p[0], p[1])?;
                let shifted = g.bias_add(product, p[2])?;
                g.relu(shifted)
            })
            .unwrap();
        builder.output("prediction", y).unwrap();
        builder
            .proof_goal(ProofGoal::nonnegative("positive", y, vec![]))
            .unwrap();
        let model = builder.finish().unwrap();
        assert_eq!(model.graph().node(y).unwrap().shape.dims(), &[4, 3]);
        // A finite-input MatMul may overflow FP32; ReLU cannot promise finite output.
        assert_eq!(model.graph().node(y).unwrap().domain, Domain::Any);
        assert_eq!(model.graph().modules().len(), 1);
        assert_eq!(
            model
                .metadata("architecture_global_nonnegative")
                .input_roles[&w.index()],
            "parameter"
        );
        let bound = model
            .bind([
                (
                    "bias",
                    Tensor::new(Shape::new(vec![3]).unwrap(), vec![0.0; 3]).unwrap(),
                ),
                (
                    "weights",
                    Tensor::new(Shape::new(vec![2, 3]).unwrap(), vec![1.0; 6]).unwrap(),
                ),
                (
                    "x",
                    Tensor::new(Shape::new(vec![4, 2]).unwrap(), vec![1.0; 8]).unwrap(),
                ),
            ])
            .unwrap();
        assert_eq!(bound.len(), 3);
    }

    #[test]
    fn certified_identity_is_independent_of_graph_allocation_history() {
        fn build_identity() -> String {
            let mut builder = ModelBuilder::new("stable_ident", "1");
            let x = builder.input("x", [2], Domain::NonNegativeFinite).unwrap();
            let y = builder.graph_mut().relu(x).unwrap();
            builder.output("y", y).unwrap();
            builder
                .proof_goal(ProofGoal {
                    name: "ordered".into(),
                    output: y,
                    kind: ProofGoalKind::Predicate(Predicate::pointwise_le(
                        ValueRef::Node(x),
                        ValueRef::Output,
                    )),
                })
                .unwrap();
            builder.finish().unwrap().certified_identity()
        }

        let first = build_identity();
        let _unrelated = NeuralGraph::default();
        let second = build_identity();
        assert_eq!(first, second);
        assert!(!first.contains("graph:"));
        assert!(first.contains("Predicate(PointwiseLe(Node(NodeId { index: 0 }), Output))"));
    }

    #[test]
    fn certificate_identity_tracks_named_contracts_not_absolute_paths() {
        let mut builder = ModelBuilder::new("ident", "0.1.0");
        let x = builder
            .input("input", [2], Domain::NonNegativeFinite)
            .unwrap();
        let y = builder
            .block("nonnegative", &[x], |g, p| g.relu(p[0]))
            .unwrap();
        builder.output("value", y).unwrap();
        builder
            .proof_goal(ProofGoal::nonnegative("nonnegative_goal", y, vec![]))
            .unwrap();
        let model = builder.finish().unwrap();
        let declaration = model.certified_identity();
        assert!(declaration.contains("id=ident\nversion=0.1.0"));
        assert!(declaration.contains("source=input;node=0;role=input"));
        assert!(declaration.contains("goal=nonnegative_goal;node=1"));
        assert!(!declaration.contains("/tmp/"));
    }

    #[test]
    fn certified_plan_rejects_unsupported_gpu_operations() {
        let mut builder = ModelBuilder::new("unsupported", "1");
        // Sqrt requires a nonnegative input; the test targets GPU lowering,
        // not the independent input-domain contract.
        let x = builder.input("x", [2], Domain::NonNegativeFinite).unwrap();
        let y = builder.graph_mut().sqrt(x).unwrap();
        builder.output("y", y).unwrap();
        let model = builder.finish().unwrap();
        assert!(matches!(
            model.plan(
                &ArchitectureAutoCompiler::default(),
                GpuRequirement::AllOutputs
            ),
            Err(AutoBuildError::Gpu(_)) | Err(AutoBuildError::Proof(_))
        ));
    }

    #[test]
    fn hidden_capture_is_rejected_without_partial_commit() {
        let mut builder = ModelBuilder::new("capture", "1");
        let x = builder.input("x", [2], Domain::Finite).unwrap();
        let hidden = builder.input("hidden", [2], Domain::Finite).unwrap();
        assert!(matches!(
            builder.block("bad", &[x], |g, p| g.add(p[0], hidden)),
            Err(ModelError::Neural(NeuralError::ContractViolation { .. }))
        ));
        assert_eq!(builder.graph_mut().nodes().len(), 2);
        let y = builder.block("good", &[x], |g, p| g.relu(p[0])).unwrap();
        builder.output("out", y).unwrap();
        assert!(builder.finish().is_ok());
    }

    #[test]
    fn graph_mut_cannot_sneak_unnamed_sources_past_binding_checks() {
        let mut builder = ModelBuilder::new("source_registry", "1");
        builder.input("x", [1], Domain::Finite).unwrap();
        let rogue = builder
            .graph_mut()
            .input(Shape::new(vec![1]).unwrap(), Domain::Finite);
        builder.output("out", rogue).unwrap();
        assert!(matches!(builder.finish(), Err(ModelError::Invalid(_))));
    }

    #[test]
    fn rejects_duplicate_source_and_missing_or_invalid_bindings() {
        let mut builder = ModelBuilder::new("checked", "1");
        let x = builder.input("x", [1], Domain::NonNegativeFinite).unwrap();
        assert!(matches!(
            builder.parameter("x", [1], Domain::Finite),
            Err(ModelError::Invalid(_))
        ));
        builder.output("out", x).unwrap();
        let model = builder.finish().unwrap();
        assert!(matches!(
            model.bind([] as [(&str, Tensor<f32>); 0]),
            Err(ModelError::Invalid(_))
        ));
        assert!(matches!(
            model.bind([(
                "x",
                Tensor::new(Shape::new(vec![1]).unwrap(), vec![-1.0]).unwrap()
            )]),
            Err(ModelError::Neural(NeuralError::ValueOutsideDomain { .. }))
        ));
    }
}

FILE	crates/verineural/src/model_execution.rs
//! Named GPU execution over the one Semantic Neural IR and the existing
//! CUDA Graph runtime. State feedback is an explicit on-device transfer.
use std::collections::BTreeMap;
use std::error::Error;
use std::fmt;
use std::path::Path;

use crate::{
    GpuEngine, GpuError, GpuExecution, Model, ModelError, NodeId, SourceRole, Tensor, TensorValue,
};

#[derive(Debug)]
pub enum ModelExecutionError {
    Model(ModelError),
    Gpu(GpuError),
    Invalid(String),
}

impl fmt::Display for ModelExecutionError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::Model(err) => write!(f, "{err}"),
            Self::Gpu(err) => write!(f, "{err}"),
            Self::Invalid(detail) => write!(f, "invalid model execution: {detail}"),
        }
    }
}

impl Error for ModelExecutionError {
    fn source(&self) -> Option<&(dyn Error + 'static)> {
        match self {
            Self::Model(err) => Some(err),
            Self::Gpu(err) => Some(err),
            Self::Invalid(_) => None,
        }
    }
}

impl From<ModelError> for ModelExecutionError {
    fn from(err: ModelError) -> Self {
        Self::Model(err)
    }
}

impl From<GpuError> for ModelExecutionError {
    fn from(err: GpuError) -> Self {
        Self::Gpu(err)
    }
}

type StateFeedbackLink = (NodeId, NodeId);
type ExecutionRootsAndStateLinks = (Vec<NodeId>, Vec<StateFeedbackLink>);

// A pure next_state may ignore its old state; the GPU execution slice still
// must include that source so the writable feedback destination is allocated.
fn execution_roots_with_states(
    model: &Model,
) -> Result<ExecutionRootsAndStateLinks, ModelExecutionError> {
    let links = model
        .state_links()
        .iter()
        .map(|(name, &next)| {
            model
                .source(name)
                .map(|(state, _)| (state, next))
                .ok_or_else(|| ModelExecutionError::Invalid(format!("unknown state: {name}")))
        })
        .collect::<Result<Vec<_>, _>>()?;
    let mut roots = model.execution_roots();
    for &(state, _) in &links {
        if !roots.contains(&state) {
            roots.push(state);
        }
    }
    Ok((roots, links))
}

/// Maintains parameter and state buffers between replays. No extra IR is
/// introduced; every step is the same compiled pure graph followed by
/// explicit device-to-device state assignment.
pub struct ModelExecution {
    sources: BTreeMap<String, (NodeId, SourceRole)>,
    outputs: BTreeMap<String, NodeId>,
    state_links: BTreeMap<String, NodeId>,
    gpu: GpuExecution,
}

impl GpuEngine {
    /// Requires a complete named initial binding, then compiles all public
    /// outputs and next-state roots into a shared CUDA Graph.
    /// Any unsupported GPU operation fails closed before the CUDA session.
    pub fn prepare_model<K: Into<String>>(
        &self,
        model: &Model,
        bindings: impl IntoIterator<Item = (K, Tensor<f32>)>,
        output_dir: &Path,
    ) -> Result<ModelExecution, ModelExecutionError> {
        let values = model.bind(bindings)?;
        let (roots, links) = execution_roots_with_states(model)?;
        let program = self.compile_outputs(model.graph(), &roots)?;
        // A model may declare inactive named parameters. The GPU program
        // binds only sources reachable from the selected outputs.
        let live = program.source_inputs();
        let active = values
            .into_iter()
            .filter(|(id, _)| live.contains(id))
            .collect::<Vec<_>>();
        let mut gpu = self.prepare(&program, &active, output_dir)?;
        let public = model.outputs().values().copied().collect::<Vec<_>>();
        // Check the full D2D plan before the first step and allocate stable
        // device snapshots for public outputs that alias writable state.
        gpu.configure_model_feedback(&public, &links)?;
        Ok(ModelExecution {
            sources: model.sources().clone(),
            outputs: model.outputs().clone(),
            state_links: model.state_links().clone(),
            gpu,
        })
    }
}

impl ModelExecution {
    fn named_source(
        &self,
        name: &str,
        expected: SourceRole,
    ) -> Result<NodeId, ModelExecutionError> {
        match self.sources.get(name).copied() {
            Some((node, role)) if role == expected => Ok(node),
            Some((_, actual)) => Err(ModelExecutionError::Invalid(format!(
                "{name} is {}, expected {}",
                actual.as_str(),
                expected.as_str()
            ))),
            None => Err(ModelExecutionError::Invalid(format!(
                "unknown source: {name}"
            ))),
        }
    }

    /// Update one ephemeral input without rebinding parameters or other inputs.
    pub fn set_input(
        &mut self,
        name: &str,
        value: &Tensor<f32>,
    ) -> Result<(), ModelExecutionError> {
        let id = self.named_source(name, SourceRole::Input)?;
        Ok(self.gpu.update_input(id, value)?)
    }

    /// Persistently replace one parameter, validating its declared domain.
    pub fn set_parameter(
        &mut self,
        name: &str,
        value: &Tensor<f32>,
    ) -> Result<(), ModelExecutionError> {
        let id = self.named_source(name, SourceRole::Parameter)?;
        Ok(self.gpu.update_input(id, value)?)
    }

    /// Explicit reset/seed of a state buffer before a replay.
    pub fn set_state(
        &mut self,
        name: &str,
        value: &Tensor<f32>,
    ) -> Result<(), ModelExecutionError> {
        let id = self.named_source(name, SourceRole::State)?;
        Ok(self.gpu.update_input(id, value)?)
    }

    /// Run the pure model once, without changing temporal state.
    pub fn run(&mut self) -> Result<(), ModelExecutionError> {
        self.gpu.replay()?;
        Ok(self.gpu.snapshot_outputs()?)
    }

    /// Compute and then feed every declared next_state into its matching
    /// state input on-device. Next step reuses the same CUDA Graph.
    pub fn step(&mut self) -> Result<(), ModelExecutionError> {
        self.gpu.replay()?;
        // GpuExecution::feedback_state snapshots any observable output
        // aliasing a state destination; do not copy those values twice.
        let links = self
            .state_links
            .iter()
            .map(|(name, next)| {
                self.named_source(name, SourceRole::State)
                    .map(|source| (source, *next))
            })
            .collect::<Result<Vec<_>, ModelExecutionError>>()?;
        Ok(self.gpu.feedback_state(&links)?)
    }

    fn named_output(&self, name: &str) -> Result<NodeId, ModelExecutionError> {
        self.outputs
            .get(name)
            .copied()
            .ok_or_else(|| ModelExecutionError::Invalid(format!("unknown output: {name}")))
    }

    /// Read a public named output while preserving its Semantic IR dtype.
    pub fn output_value(&mut self, name: &str) -> Result<TensorValue, ModelExecutionError> {
        let id = self.named_output(name)?;
        Ok(self.gpu.read_selected_value(id)?)
    }

    /// Backward-compatible F32 output reader. Index outputs must use
    /// `output_value`, and fail closed here instead of reinterpreting bits.
    pub fn output(&mut self, name: &str) -> Result<Tensor<f32>, ModelExecutionError> {
        let id = self.named_output(name)?;
        Ok(self.gpu.read_selected_output(id)?)
    }

    /// Read the current state input, including the feedback of the last step.
    pub fn state(&mut self, name: &str) -> Result<Tensor<f32>, ModelExecutionError> {
        let id = self.named_source(name, SourceRole::State)?;
        Ok(self.gpu.read_source(id)?)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::{Domain, NeuralError, Shape};

    #[test]
    fn named_transition_and_multi_block_keep_one_ir_and_explicit_roles() {
        let mut builder = crate::ModelBuilder::new("temporal", "1");
        let state = builder.state("state", [2], Domain::Any).unwrap();
        let input = builder
            .input("token", [2], Domain::NonNegativeFinite)
            .unwrap();
        let weight = builder
            .parameter("weight", [2], Domain::NonNegativeFinite)
            .unwrap();
        let ports = builder
            .block_multi(
                "transition",
                &[("state", state), ("token", input), ("weight", weight)],
                &["next_state", "readout"],
                |graph, values| {
                    let sum = graph.add(values[0], values[1])?;
                    let next = graph.relu(sum)?;
                    let output = graph.mul(next, values[2])?;
                    Ok(vec![next, output])
                },
            )
            .unwrap();
        let next = ports["next_state"];
        assert!(builder.next_state("state", next).is_ok());
        assert!(matches!(
            builder.next_state("state", next),
            Err(ModelError::Invalid(_))
        ));
        builder.output("readout", ports["readout"]).unwrap();
        let model = builder.finish().unwrap();
        assert_eq!(model.source("state").unwrap().1, SourceRole::State);
        assert_eq!(model.state_links()["state"], next);
        assert_eq!(model.graph().multi_modules().len(), 1);
        assert_eq!(model.execution_roots().len(), 2);
        assert_eq!(
            model
                .metadata("architecture_global_nonnegative")
                .input_roles[&state.index()],
            "state"
        );
        // Compiling before CUDA launch validates that all executable roots
        // are reachable from one graph.
        assert!(
            GpuEngine::default()
                .compile_outputs(model.graph(), &model.execution_roots())
                .is_ok()
        );
    }

    #[test]
    fn replacement_state_is_a_live_gpu_source_even_without_read_dependencies() {
        let mut builder = crate::ModelBuilder::new("replacement", "1");
        let memory = builder.state("memory", [2], Domain::Any).unwrap();
        let token = builder.input("token", [2], Domain::Finite).unwrap();
        let out = builder.graph_mut().relu(token).unwrap();
        builder.output("readout", out).unwrap();
        builder.next_state("memory", token).unwrap();
        let model = builder.finish().unwrap();

        assert!(!model.execution_roots().contains(&memory));
        let (roots, links) = execution_roots_with_states(&model).unwrap();
        assert!(roots.contains(&memory));
        assert_eq!(links, vec![(memory, token)]);
        let program = GpuEngine::default()
            .compile_outputs(model.graph(), &roots)
            .unwrap();
        assert!(program.source_inputs().contains(&memory));
        assert!(program.outputs().contains(&memory));
        assert!(program.source_inputs().contains(&token));
    }

    #[test]
    fn invalid_temporal_connections_and_capture_leave_builder_consistent() {
        let mut builder = crate::ModelBuilder::new("bad_temporal", "1");
        let state = builder
            .state("state", [2], Domain::NonNegativeFinite)
            .unwrap();
        let input = builder.input("input", [2], Domain::Finite).unwrap();
        let bad = builder
            .graph_mut()
            .reshape(input, Shape::new(vec![1, 2]).unwrap())
            .unwrap();
        assert!(matches!(
            builder.next_state("state", bad),
            Err(ModelError::Neural(NeuralError::ShapeMismatch { .. }))
        ));
        assert!(matches!(
            builder.next_state("state", input),
            Err(ModelError::Neural(NeuralError::DomainNotEstablished { .. }))
        ));
        let before = builder.graph_mut().nodes().len();
        assert!(matches!(
            builder.block_multi(
                "broken",
                &[("state", state)],
                &["one", "two"],
                |graph, ids| Ok(vec![graph.relu(ids[0])?]),
            ),
            Err(ModelError::Neural(NeuralError::ContractViolation { .. }))
        ));
        assert_eq!(builder.graph_mut().nodes().len(), before);
        let next = builder.graph_mut().relu(state).unwrap();
        builder.next_state("state", next).unwrap();
        builder.output("out", next).unwrap();
        assert!(builder.finish().is_ok());
    }
}

FILE	crates/verineural/src/modules.rs
//! Stage 6 neural building blocks expressed entirely through Semantic Neural IR.
//!
//! These modules have checked *shape* contracts; f32 overflow and backend
//! lowering remain outside the current Lean proof boundary.

use crate::{MathContract, NeuralError, NeuralGraph, NeuralModule, NodeId, PortContract, Shape};

/// Dense layer Y = X * W + bias, with row-wise bias broadcast.
pub struct Dense {
    contract: MathContract,
}

impl Dense {
    /// X is [batch, inputs], W is [inputs, outputs], bias is [outputs].
    pub fn new(batch: usize, inputs: usize, outputs: usize) -> Result<Self, NeuralError> {
        let x = Shape::new(vec![batch, inputs])?;
        let w = Shape::new(vec![inputs, outputs])?;
        let bias = Shape::new(vec![outputs])?;
        let y = Shape::new(vec![batch, outputs])?;
        Ok(Self {
            contract: MathContract::new(
                vec![
                    PortContract::any(x),
                    PortContract::any(w),
                    PortContract::any(bias),
                ],
                PortContract::any(y),
            ),
        })
    }
}

impl NeuralModule for Dense {
    fn name(&self) -> &'static str {
        "dense"
    }

    fn contract(&self) -> &MathContract {
        &self.contract
    }

    fn build(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        let product = graph.matmul(inputs[0], inputs[1])?;
        graph.bias_add(product, inputs[2])
    }
}

/// Elementwise residual connection Y = X + F(X), with no broadcasting.
pub struct ResidualAdd {
    contract: MathContract,
}

impl ResidualAdd {
    pub fn new(shape: Shape) -> Self {
        Self {
            contract: MathContract::new(
                vec![
                    PortContract::any(shape.clone()),
                    PortContract::any(shape.clone()),
                ],
                PortContract::any(shape),
            ),
        }
    }
}

impl NeuralModule for ResidualAdd {
    fn name(&self) -> &'static str {
        "residual_add"
    }

    fn contract(&self) -> &MathContract {
        &self.contract
    }

    fn build(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        graph.add(inputs[0], inputs[1])
    }
}

/// Residual two-layer FFN:
/// X + (ReLU(X W1 + b1) W2 + b2)
///
/// The five inputs are X, W1, b1, W2 and b2 in that order.
/// This is a forward-only composable primitive, not a Transformer or training
/// implementation. All weights are explicit graph inputs, not hidden constants.
pub struct ResidualFfn {
    contract: MathContract,
}

impl ResidualFfn {
    pub fn new(batch: usize, features: usize, hidden: usize) -> Result<Self, NeuralError> {
        let x = Shape::new(vec![batch, features])?;
        let w1 = Shape::new(vec![features, hidden])?;
        let b1 = Shape::new(vec![hidden])?;
        let w2 = Shape::new(vec![hidden, features])?;
        let b2 = Shape::new(vec![features])?;
        Ok(Self {
            contract: MathContract::new(
                vec![
                    PortContract::any(x.clone()),
                    PortContract::any(w1),
                    PortContract::any(b1),
                    PortContract::any(w2),
                    PortContract::any(b2),
                ],
                PortContract::any(x),
            ),
        })
    }
}

impl NeuralModule for ResidualFfn {
    fn name(&self) -> &'static str {
        "residual_ffn"
    }

    fn contract(&self) -> &MathContract {
        &self.contract
    }

    fn build(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        let first = graph.matmul(inputs[0], inputs[1])?;
        let first = graph.bias_add(first, inputs[2])?;
        let activated = graph.relu(first)?;
        let projected = graph.matmul(activated, inputs[3])?;
        let projected = graph.bias_add(projected, inputs[4])?;
        graph.add(inputs[0], projected)
    }
}

FILE	crates/verineural/src/numeric.rs
//! Stage 8 exact-integer FP32 domain plus compositional range obligations for
//! Add/Mul/MatMul/BiasAdd/Relu/Reshape.
//!
//! All integral inputs and intermediate mathematical values are restricted to
//! magnitude <= 2^24, where every integer has a binary32 representation.
//! Lean establishes *ideal Int* bounds, and the integer oracle validates the
//! concrete GPU output bitwise. Correct IEEE RNE hardware/LLVM behavior is
//! STILL TRUSTED, not proved by this engine. Non-integral or negative-zero
//! inputs and unsupported operators fail closed.
//!
//! A second slice models concrete fractional dyadic traces under round-to-nearest,
//! ties-to-even and composes absolute error through Add/Mul/MatMul/BiasAdd/Relu/
//! Reshape. Products use finer per-node dyadic lattices; MatMul explicitly models
//! separate rounded multiply/add steps. A reusable range slice additionally
//! propagates ideal bounds and worst-case epsilon across arbitrary bounded inputs
//! and exports module-boundary summaries. The LLVM/PTX/GPU execution link remains TCB.

use std::collections::{BTreeMap, BTreeSet};
use std::error::Error;
use std::fmt;

use crate::{
    LeanProgram, LeanProofEngine, ModuleInvocation, NeuralError, NeuralGraph, NodeId, Operation,
    ProofError, Tensor,
};

const EXACT_F32_INTEGER_LIMIT: i64 = 1 << 24;
const SOURCE_INTEGER_LIMIT: i64 = 1 << 20;
const BASIC_LIBRARY: &str = include_str!("../../../lean/VeriNeural/Basic.lean");
const MEMORY_LIBRARY: &str = include_str!("../../../lean/VeriNeural/Memory.lean");
const NUMERIC_LIBRARY: &str = include_str!("../../../lean/VeriNeural/Numeric.lean");

#[derive(Debug)]
pub enum NumericError {
    Graph(NeuralError),
    Proof(ProofError),
    UnsupportedOperation {
        node: usize,
        operation: &'static str,
    },
    UnsupportedRange {
        node: usize,
        bound: i64,
    },
    UnstableBranch {
        node: usize,
        lower_ticks: i128,
        upper_ticks: i128,
    },
    InvalidInput {
        node: usize,
        reason: &'static str,
    },
    MissingInput {
        node: usize,
    },
    OutputBits {
        index: usize,
        expected: u32,
        actual: u32,
    },
}

impl fmt::Display for NumericError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::Graph(err) => write!(f, "invalid neural graph: {err}"),
            Self::Proof(err) => write!(f, "numerical Lean model: {err}"),
            Self::UnsupportedOperation { node, operation } => {
                write!(f, "numeric FP32 subset rejects {operation} at node {node}")
            }
            Self::UnsupportedRange { node, bound } => write!(
                f,
                "node {node} needs integer bound {bound}, outside exact binary32 subset"
            ),
            Self::UnstableBranch {
                node,
                lower_ticks,
                upper_ticks,
            } => write!(
                f,
                "numeric branch at node {node} is unstable: ideal condition interval [{lower_ticks}, {upper_ticks}] crosses zero"
            ),
            Self::InvalidInput { node, reason } => {
                write!(f, "FP32 numeric input {node}: {reason}")
            }
            Self::MissingInput { node } => write!(f, "missing numeric input node {node}"),
            Self::OutputBits {
                index,
                expected,
                actual,
            } => write!(
                f,
                "FP32 oracle mismatch at {index}: expected={expected:08x} GPU={actual:08x}"
            ),
        }
    }
}

impl Error for NumericError {}

impl From<NeuralError> for NumericError {
    fn from(value: NeuralError) -> Self {
        Self::Graph(value)
    }
}

impl From<ProofError> for NumericError {
    fn from(value: ProofError) -> Self {
        Self::Proof(value)
    }
}

/// Conditional exactness under trusted IEEE binary32 round-to-nearest,
/// separate operations, preservation of the emitted arithmetic and CUDA
/// execution. No claim about the hardware is certified by this plan.
#[derive(Clone, Debug)]
pub struct ExactFp32Plan {
    graph: NeuralGraph,
    output: NodeId,
    reachable: Vec<usize>,
    inputs: Vec<NodeId>,
    bounds: BTreeMap<usize, i64>,
    max_input: i64,
}

impl ExactFp32Plan {
    pub const fn input_bound() -> i64 {
        SOURCE_INTEGER_LIMIT
    }

    pub const fn max_exact_integer() -> i64 {
        EXACT_F32_INTEGER_LIMIT
    }

    /// Backwards-compatible conservative profile for purely additive graphs.
    /// Products normally need a tighter explicit source bound.
    pub fn compile(graph: &NeuralGraph, output: NodeId) -> Result<Self, NumericError> {
        Self::compile_with_input_bound(graph, output, SOURCE_INTEGER_LIMIT)
    }

    /// Check all reachable integer intermediates and left-to-right MatMul
    /// partial sums against the exact-binary32 magnitude limit. A tighter
    /// input bound permits safe products without weakening the guarantee.
    pub fn compile_with_input_bound(
        graph: &NeuralGraph,
        output: NodeId,
        max_input: i64,
    ) -> Result<Self, NumericError> {
        graph.node(output)?;
        if !(1..=SOURCE_INTEGER_LIMIT).contains(&max_input) {
            return Err(NumericError::InvalidInput {
                node: output.index(),
                reason: "source bound must be in 1..=2^20",
            });
        }
        if graph.policy() != crate::FP32Policy::strict() {
            return Err(NumericError::InvalidInput {
                node: output.index(),
                reason: "exact-integer subset requires strict FP32 policy",
            });
        }
        let mut used = BTreeSet::new();
        let mut pending = vec![output];
        while let Some(id) = pending.pop() {
            let node = graph.node(id)?;
            if !used.insert(id.index()) {
                continue;
            }
            if !matches!(
                node.operation,
                Operation::Input
                    | Operation::Add
                    | Operation::Mul
                    | Operation::MatMul
                    | Operation::BiasAdd
                    | Operation::Relu
                    | Operation::Reshape(_)
            ) {
                return Err(NumericError::UnsupportedOperation {
                    node: id.index(),
                    operation: node.operation.name(),
                });
            }
            pending.extend(node.inputs.iter().copied());
            // Mirror the Lean proof engine's module-interface dependencies.
            for module in graph.modules() {
                if module.output == id {
                    pending.extend(module.inputs.iter().copied());
                }
            }
        }

        let reachable = used.into_iter().collect::<Vec<_>>();
        let inputs = reachable
            .iter()
            .filter_map(|&i| {
                matches!(graph.nodes()[i].operation, Operation::Input)
                    .then_some(graph.nodes()[i].id)
            })
            .collect::<Vec<_>>();
        let mut bounds = BTreeMap::<usize, i64>::new();
        for &index in &reachable {
            let node = &graph.nodes()[index];
            let parent = |position: usize| bounds[&node.inputs[position].index()];
            let bound = match node.operation {
                Operation::Input => max_input,
                Operation::Add | Operation::BiasAdd => parent(0) + parent(1),
                Operation::Mul => parent(0).checked_mul(parent(1)).unwrap_or(i64::MAX),
                Operation::MatMul => {
                    let left = graph.nodes()[node.inputs[0].index()].shape.dims()[1];
                    parent(0)
                        .checked_mul(parent(1))
                        .and_then(|product| i64::try_from(left).ok()?.checked_mul(product))
                        .unwrap_or(i64::MAX)
                }
                Operation::Relu | Operation::Reshape(_) => parent(0),
                _ => unreachable!("rejected during graph traversal"),
            };
            if bound > EXACT_F32_INTEGER_LIMIT {
                return Err(NumericError::UnsupportedRange { node: index, bound });
            }
            bounds.insert(index, bound);
        }
        Ok(Self {
            graph: graph.clone(),
            output,
            reachable,
            inputs,
            bounds,
            max_input,
        })
    }

    pub fn output_bound(&self) -> i64 {
        self.bounds[&self.output.index()]
    }

    pub fn source_inputs(&self) -> &[NodeId] {
        &self.inputs
    }

    pub fn max_input_bound(&self) -> i64 {
        self.max_input
    }

    /// Generate a Lean theorem for every reachable output node and its real
    /// composed input hypotheses. The result is NOT proof until Lean checks it.
    pub fn lean_source(&self) -> Result<String, NumericError> {
        let base = LeanProofEngine::default().generate(&self.graph, self.output)?;
        let mut source = base.source().to_owned();
        source.push_str("\n\n");
        source.push_str(MEMORY_LIBRARY);
        source.push_str("\n\n");
        source.push_str(NUMERIC_LIBRARY);
        source.push_str("\nnamespace VeriNeural.Generated\n\n");

        let params = self
            .inputs
            .iter()
            .map(|id| {
                let i = id.index();
                format!(
                    "(x_{i} : VeriNeural.Tensor {})",
                    self.graph.nodes()[i].shape.element_count()
                )
            })
            .collect::<Vec<_>>()
            .join(" ");
        // A node's proof needs hypotheses only for its actual data ancestors,
        // not every reachable input in the enclosing graph. This prevents
        // vacuous assumptions and Lean's unused-variable warnings.
        let mut dependencies: BTreeMap<usize, BTreeSet<usize>> = BTreeMap::new();
        for &index in &self.reachable {
            let node = &self.graph.nodes()[index];
            let mut sources = BTreeSet::new();
            if matches!(node.operation, Operation::Input) {
                sources.insert(index);
            } else {
                for parent in &node.inputs {
                    sources.extend(dependencies[&parent.index()].iter().copied());
                }
            }
            dependencies.insert(index, sources);
        }
        let hypotheses_for = |index: usize| {
            dependencies[&index]
                .iter()
                .map(|source| {
                    format!(
                        "(h_{source} : VeriNeural.TensorWithin {} x_{source})",
                        self.max_input
                    )
                })
                .collect::<Vec<_>>()
                .join(" ")
        };
        let args = self
            .inputs
            .iter()
            .map(|id| format!("x_{}", id.index()))
            .collect::<Vec<_>>()
            .join(" ");
        let conditions_for = |index: usize| {
            dependencies[&index]
                .iter()
                .map(|source| format!("h_{source}"))
                .collect::<Vec<_>>()
                .join(" ")
        };
        let call = |index: usize| format!("(node_{index} {args})");
        let proof = |index: usize| {
            format!(
                "(node_{index}_integer_range {args} {})",
                conditions_for(index)
            )
        };

        for &index in &self.reachable {
            let node = &self.graph.nodes()[index];
            let bound = self.bounds[&index];
            let derived = match node.operation {
                Operation::Input => format!("h_{index}"),
                Operation::Add => format!(
                    "VeriNeural.tensor_within_add {} {}",
                    proof(node.inputs[0].index()),
                    proof(node.inputs[1].index())
                ),
                Operation::Mul => format!(
                    "VeriNeural.tensor_within_mul {} {}",
                    proof(node.inputs[0].index()),
                    proof(node.inputs[1].index())
                ),
                Operation::MatMul => {
                    let left = &self.graph.nodes()[node.inputs[0].index()];
                    let right = &self.graph.nodes()[node.inputs[1].index()];
                    format!(
                        "VeriNeural.tensor_within_matmul (m := {}) (k := {}) (n := {}) \
                         (a := {}) (b := {}) (by decide : 0 < {}) {} {}",
                        left.shape.dims()[0],
                        left.shape.dims()[1],
                        right.shape.dims()[1],
                        call(node.inputs[0].index()),
                        call(node.inputs[1].index()),
                        right.shape.dims()[1],
                        proof(node.inputs[0].index()),
                        proof(node.inputs[1].index()),
                    )
                }
                Operation::BiasAdd => format!(
                    "VeriNeural.tensor_within_biasAdd (m := {}) (n := {}) (a := {}) (b := {}) \
                     (by decide : 0 < {}) {} {}",
                    node.shape.dims()[0],
                    node.shape.dims()[1],
                    call(node.inputs[0].index()),
                    call(node.inputs[1].index()),
                    node.shape.dims()[1],
                    proof(node.inputs[0].index()),
                    proof(node.inputs[1].index())
                ),
                Operation::Relu => format!(
                    "VeriNeural.tensor_within_relu (by decide : 0 ≤ ({bound} : Int)) {}",
                    proof(node.inputs[0].index())
                ),
                Operation::Reshape(_) => format!(
                    "VeriNeural.tensor_within_reshape {}",
                    proof(node.inputs[0].index())
                ),
                _ => unreachable!("checked in compile"),
            };
            source.push_str(&format!(
                "theorem node_{index}_integer_range {params} {hypotheses} :\n  \
                 VeriNeural.TensorWithin {bound} {} := by\n  \
                 simpa [node_{index}] using ({derived})\n\n",
                call(index),
                hypotheses = hypotheses_for(index)
            ));
        }
        let final_bound = self.output_bound();
        source.push_str(&format!(
            "-- Final output of this *particular* composition is within the\n\
             -- exact-binary32-integer magnitude, assuming input bounds.\n\
             theorem output_integer_range {params} {hypotheses} :\n  \
             VeriNeural.TensorWithin {final_bound} {} := by\n  \
             exact {}\n\nend VeriNeural.Generated\n",
            call(self.output.index()),
            proof(self.output.index()),
            hypotheses = hypotheses_for(self.output.index()),
        ));
        Ok(source)
    }

    fn checked_inputs<'a>(
        &self,
        values: &'a [(NodeId, Tensor<f32>)],
    ) -> Result<BTreeMap<usize, &'a Tensor<f32>>, NumericError> {
        let mut given = BTreeMap::new();
        for (id, tensor) in values {
            let node = self.graph.node(*id)?;
            if !matches!(node.operation, Operation::Input) || !self.inputs.contains(id) {
                return Err(NumericError::InvalidInput {
                    node: id.index(),
                    reason: "input is outside this numeric output slice",
                });
            }
            if tensor.shape() != &node.shape {
                return Err(NumericError::InvalidInput {
                    node: id.index(),
                    reason: "tensor shape differs from the graph input",
                });
            }
            tensor.validate_domain(node.domain)?;
            for value in tensor.values() {
                if !value.is_finite()
                    || value.abs() > self.max_input as f32
                    || value.fract() != 0.0
                    || (value.to_bits() == (-0.0f32).to_bits())
                {
                    return Err(NumericError::InvalidInput {
                        node: id.index(),
                        reason: "requires finite integral f32 values, no -0, |x| <= plan input bound",
                    });
                }
            }
            if given.insert(id.index(), tensor).is_some() {
                return Err(NumericError::InvalidInput {
                    node: id.index(),
                    reason: "duplicate graph input",
                });
            }
        }
        for id in &self.inputs {
            if !given.contains_key(&id.index()) {
                return Err(NumericError::MissingInput { node: id.index() });
            }
        }
        Ok(given)
    }

    /// An independent i64 oracle; no f32 arithmetic is used until the final
    /// exact integer-to-binary32 conversion. All intermediates are <= 2^24.
    pub fn integer_reference(
        &self,
        inputs: &[(NodeId, Tensor<f32>)],
    ) -> Result<Tensor<f32>, NumericError> {
        let given = self.checked_inputs(inputs)?;
        let mut values = BTreeMap::<usize, Vec<i64>>::new();
        for &index in &self.reachable {
            let node = &self.graph.nodes()[index];
            let output = match node.operation {
                Operation::Input => given[&index]
                    .values()
                    .iter()
                    .map(|&value| value as i64)
                    .collect(),
                Operation::Add => {
                    let left = &values[&node.inputs[0].index()];
                    let right = &values[&node.inputs[1].index()];
                    left.iter().zip(right).map(|(&a, &b)| a + b).collect()
                }
                Operation::Mul => {
                    let left = &values[&node.inputs[0].index()];
                    let right = &values[&node.inputs[1].index()];
                    left.iter().zip(right).map(|(&a, &b)| a * b).collect()
                }
                Operation::MatMul => {
                    let left = &values[&node.inputs[0].index()];
                    let right = &values[&node.inputs[1].index()];
                    let inner = self.graph.nodes()[node.inputs[0].index()].shape.dims()[1];
                    let rows = node.shape.dims()[0];
                    let cols = node.shape.dims()[1];
                    let mut out = vec![0i64; rows * cols];
                    for row in 0..rows {
                        for col in 0..cols {
                            let mut sum = 0i64;
                            for j in 0..inner {
                                sum += left[row * inner + j] * right[j * cols + col];
                            }
                            out[row * cols + col] = sum;
                        }
                    }
                    out
                }
                Operation::BiasAdd => {
                    let left = &values[&node.inputs[0].index()];
                    let bias = &values[&node.inputs[1].index()];
                    left.iter()
                        .enumerate()
                        .map(|(i, &value)| value + bias[i % bias.len()])
                        .collect()
                }
                Operation::Relu => values[&node.inputs[0].index()]
                    .iter()
                    .map(|&value| value.max(0))
                    .collect(),
                Operation::Reshape(_) => values[&node.inputs[0].index()].clone(),
                _ => unreachable!("checked in compile"),
            };
            debug_assert_eq!(output.len(), node.shape.element_count());
            debug_assert!(output.iter().all(|x| x.abs() <= self.bounds[&index]));
            values.insert(index, output);
        }
        let out = values
            .remove(&self.output.index())
            .expect("reachable output");
        let shape = self.graph.node(self.output)?.shape.clone();
        let floats = out.into_iter().map(|i| i as f32).collect();
        Ok(Tensor::new(shape, floats)?)
    }

    pub fn compare_gpu(
        &self,
        inputs: &[(NodeId, Tensor<f32>)],
        gpu: &Tensor<f32>,
    ) -> Result<(), NumericError> {
        let expected = self.integer_reference(inputs)?;
        if expected.shape() != gpu.shape() {
            return Err(NumericError::InvalidInput {
                node: self.output.index(),
                reason: "GPU output shape differs from exact-integer reference",
            });
        }
        for (index, (&target, &actual)) in expected.values().iter().zip(gpu.values()).enumerate() {
            if target.to_bits() != actual.to_bits() {
                return Err(NumericError::OutputBits {
                    index,
                    expected: target.to_bits(),
                    actual: actual.to_bits(),
                });
            }
        }
        Ok(())
    }
}

/// A concrete Stage 8 rounding slice for fractional dyadic inputs.
///
/// Source inputs live on 2^-fraction_bits. Each reachable node carries its own
/// exact dyadic proof lattice: Add/BiasAdd lift operands to the finer lattice,
/// while Mul/MatMul add operand fractional widths. Concrete traces fail closed
/// if that lattice or any i64 oracle value would overflow. No f32 arithmetic is
/// used by the oracle itself.
#[derive(Clone, Debug)]
pub struct RneFp32Plan {
    graph: NeuralGraph,
    output: NodeId,
    reachable: Vec<usize>,
    inputs: Vec<NodeId>,
    fraction_bits: u32,
    scales: BTreeMap<usize, u32>,
}

/// Result of one concrete, independently rounded binary32 trace.
///
/// epsilon_ticks is the Lean-composed conservative absolute-error budget on
/// the output trace lattice. observed_error_ticks is the actual deviation of
/// the integer RNE oracle from exact dyadic arithmetic on the same lattice.
#[derive(Clone, Debug)]
pub struct RneFp32Trace {
    expected: Tensor<f32>,
    ideal_ticks: Vec<i64>,
    rounded_ticks: Vec<i64>,
    epsilon_ticks: i64,
    observed_error_ticks: i64,
    fraction_bits: u32,
    lean_source: String,
}

#[derive(Clone, Copy, Debug)]
struct RneWitness {
    pre_round: i64,
    rounded: i64,
    shift: u32,
}

#[derive(Clone, Copy, Debug)]
struct RneMatMulStep {
    left_element: usize,
    right_element: usize,
    product_ideal: i64,
    product_actual: i64,
    product_epsilon: i64,
    product_rounding: RneWitness,
    sum_ideal: i64,
    sum_actual: i64,
    sum_epsilon: i64,
    sum_rounding: RneWitness,
}

#[derive(Clone, Debug)]
struct RneNodeTrace {
    ideal: Vec<i64>,
    actual: Vec<i64>,
    epsilon: Vec<i64>,
    fraction_bits: u32,
    rounding: Vec<Option<RneWitness>>,
    matmul_steps: Option<Vec<Vec<RneMatMulStep>>>,
}

impl RneFp32Plan {
    /// Compile a concrete dyadic RNE trace profile.
    ///
    /// fraction_bits chooses the exact source-input lattice 2^-q. Source
    /// inputs keep q <= 30 so accepted normal binary32 values fit the i64
    /// decoder. Products may use finer internal lattices, capped at 60 bits;
    /// concrete traces still fail closed on any value/budget overflow.
    pub fn compile(
        graph: &NeuralGraph,
        output: NodeId,
        fraction_bits: u32,
    ) -> Result<Self, NumericError> {
        graph.node(output)?;
        if !(1..=30).contains(&fraction_bits) {
            return Err(NumericError::InvalidInput {
                node: output.index(),
                reason: "RNE dyadic fraction_bits must be in 1..=30",
            });
        }
        if graph.policy() != crate::FP32Policy::strict() {
            return Err(NumericError::InvalidInput {
                node: output.index(),
                reason: "RNE dyadic slice requires strict FP32 policy",
            });
        }

        let mut used = BTreeSet::new();
        let mut pending = vec![output];
        while let Some(id) = pending.pop() {
            let node = graph.node(id)?;
            if !used.insert(id.index()) {
                continue;
            }
            if !matches!(
                node.operation,
                Operation::Input
                    | Operation::Add
                    | Operation::Mul
                    | Operation::MatMul
                    | Operation::BiasAdd
                    | Operation::Relu
                    | Operation::Reshape(_)
            ) {
                return Err(NumericError::UnsupportedOperation {
                    node: id.index(),
                    operation: node.operation.name(),
                });
            }
            pending.extend(node.inputs.iter().copied());
            for module in graph.modules() {
                if module.output == id {
                    pending.extend(module.inputs.iter().copied());
                }
            }
        }

        let reachable = used.into_iter().collect::<Vec<_>>();
        let inputs = reachable
            .iter()
            .filter_map(|&i| {
                matches!(graph.nodes()[i].operation, Operation::Input)
                    .then_some(graph.nodes()[i].id)
            })
            .collect::<Vec<_>>();

        let mut scales = BTreeMap::<usize, u32>::new();
        for &index in &reachable {
            let node = &graph.nodes()[index];
            let parent = |position: usize| scales[&node.inputs[position].index()];
            let scale = match node.operation {
                Operation::Input => fraction_bits,
                Operation::Add | Operation::BiasAdd => parent(0).max(parent(1)),
                Operation::Mul | Operation::MatMul => {
                    parent(0)
                        .checked_add(parent(1))
                        .ok_or(NumericError::InvalidInput {
                            node: index,
                            reason: "RNE proof lattice fractional-width overflow",
                        })?
                }
                Operation::Relu | Operation::Reshape(_) => parent(0),
                _ => unreachable!("rejected during RNE plan compilation"),
            };
            if scale > 60 {
                return Err(NumericError::InvalidInput {
                    node: index,
                    reason: "RNE proof lattice exceeds 60 fractional bits",
                });
            }
            scales.insert(index, scale);
        }

        Ok(Self {
            graph: graph.clone(),
            output,
            reachable,
            inputs,
            fraction_bits,
            scales,
        })
    }

    pub fn fraction_bits(&self) -> u32 {
        self.fraction_bits
    }

    pub fn output_fraction_bits(&self) -> u32 {
        self.scales[&self.output.index()]
    }

    pub fn source_inputs(&self) -> &[NodeId] {
        &self.inputs
    }

    fn checked_tick_inputs(
        &self,
        values: &[(NodeId, Tensor<f32>)],
    ) -> Result<BTreeMap<usize, Vec<i64>>, NumericError> {
        let mut given = BTreeMap::new();
        for (id, tensor) in values {
            let node = self.graph.node(*id)?;
            if !matches!(node.operation, Operation::Input) || !self.inputs.contains(id) {
                return Err(NumericError::InvalidInput {
                    node: id.index(),
                    reason: "input is outside this RNE output slice",
                });
            }
            if tensor.shape() != &node.shape {
                return Err(NumericError::InvalidInput {
                    node: id.index(),
                    reason: "tensor shape differs from the graph input",
                });
            }
            tensor.validate_domain(node.domain)?;
            let ticks = tensor
                .values()
                .iter()
                .map(|&value| {
                    f32_to_dyadic_ticks(value, self.fraction_bits).map_err(|reason| {
                        NumericError::InvalidInput {
                            node: id.index(),
                            reason,
                        }
                    })
                })
                .collect::<Result<Vec<_>, _>>()?;
            if given.insert(id.index(), ticks).is_some() {
                return Err(NumericError::InvalidInput {
                    node: id.index(),
                    reason: "duplicate graph input",
                });
            }
        }
        for id in &self.inputs {
            if !given.contains_key(&id.index()) {
                return Err(NumericError::MissingInput { node: id.index() });
            }
        }
        Ok(given)
    }

    /// Execute the independent dyadic/RNE oracle and build a concrete Lean
    /// proof trace. MatMul models a separate rounded multiply followed by a
    /// separate rounded add at every left-to-right reduction step.
    pub fn trace(&self, inputs: &[(NodeId, Tensor<f32>)]) -> Result<RneFp32Trace, NumericError> {
        let given = self.checked_tick_inputs(inputs)?;
        let mut nodes = BTreeMap::<usize, RneNodeTrace>::new();

        for &index in &self.reachable {
            let node = &self.graph.nodes()[index];
            let len = node.shape.element_count();
            let trace = match node.operation {
                Operation::Input => {
                    let ticks = given[&index].clone();
                    RneNodeTrace {
                        ideal: ticks.clone(),
                        actual: ticks,
                        epsilon: vec![0; len],
                        fraction_bits: self.scales[&index],
                        rounding: vec![None; len],
                        matmul_steps: None,
                    }
                }
                Operation::Add => {
                    let left = &nodes[&node.inputs[0].index()];
                    let right = &nodes[&node.inputs[1].index()];
                    self.trace_add(index, left, right, None)?
                }
                Operation::Mul => {
                    let left = &nodes[&node.inputs[0].index()];
                    let right = &nodes[&node.inputs[1].index()];
                    self.trace_mul(index, left, right)?
                }
                Operation::MatMul => {
                    let left = &nodes[&node.inputs[0].index()];
                    let right = &nodes[&node.inputs[1].index()];
                    self.trace_matmul(index, left, right)?
                }
                Operation::BiasAdd => {
                    let left = &nodes[&node.inputs[0].index()];
                    let bias = &nodes[&node.inputs[1].index()];
                    self.trace_add(index, left, bias, Some(bias.actual.len()))?
                }
                Operation::Relu => {
                    let parent = &nodes[&node.inputs[0].index()];
                    RneNodeTrace {
                        ideal: parent.ideal.iter().map(|&v| v.max(0)).collect(),
                        actual: parent.actual.iter().map(|&v| v.max(0)).collect(),
                        epsilon: parent.epsilon.clone(),
                        fraction_bits: parent.fraction_bits,
                        rounding: vec![None; len],
                        matmul_steps: None,
                    }
                }
                Operation::Reshape(_) => {
                    let parent = &nodes[&node.inputs[0].index()];
                    RneNodeTrace {
                        ideal: parent.ideal.clone(),
                        actual: parent.actual.clone(),
                        epsilon: parent.epsilon.clone(),
                        fraction_bits: parent.fraction_bits,
                        rounding: vec![None; len],
                        matmul_steps: None,
                    }
                }
                _ => unreachable!("rejected during RNE plan compilation"),
            };
            if trace.actual.len() != len || trace.fraction_bits != self.scales[&index] {
                return Err(NumericError::InvalidInput {
                    node: index,
                    reason: "internal RNE trace shape/scale mismatch",
                });
            }
            for i in 0..len {
                let observed = trace.actual[i]
                    .checked_sub(trace.ideal[i])
                    .and_then(|value| value.checked_abs())
                    .ok_or(NumericError::InvalidInput {
                        node: index,
                        reason: "RNE trace error overflow",
                    })?;
                if observed > trace.epsilon[i] {
                    return Err(NumericError::InvalidInput {
                        node: index,
                        reason: "RNE trace exceeded composed error budget",
                    });
                }
            }
            nodes.insert(index, trace);
        }

        let final_trace = nodes
            .get(&self.output.index())
            .expect("reachable RNE output");
        let epsilon_ticks = final_trace.epsilon.iter().copied().max().unwrap_or(0);
        let observed_error_ticks = final_trace
            .actual
            .iter()
            .zip(&final_trace.ideal)
            .map(|(&actual, &ideal)| {
                actual
                    .checked_sub(ideal)
                    .and_then(|value| value.checked_abs())
                    .expect("validated RNE error")
            })
            .max()
            .unwrap_or(0);
        let floats = final_trace
            .actual
            .iter()
            .map(|&ticks| {
                encode_representable_ticks(ticks, final_trace.fraction_bits)
                    .map(f32::from_bits)
                    .map_err(|reason| NumericError::InvalidInput {
                        node: self.output.index(),
                        reason,
                    })
            })
            .collect::<Result<Vec<_>, _>>()?;
        let expected = Tensor::new(self.graph.node(self.output)?.shape.clone(), floats)?;
        let lean_source = self.trace_lean_source(&nodes, epsilon_ticks)?;

        Ok(RneFp32Trace {
            expected,
            ideal_ticks: final_trace.ideal.clone(),
            rounded_ticks: final_trace.actual.clone(),
            epsilon_ticks,
            observed_error_ticks,
            fraction_bits: final_trace.fraction_bits,
            lean_source,
        })
    }

    fn trace_add(
        &self,
        node_index: usize,
        left: &RneNodeTrace,
        right: &RneNodeTrace,
        bias_len: Option<usize>,
    ) -> Result<RneNodeTrace, NumericError> {
        let len = left.actual.len();
        if matches!(bias_len, Some(0)) {
            return Err(NumericError::InvalidInput {
                node: node_index,
                reason: "bias width must be positive in RNE trace",
            });
        }
        let fraction_bits = left.fraction_bits.max(right.fraction_bits);
        let left_shift = fraction_bits - left.fraction_bits;
        let right_shift = fraction_bits - right.fraction_bits;
        let mut ideal = Vec::with_capacity(len);
        let mut actual = Vec::with_capacity(len);
        let mut epsilon = Vec::with_capacity(len);
        let mut rounding = Vec::with_capacity(len);

        for i in 0..len {
            let j = bias_len.map_or(i, |width| i % width);
            let left_ideal =
                rescale_i64(left.ideal[i], left_shift).ok_or(NumericError::InvalidInput {
                    node: node_index,
                    reason: "ideal dyadic addition rescale overflow",
                })?;
            let right_ideal =
                rescale_i64(right.ideal[j], right_shift).ok_or(NumericError::InvalidInput {
                    node: node_index,
                    reason: "ideal dyadic addition rescale overflow",
                })?;
            let left_actual =
                rescale_i64(left.actual[i], left_shift).ok_or(NumericError::InvalidInput {
                    node: node_index,
                    reason: "rounded dyadic addition rescale overflow",
                })?;
            let right_actual =
                rescale_i64(right.actual[j], right_shift).ok_or(NumericError::InvalidInput {
                    node: node_index,
                    reason: "rounded dyadic addition rescale overflow",
                })?;
            let left_epsilon =
                rescale_i64(left.epsilon[i], left_shift).ok_or(NumericError::InvalidInput {
                    node: node_index,
                    reason: "dyadic addition error rescale overflow",
                })?;
            let right_epsilon =
                rescale_i64(right.epsilon[j], right_shift).ok_or(NumericError::InvalidInput {
                    node: node_index,
                    reason: "dyadic addition error rescale overflow",
                })?;
            let ideal_value =
                left_ideal
                    .checked_add(right_ideal)
                    .ok_or(NumericError::InvalidInput {
                        node: node_index,
                        reason: "ideal dyadic addition overflow",
                    })?;
            let pre_round =
                left_actual
                    .checked_add(right_actual)
                    .ok_or(NumericError::InvalidInput {
                        node: node_index,
                        reason: "rounded dyadic addition overflow",
                    })?;
            let (rounded, _bits, shift) = round_ticks_to_binary32(pre_round, fraction_bits)
                .map_err(|reason| NumericError::InvalidInput {
                    node: node_index,
                    reason,
                })?;
            let step = binary32_step_i64(shift).ok_or(NumericError::InvalidInput {
                node: node_index,
                reason: "binary32 ulp step overflow",
            })?;
            let budget = left_epsilon
                .checked_add(right_epsilon)
                .and_then(|v| v.checked_add(step))
                .ok_or(NumericError::InvalidInput {
                    node: node_index,
                    reason: "RNE addition error budget overflow",
                })?;
            ideal.push(ideal_value);
            actual.push(rounded);
            epsilon.push(budget);
            rounding.push(Some(RneWitness {
                pre_round,
                rounded,
                shift,
            }));
        }

        Ok(RneNodeTrace {
            ideal,
            actual,
            epsilon,
            fraction_bits,
            rounding,
            matmul_steps: None,
        })
    }

    fn trace_mul_element(
        &self,
        node_index: usize,
        left: &RneNodeTrace,
        right: &RneNodeTrace,
        left_element: usize,
        right_element: usize,
    ) -> Result<(i64, i64, i64, RneWitness), NumericError> {
        let fraction_bits = left.fraction_bits.checked_add(right.fraction_bits).ok_or(
            NumericError::InvalidInput {
                node: node_index,
                reason: "RNE product fractional-width overflow",
            },
        )?;
        let ideal = left.ideal[left_element]
            .checked_mul(right.ideal[right_element])
            .ok_or(NumericError::InvalidInput {
                node: node_index,
                reason: "ideal dyadic product overflow",
            })?;
        let pre_round = left.actual[left_element]
            .checked_mul(right.actual[right_element])
            .ok_or(NumericError::InvalidInput {
                node: node_index,
                reason: "rounded dyadic product overflow",
            })?;
        let (rounded, _bits, shift) =
            round_ticks_to_binary32(pre_round, fraction_bits).map_err(|reason| {
                NumericError::InvalidInput {
                    node: node_index,
                    reason,
                }
            })?;
        let step = binary32_step_i64(shift).ok_or(NumericError::InvalidInput {
            node: node_index,
            reason: "binary32 product ulp step overflow",
        })?;
        let bound_ideal_left =
            left.ideal[left_element]
                .checked_abs()
                .ok_or(NumericError::InvalidInput {
                    node: node_index,
                    reason: "ideal product bound overflow",
                })?;
        let bound_actual_right =
            right.actual[right_element]
                .checked_abs()
                .ok_or(NumericError::InvalidInput {
                    node: node_index,
                    reason: "actual product bound overflow",
                })?;
        let propagated = left.epsilon[left_element]
            .checked_mul(bound_actual_right)
            .and_then(|v| {
                bound_ideal_left
                    .checked_mul(right.epsilon[right_element])
                    .and_then(|w| v.checked_add(w))
            })
            .ok_or(NumericError::InvalidInput {
                node: node_index,
                reason: "RNE product propagated-error overflow",
            })?;
        let budget = propagated
            .checked_add(step)
            .ok_or(NumericError::InvalidInput {
                node: node_index,
                reason: "RNE product error budget overflow",
            })?;

        Ok((
            ideal,
            rounded,
            budget,
            RneWitness {
                pre_round,
                rounded,
                shift,
            },
        ))
    }

    fn trace_mul(
        &self,
        node_index: usize,
        left: &RneNodeTrace,
        right: &RneNodeTrace,
    ) -> Result<RneNodeTrace, NumericError> {
        if left.actual.len() != right.actual.len() {
            return Err(NumericError::InvalidInput {
                node: node_index,
                reason: "internal RNE pointwise product shape mismatch",
            });
        }
        let len = left.actual.len();
        let fraction_bits = left.fraction_bits + right.fraction_bits;
        let mut ideal = Vec::with_capacity(len);
        let mut actual = Vec::with_capacity(len);
        let mut epsilon = Vec::with_capacity(len);
        let mut rounding = Vec::with_capacity(len);
        for i in 0..len {
            let (ideal_value, actual_value, error, witness) =
                self.trace_mul_element(node_index, left, right, i, i)?;
            ideal.push(ideal_value);
            actual.push(actual_value);
            epsilon.push(error);
            rounding.push(Some(witness));
        }
        Ok(RneNodeTrace {
            ideal,
            actual,
            epsilon,
            fraction_bits,
            rounding,
            matmul_steps: None,
        })
    }

    fn trace_matmul(
        &self,
        node_index: usize,
        left: &RneNodeTrace,
        right: &RneNodeTrace,
    ) -> Result<RneNodeTrace, NumericError> {
        let node = &self.graph.nodes()[node_index];
        let left_node = &self.graph.nodes()[node.inputs[0].index()];
        let inner = left_node.shape.dims()[1];
        let rows = node.shape.dims()[0];
        let cols = node.shape.dims()[1];
        let fraction_bits = left.fraction_bits + right.fraction_bits;
        let mut ideal = Vec::with_capacity(rows * cols);
        let mut actual = Vec::with_capacity(rows * cols);
        let mut epsilon = Vec::with_capacity(rows * cols);
        let mut all_steps = Vec::with_capacity(rows * cols);

        for row in 0..rows {
            for col in 0..cols {
                let mut sum_ideal = 0i64;
                let mut sum_actual = 0i64;
                let mut sum_epsilon = 0i64;
                let mut steps = Vec::with_capacity(inner);
                for j in 0..inner {
                    let left_element = row * inner + j;
                    let right_element = j * cols + col;
                    let (product_ideal, product_actual, product_epsilon, product_rounding) = self
                        .trace_mul_element(
                        node_index,
                        left,
                        right,
                        left_element,
                        right_element,
                    )?;
                    let next_ideal =
                        sum_ideal
                            .checked_add(product_ideal)
                            .ok_or(NumericError::InvalidInput {
                                node: node_index,
                                reason: "ideal MatMul reduction overflow",
                            })?;
                    let pre_round = sum_actual.checked_add(product_actual).ok_or(
                        NumericError::InvalidInput {
                            node: node_index,
                            reason: "rounded MatMul reduction overflow",
                        },
                    )?;
                    let (next_actual, _bits, shift) =
                        round_ticks_to_binary32(pre_round, fraction_bits).map_err(|reason| {
                            NumericError::InvalidInput {
                                node: node_index,
                                reason,
                            }
                        })?;
                    let step = binary32_step_i64(shift).ok_or(NumericError::InvalidInput {
                        node: node_index,
                        reason: "binary32 MatMul-add ulp step overflow",
                    })?;
                    let next_epsilon = sum_epsilon
                        .checked_add(product_epsilon)
                        .and_then(|v| v.checked_add(step))
                        .ok_or(NumericError::InvalidInput {
                            node: node_index,
                            reason: "RNE MatMul reduction error budget overflow",
                        })?;
                    let sum_rounding = RneWitness {
                        pre_round,
                        rounded: next_actual,
                        shift,
                    };
                    steps.push(RneMatMulStep {
                        left_element,
                        right_element,
                        product_ideal,
                        product_actual,
                        product_epsilon,
                        product_rounding,
                        sum_ideal: next_ideal,
                        sum_actual: next_actual,
                        sum_epsilon: next_epsilon,
                        sum_rounding,
                    });
                    sum_ideal = next_ideal;
                    sum_actual = next_actual;
                    sum_epsilon = next_epsilon;
                }
                ideal.push(sum_ideal);
                actual.push(sum_actual);
                epsilon.push(sum_epsilon);
                all_steps.push(steps);
            }
        }

        Ok(RneNodeTrace {
            ideal,
            actual,
            epsilon,
            fraction_bits,
            rounding: vec![None; rows * cols],
            matmul_steps: Some(all_steps),
        })
    }

    fn trace_lean_source(
        &self,
        traces: &BTreeMap<usize, RneNodeTrace>,
        output_epsilon: i64,
    ) -> Result<String, NumericError> {
        let base = LeanProofEngine::default().generate(&self.graph, self.output)?;
        let mut source = base.source().to_owned();
        source.push_str("\n\n");
        source.push_str(MEMORY_LIBRARY);
        source.push_str("\n\n");
        source.push_str(NUMERIC_LIBRARY);
        source.push_str("\nnamespace VeriNeural.Generated.RneTrace\n\n");
        source.push_str(&format!(
            "-- Concrete dyadic RNE trace: source inputs use 2^-{} ticks.\n\
             -- Internal products may use finer per-node dyadic lattices.\n\
             -- The hardware/LLVM/PTX link is not proved by this theorem.\n\n",
            self.fraction_bits
        ));

        for &index in &self.reachable {
            let node = &self.graph.nodes()[index];
            let trace = &traces[&index];
            for element in 0..trace.actual.len() {
                let error_name = format!("rne_node_{index}_elem_{element}_error");
                match node.operation {
                    Operation::Input => {
                        source.push_str(&format!(
                            "theorem {error_name} :\n  \
                             VeriNeural.ApproxWithin 0 {} {} := by\n  \
                             exact VeriNeural.approx_refl _\n\n",
                            trace.ideal[element], trace.actual[element]
                        ));
                    }
                    Operation::Add | Operation::BiasAdd => {
                        let left_index = node.inputs[0].index();
                        let right_index = node.inputs[1].index();
                        let left_trace = &traces[&left_index];
                        let right_trace = &traces[&right_index];
                        let right_element = if matches!(node.operation, Operation::BiasAdd) {
                            element % right_trace.actual.len()
                        } else {
                            element
                        };
                        let left_shift = trace.fraction_bits - left_trace.fraction_bits;
                        let right_shift = trace.fraction_bits - right_trace.fraction_bits;
                        let left_factor = binary32_step_i64(left_shift).expect("validated scale");
                        let right_factor = binary32_step_i64(right_shift).expect("validated scale");
                        let left_ideal =
                            rescale_i64(left_trace.ideal[element], left_shift).expect("validated");
                        let left_actual =
                            rescale_i64(left_trace.actual[element], left_shift).expect("validated");
                        let left_epsilon = rescale_i64(left_trace.epsilon[element], left_shift)
                            .expect("validated");
                        let right_ideal =
                            rescale_i64(right_trace.ideal[right_element], right_shift)
                                .expect("validated");
                        let right_actual =
                            rescale_i64(right_trace.actual[right_element], right_shift)
                                .expect("validated");
                        let right_epsilon =
                            rescale_i64(right_trace.epsilon[right_element], right_shift)
                                .expect("validated");
                        let witness = trace.rounding[element].expect("add rounding witness");
                        let round_name = format!("rne_node_{index}_elem_{element}_round");
                        source.push_str(&format!(
                            "theorem {round_name} :\n  \
                             VeriNeural.Binary32RneTick {} {} {} := by\n  \
                             decide\n\n",
                            witness.pre_round, witness.rounded, witness.shift
                        ));
                        source.push_str(&format!(
                            "theorem {error_name} :\n  \
                             VeriNeural.ApproxWithin {} {} {} := by\n  \
                             have hleft : VeriNeural.ApproxWithin {left_epsilon} \
                               {left_ideal} {left_actual} := by\n    \
                               simpa using (VeriNeural.approx_scale (scale := {left_factor}) \
                                 (by decide) rne_node_{left_index}_elem_{element}_error)\n  \
                             have hright : VeriNeural.ApproxWithin {right_epsilon} \
                               {right_ideal} {right_actual} := by\n    \
                               simpa using (VeriNeural.approx_scale (scale := {right_factor}) \
                                 (by decide) rne_node_{right_index}_elem_{right_element}_error)\n  \
                             simpa [VeriNeural.binary32Step] using\n    \
                               (VeriNeural.approx_add_round hleft hright\n      \
                                 (VeriNeural.binary32_rne_within_step {round_name}))\n\n",
                            trace.epsilon[element], trace.ideal[element], trace.actual[element]
                        ));
                    }
                    Operation::Mul => {
                        let left_index = node.inputs[0].index();
                        let right_index = node.inputs[1].index();
                        let left_trace = &traces[&left_index];
                        let right_trace = &traces[&right_index];
                        let witness = trace.rounding[element].expect("mul rounding witness");
                        let round_name = format!("rne_node_{index}_elem_{element}_round");
                        let bound_ideal_left =
                            left_trace.ideal[element].checked_abs().expect("validated");
                        let bound_actual_right = right_trace.actual[element]
                            .checked_abs()
                            .expect("validated");
                        source.push_str(&format!(
                            "theorem {round_name} :\n  \
                             VeriNeural.Binary32RneTick {} {} {} := by\n  \
                             decide\n\n",
                            witness.pre_round, witness.rounded, witness.shift
                        ));
                        source.push_str(&format!(
                            "theorem {error_name} :\n  \
                             VeriNeural.ApproxWithin {} {} {} := by\n  \
                             have hideal : VeriNeural.Within {bound_ideal_left} \
                               {} := by decide\n  \
                             have hactual : VeriNeural.Within {bound_actual_right} \
                               {} := by decide\n  \
                             simpa [VeriNeural.binary32Step] using\n    \
                               (VeriNeural.approx_mul_round\n      \
                                 rne_node_{left_index}_elem_{element}_error\n      \
                                 rne_node_{right_index}_elem_{element}_error\n      \
                                 hideal hactual\n      \
                                 (VeriNeural.binary32_rne_within_step {round_name}))\n\n",
                            trace.epsilon[element],
                            trace.ideal[element],
                            trace.actual[element],
                            left_trace.ideal[element],
                            right_trace.actual[element],
                        ));
                    }
                    Operation::MatMul => {
                        let left_index = node.inputs[0].index();
                        let right_index = node.inputs[1].index();
                        let left_trace = &traces[&left_index];
                        let right_trace = &traces[&right_index];
                        let steps = &trace
                            .matmul_steps
                            .as_ref()
                            .expect("MatMul reduction witnesses")[element];
                        let init_name = format!("rne_node_{index}_elem_{element}_acc_0_error");
                        source.push_str(&format!(
                            "theorem {init_name} :\n  \
                             VeriNeural.ApproxWithin 0 0 0 := by\n  \
                             exact VeriNeural.approx_refl _\n\n"
                        ));
                        let mut previous = init_name;
                        for (step_index, step) in steps.iter().enumerate() {
                            let product_round_name = format!(
                                "rne_node_{index}_elem_{element}_product_{step_index}_round"
                            );
                            let product_error_name = format!(
                                "rne_node_{index}_elem_{element}_product_{step_index}_error"
                            );
                            let sum_round_name =
                                format!("rne_node_{index}_elem_{element}_sum_{step_index}_round");
                            let sum_error_name = format!(
                                "rne_node_{index}_elem_{element}_sum_{}_error",
                                step_index + 1
                            );
                            let bound_ideal_left = left_trace.ideal[step.left_element]
                                .checked_abs()
                                .expect("validated");
                            let bound_actual_right = right_trace.actual[step.right_element]
                                .checked_abs()
                                .expect("validated");
                            source.push_str(&format!(
                                "theorem {product_round_name} :\n  \
                                 VeriNeural.Binary32RneTick {} {} {} := by\n  \
                                 decide\n\n",
                                step.product_rounding.pre_round,
                                step.product_rounding.rounded,
                                step.product_rounding.shift
                            ));
                            source.push_str(&format!(
                                "theorem {product_error_name} :\n  \
                                 VeriNeural.ApproxWithin {} {} {} := by\n  \
                                 have hideal : VeriNeural.Within {bound_ideal_left} \
                                   {} := by decide\n  \
                                 have hactual : VeriNeural.Within {bound_actual_right} \
                                   {} := by decide\n  \
                                 simpa [VeriNeural.binary32Step] using\n    \
                                   (VeriNeural.approx_mul_round\n      \
                                     rne_node_{left_index}_elem_{}_error\n      \
                                     rne_node_{right_index}_elem_{}_error\n      \
                                     hideal hactual\n      \
                                     (VeriNeural.binary32_rne_within_step \
                                       {product_round_name}))\n\n",
                                step.product_epsilon,
                                step.product_ideal,
                                step.product_actual,
                                left_trace.ideal[step.left_element],
                                right_trace.actual[step.right_element],
                                step.left_element,
                                step.right_element,
                            ));
                            source.push_str(&format!(
                                "theorem {sum_round_name} :\n  \
                                 VeriNeural.Binary32RneTick {} {} {} := by\n  \
                                 decide\n\n",
                                step.sum_rounding.pre_round,
                                step.sum_rounding.rounded,
                                step.sum_rounding.shift
                            ));
                            source.push_str(&format!(
                                "theorem {sum_error_name} :\n  \
                                 VeriNeural.ApproxWithin {} {} {} := by\n  \
                                 simpa [VeriNeural.binary32Step] using\n    \
                                   (VeriNeural.approx_add_round\n      \
                                     {previous}\n      \
                                     {product_error_name}\n      \
                                     (VeriNeural.binary32_rne_within_step {sum_round_name}))\n\n",
                                step.sum_epsilon, step.sum_ideal, step.sum_actual
                            ));
                            previous = sum_error_name;
                        }
                        source.push_str(&format!(
                            "theorem {error_name} :\n  \
                             VeriNeural.ApproxWithin {} {} {} := by\n  \
                             simpa using {previous}\n\n",
                            trace.epsilon[element], trace.ideal[element], trace.actual[element]
                        ));
                    }
                    Operation::Relu => {
                        let parent = node.inputs[0].index();
                        source.push_str(&format!(
                            "theorem {error_name} :\n  \
                             VeriNeural.ApproxWithin {} {} {} := by\n  \
                             simpa using\n    \
                             (VeriNeural.approx_relu rne_node_{parent}_elem_{element}_error)\n\n",
                            trace.epsilon[element], trace.ideal[element], trace.actual[element]
                        ));
                    }
                    Operation::Reshape(_) => {
                        let parent = node.inputs[0].index();
                        source.push_str(&format!(
                            "theorem {error_name} :\n  \
                             VeriNeural.ApproxWithin {} {} {} := by\n  \
                             simpa using rne_node_{parent}_elem_{element}_error\n\n",
                            trace.epsilon[element], trace.ideal[element], trace.actual[element]
                        ));
                    }
                    _ => unreachable!("rejected during RNE plan compilation"),
                }
            }
        }

        let output = &traces[&self.output.index()];
        for element in 0..output.actual.len() {
            source.push_str(&format!(
                "theorem output_elem_{element}_fp32_error :\n  \
                 VeriNeural.ApproxWithin {output_epsilon} {} {} := by\n  \
                 exact VeriNeural.approx_weaken (by decide) \
                 rne_node_{}_elem_{element}_error\n\n",
                output.ideal[element],
                output.actual[element],
                self.output.index()
            ));
        }
        source.push_str("end VeriNeural.Generated.RneTrace\n");
        Ok(source)
    }
}

impl RneFp32Trace {
    pub fn expected(&self) -> &Tensor<f32> {
        &self.expected
    }

    pub fn ideal_output_ticks(&self) -> &[i64] {
        &self.ideal_ticks
    }

    pub fn rounded_output_ticks(&self) -> &[i64] {
        &self.rounded_ticks
    }

    pub fn epsilon_ticks(&self) -> i64 {
        self.epsilon_ticks
    }

    pub fn observed_error_ticks(&self) -> i64 {
        self.observed_error_ticks
    }

    pub fn fraction_bits(&self) -> u32 {
        self.fraction_bits
    }

    pub fn epsilon(&self) -> f64 {
        self.epsilon_ticks as f64 / (1u64 << self.fraction_bits) as f64
    }

    pub fn observed_error(&self) -> f64 {
        self.observed_error_ticks as f64 / (1u64 << self.fraction_bits) as f64
    }

    pub fn lean_source(&self) -> &str {
        &self.lean_source
    }

    pub fn compare_gpu(&self, gpu: &Tensor<f32>) -> Result<(), NumericError> {
        if self.expected.shape() != gpu.shape() {
            return Err(NumericError::InvalidInput {
                node: 0,
                reason: "GPU output shape differs from dyadic RNE reference",
            });
        }
        for (index, (&target, &actual)) in
            self.expected.values().iter().zip(gpu.values()).enumerate()
        {
            if target.to_bits() != actual.to_bits() {
                return Err(NumericError::OutputBits {
                    index,
                    expected: target.to_bits(),
                    actual: actual.to_bits(),
                });
            }
        }
        Ok(())
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct RneErrorContract {
    ideal_bound_ticks: i64,
    epsilon_ticks: i64,
    actual_bound_ticks: i64,
    fraction_bits: u32,
}

impl RneErrorContract {
    pub fn ideal_bound_ticks(self) -> i64 {
        self.ideal_bound_ticks
    }

    pub fn epsilon_ticks(self) -> i64 {
        self.epsilon_ticks
    }

    pub fn actual_bound_ticks(self) -> i64 {
        self.actual_bound_ticks
    }

    pub fn fraction_bits(self) -> u32 {
        self.fraction_bits
    }

    pub fn epsilon(self) -> f64 {
        self.epsilon_ticks as f64 / (1u64 << self.fraction_bits) as f64
    }
}

/// Conditional ReLU branch in the ideal integer model, not an assertion that
/// CUDA/LLVM/PTX followed the source-level dyadic RNE contract.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum RneThresholdSide {
    Positive,
    NonPositive,
    Indeterminate,
}

/// A pre-ReLU observation and the interval enclosing its ideal counterpart
/// if the per-node ApproxContract hypothesis holds.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct RneThresholdEvidence {
    relu: NodeId,
    input: NodeId,
    fraction_bits: u32,
    observed_ticks: i64,
    epsilon_ticks: i64,
    ideal_lower_ticks: i128,
    ideal_upper_ticks: i128,
    side: RneThresholdSide,
}

impl RneThresholdEvidence {
    pub fn relu(&self) -> NodeId {
        self.relu
    }

    pub fn input(&self) -> NodeId {
        self.input
    }

    pub fn fraction_bits(&self) -> u32 {
        self.fraction_bits
    }

    pub fn observed_ticks(&self) -> i64 {
        self.observed_ticks
    }

    pub fn epsilon_ticks(&self) -> i64 {
        self.epsilon_ticks
    }

    pub fn ideal_interval_ticks(&self) -> (i128, i128) {
        (self.ideal_lower_ticks, self.ideal_upper_ticks)
    }

    pub fn side(&self) -> RneThresholdSide {
        self.side
    }
}

/// Generic strict-positive condition classification for a reachable numeric
/// node. This is reusable by ReLU and by PositiveMask → SelectPositive.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct RneConditionEvidence {
    condition: NodeId,
    fraction_bits: u32,
    observed_ticks: i64,
    epsilon_ticks: i64,
    ideal_lower_ticks: i128,
    ideal_upper_ticks: i128,
    side: RneThresholdSide,
}

impl RneConditionEvidence {
    pub fn condition(&self) -> NodeId {
        self.condition
    }

    pub fn fraction_bits(&self) -> u32 {
        self.fraction_bits
    }

    pub fn observed_ticks(&self) -> i64 {
        self.observed_ticks
    }

    pub fn epsilon_ticks(&self) -> i64 {
        self.epsilon_ticks
    }

    pub fn ideal_interval_ticks(&self) -> (i128, i128) {
        (self.ideal_lower_ticks, self.ideal_upper_ticks)
    }

    pub fn side(&self) -> RneThresholdSide {
        self.side
    }
}

/// Conditional numerical evidence for the canonical
/// PositiveMask(condition) → SelectPositive(mask, yes, no) pattern.
/// An indeterminate condition deliberately has no selected contract.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct RneSelectEvidence {
    select: NodeId,
    condition: NodeId,
    selected: Option<NodeId>,
    condition_evidence: RneConditionEvidence,
    contract: Option<RneErrorContract>,
}

impl RneSelectEvidence {
    pub fn select(&self) -> NodeId {
        self.select
    }

    pub fn condition(&self) -> NodeId {
        self.condition
    }

    pub fn side(&self) -> RneThresholdSide {
        self.condition_evidence.side()
    }

    pub fn condition_evidence(&self) -> RneConditionEvidence {
        self.condition_evidence
    }

    pub fn selected(&self) -> Option<NodeId> {
        self.selected
    }

    pub fn contract(&self) -> Option<RneErrorContract> {
        self.contract
    }
}

/// P1 branch-composition slice. It does not pretend PositiveMask/SelectPositive
/// are ordinary RNE arithmetic nodes. Instead it proves a conditional rule:
/// once the condition interval lies strictly on one side of zero, the select
/// inherits exactly the already-proved error contract of that branch.
#[derive(Clone, Debug)]
pub struct RneSelectPlan {
    select: NodeId,
    condition: NodeId,
    yes: NodeId,
    no: NodeId,
    condition_plan: RneRangePlan,
    yes_plan: RneRangePlan,
    no_plan: RneRangePlan,
}

/// One fixed recurrent step in the numerical contract rollout.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct RneStateStepContract {
    step: usize,
    input_state: RneErrorContract,
    output_state: RneErrorContract,
}

impl RneStateStepContract {
    pub fn step(&self) -> usize {
        self.step
    }

    pub fn input_state(&self) -> RneErrorContract {
        self.input_state
    }

    pub fn output_state(&self) -> RneErrorContract {
        self.output_state
    }
}

/// Fixed-horizon recurrent numerical composition for one explicit state input.
/// Fresh non-state sources are exact dyadic inputs at every step. The feedback
/// state carries the previous step's epsilon and bound. This deliberately
/// requires an invariant q scale; transitions that change the state lattice
/// fail closed instead of silently rescaling temporal state.
#[derive(Clone, Debug)]
pub struct RneStateRolloutPlan {
    state: NodeId,
    next_state: NodeId,
    initial_state: RneErrorContract,
    steps: Vec<RneStateStepContract>,
    plans: Vec<RneRangePlan>,
}

impl RneStateRolloutPlan {
    pub fn compile_fixed(
        graph: &NeuralGraph,
        state: NodeId,
        next_state: NodeId,
        source_fraction_bits: u32,
        source_bound_ticks: i64,
        horizon: usize,
    ) -> Result<Self, NumericError> {
        let state_node = graph.node(state)?;
        let next_node = graph.node(next_state)?;
        if !matches!(state_node.operation, Operation::Input) {
            return Err(NumericError::InvalidInput {
                node: state.index(),
                reason: "RNE recurrent state must be an Input node",
            });
        }
        if state_node.shape != next_node.shape || state_node.dtype != next_node.dtype {
            return Err(NumericError::InvalidInput {
                node: next_state.index(),
                reason: "RNE recurrent next_state must preserve state shape and dtype",
            });
        }

        let initial_state =
            RneRangePlan::compile(graph, state, source_fraction_bits, source_bound_ticks)?
                .output_contract();
        let mut input_state = initial_state;
        let mut steps = Vec::with_capacity(horizon);
        let mut plans = Vec::with_capacity(horizon);

        for step in 0..horizon {
            let plan = RneRangePlan::compile_with_source_contracts(
                graph,
                next_state,
                source_fraction_bits,
                source_bound_ticks,
                &[(state, input_state)],
            )?;
            let output_state = plan.output_contract();
            if output_state.fraction_bits != source_fraction_bits {
                return Err(NumericError::InvalidInput {
                    node: next_state.index(),
                    reason: "RNE recurrent feedback changes the state q scale",
                });
            }
            steps.push(RneStateStepContract {
                step,
                input_state,
                output_state,
            });
            input_state = output_state;
            plans.push(plan);
        }

        Ok(Self {
            state,
            next_state,
            initial_state,
            steps,
            plans,
        })
    }

    pub fn state(&self) -> NodeId {
        self.state
    }

    pub fn next_state(&self) -> NodeId {
        self.next_state
    }

    pub fn initial_contract(&self) -> RneErrorContract {
        self.initial_state
    }

    pub fn steps(&self) -> &[RneStateStepContract] {
        &self.steps
    }

    pub fn final_contract(&self) -> RneErrorContract {
        self.steps
            .last()
            .map(RneStateStepContract::output_state)
            .unwrap_or(self.initial_state)
    }

    pub fn step_plan(&self, step: usize) -> Option<&RneRangePlan> {
        self.plans.get(step)
    }

    /// Each source is a standalone Lean program for one conditional step.
    /// The Rust rollout guarantees adjacent numeric contracts match exactly;
    /// arbitrary-horizon induction is intentionally not claimed here.
    pub fn lean_sources(&self) -> Result<Vec<String>, NumericError> {
        self.plans.iter().map(RneRangePlan::lean_source).collect()
    }
}

impl RneSelectPlan {
    pub fn compile(
        graph: &NeuralGraph,
        select: NodeId,
        source_fraction_bits: u32,
        source_bound_ticks: i64,
    ) -> Result<Self, NumericError> {
        let select_node = graph.node(select)?;
        if !matches!(select_node.operation, Operation::SelectPositive) {
            return Err(NumericError::InvalidInput {
                node: select.index(),
                reason: "RNE select plan requires a SelectPositive node",
            });
        }
        let mask = select_node.inputs[0];
        let mask_node = graph.node(mask)?;
        if !matches!(mask_node.operation, Operation::PositiveMask) {
            return Err(NumericError::InvalidInput {
                node: mask.index(),
                reason: "RNE select plan currently requires a direct PositiveMask producer",
            });
        }
        let condition = mask_node.inputs[0];
        let yes = select_node.inputs[1];
        let no = select_node.inputs[2];

        Ok(Self {
            select,
            condition,
            yes,
            no,
            condition_plan: RneRangePlan::compile(
                graph,
                condition,
                source_fraction_bits,
                source_bound_ticks,
            )?,
            yes_plan: RneRangePlan::compile(graph, yes, source_fraction_bits, source_bound_ticks)?,
            no_plan: RneRangePlan::compile(graph, no, source_fraction_bits, source_bound_ticks)?,
        })
    }

    pub fn select(&self) -> NodeId {
        self.select
    }

    pub fn condition(&self) -> NodeId {
        self.condition
    }

    pub fn yes(&self) -> NodeId {
        self.yes
    }

    pub fn no(&self) -> NodeId {
        self.no
    }

    pub fn condition_plan(&self) -> &RneRangePlan {
        &self.condition_plan
    }

    pub fn yes_plan(&self) -> &RneRangePlan {
        &self.yes_plan
    }

    pub fn no_plan(&self) -> &RneRangePlan {
        &self.no_plan
    }

    pub fn classify(&self, observed_condition: f32) -> Result<RneSelectEvidence, NumericError> {
        let condition_evidence = self
            .condition_plan
            .classify_condition(self.condition, observed_condition)?;
        let (selected, contract) = match condition_evidence.side() {
            RneThresholdSide::Positive => (Some(self.yes), Some(self.yes_plan.output_contract())),
            RneThresholdSide::NonPositive => (Some(self.no), Some(self.no_plan.output_contract())),
            RneThresholdSide::Indeterminate => (None, None),
        };
        Ok(RneSelectEvidence {
            select: self.select,
            condition: self.condition,
            selected,
            condition_evidence,
            contract,
        })
    }

    pub fn stable_contract(
        &self,
        observed_condition: f32,
    ) -> Result<RneErrorContract, NumericError> {
        let evidence = self.classify(observed_condition)?;
        evidence.contract().ok_or_else(|| {
            let (lower_ticks, upper_ticks) = evidence.condition_evidence().ideal_interval_ticks();
            NumericError::UnstableBranch {
                node: self.select.index(),
                lower_ticks,
                upper_ticks,
            }
        })
    }

    /// Generate the conditional Lean composition theorem for one observed
    /// condition. The theorem assumes the condition ApproxContract and the
    /// selected branch ApproxContract; the opposite branch is intentionally
    /// irrelevant. Indeterminate observations fail closed before generation.
    pub fn lean_program(&self, observed_condition: f32) -> Result<LeanProgram, NumericError> {
        let evidence = self.classify(observed_condition)?;
        let selected = evidence.contract().ok_or_else(|| {
            let (lower_ticks, upper_ticks) = evidence.condition_evidence().ideal_interval_ticks();
            NumericError::UnstableBranch {
                node: self.select.index(),
                lower_ticks,
                upper_ticks,
            }
        })?;
        let condition = self.condition_plan.output_contract();
        let observed_ticks = evidence.condition_evidence().observed_ticks();
        let theorem = match evidence.side() {
            RneThresholdSide::Positive => format!("select_{}_stable_positive", self.select.index()),
            RneThresholdSide::NonPositive => {
                format!("select_{}_stable_nonpositive", self.select.index())
            }
            RneThresholdSide::Indeterminate => unreachable!("handled above"),
        };
        let lemma = match evidence.side() {
            RneThresholdSide::Positive => {
                "VeriNeural.approx_contract_positive_mask_select_positive"
            }
            RneThresholdSide::NonPositive => {
                "VeriNeural.approx_contract_positive_mask_select_nonpositive"
            }
            RneThresholdSide::Indeterminate => unreachable!("handled above"),
        };
        let margin = match evidence.side() {
            RneThresholdSide::Positive => {
                format!("{} < ({observed_ticks} : Int)", condition.epsilon_ticks)
            }
            RneThresholdSide::NonPositive => {
                format!("({observed_ticks} : Int) + {} ≤ 0", condition.epsilon_ticks)
            }
            RneThresholdSide::Indeterminate => unreachable!("handled above"),
        };
        let source = format!(
            "{BASIC_LIBRARY}\n\n{MEMORY_LIBRARY}\n\n{NUMERIC_LIBRARY}\n\nnamespace VeriNeural.Generated\n\n             theorem {theorem}\n                 {{idealCondition selectedIdeal selectedActual otherIdeal otherActual : Int}}\n                 (hcondition : VeriNeural.ApproxContract {} {} idealCondition ({observed_ticks} : Int))\n                 (hselected : VeriNeural.ApproxContract {} {} selectedIdeal selectedActual) :\n                 VeriNeural.ApproxContract {} {}\n                   (if 0 < (if 0 < idealCondition then 1 else 0) then {} else {})\n                   (if 0 < (if 0 < ({observed_ticks} : Int) then 1 else 0) then {} else {}) := by\n               have hmargin : {margin} := by decide\n               exact {} hcondition hmargin hselected\n\nend VeriNeural.Generated\n",
            condition.ideal_bound_ticks,
            condition.epsilon_ticks,
            selected.ideal_bound_ticks,
            selected.epsilon_ticks,
            selected.ideal_bound_ticks,
            selected.epsilon_ticks,
            if matches!(evidence.side(), RneThresholdSide::Positive) {
                "selectedIdeal"
            } else {
                "otherIdeal"
            },
            if matches!(evidence.side(), RneThresholdSide::Positive) {
                "otherIdeal"
            } else {
                "selectedIdeal"
            },
            if matches!(evidence.side(), RneThresholdSide::Positive) {
                "selectedActual"
            } else {
                "otherActual"
            },
            if matches!(evidence.side(), RneThresholdSide::Positive) {
                "otherActual"
            } else {
                "selectedActual"
            },
            lemma,
        );
        Ok(LeanProgram::generated(source, vec![theorem], Vec::new()))
    }
}

#[derive(Clone, Debug)]
pub struct RneModuleErrorContract {
    name: &'static str,
    inputs: Vec<(NodeId, RneErrorContract)>,
    output: NodeId,
    contract: RneErrorContract,
}

impl RneModuleErrorContract {
    pub fn name(&self) -> &'static str {
        self.name
    }

    pub fn inputs(&self) -> &[(NodeId, RneErrorContract)] {
        &self.inputs
    }

    pub fn output(&self) -> NodeId {
        self.output
    }

    pub fn contract(&self) -> RneErrorContract {
        self.contract
    }
}

#[derive(Clone, Debug)]
enum RneRangeRule {
    Input,
    Add {
        left_shift: u32,
        right_shift: u32,
        max_shift: u32,
    },
    Mul {
        max_shift: u32,
    },
    MatMul {
        product: RneErrorContract,
        product_max_shift: u32,
        sums: Vec<(RneErrorContract, u32)>,
    },
    BiasAdd {
        left_shift: u32,
        right_shift: u32,
        max_shift: u32,
    },
    Relu,
    Reshape,
}

#[derive(Clone, Debug)]
struct RneGlobalElement {
    ideal: String,
    actual: String,
    proof: String,
}

#[derive(Clone, Debug)]
struct RneArchitectureStep {
    module_index: usize,
    args: Vec<String>,
    output_proofs: Vec<String>,
}

#[derive(Clone, Debug)]
pub struct RneRangePlan {
    graph: NeuralGraph,
    output: NodeId,
    reachable: Vec<usize>,
    inputs: Vec<NodeId>,
    source_fraction_bits: u32,
    source_bound_ticks: i64,
    contracts: BTreeMap<usize, RneErrorContract>,
    rules: BTreeMap<usize, RneRangeRule>,
}

impl RneRangePlan {
    /// Build a reusable worst-case dyadic RNE contract for all values satisfying
    /// the source tick bound. The theorem is conditional on the same
    /// Binary32RneTick relation as concrete traces; LLVM/PTX/GPU conformance
    /// remains outside the formal boundary.
    pub fn compile(
        graph: &NeuralGraph,
        output: NodeId,
        source_fraction_bits: u32,
        source_bound_ticks: i64,
    ) -> Result<Self, NumericError> {
        Self::compile_with_source_contracts(
            graph,
            output,
            source_fraction_bits,
            source_bound_ticks,
            &[],
        )
    }

    /// Compile the same range plan while replacing selected reachable Input
    /// nodes with already-established ApproxContracts. This is the primitive
    /// needed for recurrent error composition: a previous next_state contract
    /// becomes the current state source contract, while all other sources keep
    /// the exact default bound for this step.
    pub fn compile_with_source_contracts(
        graph: &NeuralGraph,
        output: NodeId,
        source_fraction_bits: u32,
        source_bound_ticks: i64,
        source_contracts: &[(NodeId, RneErrorContract)],
    ) -> Result<Self, NumericError> {
        if source_bound_ticks < 0 {
            return Err(NumericError::InvalidInput {
                node: output.index(),
                reason: "RNE range source bound must be nonnegative",
            });
        }
        let base = RneFp32Plan::compile(graph, output, source_fraction_bits)?;
        let mut overrides = BTreeMap::<usize, RneErrorContract>::new();
        for &(source, contract) in source_contracts {
            let node = graph.node(source)?;
            if !matches!(node.operation, Operation::Input) || !base.inputs.contains(&source) {
                return Err(NumericError::InvalidInput {
                    node: source.index(),
                    reason: "RNE source override must name a reachable Input",
                });
            }
            if contract.fraction_bits != source_fraction_bits {
                return Err(NumericError::InvalidInput {
                    node: source.index(),
                    reason: "RNE source override must use the plan source q scale",
                });
            }
            let expected_actual = contract
                .ideal_bound_ticks
                .checked_add(contract.epsilon_ticks)
                .ok_or(NumericError::InvalidInput {
                    node: source.index(),
                    reason: "RNE source override bound overflow",
                })?;
            if contract.ideal_bound_ticks < 0
                || contract.epsilon_ticks < 0
                || contract.actual_bound_ticks != expected_actual
            {
                return Err(NumericError::InvalidInput {
                    node: source.index(),
                    reason: "RNE source override is not a well-formed ApproxContract bound",
                });
            }
            if overrides.insert(source.index(), contract).is_some() {
                return Err(NumericError::InvalidInput {
                    node: source.index(),
                    reason: "duplicate RNE source override",
                });
            }
        }

        let mut contracts = BTreeMap::<usize, RneErrorContract>::new();
        let mut rules = BTreeMap::<usize, RneRangeRule>::new();

        for &index in &base.reachable {
            let node = &graph.nodes()[index];
            let source_contract = || -> Result<RneErrorContract, NumericError> {
                Self::contract(
                    index,
                    source_bound_ticks,
                    0,
                    base.scales[&index],
                    "RNE source contract overflow",
                )
            };
            let trace = match node.operation {
                Operation::Input => {
                    rules.insert(index, RneRangeRule::Input);
                    overrides
                        .get(&index)
                        .copied()
                        .map(Ok)
                        .unwrap_or_else(source_contract)?
                }
                Operation::Add | Operation::BiasAdd => {
                    let left = contracts[&node.inputs[0].index()];
                    let right = contracts[&node.inputs[1].index()];
                    let (contract, left_shift, right_shift, max_shift) =
                        Self::add_contract(index, left, right)?;
                    let rule = if matches!(node.operation, Operation::BiasAdd) {
                        RneRangeRule::BiasAdd {
                            left_shift,
                            right_shift,
                            max_shift,
                        }
                    } else {
                        RneRangeRule::Add {
                            left_shift,
                            right_shift,
                            max_shift,
                        }
                    };
                    rules.insert(index, rule);
                    contract
                }
                Operation::Mul => {
                    let left = contracts[&node.inputs[0].index()];
                    let right = contracts[&node.inputs[1].index()];
                    let (contract, max_shift) = Self::mul_contract(index, left, right)?;
                    rules.insert(index, RneRangeRule::Mul { max_shift });
                    contract
                }
                Operation::MatMul => {
                    let left = contracts[&node.inputs[0].index()];
                    let right = contracts[&node.inputs[1].index()];
                    let (product, product_max_shift) = Self::mul_contract(index, left, right)?;
                    let inner = graph.nodes()[node.inputs[0].index()].shape.dims()[1];
                    let mut accumulator = Self::contract(
                        index,
                        0,
                        0,
                        product.fraction_bits,
                        "RNE MatMul zero contract",
                    )?;
                    let mut sums = Vec::with_capacity(inner);
                    for _ in 0..inner {
                        let (next, left_shift, right_shift, max_shift) =
                            Self::add_contract(index, accumulator, product)?;
                        debug_assert_eq!(left_shift, 0);
                        debug_assert_eq!(right_shift, 0);
                        sums.push((next, max_shift));
                        accumulator = next;
                    }
                    rules.insert(
                        index,
                        RneRangeRule::MatMul {
                            product,
                            product_max_shift,
                            sums,
                        },
                    );
                    accumulator
                }
                Operation::Relu => {
                    let contract = contracts[&node.inputs[0].index()];
                    rules.insert(index, RneRangeRule::Relu);
                    contract
                }
                Operation::Reshape(_) => {
                    let contract = contracts[&node.inputs[0].index()];
                    rules.insert(index, RneRangeRule::Reshape);
                    contract
                }
                _ => unreachable!("RneFp32Plan rejected unsupported range operation"),
            };
            if trace.fraction_bits != base.scales[&index] {
                return Err(NumericError::InvalidInput {
                    node: index,
                    reason: "RNE range contract scale disagrees with trace plan",
                });
            }
            contracts.insert(index, trace);
        }

        Ok(Self {
            graph: graph.clone(),
            output,
            reachable: base.reachable,
            inputs: base.inputs,
            source_fraction_bits,
            source_bound_ticks,
            contracts,
            rules,
        })
    }

    fn contract(
        node: usize,
        ideal_bound_ticks: i64,
        epsilon_ticks: i64,
        fraction_bits: u32,
        reason: &'static str,
    ) -> Result<RneErrorContract, NumericError> {
        if ideal_bound_ticks < 0 || epsilon_ticks < 0 {
            return Err(NumericError::InvalidInput { node, reason });
        }
        let actual_bound_ticks = ideal_bound_ticks
            .checked_add(epsilon_ticks)
            .ok_or(NumericError::InvalidInput { node, reason })?;
        Ok(RneErrorContract {
            ideal_bound_ticks,
            epsilon_ticks,
            actual_bound_ticks,
            fraction_bits,
        })
    }

    fn scale_contract(
        node: usize,
        contract: RneErrorContract,
        target_fraction_bits: u32,
    ) -> Result<(RneErrorContract, u32), NumericError> {
        let shift = target_fraction_bits
            .checked_sub(contract.fraction_bits)
            .ok_or(NumericError::InvalidInput {
                node,
                reason: "RNE range contract cannot scale to a coarser lattice",
            })?;
        let factor = binary32_step_i64(shift).ok_or(NumericError::InvalidInput {
            node,
            reason: "RNE range scale factor overflow",
        })?;
        let ideal_bound_ticks =
            contract
                .ideal_bound_ticks
                .checked_mul(factor)
                .ok_or(NumericError::InvalidInput {
                    node,
                    reason: "RNE range ideal-bound rescale overflow",
                })?;
        let epsilon_ticks =
            contract
                .epsilon_ticks
                .checked_mul(factor)
                .ok_or(NumericError::InvalidInput {
                    node,
                    reason: "RNE range epsilon rescale overflow",
                })?;
        Ok((
            Self::contract(
                node,
                ideal_bound_ticks,
                epsilon_ticks,
                target_fraction_bits,
                "RNE range scaled contract overflow",
            )?,
            shift,
        ))
    }

    fn round_budget(node: usize, pre_round_bound: i64) -> Result<(u32, i64), NumericError> {
        if pre_round_bound < 0 {
            return Err(NumericError::InvalidInput {
                node,
                reason: "RNE range pre-round bound must be nonnegative",
            });
        }
        let magnitude = pre_round_bound as u64;
        let bit_len = if magnitude == 0 {
            0
        } else {
            64 - magnitude.leading_zeros()
        };
        let max_shift = bit_len.saturating_sub(24);
        let step = binary32_step_i64(max_shift).ok_or(NumericError::InvalidInput {
            node,
            reason: "RNE range ULP budget overflow",
        })?;
        let limit =
            8_388_608i128
                .checked_mul(1i128.checked_shl(max_shift + 1).ok_or(
                    NumericError::InvalidInput {
                        node,
                        reason: "RNE range shift limit overflow",
                    },
                )?)
                .ok_or(NumericError::InvalidInput {
                    node,
                    reason: "RNE range shift limit overflow",
                })?;
        if i128::from(pre_round_bound) >= limit {
            return Err(NumericError::InvalidInput {
                node,
                reason: "RNE range shift bound is inconsistent",
            });
        }
        Ok((max_shift, step))
    }

    fn add_contract(
        node: usize,
        left: RneErrorContract,
        right: RneErrorContract,
    ) -> Result<(RneErrorContract, u32, u32, u32), NumericError> {
        let fraction_bits = left.fraction_bits.max(right.fraction_bits);
        let (left, left_shift) = Self::scale_contract(node, left, fraction_bits)?;
        let (right, right_shift) = Self::scale_contract(node, right, fraction_bits)?;
        let ideal_bound_ticks = left
            .ideal_bound_ticks
            .checked_add(right.ideal_bound_ticks)
            .ok_or(NumericError::InvalidInput {
                node,
                reason: "RNE range addition ideal bound overflow",
            })?;
        let pre_round_bound = left
            .actual_bound_ticks
            .checked_add(right.actual_bound_ticks)
            .ok_or(NumericError::InvalidInput {
                node,
                reason: "RNE range addition actual bound overflow",
            })?;
        let (max_shift, round_budget) = Self::round_budget(node, pre_round_bound)?;
        let epsilon_ticks = left
            .epsilon_ticks
            .checked_add(right.epsilon_ticks)
            .and_then(|value| value.checked_add(round_budget))
            .ok_or(NumericError::InvalidInput {
                node,
                reason: "RNE range addition epsilon overflow",
            })?;
        Ok((
            Self::contract(
                node,
                ideal_bound_ticks,
                epsilon_ticks,
                fraction_bits,
                "RNE range addition contract overflow",
            )?,
            left_shift,
            right_shift,
            max_shift,
        ))
    }

    fn mul_contract(
        node: usize,
        left: RneErrorContract,
        right: RneErrorContract,
    ) -> Result<(RneErrorContract, u32), NumericError> {
        let fraction_bits = left.fraction_bits.checked_add(right.fraction_bits).ok_or(
            NumericError::InvalidInput {
                node,
                reason: "RNE range product fractional-width overflow",
            },
        )?;
        if fraction_bits > 60 {
            return Err(NumericError::InvalidInput {
                node,
                reason: "RNE range product lattice exceeds 60 fractional bits",
            });
        }
        let ideal_bound_ticks = left
            .ideal_bound_ticks
            .checked_mul(right.ideal_bound_ticks)
            .ok_or(NumericError::InvalidInput {
                node,
                reason: "RNE range product ideal bound overflow",
            })?;
        let pre_round_bound = left
            .actual_bound_ticks
            .checked_mul(right.actual_bound_ticks)
            .ok_or(NumericError::InvalidInput {
                node,
                reason: "RNE range product actual bound overflow",
            })?;
        let (max_shift, round_budget) = Self::round_budget(node, pre_round_bound)?;
        let propagated_left = left
            .epsilon_ticks
            .checked_mul(right.actual_bound_ticks)
            .ok_or(NumericError::InvalidInput {
                node,
                reason: "RNE range product propagated error overflow",
            })?;
        let propagated_right = left
            .ideal_bound_ticks
            .checked_mul(right.epsilon_ticks)
            .ok_or(NumericError::InvalidInput {
                node,
                reason: "RNE range product propagated error overflow",
            })?;
        let epsilon_ticks = propagated_left
            .checked_add(propagated_right)
            .and_then(|value| value.checked_add(round_budget))
            .ok_or(NumericError::InvalidInput {
                node,
                reason: "RNE range product epsilon overflow",
            })?;
        Ok((
            Self::contract(
                node,
                ideal_bound_ticks,
                epsilon_ticks,
                fraction_bits,
                "RNE range product contract overflow",
            )?,
            max_shift,
        ))
    }

    pub fn source_fraction_bits(&self) -> u32 {
        self.source_fraction_bits
    }

    pub fn source_bound_ticks(&self) -> i64 {
        self.source_bound_ticks
    }

    pub fn source_inputs(&self) -> &[NodeId] {
        &self.inputs
    }

    pub fn output_contract(&self) -> RneErrorContract {
        self.contracts[&self.output.index()]
    }

    pub fn node_contract(&self, node: NodeId) -> Result<RneErrorContract, NumericError> {
        self.graph.node(node)?;
        self.contracts
            .get(&node.index())
            .copied()
            .ok_or(NumericError::InvalidInput {
                node: node.index(),
                reason: "node is outside this RNE range output slice",
            })
    }

    /// Classify any reachable numeric condition against strict zero.
    /// This is a conditional source-level result under the node ApproxContract.
    pub fn classify_condition(
        &self,
        condition: NodeId,
        observed: f32,
    ) -> Result<RneConditionEvidence, NumericError> {
        let contract = self.node_contract(condition)?;
        let observed_ticks =
            f32_to_dyadic_ticks(observed, contract.fraction_bits).map_err(|reason| {
                NumericError::InvalidInput {
                    node: condition.index(),
                    reason,
                }
            })?;
        if observed_ticks.unsigned_abs() > contract.actual_bound_ticks as u64 {
            return Err(NumericError::InvalidInput {
                node: condition.index(),
                reason: "condition observation exceeds the node actual range bound",
            });
        }
        // i128 avoids signed overflow even near the maximum supported i64.
        let epsilon = i128::from(contract.epsilon_ticks);
        let actual = i128::from(observed_ticks);
        let ideal_lower_ticks = actual - epsilon;
        let ideal_upper_ticks = actual + epsilon;
        let side = if ideal_lower_ticks > 0 {
            RneThresholdSide::Positive
        } else if ideal_upper_ticks <= 0 {
            RneThresholdSide::NonPositive
        } else {
            RneThresholdSide::Indeterminate
        };
        Ok(RneConditionEvidence {
            condition,
            fraction_bits: contract.fraction_bits,
            observed_ticks,
            epsilon_ticks: contract.epsilon_ticks,
            ideal_lower_ticks,
            ideal_upper_ticks,
            side,
        })
    }

    /// Backwards-compatible ReLU-specific view over generic condition evidence.
    pub fn classify_relu_input(
        &self,
        relu: NodeId,
        observed: f32,
    ) -> Result<RneThresholdEvidence, NumericError> {
        let node = self.graph.node(relu)?;
        if !matches!(node.operation, Operation::Relu) || !self.contracts.contains_key(&relu.index())
        {
            return Err(NumericError::InvalidInput {
                node: relu.index(),
                reason: "threshold target must be a reachable ReLU",
            });
        }
        let input = node.inputs[0];
        let evidence = self.classify_condition(input, observed)?;
        let (ideal_lower_ticks, ideal_upper_ticks) = evidence.ideal_interval_ticks();
        Ok(RneThresholdEvidence {
            relu,
            input,
            fraction_bits: evidence.fraction_bits(),
            observed_ticks: evidence.observed_ticks(),
            epsilon_ticks: evidence.epsilon_ticks(),
            ideal_lower_ticks,
            ideal_upper_ticks,
            side: evidence.side(),
        })
    }

    pub fn module_contracts(&self) -> Vec<RneModuleErrorContract> {
        self.graph
            .modules()
            .iter()
            .filter_map(|module| {
                let contract = self.contracts.get(&module.output.index()).copied()?;
                let inputs = module
                    .inputs
                    .iter()
                    .filter_map(|&node| {
                        self.contracts
                            .get(&node.index())
                            .copied()
                            .map(|contract| (node, contract))
                    })
                    .collect::<Vec<_>>();
                (inputs.len() == module.inputs.len()).then_some(RneModuleErrorContract {
                    name: module.name,
                    inputs,
                    output: module.output,
                    contract,
                })
            })
            .collect()
    }

    fn module_in_slice(&self, module: &ModuleInvocation) -> bool {
        self.contracts.contains_key(&module.output.index())
            && module
                .inputs
                .iter()
                .all(|input| self.contracts.contains_key(&input.index()))
    }

    fn module_contains(&self, parent_index: usize, child_index: usize) -> bool {
        if child_index >= parent_index {
            return false;
        }
        let modules = self.graph.modules();
        let parent = &modules[parent_index];
        let child = &modules[child_index];
        self.module_in_slice(parent)
            && self.module_in_slice(child)
            && child.body_start >= parent.body_start
            && child.body_end <= parent.body_end
    }

    fn direct_nested_module_indices(
        &self,
        parent_index: usize,
    ) -> Result<Vec<usize>, NumericError> {
        let modules = self.graph.modules();
        let parent = &modules[parent_index];
        let parent_internal = self
            .module_internal_nodes(parent)?
            .into_iter()
            .collect::<BTreeSet<_>>();
        let nested = (0..parent_index)
            .filter(|&child_index| {
                self.module_contains(parent_index, child_index)
                    && parent_internal.contains(&modules[child_index].output.index())
            })
            .collect::<Vec<_>>();

        Ok(nested
            .iter()
            .copied()
            .filter(|&child_index| {
                !nested.iter().copied().any(|container_index| {
                    container_index != child_index
                        && self.module_contains(container_index, child_index)
                })
            })
            .collect())
    }

    fn architecture_module_indices(&self) -> Result<Option<Vec<usize>>, NumericError> {
        let modules = self.graph.modules();
        let eligible = modules
            .iter()
            .enumerate()
            .filter_map(|(index, module)| self.module_in_slice(module).then_some(index))
            .collect::<Vec<_>>();
        let top_level = eligible
            .iter()
            .copied()
            .filter(|&child_index| {
                !eligible
                    .iter()
                    .copied()
                    .any(|parent_index| self.module_contains(parent_index, child_index))
            })
            .collect::<Vec<_>>();

        let mut producers = BTreeMap::<usize, usize>::new();
        for module_index in top_level {
            let output = modules[module_index].output.index();
            if producers.insert(output, module_index).is_some() {
                return Err(NumericError::InvalidInput {
                    node: output,
                    reason: "architecture range proof has multiple top-level module producers",
                });
            }
        }
        let Some(&final_module) = producers.get(&self.output.index()) else {
            return Ok(None);
        };

        let source_inputs = self
            .inputs
            .iter()
            .map(|input| input.index())
            .collect::<BTreeSet<_>>();
        let mut selected = BTreeSet::new();
        let mut stack = vec![final_module];
        while let Some(module_index) = stack.pop() {
            if !selected.insert(module_index) {
                continue;
            }
            let module = &modules[module_index];
            for input in &module.inputs {
                if source_inputs.contains(&input.index()) {
                    continue;
                }
                let Some(&producer_index) = producers.get(&input.index()) else {
                    return Ok(None);
                };
                if producer_index >= module_index {
                    return Err(NumericError::InvalidInput {
                        node: input.index(),
                        reason: "architecture module dependency is not topologically ordered",
                    });
                }
                stack.push(producer_index);
            }
        }

        if selected.len() < 2 {
            return Ok(None);
        }
        Ok(Some(selected.into_iter().collect()))
    }

    fn module_internal_nodes(&self, module: &ModuleInvocation) -> Result<Vec<usize>, NumericError> {
        let boundary = module
            .inputs
            .iter()
            .map(|node| node.index())
            .collect::<BTreeSet<_>>();
        let mut stack = vec![module.output.index()];
        let mut internal = BTreeSet::new();

        while let Some(index) = stack.pop() {
            if boundary.contains(&index) {
                continue;
            }
            if !self.contracts.contains_key(&index) {
                return Err(NumericError::InvalidInput {
                    node: index,
                    reason: "module global range proof leaves the compiled output slice",
                });
            }
            if index < module.body_start || index >= module.body_end {
                return Err(NumericError::InvalidInput {
                    node: index,
                    reason: "module global range proof leaves the declared module body",
                });
            }
            let node = &self.graph.nodes()[index];
            if matches!(node.operation, Operation::Input) {
                return Err(NumericError::InvalidInput {
                    node: index,
                    reason: "module global range proof reaches an undeclared input",
                });
            }
            if internal.insert(index) {
                stack.extend(node.inputs.iter().map(|input| input.index()));
            }
        }

        Ok(internal.into_iter().collect())
    }

    fn global_element(
        elements: &BTreeMap<(usize, usize), RneGlobalElement>,
        node: NodeId,
        element: usize,
    ) -> Result<RneGlobalElement, NumericError> {
        elements
            .get(&(node.index(), element))
            .cloned()
            .ok_or(NumericError::InvalidInput {
                node: node.index(),
                reason: "module global range proof is missing an element dependency",
            })
    }

    fn lean_conjunction(items: &[String]) -> String {
        match items {
            [] => "True".to_owned(),
            [one] => one.clone(),
            [first, rest @ ..] => {
                format!("{first} /\\ ({})", Self::lean_conjunction(rest))
            }
        }
    }

    fn lean_conjunction_proof(items: &[String]) -> String {
        match items {
            [] => "True.intro".to_owned(),
            [one] => one.clone(),
            [first, rest @ ..] => {
                format!("⟨{first}, {}⟩", Self::lean_conjunction_proof(rest))
            }
        }
    }

    fn module_global_source(
        &self,
        module_index: usize,
        module: &ModuleInvocation,
    ) -> Result<String, NumericError> {
        let internal = self.module_internal_nodes(module)?;
        let nested_modules = self.direct_nested_module_indices(module_index)?;
        let mut nested_by_output = BTreeMap::<usize, usize>::new();
        let mut nested_internal = BTreeSet::new();
        for &nested_index in &nested_modules {
            let nested = &self.graph.modules()[nested_index];
            if nested_by_output
                .insert(nested.output.index(), nested_index)
                .is_some()
            {
                return Err(NumericError::InvalidInput {
                    node: nested.output.index(),
                    reason: "module range proof has ambiguous nested module output",
                });
            }
            nested_internal.extend(self.module_internal_nodes(nested)?);
        }
        let mut source = format!(
            "-- Whole-module numerical composition for {}. Every output element\n\
             -- is derived from declared module-input contracts and explicit RNE witnesses.\n\
             -- Direct nested modules are consumed through their checked whole-module theorems.\n\
             -- Dependencies before body_start={} are rejected unless declared as inputs.\n\
             theorem module_{module_index}_global_contract\n",
            module.name, module.body_start
        );
        let mut elements = BTreeMap::<(usize, usize), RneGlobalElement>::new();
        let mut seen_inputs = BTreeSet::new();

        for &input in &module.inputs {
            if !seen_inputs.insert(input.index()) {
                continue;
            }
            let node = &self.graph.nodes()[input.index()];
            let contract = self.contracts[&input.index()];
            for element in 0..node.shape.element_count() {
                let ideal = format!("ideal_{}_{}", input.index(), element);
                let actual = format!("actual_{}_{}", input.index(), element);
                let proof = format!("h_{}_{}", input.index(), element);
                source.push_str(&format!(
                    "    {{{ideal} {actual} : Int}}\n    \
                     ({proof} : VeriNeural.ApproxContract {} {} {ideal} {actual})\n",
                    contract.ideal_bound_ticks, contract.epsilon_ticks
                ));
                elements.insert(
                    (input.index(), element),
                    RneGlobalElement {
                        ideal,
                        actual,
                        proof,
                    },
                );
            }
        }

        for &index in &internal {
            let node = &self.graph.nodes()[index];
            match &self.rules[&index] {
                RneRangeRule::Input => {
                    return Err(NumericError::InvalidInput {
                        node: index,
                        reason: "module global range proof contains an internal Input node",
                    });
                }
                RneRangeRule::Add {
                    left_shift,
                    right_shift,
                    ..
                }
                | RneRangeRule::BiasAdd {
                    left_shift,
                    right_shift,
                    ..
                } => {
                    let left_factor =
                        binary32_step_i64(*left_shift).expect("validated range scale");
                    let right_factor =
                        binary32_step_i64(*right_shift).expect("validated range scale");
                    let bias_columns = node.shape.dims().get(1).copied();
                    for element in 0..node.shape.element_count() {
                        let left = Self::global_element(&elements, node.inputs[0], element)?;
                        let right_index = if matches!(node.operation, Operation::BiasAdd) {
                            element % bias_columns.expect("validated BiasAdd rank")
                        } else {
                            element
                        };
                        let right = Self::global_element(&elements, node.inputs[1], right_index)?;
                        let actual = format!("actual_{index}_{element}");
                        let shift = format!("shift_{index}_{element}");
                        let proof = format!("h_{index}_{element}");
                        source.push_str(&format!(
                            "    {{{actual} : Int}} {{{shift} : Nat}}\n    \
                             (hrne_{index}_{element} : VeriNeural.Binary32RneTick\n      \
                               (({}) * {left_factor} + ({}) * {right_factor}) \
                               {actual} {shift})\n",
                            left.actual, right.actual
                        ));
                        elements.insert(
                            (index, element),
                            RneGlobalElement {
                                ideal: format!(
                                    "(({}) * {left_factor} + ({}) * {right_factor})",
                                    left.ideal, right.ideal
                                ),
                                actual,
                                proof,
                            },
                        );
                    }
                }
                RneRangeRule::Mul { .. } => {
                    for element in 0..node.shape.element_count() {
                        let left = Self::global_element(&elements, node.inputs[0], element)?;
                        let right = Self::global_element(&elements, node.inputs[1], element)?;
                        let actual = format!("actual_{index}_{element}");
                        let shift = format!("shift_{index}_{element}");
                        let proof = format!("h_{index}_{element}");
                        source.push_str(&format!(
                            "    {{{actual} : Int}} {{{shift} : Nat}}\n    \
                             (hrne_{index}_{element} : VeriNeural.Binary32RneTick\n      \
                               (({}) * ({})) {actual} {shift})\n",
                            left.actual, right.actual
                        ));
                        elements.insert(
                            (index, element),
                            RneGlobalElement {
                                ideal: format!("(({}) * ({}))", left.ideal, right.ideal),
                                actual,
                                proof,
                            },
                        );
                    }
                }
                RneRangeRule::MatMul { .. } => {
                    let left_shape = &self.graph.nodes()[node.inputs[0].index()].shape;
                    let right_shape = &self.graph.nodes()[node.inputs[1].index()].shape;
                    let inner = left_shape.dims()[1];
                    let columns = right_shape.dims()[1];
                    for element in 0..node.shape.element_count() {
                        let row = element / columns;
                        let column = element % columns;
                        let mut ideal_sum = String::new();
                        for j in 0..inner {
                            let left_index = row * inner + j;
                            let right_index = j * columns + column;
                            let left = Self::global_element(&elements, node.inputs[0], left_index)?;
                            let right =
                                Self::global_element(&elements, node.inputs[1], right_index)?;
                            let product = format!("product_{index}_{element}_{j}");
                            let sum = format!("sum_{index}_{element}_{j}");
                            let product_shift = format!("productShift_{index}_{element}_{j}");
                            let sum_shift = format!("sumShift_{index}_{element}_{j}");
                            let previous = if j == 0 {
                                "0".to_owned()
                            } else {
                                format!("sum_{index}_{element}_{}", j - 1)
                            };
                            source.push_str(&format!(
                                "    {{{product} {sum} : Int}}\n    \
                                 {{{product_shift} {sum_shift} : Nat}}\n    \
                                 (hproduct_{index}_{element}_{j} : \
                                   VeriNeural.Binary32RneTick\n      \
                                   (({}) * ({})) {product} {product_shift})\n    \
                                 (hsum_{index}_{element}_{j} : \
                                   VeriNeural.Binary32RneTick\n      \
                                   ({previous} + {product}) {sum} {sum_shift})\n",
                                left.actual, right.actual
                            ));
                            let term = format!("(({}) * ({}))", left.ideal, right.ideal);
                            ideal_sum = if ideal_sum.is_empty() {
                                term
                            } else {
                                format!("({ideal_sum} + {term})")
                            };
                        }
                        elements.insert(
                            (index, element),
                            RneGlobalElement {
                                ideal: ideal_sum,
                                actual: format!("sum_{index}_{element}_{}", inner - 1),
                                proof: format!("h_{index}_{element}"),
                            },
                        );
                    }
                }
                RneRangeRule::Relu | RneRangeRule::Reshape => {
                    for element in 0..node.shape.element_count() {
                        let parent = Self::global_element(&elements, node.inputs[0], element)?;
                        let (ideal, actual) = if matches!(node.operation, Operation::Relu) {
                            (
                                format!("(max ({}) 0)", parent.ideal),
                                format!("(max ({}) 0)", parent.actual),
                            )
                        } else {
                            (parent.ideal, parent.actual)
                        };
                        elements.insert(
                            (index, element),
                            RneGlobalElement {
                                ideal,
                                actual,
                                proof: format!("h_{index}_{element}"),
                            },
                        );
                    }
                }
            }
        }

        let output_contract = self.contracts[&module.output.index()];
        let output_node = &self.graph.nodes()[module.output.index()];
        let mut goals = Vec::with_capacity(output_node.shape.element_count());
        let mut output_proofs = Vec::with_capacity(output_node.shape.element_count());
        for element in 0..output_node.shape.element_count() {
            let output = Self::global_element(&elements, module.output, element)?;
            goals.push(format!(
                "VeriNeural.ApproxContract {} {} ({}) ({})",
                output_contract.ideal_bound_ticks,
                output_contract.epsilon_ticks,
                output.ideal,
                output.actual
            ));
            output_proofs.push(output.proof);
        }
        source.push_str(&format!("    : {} := by\n", Self::lean_conjunction(&goals)));

        for &index in &internal {
            if let Some(&nested_index) = nested_by_output.get(&index) {
                let nested = &self.graph.modules()[nested_index];
                let mut args = Vec::new();
                let mut seen_inputs = BTreeSet::new();
                for &input in &nested.inputs {
                    if !seen_inputs.insert(input.index()) {
                        continue;
                    }
                    let input_node = &self.graph.nodes()[input.index()];
                    for element in 0..input_node.shape.element_count() {
                        args.push(Self::global_element(&elements, input, element)?.proof);
                    }
                }
                for nested_node in self.module_internal_nodes(nested)? {
                    args.extend(self.architecture_witness_args(nested_node));
                }
                let call_args = if args.is_empty() {
                    String::new()
                } else {
                    format!(" {}", args.join(" "))
                };
                let nested_result = format!("nested_module_{nested_index}");
                source.push_str(&format!(
                    "  have {nested_result} := module_{nested_index}_global_contract{call_args}\n"
                ));
                let output_node = &self.graph.nodes()[nested.output.index()];
                let output_proofs = (0..output_node.shape.element_count())
                    .map(|element| {
                        Self::global_element(&elements, nested.output, element)
                            .map(|output| output.proof)
                    })
                    .collect::<Result<Vec<_>, _>>()?;
                if output_proofs.len() == 1 {
                    source.push_str(&format!("  have {} := {nested_result}\n", output_proofs[0]));
                } else {
                    source.push_str(&format!(
                        "  rcases {nested_result} with {}\n",
                        Self::lean_conjunction_pattern(&output_proofs)
                    ));
                }
                continue;
            }
            if nested_internal.contains(&index) {
                continue;
            }

            let node = &self.graph.nodes()[index];
            let contract = self.contracts[&index];
            match &self.rules[&index] {
                RneRangeRule::Input => unreachable!("rejected above"),
                RneRangeRule::Add { .. } | RneRangeRule::BiasAdd { .. } => {
                    let bias_columns = node.shape.dims().get(1).copied();
                    for element in 0..node.shape.element_count() {
                        let left = Self::global_element(&elements, node.inputs[0], element)?;
                        let right_index = if matches!(node.operation, Operation::BiasAdd) {
                            element % bias_columns.expect("validated BiasAdd rank")
                        } else {
                            element
                        };
                        let right = Self::global_element(&elements, node.inputs[1], right_index)?;
                        let output = Self::global_element(&elements, node.id, element)?;
                        source.push_str(&format!(
                            "  have {} : VeriNeural.ApproxContract {} {} ({}) ({}) := by\n    \
                             exact node_{index}_range_rule {} {} hrne_{index}_{element}\n",
                            output.proof,
                            contract.ideal_bound_ticks,
                            contract.epsilon_ticks,
                            output.ideal,
                            output.actual,
                            left.proof,
                            right.proof
                        ));
                    }
                }
                RneRangeRule::Mul { .. } => {
                    for element in 0..node.shape.element_count() {
                        let left = Self::global_element(&elements, node.inputs[0], element)?;
                        let right = Self::global_element(&elements, node.inputs[1], element)?;
                        let output = Self::global_element(&elements, node.id, element)?;
                        source.push_str(&format!(
                            "  have {} : VeriNeural.ApproxContract {} {} ({}) ({}) := by\n    \
                             exact node_{index}_range_rule {} {} hrne_{index}_{element}\n",
                            output.proof,
                            contract.ideal_bound_ticks,
                            contract.epsilon_ticks,
                            output.ideal,
                            output.actual,
                            left.proof,
                            right.proof
                        ));
                    }
                }
                RneRangeRule::MatMul { .. } => {
                    let left_shape = &self.graph.nodes()[node.inputs[0].index()].shape;
                    let right_shape = &self.graph.nodes()[node.inputs[1].index()].shape;
                    let inner = left_shape.dims()[1];
                    let columns = right_shape.dims()[1];
                    for element in 0..node.shape.element_count() {
                        let row = element / columns;
                        let column = element % columns;
                        let mut args = String::new();
                        for j in 0..inner {
                            let left =
                                Self::global_element(&elements, node.inputs[0], row * inner + j)?;
                            let right = Self::global_element(
                                &elements,
                                node.inputs[1],
                                j * columns + column,
                            )?;
                            args.push_str(&format!(
                                " {} {} hproduct_{index}_{element}_{j} hsum_{index}_{element}_{j}",
                                left.proof, right.proof
                            ));
                        }
                        let output = Self::global_element(&elements, node.id, element)?;
                        source.push_str(&format!(
                            "  have {} : VeriNeural.ApproxContract {} {} ({}) ({}) := by\n    \
                             exact node_{index}_range_rule{args}\n",
                            output.proof,
                            contract.ideal_bound_ticks,
                            contract.epsilon_ticks,
                            output.ideal,
                            output.actual
                        ));
                    }
                }
                RneRangeRule::Relu | RneRangeRule::Reshape => {
                    for element in 0..node.shape.element_count() {
                        let parent = Self::global_element(&elements, node.inputs[0], element)?;
                        let output = Self::global_element(&elements, node.id, element)?;
                        source.push_str(&format!(
                            "  have {} : VeriNeural.ApproxContract {} {} ({}) ({}) := by\n    \
                             exact node_{index}_range_rule {}\n",
                            output.proof,
                            contract.ideal_bound_ticks,
                            contract.epsilon_ticks,
                            output.ideal,
                            output.actual,
                            parent.proof
                        ));
                    }
                }
            }
        }

        source.push_str(&format!(
            "  exact {}\n\n",
            Self::lean_conjunction_proof(&output_proofs)
        ));
        Ok(source)
    }

    fn lean_conjunction_pattern(items: &[String]) -> String {
        match items {
            [] => "_".to_owned(),
            [one] => one.clone(),
            [first, rest @ ..] => {
                format!("⟨{first}, {}⟩", Self::lean_conjunction_pattern(rest))
            }
        }
    }

    fn architecture_register_node(
        &self,
        index: usize,
        elements: &mut BTreeMap<(usize, usize), RneGlobalElement>,
        source: &mut String,
    ) -> Result<(), NumericError> {
        let node = &self.graph.nodes()[index];
        if (0..node.shape.element_count()).all(|element| elements.contains_key(&(index, element))) {
            return Ok(());
        }

        match &self.rules[&index] {
            RneRangeRule::Input => {
                return Err(NumericError::InvalidInput {
                    node: index,
                    reason: "architecture range proof reached an undeclared Input",
                });
            }
            RneRangeRule::Add {
                left_shift,
                right_shift,
                ..
            }
            | RneRangeRule::BiasAdd {
                left_shift,
                right_shift,
                ..
            } => {
                let left_factor = binary32_step_i64(*left_shift).expect("validated range scale");
                let right_factor = binary32_step_i64(*right_shift).expect("validated range scale");
                let bias_columns = node.shape.dims().get(1).copied();
                for element in 0..node.shape.element_count() {
                    let left = Self::global_element(elements, node.inputs[0], element)?;
                    let right_index = if matches!(node.operation, Operation::BiasAdd) {
                        element % bias_columns.expect("validated BiasAdd rank")
                    } else {
                        element
                    };
                    let right = Self::global_element(elements, node.inputs[1], right_index)?;
                    let actual = format!("actual_{index}_{element}");
                    let shift = format!("shift_{index}_{element}");
                    source.push_str(&format!(
                        "    {{{actual} : Int}} {{{shift} : Nat}}\n    \
                         (hrne_{index}_{element} : VeriNeural.Binary32RneTick\n      \
                           (({}) * {left_factor} + ({}) * {right_factor}) \
                           {actual} {shift})\n",
                        left.actual, right.actual
                    ));
                    elements.insert(
                        (index, element),
                        RneGlobalElement {
                            ideal: format!(
                                "(({}) * {left_factor} + ({}) * {right_factor})",
                                left.ideal, right.ideal
                            ),
                            actual,
                            proof: String::new(),
                        },
                    );
                }
            }
            RneRangeRule::Mul { .. } => {
                for element in 0..node.shape.element_count() {
                    let left = Self::global_element(elements, node.inputs[0], element)?;
                    let right = Self::global_element(elements, node.inputs[1], element)?;
                    let actual = format!("actual_{index}_{element}");
                    let shift = format!("shift_{index}_{element}");
                    source.push_str(&format!(
                        "    {{{actual} : Int}} {{{shift} : Nat}}\n    \
                         (hrne_{index}_{element} : VeriNeural.Binary32RneTick\n      \
                           (({}) * ({})) {actual} {shift})\n",
                        left.actual, right.actual
                    ));
                    elements.insert(
                        (index, element),
                        RneGlobalElement {
                            ideal: format!("(({}) * ({}))", left.ideal, right.ideal),
                            actual,
                            proof: String::new(),
                        },
                    );
                }
            }
            RneRangeRule::MatMul { .. } => {
                let left_shape = &self.graph.nodes()[node.inputs[0].index()].shape;
                let right_shape = &self.graph.nodes()[node.inputs[1].index()].shape;
                let inner = left_shape.dims()[1];
                let columns = right_shape.dims()[1];
                for element in 0..node.shape.element_count() {
                    let row = element / columns;
                    let column = element % columns;
                    let mut ideal_sum = String::new();
                    for j in 0..inner {
                        let left = Self::global_element(elements, node.inputs[0], row * inner + j)?;
                        let right =
                            Self::global_element(elements, node.inputs[1], j * columns + column)?;
                        let product = format!("product_{index}_{element}_{j}");
                        let sum = format!("sum_{index}_{element}_{j}");
                        let product_shift = format!("productShift_{index}_{element}_{j}");
                        let sum_shift = format!("sumShift_{index}_{element}_{j}");
                        let previous = if j == 0 {
                            "0".to_owned()
                        } else {
                            format!("sum_{index}_{element}_{}", j - 1)
                        };
                        source.push_str(&format!(
                            "    {{{product} {sum} : Int}}\n    \
                             {{{product_shift} {sum_shift} : Nat}}\n    \
                             (hproduct_{index}_{element}_{j} : \
                               VeriNeural.Binary32RneTick\n      \
                               (({}) * ({})) {product} {product_shift})\n    \
                             (hsum_{index}_{element}_{j} : \
                               VeriNeural.Binary32RneTick\n      \
                               ({previous} + {product}) {sum} {sum_shift})\n",
                            left.actual, right.actual
                        ));
                        let term = format!("(({}) * ({}))", left.ideal, right.ideal);
                        ideal_sum = if ideal_sum.is_empty() {
                            term
                        } else {
                            format!("({ideal_sum} + {term})")
                        };
                    }
                    elements.insert(
                        (index, element),
                        RneGlobalElement {
                            ideal: ideal_sum,
                            actual: format!("sum_{index}_{element}_{}", inner - 1),
                            proof: String::new(),
                        },
                    );
                }
            }
            RneRangeRule::Relu | RneRangeRule::Reshape => {
                for element in 0..node.shape.element_count() {
                    let parent = Self::global_element(elements, node.inputs[0], element)?;
                    let (ideal, actual) = if matches!(node.operation, Operation::Relu) {
                        (
                            format!("(max ({}) 0)", parent.ideal),
                            format!("(max ({}) 0)", parent.actual),
                        )
                    } else {
                        (parent.ideal, parent.actual)
                    };
                    elements.insert(
                        (index, element),
                        RneGlobalElement {
                            ideal,
                            actual,
                            proof: String::new(),
                        },
                    );
                }
            }
        }
        Ok(())
    }

    fn architecture_witness_args(&self, index: usize) -> Vec<String> {
        let node = &self.graph.nodes()[index];
        match &self.rules[&index] {
            RneRangeRule::Add { .. } | RneRangeRule::BiasAdd { .. } | RneRangeRule::Mul { .. } => {
                (0..node.shape.element_count())
                    .map(|element| format!("hrne_{index}_{element}"))
                    .collect()
            }
            RneRangeRule::MatMul { .. } => {
                let inner = self.graph.nodes()[node.inputs[0].index()].shape.dims()[1];
                let mut args = Vec::new();
                for element in 0..node.shape.element_count() {
                    for j in 0..inner {
                        args.push(format!("hproduct_{index}_{element}_{j}"));
                        args.push(format!("hsum_{index}_{element}_{j}"));
                    }
                }
                args
            }
            RneRangeRule::Input | RneRangeRule::Relu | RneRangeRule::Reshape => Vec::new(),
        }
    }

    fn architecture_global_source(&self) -> Result<Option<String>, NumericError> {
        let Some(module_indices) = self.architecture_module_indices()? else {
            return Ok(None);
        };

        let mut source = String::from(
            "-- Architecture-level numerical composition over the reachable module DAG.\n\
             -- Producer module theorems feed every dependent branch and fan-in boundary.\n\
             theorem architecture_global_contract\n",
        );
        let mut elements = BTreeMap::<(usize, usize), RneGlobalElement>::new();
        for &input in &self.inputs {
            let node = &self.graph.nodes()[input.index()];
            let contract = self.contracts[&input.index()];
            for element in 0..node.shape.element_count() {
                let ideal = format!("ideal_{}_{}", input.index(), element);
                let actual = format!("actual_{}_{}", input.index(), element);
                let proof = format!("arch_h_{}_{}", input.index(), element);
                source.push_str(&format!(
                    "    {{{ideal} {actual} : Int}}\n    \
                     ({proof} : VeriNeural.ApproxContract {} {} {ideal} {actual})\n",
                    contract.ideal_bound_ticks, contract.epsilon_ticks
                ));
                elements.insert(
                    (input.index(), element),
                    RneGlobalElement {
                        ideal,
                        actual,
                        proof,
                    },
                );
            }
        }

        let mut declared_nodes = BTreeSet::new();
        let mut steps = Vec::<RneArchitectureStep>::new();
        for &module_index in &module_indices {
            let module = &self.graph.modules()[module_index];
            let mut args = Vec::new();
            let mut seen_inputs = BTreeSet::new();
            for &input in &module.inputs {
                if !seen_inputs.insert(input.index()) {
                    continue;
                }
                let node = &self.graph.nodes()[input.index()];
                for element in 0..node.shape.element_count() {
                    let input_element = Self::global_element(&elements, input, element)?;
                    if input_element.proof.is_empty() {
                        return Ok(None);
                    }
                    args.push(input_element.proof);
                }
            }

            let internal = self.module_internal_nodes(module)?;
            for &index in &internal {
                if declared_nodes.insert(index) {
                    self.architecture_register_node(index, &mut elements, &mut source)?;
                }
                args.extend(self.architecture_witness_args(index));
            }

            let output_node = &self.graph.nodes()[module.output.index()];
            let output_count = output_node.shape.element_count();
            let output_proofs = (0..output_count)
                .map(|element| format!("arch_h_{}_{}", module.output.index(), element))
                .collect::<Vec<_>>();
            for (element, proof) in output_proofs.iter().enumerate() {
                let output = elements.get_mut(&(module.output.index(), element)).ok_or(
                    NumericError::InvalidInput {
                        node: module.output.index(),
                        reason: "architecture range proof is missing a module output",
                    },
                )?;
                output.proof = proof.clone();
            }
            steps.push(RneArchitectureStep {
                module_index,
                args,
                output_proofs,
            });
        }

        let output_contract = self.output_contract();
        let output_node = &self.graph.nodes()[self.output.index()];
        let mut goals = Vec::with_capacity(output_node.shape.element_count());
        let mut final_proofs = Vec::with_capacity(output_node.shape.element_count());
        for element in 0..output_node.shape.element_count() {
            let output = Self::global_element(&elements, self.output, element)?;
            if output.proof.is_empty() {
                return Ok(None);
            }
            goals.push(format!(
                "VeriNeural.ApproxContract {} {} ({}) ({})",
                output_contract.ideal_bound_ticks,
                output_contract.epsilon_ticks,
                output.ideal,
                output.actual
            ));
            final_proofs.push(output.proof);
        }
        source.push_str(&format!("    : {} := by\n", Self::lean_conjunction(&goals)));
        for step in steps {
            let call_args = if step.args.is_empty() {
                String::new()
            } else {
                format!(" {}", step.args.join(" "))
            };
            let module_result = format!("arch_module_{}", step.module_index);
            source.push_str(&format!(
                "  have {module_result} := module_{}_global_contract{call_args}\n",
                step.module_index
            ));
            if step.output_proofs.len() == 1 {
                source.push_str(&format!(
                    "  have {} := {module_result}\n",
                    step.output_proofs[0]
                ));
            } else {
                source.push_str(&format!(
                    "  rcases {module_result} with {}\n",
                    Self::lean_conjunction_pattern(&step.output_proofs)
                ));
            }
        }
        source.push_str(&format!(
            "  exact {}\n\n",
            Self::lean_conjunction_proof(&final_proofs)
        ));
        Ok(Some(source))
    }

    fn add_rule_source(
        &self,
        index: usize,
        left_shift: u32,
        right_shift: u32,
        max_shift: u32,
    ) -> String {
        let node = &self.graph.nodes()[index];
        let left = self.contracts[&node.inputs[0].index()];
        let right = self.contracts[&node.inputs[1].index()];
        let output = self.contracts[&index];
        let left_factor = binary32_step_i64(left_shift).expect("validated range scale");
        let right_factor = binary32_step_i64(right_shift).expect("validated range scale");
        let left_scaled = Self::scale_contract(index, left, output.fraction_bits)
            .expect("validated range scale")
            .0;
        let right_scaled = Self::scale_contract(index, right, output.fraction_bits)
            .expect("validated range scale")
            .0;
        format!(
            "theorem node_{index}_range_rule\n    \
             {{idealA actualA idealB actualB rounded : Int}} {{shift : Nat}}\n    \
             (ha : VeriNeural.ApproxContract {} {} idealA actualA)\n    \
             (hb : VeriNeural.ApproxContract {} {} idealB actualB)\n    \
             (hrne : VeriNeural.Binary32RneTick\n      \
               (actualA * {left_factor} + actualB * {right_factor}) rounded shift) :\n    \
             VeriNeural.ApproxContract {} {}\n      \
               (idealA * {left_factor} + idealB * {right_factor}) rounded := by\n  \
             have haScaled : VeriNeural.ApproxContract {} {}\n      \
                 (idealA * {left_factor}) (actualA * {left_factor}) := by\n    \
               simpa using (VeriNeural.approx_contract_scale (scale := {left_factor})\n      \
                 (by decide) ha)\n  \
             have hbScaled : VeriNeural.ApproxContract {} {}\n      \
                 (idealB * {right_factor}) (actualB * {right_factor}) := by\n    \
               simpa using (VeriNeural.approx_contract_scale (scale := {right_factor})\n      \
                 (by decide) hb)\n  \
             simpa [VeriNeural.binary32Step] using\n    \
               (VeriNeural.approx_contract_add_rne (maxShift := {max_shift})\n      \
                 haScaled hbScaled (by decide) hrne)\n\n",
            left.ideal_bound_ticks,
            left.epsilon_ticks,
            right.ideal_bound_ticks,
            right.epsilon_ticks,
            output.ideal_bound_ticks,
            output.epsilon_ticks,
            left_scaled.ideal_bound_ticks,
            left_scaled.epsilon_ticks,
            right_scaled.ideal_bound_ticks,
            right_scaled.epsilon_ticks,
        )
    }

    fn mul_rule_source(&self, index: usize, max_shift: u32) -> String {
        let node = &self.graph.nodes()[index];
        let left = self.contracts[&node.inputs[0].index()];
        let right = self.contracts[&node.inputs[1].index()];
        let output = self.contracts[&index];
        format!(
            "theorem node_{index}_range_rule\n    \
             {{idealA actualA idealB actualB rounded : Int}} {{shift : Nat}}\n    \
             (ha : VeriNeural.ApproxContract {} {} idealA actualA)\n    \
             (hb : VeriNeural.ApproxContract {} {} idealB actualB)\n    \
             (hrne : VeriNeural.Binary32RneTick (actualA * actualB) rounded shift) :\n    \
             VeriNeural.ApproxContract {} {} (idealA * idealB) rounded := by\n  \
             simpa [VeriNeural.binary32Step] using\n    \
               (VeriNeural.approx_contract_mul_rne (maxShift := {max_shift})\n      \
                 ha hb (by decide) hrne)\n\n",
            left.ideal_bound_ticks,
            left.epsilon_ticks,
            right.ideal_bound_ticks,
            right.epsilon_ticks,
            output.ideal_bound_ticks,
            output.epsilon_ticks,
        )
    }

    fn matmul_rule_source(
        &self,
        index: usize,
        product: RneErrorContract,
        product_max_shift: u32,
        sums: &[(RneErrorContract, u32)],
    ) -> String {
        let node = &self.graph.nodes()[index];
        let left = self.contracts[&node.inputs[0].index()];
        let right = self.contracts[&node.inputs[1].index()];
        let output = self.contracts[&index];
        let inner = sums.len();
        let mut source = format!("theorem node_{index}_range_rule\n");
        for j in 0..inner {
            source.push_str(&format!(
                "    {{idealA_{j} actualA_{j} idealB_{j} actualB_{j} product_{j} sum_{j} : Int}}\n    \
                 {{productShift_{j} sumShift_{j} : Nat}}\n"
            ));
        }
        for j in 0..inner {
            source.push_str(&format!(
                "    (ha_{j} : VeriNeural.ApproxContract {} {} idealA_{j} actualA_{j})\n    \
                 (hb_{j} : VeriNeural.ApproxContract {} {} idealB_{j} actualB_{j})\n    \
                 (hproduct_{j} : VeriNeural.Binary32RneTick\n      \
                   (actualA_{j} * actualB_{j}) product_{j} productShift_{j})\n",
                left.ideal_bound_ticks,
                left.epsilon_ticks,
                right.ideal_bound_ticks,
                right.epsilon_ticks,
            ));
            let previous = if j == 0 {
                "0".to_owned()
            } else {
                format!("sum_{}", j - 1)
            };
            source.push_str(&format!(
                "    (hsum_{j} : VeriNeural.Binary32RneTick\n      \
                   ({previous} + product_{j}) sum_{j} sumShift_{j})\n"
            ));
        }
        let mut ideal_expression = String::new();
        for j in 0..inner {
            let term = format!("idealA_{j} * idealB_{j}");
            ideal_expression = if ideal_expression.is_empty() {
                term
            } else {
                format!("({ideal_expression} + {term})")
            };
        }
        source.push_str(&format!(
            "    : VeriNeural.ApproxContract {} {}\n      \
             {ideal_expression} sum_{} := by\n  \
             have hacc_0 : VeriNeural.ApproxContract 0 0 0 0 := by\n    \
               exact VeriNeural.approx_contract_exact (by decide) (by decide)\n",
            output.ideal_bound_ticks,
            output.epsilon_ticks,
            inner - 1,
        ));
        let mut previous_contract_name = "hacc_0".to_owned();
        for (j, (sum_contract, sum_max_shift)) in sums.iter().enumerate() {
            source.push_str(&format!(
                "  have hproductContract_{j} : VeriNeural.ApproxContract {} {}\n      \
                   (idealA_{j} * idealB_{j}) product_{j} := by\n    \
                 simpa [VeriNeural.binary32Step] using\n      \
                   (VeriNeural.approx_contract_mul_rne (maxShift := {product_max_shift})\n        \
                     ha_{j} hb_{j} (by decide) hproduct_{j})\n",
                product.ideal_bound_ticks, product.epsilon_ticks
            ));
            let ideal_sum = {
                let mut expr = String::new();
                for k in 0..=j {
                    let term = format!("idealA_{k} * idealB_{k}");
                    expr = if expr.is_empty() {
                        term
                    } else {
                        format!("({expr} + {term})")
                    };
                }
                expr
            };
            source.push_str(&format!(
                "  have hsumContract_{j} : VeriNeural.ApproxContract {} {}\n      \
                   ({ideal_sum}) sum_{j} := by\n    \
                 simpa [VeriNeural.binary32Step] using\n      \
                   (VeriNeural.approx_contract_add_rne (maxShift := {sum_max_shift})\n        \
                     {previous_contract_name} hproductContract_{j} (by decide) hsum_{j})\n",
                sum_contract.ideal_bound_ticks, sum_contract.epsilon_ticks
            ));
            previous_contract_name = format!("hsumContract_{j}");
        }
        source.push_str(&format!("  exact {previous_contract_name}\n\n"));
        source
    }

    /// Emit range-transfer theorems with arbitrary scalar values. The numeric
    /// bounds are fixed by this plan, but the values themselves are variables,
    /// so the proof is reusable for every input satisfying the source contract.
    pub fn lean_source(&self) -> Result<String, NumericError> {
        let base = LeanProofEngine::default().generate(&self.graph, self.output)?;
        let mut source = base.source().to_owned();
        source.push_str("\n\n");
        source.push_str(MEMORY_LIBRARY);
        source.push_str("\n\n");
        source.push_str(NUMERIC_LIBRARY);
        source.push_str("\nnamespace VeriNeural.Generated.RneRange\n\n");
        source.push_str(&format!(
            "-- Reusable dyadic range contract: source q={}, |ticks| <= {}.\n\
             -- Values are arbitrary; local arithmetic is conditional on Binary32RneTick.\n\
             -- LLVM/PTX/JIT/GPU conformance is not proved here.\n\n",
            self.source_fraction_bits, self.source_bound_ticks
        ));

        for &index in &self.reachable {
            let node = &self.graph.nodes()[index];
            let contract = self.contracts[&index];
            match &self.rules[&index] {
                RneRangeRule::Input => {
                    source.push_str(&format!(
                        "theorem node_{index}_range_rule\n    \
                         {{ideal actual : Int}}\n    \
                         (h : VeriNeural.ApproxContract {} {} ideal actual) :\n    \
                         VeriNeural.ApproxContract {} {} ideal actual := by\n  \
                         exact h\n\n",
                        contract.ideal_bound_ticks,
                        contract.epsilon_ticks,
                        contract.ideal_bound_ticks,
                        contract.epsilon_ticks,
                    ));
                }
                RneRangeRule::Add {
                    left_shift,
                    right_shift,
                    max_shift,
                }
                | RneRangeRule::BiasAdd {
                    left_shift,
                    right_shift,
                    max_shift,
                } => source.push_str(&self.add_rule_source(
                    index,
                    *left_shift,
                    *right_shift,
                    *max_shift,
                )),
                RneRangeRule::Mul { max_shift } => {
                    source.push_str(&self.mul_rule_source(index, *max_shift))
                }
                RneRangeRule::MatMul {
                    product,
                    product_max_shift,
                    sums,
                } => source.push_str(&self.matmul_rule_source(
                    index,
                    *product,
                    *product_max_shift,
                    sums,
                )),
                RneRangeRule::Relu => {
                    let parent = self.contracts[&node.inputs[0].index()];
                    source.push_str(&format!(
                        "theorem node_{index}_range_rule\n    \
                         {{ideal actual : Int}}\n    \
                         (h : VeriNeural.ApproxContract {} {} ideal actual) :\n    \
                         VeriNeural.ApproxContract {} {} (max ideal 0) (max actual 0) := by\n  \
                         simpa using (VeriNeural.approx_contract_relu h)\n\n",
                        parent.ideal_bound_ticks,
                        parent.epsilon_ticks,
                        contract.ideal_bound_ticks,
                        contract.epsilon_ticks,
                    ));
                    source.push_str(&format!(
                        r#"theorem node_{index}_positive_branch
    {{ideal actual : Int}}
    (h : VeriNeural.ApproxContract {} {} ideal actual)
    (hmargin : {} < actual) :
    max ideal 0 = ideal ∧ max actual 0 = actual := by
  exact VeriNeural.approx_contract_relu_positive_branch h hmargin

theorem node_{index}_nonpositive_branch
    {{ideal actual : Int}}
    (h : VeriNeural.ApproxContract {} {} ideal actual)
    (hmargin : actual + {} ≤ 0) :
    max ideal 0 = 0 ∧ max actual 0 = 0 := by
  exact VeriNeural.approx_contract_relu_nonpositive_branch h hmargin

"#,
                        parent.ideal_bound_ticks,
                        parent.epsilon_ticks,
                        parent.epsilon_ticks,
                        parent.ideal_bound_ticks,
                        parent.epsilon_ticks,
                        parent.epsilon_ticks,
                    ));
                }
                RneRangeRule::Reshape => {
                    let parent = self.contracts[&node.inputs[0].index()];
                    source.push_str(&format!(
                        "theorem node_{index}_range_rule\n    \
                         {{ideal actual : Int}}\n    \
                         (h : VeriNeural.ApproxContract {} {} ideal actual) :\n    \
                         VeriNeural.ApproxContract {} {} ideal actual := by\n  \
                         exact h\n\n",
                        parent.ideal_bound_ticks,
                        parent.epsilon_ticks,
                        contract.ideal_bound_ticks,
                        contract.epsilon_ticks,
                    ));
                }
            }
        }

        let output = self.output_contract();
        source.push_str(&format!(
            "theorem output_contract_well_formed :\n  \
             (0 : Int) <= {} /\\ (0 : Int) <= {} := by\n  \
             decide\n\n",
            output.ideal_bound_ticks, output.epsilon_ticks
        ));
        for (module_index, module) in self.graph.modules().iter().enumerate() {
            if !self.module_in_slice(module) {
                continue;
            }
            let contract = self.contracts[&module.output.index()];
            source.push_str(&format!(
                "-- Module {} (output node {}) exports q={}, ideal bound {}, epsilon {} ticks.\n\
                 theorem module_{module_index}_contract_well_formed :\n  \
                   (0 : Int) <= {} /\\ (0 : Int) <= {} := by\n  \
                   decide\n\n",
                module.name,
                module.output.index(),
                contract.fraction_bits,
                contract.ideal_bound_ticks,
                contract.epsilon_ticks,
                contract.ideal_bound_ticks,
                contract.epsilon_ticks,
            ));
            source.push_str(&self.module_global_source(module_index, module)?);
        }
        if let Some(architecture) = self.architecture_global_source()? {
            source.push_str(&architecture);
        }
        source.push_str("end VeriNeural.Generated.RneRange\n");
        Ok(source)
    }
}

fn rescale_i64(value: i64, shift: u32) -> Option<i64> {
    let factor = 1i128.checked_shl(shift)?;
    let scaled = i128::from(value).checked_mul(factor)?;
    i64::try_from(scaled).ok()
}

fn binary32_step_i64(shift: u32) -> Option<i64> {
    1i64.checked_shl(shift)
}

fn f32_to_dyadic_ticks(value: f32, fraction_bits: u32) -> Result<i64, &'static str> {
    let bits = value.to_bits();
    let sign = bits >> 31;
    let exponent = (bits >> 23) & 0xff;
    let fraction = bits & 0x7f_ffff;

    if exponent == 0xff {
        return Err("RNE dyadic inputs must be finite");
    }
    if exponent == 0 {
        if fraction == 0 {
            if sign != 0 {
                return Err("RNE dyadic slice does not model signed zero");
            }
            return Ok(0);
        }
        return Err("RNE dyadic slice does not yet model subnormals");
    }

    let significand = (1u64 << 23) | u64::from(fraction);
    let unbiased = exponent as i32 - 127;
    let shift = unbiased - 23 + fraction_bits as i32;
    let magnitude = if shift >= 0 {
        let left = shift as u32;
        if left > 104 {
            return Err("fixed-point input overflow");
        }
        (u128::from(significand)) << left
    } else {
        let right = (-shift) as u32;
        if right >= 64 {
            return Err("input is not on the selected dyadic lattice");
        }
        let mask = if right == 0 { 0 } else { (1u64 << right) - 1 };
        if significand & mask != 0 {
            return Err("input is not on the selected dyadic lattice");
        }
        u128::from(significand >> right)
    };
    if magnitude > i64::MAX as u128 {
        return Err("fixed-point input overflow");
    }
    let magnitude = magnitude as i64;
    Ok(if sign == 0 { magnitude } else { -magnitude })
}

fn round_ticks_to_binary32(
    value: i64,
    fraction_bits: u32,
) -> Result<(i64, u32, u32), &'static str> {
    if value == 0 {
        return Ok((0, 0, 0));
    }
    let magnitude = value.unsigned_abs();
    if magnitude > i64::MAX as u64 {
        return Err("fixed-point magnitude exceeds supported i64 range");
    }
    let bit_len = 64 - magnitude.leading_zeros();
    let shift = bit_len.saturating_sub(24);
    let rounded_magnitude = if shift == 0 {
        magnitude
    } else {
        let step = 1u64 << shift;
        let quotient = magnitude >> shift;
        let remainder = magnitude & (step - 1);
        let half = step >> 1;
        let increment = remainder > half || (remainder == half && quotient & 1 == 1);
        let rounded_quotient = quotient + if increment { 1 } else { 0 };
        rounded_quotient
            .checked_shl(shift)
            .ok_or("binary32 rounding overflow")?
    };
    if rounded_magnitude > i64::MAX as u64 {
        return Err("binary32 rounded value exceeds supported i64 range");
    }
    let rounded = if value < 0 {
        -(rounded_magnitude as i64)
    } else {
        rounded_magnitude as i64
    };
    let bits = encode_representable_ticks(rounded, fraction_bits)?;
    Ok((rounded, bits, shift))
}

fn encode_representable_ticks(value: i64, fraction_bits: u32) -> Result<u32, &'static str> {
    if value == 0 {
        return Ok(0);
    }
    let sign = if value < 0 { 1 } else { 0 };
    let magnitude = value.unsigned_abs();
    if magnitude > i64::MAX as u64 {
        return Err("fixed-point magnitude exceeds supported i64 range");
    }
    let bit_len = 64 - magnitude.leading_zeros();
    let precision_shift = bit_len.saturating_sub(24);
    if precision_shift > 0 {
        let mask = (1u64 << precision_shift) - 1;
        if magnitude & mask != 0 {
            return Err("rounded tick is not exactly representable as binary32");
        }
    }
    let significand = if bit_len < 24 {
        magnitude << (24 - bit_len)
    } else {
        magnitude >> precision_shift
    };
    let exponent = bit_len as i32 - 1 - fraction_bits as i32;
    if !(-126..=127).contains(&exponent) {
        return Err("dyadic value leaves the normal finite binary32 range");
    }
    let biased = (exponent + 127) as u32;
    let fraction = (significand as u32) & 0x7f_ffff;
    Ok((sign << 31) | (biased << 23) | fraction)
}

FILE	crates/verineural/src/optimizer.rs
//! Architecture-neutral host optimizer over explicit named f32 parameter tensors.
//! GPU kernels and training graphs remain in VeriNeural; this CPU update is
//! a deliberately separate *trusted numerical* step, not a Lean certificate.
use std::collections::BTreeMap;
use std::fmt;

use crate::Tensor;

#[derive(Clone, Debug, PartialEq)]
pub enum OptimizerError {
    Invalid(&'static str),
    Parameter(String),
}
impl fmt::Display for OptimizerError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::Invalid(s) => write!(f, "invalid AdamW configuration: {s}"),
            Self::Parameter(s) => write!(f, "invalid AdamW parameter: {s}"),
        }
    }
}
impl std::error::Error for OptimizerError {}

#[derive(Clone, Debug)]
struct Moments {
    first: Vec<f32>,
    second: Vec<f32>,
}

/// Architecture-neutral serializable AdamW state. Moments use explicit
/// names and dense F32 vectors; callers own the on-disk format.
#[derive(Clone, Debug, PartialEq)]
pub struct AdamWCheckpoint {
    pub learning_rate: f32,
    pub weight_decay: f32,
    pub beta1: f32,
    pub beta2: f32,
    pub epsilon: f32,
    pub steps: u64,
    pub moments: BTreeMap<String, (Vec<f32>, Vec<f32>)>,
}

#[derive(Clone, Debug)]
pub struct AdamW {
    learning_rate: f32,
    weight_decay: f32,
    beta1: f32,
    beta2: f32,
    epsilon: f32,
    steps: u64,
    states: BTreeMap<String, Moments>,
}

impl AdamW {
    pub fn new(learning_rate: f32, weight_decay: f32) -> Result<Self, OptimizerError> {
        if !learning_rate.is_finite()
            || learning_rate <= 0.
            || !weight_decay.is_finite()
            || weight_decay < 0.
        {
            return Err(OptimizerError::Invalid(
                "learning rate must be positive, weight decay nonnegative and finite",
            ));
        }
        Ok(Self {
            learning_rate,
            weight_decay,
            beta1: 0.9,
            beta2: 0.999,
            epsilon: 1e-8,
            steps: 0,
            states: BTreeMap::new(),
        })
    }
    /// Export all optimizer hyperparameters and first/second moments.
    pub fn checkpoint(&self) -> AdamWCheckpoint {
        AdamWCheckpoint {
            learning_rate: self.learning_rate,
            weight_decay: self.weight_decay,
            beta1: self.beta1,
            beta2: self.beta2,
            epsilon: self.epsilon,
            steps: self.steps,
            moments: self
                .states
                .iter()
                .map(|(name, state)| (name.clone(), (state.first.clone(), state.second.clone())))
                .collect(),
        }
    }

    /// Restore optimizer state against the exact named parameter schema.
    /// Rejects stale names, invalid hyperparameters, NaNs, shape changes and
    /// missing moment buffers; never performs an implicit reset of AdamW.
    pub fn from_checkpoint(
        saved: AdamWCheckpoint,
        parameters: &BTreeMap<String, Tensor<f32>>,
    ) -> Result<Self, OptimizerError> {
        if parameters.is_empty()
            || !saved.learning_rate.is_finite()
            || saved.learning_rate <= 0.
            || !saved.weight_decay.is_finite()
            || saved.weight_decay < 0.
            || !saved.beta1.is_finite()
            || saved.beta1 <= 0.
            || saved.beta1 >= 1.
            || !saved.beta2.is_finite()
            || saved.beta2 <= 0.
            || saved.beta2 >= 1.
            || !saved.epsilon.is_finite()
            || saved.epsilon <= 0.
            || (saved.steps == 0 && !saved.moments.is_empty())
            || (saved.steps > 0 && saved.moments.keys().ne(parameters.keys()))
        {
            return Err(OptimizerError::Invalid(
                "invalid AdamW checkpoint metadata or keys",
            ));
        }
        let mut states = BTreeMap::new();
        for (name, tensor) in parameters {
            if tensor.values().iter().any(|v| !v.is_finite()) {
                return Err(OptimizerError::Parameter(format!(
                    "invalid parameter values in checkpoint: {name}"
                )));
            }
            if saved.steps == 0 {
                continue;
            }
            let (first, second) = &saved.moments[name];
            let count = tensor.values().len();
            if first.len() != count
                || second.len() != count
                || first.iter().chain(second).any(|v| !v.is_finite())
                || second.iter().any(|&v| v < 0.)
            {
                return Err(OptimizerError::Parameter(format!(
                    "invalid AdamW moments in checkpoint: {name}"
                )));
            }
            states.insert(
                name.clone(),
                Moments {
                    first: first.clone(),
                    second: second.clone(),
                },
            );
        }
        Ok(Self {
            learning_rate: saved.learning_rate,
            weight_decay: saved.weight_decay,
            beta1: saved.beta1,
            beta2: saved.beta2,
            epsilon: saved.epsilon,
            steps: saved.steps,
            states,
        })
    }

    pub fn steps(&self) -> u64 {
        self.steps
    }
    pub fn learning_rate(&self) -> f32 {
        self.learning_rate
    }

    /// One atomic step for an explicitly selected *exact* parameter set.
    /// Reject missing/extra gradients, mismatched shapes and non-finite values
    /// before mutating state or any parameter. No implicit decoupled weight
    /// decay on unselected/frozen model weights.
    pub fn step(
        &mut self,
        parameters: &mut BTreeMap<String, Tensor<f32>>,
        gradients: &BTreeMap<String, Tensor<f32>>,
    ) -> Result<(), OptimizerError> {
        if parameters.is_empty()
            || parameters.len() != gradients.len()
            || parameters.keys().ne(gradients.keys())
        {
            return Err(OptimizerError::Invalid(
                "parameters and gradients require matching nonempty names",
            ));
        }
        let next_step = self
            .steps
            .checked_add(1)
            .ok_or(OptimizerError::Invalid("optimizer step counter overflow"))?;
        let b1_correction = 1. - self.beta1.powf(next_step as f32);
        let b2_correction = 1. - self.beta2.powf(next_step as f32);
        if b1_correction <= 0. || b2_correction <= 0. {
            return Err(OptimizerError::Invalid("bias correction underflow"));
        }

        let mut new_params = BTreeMap::new();
        let mut new_states = self.states.clone();
        for (name, parameter) in parameters.iter() {
            let gradient = &gradients[name];
            if parameter.shape() != gradient.shape()
                || parameter
                    .values()
                    .iter()
                    .chain(gradient.values())
                    .any(|v| !v.is_finite())
            {
                return Err(OptimizerError::Parameter(format!(
                    "invalid shape or non-finite tensor: {name}"
                )));
            }
            let count = parameter.values().len();
            let state = new_states.entry(name.clone()).or_insert_with(|| Moments {
                first: vec![0.; count],
                second: vec![0.; count],
            });
            if state.first.len() != count || state.second.len() != count {
                return Err(OptimizerError::Parameter(format!(
                    "optimizer state shape changed: {name}"
                )));
            }
            let mut next = Vec::with_capacity(count);
            for (i, (&value, &gradient)) in
                parameter.values().iter().zip(gradient.values()).enumerate()
            {
                state.first[i] = self.beta1 * state.first[i] + (1. - self.beta1) * gradient;
                state.second[i] =
                    self.beta2 * state.second[i] + (1. - self.beta2) * gradient * gradient;
                let m_hat = state.first[i] / b1_correction;
                let v_hat = state.second[i] / b2_correction;
                let update = m_hat / (v_hat.sqrt() + self.epsilon);
                let next_value = value - self.learning_rate * (update + self.weight_decay * value);
                if !next_value.is_finite() {
                    return Err(OptimizerError::Parameter(format!(
                        "non-finite update: {name}"
                    )));
                }
                next.push(next_value);
            }
            new_params.insert(
                name.clone(),
                Tensor::new(parameter.shape().clone(), next)
                    .map_err(|_| OptimizerError::Parameter(format!("invalid tensor: {name}")))?,
            );
        }
        *parameters = new_params;
        self.states = new_states;
        self.steps = next_step;
        Ok(())
    }
}

FILE	crates/verineural/src/primitive.rs
//! Versioned consumer-defined composite primitives lowered through typed Semantic IR.
//! This DSL deliberately cannot wrap opaque host callbacks or pretend to certify
//! unsupported backend operations.
use crate::{MathContract, NeuralError, NeuralGraph, NeuralModule, NodeId, Operation, Shape};

#[derive(Clone, Debug, PartialEq, Eq)]
pub enum PrimitiveExpr {
    Port(usize),
    Apply(Operation, Vec<PrimitiveExpr>),
}

// Inherent fluent methods are part of the consumer DSL's stable API.
// std::ops traits would require consumers to import the traits for method syntax.
#[allow(clippy::should_implement_trait)]
impl PrimitiveExpr {
    pub const fn port(index: usize) -> Self {
        Self::Port(index)
    }

    pub fn apply(operation: Operation, inputs: impl IntoIterator<Item = Self>) -> Self {
        Self::Apply(operation, inputs.into_iter().collect())
    }

    pub fn add(self, rhs: Self) -> Self {
        Self::apply(Operation::Add, [self, rhs])
    }

    pub fn mul(self, rhs: Self) -> Self {
        Self::apply(Operation::Mul, [self, rhs])
    }

    pub fn matmul(self, rhs: Self) -> Self {
        Self::apply(Operation::MatMul, [self, rhs])
    }

    pub fn bias_add(self, bias: Self) -> Self {
        Self::apply(Operation::BiasAdd, [self, bias])
    }

    pub fn relu(self) -> Self {
        Self::apply(Operation::Relu, [self])
    }

    pub fn positive_mask(self) -> Self {
        Self::apply(Operation::PositiveMask, [self])
    }

    pub fn select_positive(self, when_positive: Self, otherwise: Self) -> Self {
        Self::apply(Operation::SelectPositive, [self, when_positive, otherwise])
    }

    pub fn sqrt(self) -> Self {
        Self::apply(Operation::Sqrt, [self])
    }

    pub fn reshape(self, shape: Shape) -> Self {
        Self::apply(Operation::Reshape(shape), [self])
    }

    /// General row-major axis reduction, not a specialized neural block.
    pub fn reduce_sum(self, axis: usize) -> Self {
        Self::apply(Operation::ReduceSum { axis }, [self])
    }

    fn lower(&self, graph: &mut NeuralGraph, ports: &[NodeId]) -> Result<NodeId, NeuralError> {
        match self {
            Self::Port(index) => ports.get(*index).copied().ok_or(NeuralError::InvalidNode),
            Self::Apply(operation, inputs) => {
                let ids = inputs
                    .iter()
                    .map(|e| e.lower(graph, ports))
                    .collect::<Result<Vec<_>, _>>()?;
                graph.apply(operation.clone(), &ids)
            }
        }
    }
}

/// A versioned composite declaration lowered entirely through existing typed
/// operations. It reduces consumer boilerplate, but does not extend the atomic
/// operation set.
#[derive(Clone, Debug)]
pub struct PrimitiveSpec {
    pub id: &'static str,
    pub version: &'static str,
    pub contract: MathContract,
    pub expression: PrimitiveExpr,
}

impl PrimitiveSpec {
    pub fn new(
        id: &'static str,
        version: &'static str,
        contract: MathContract,
        expression: PrimitiveExpr,
    ) -> Result<Self, NeuralError> {
        if id.is_empty() || version.is_empty() {
            return Err(NeuralError::ContractViolation {
                module: id,
                detail: "primitive id and version must be nonempty",
            });
        }
        Ok(Self {
            id,
            version,
            contract,
            expression,
        })
    }

    pub fn apply(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        graph.apply_module(self, inputs)
    }
}

impl NeuralModule for PrimitiveSpec {
    fn name(&self) -> &'static str {
        self.id
    }
    fn contract(&self) -> &MathContract {
        &self.contract
    }
    fn semantic_version(&self) -> &'static str {
        self.version
    }
    fn build(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        self.expression.lower(graph, inputs)
    }
}

/// A small total elementwise mathematical language. Every argument has the
/// same shape. This AST, not a Rust callback, is the semantic source of truth.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum PointwiseExpr {
    Input(usize),
    Add(Box<Self>, Box<Self>),
    Mul(Box<Self>, Box<Self>),
    Sub(Box<Self>, Box<Self>),
    Div(Box<Self>, Box<Self>),
    Exp(Box<Self>),
    Sqrt(Box<Self>),
    Relu(Box<Self>),
}

// Preserve the same fluent expression-building API as PrimitiveExpr.
#[allow(clippy::should_implement_trait)]
impl PointwiseExpr {
    pub fn input(index: usize) -> Self {
        Self::Input(index)
    }

    pub fn add(self, rhs: Self) -> Self {
        Self::Add(Box::new(self), Box::new(rhs))
    }

    pub fn mul(self, rhs: Self) -> Self {
        Self::Mul(Box::new(self), Box::new(rhs))
    }

    pub fn sub(self, rhs: Self) -> Self {
        Self::Sub(Box::new(self), Box::new(rhs))
    }
    pub fn div(self, rhs: Self) -> Self {
        Self::Div(Box::new(self), Box::new(rhs))
    }
    pub fn exp(self) -> Self {
        Self::Exp(Box::new(self))
    }
    pub fn sqrt(self) -> Self {
        Self::Sqrt(Box::new(self))
    }
    pub fn relu(self) -> Self {
        Self::Relu(Box::new(self))
    }

    pub(crate) fn has_ideal_int_semantics(&self) -> bool {
        match self {
            Self::Input(_) => true,
            Self::Add(a, b) | Self::Mul(a, b) => {
                a.has_ideal_int_semantics() && b.has_ideal_int_semantics()
            }
            Self::Relu(a) => a.has_ideal_int_semantics(),
            Self::Sub(..) | Self::Div(..) | Self::Exp(..) | Self::Sqrt(..) => false,
        }
    }

    fn valid(&self, arity: usize, remaining_depth: usize) -> bool {
        if remaining_depth == 0 {
            return false;
        }
        match self {
            Self::Input(index) => *index < arity,
            Self::Add(a, b) | Self::Mul(a, b) | Self::Sub(a, b) | Self::Div(a, b) => {
                a.valid(arity, remaining_depth - 1) && b.valid(arity, remaining_depth - 1)
            }
            Self::Relu(a) | Self::Exp(a) | Self::Sqrt(a) => a.valid(arity, remaining_depth - 1),
        }
    }

    /// Canonical, unambiguous expression encoding for semantic fingerprints.
    pub fn canonical(&self) -> String {
        match self {
            Self::Input(port) => format!("arg:{port}"),
            Self::Add(a, b) => format!("add({},{})", a.canonical(), b.canonical()),
            Self::Mul(a, b) => format!("mul({},{})", a.canonical(), b.canonical()),
            Self::Sub(a, b) => format!("sub({},{})", a.canonical(), b.canonical()),
            Self::Div(a, b) => format!("div({},{})", a.canonical(), b.canonical()),
            Self::Exp(a) => format!("exp({})", a.canonical()),
            Self::Sqrt(a) => format!("sqrt({})", a.canonical()),
            Self::Relu(a) => format!("relu({})", a.canonical()),
        }
    }

    /// The Lean interpretation is derived entirely from this same AST.
    /// The caller provides graph-specific, validated tensor references.
    pub(crate) fn lean(&self, input: &impl Fn(usize) -> String) -> String {
        match self {
            // A substituted graph term may itself be an application with
            // named arguments (for example matmul). Keep it atomic when
            // an enclosing pointwise operator consumes it.
            Self::Input(port) => format!("({})", input(*port)),
            Self::Add(a, b) => {
                format!("(VeriNeural.add {} {})", a.lean(input), b.lean(input))
            }
            Self::Mul(a, b) => {
                format!("(VeriNeural.mul {} {})", a.lean(input), b.lean(input))
            }
            Self::Relu(a) => format!("(VeriNeural.relu {})", a.lean(input)),
            Self::Sub(..) | Self::Div(..) | Self::Exp(..) | Self::Sqrt(..) => {
                unreachable!(
                    "unsupported pointwise expression must be rejected before Lean generation"
                )
            }
        }
    }

    /// Independent ideal-Int theorem rule for an unconditional final ReLU.
    /// All other expressions require a different proof rule: fail closed.
    pub(crate) fn nonnegative_lean(&self, input: &impl Fn(usize) -> String) -> Option<String> {
        if !self.has_ideal_int_semantics() {
            return None;
        }
        match self {
            Self::Relu(inner) => Some(format!("VeriNeural.relu_nonnegative {}", inner.lean(input))),
            _ => None,
        }
    }

    fn evaluate(&self, input: &impl Fn(usize) -> f32) -> f32 {
        match self {
            Self::Input(port) => input(*port),
            Self::Add(a, b) => a.evaluate(input) + b.evaluate(input),
            Self::Mul(a, b) => a.evaluate(input) * b.evaluate(input),
            Self::Sub(a, b) => a.evaluate(input) - b.evaluate(input),
            Self::Div(a, b) => a.evaluate(input) / b.evaluate(input),
            Self::Exp(a) => a.evaluate(input).exp(),
            Self::Sqrt(a) => a.evaluate(input).sqrt(),
            Self::Relu(inner) => {
                let value = inner.evaluate(input);
                if value.is_nan() || value > 0.0 {
                    value
                } else {
                    0.0
                }
            }
        }
    }
}

/// A genuine single IR operation defined by a consumer, not a pre-expanded
/// neural module. Only supported pointwise AST semantics can be registered.
/// Lean models the ideal integer expression; GPU and FP32 proof backends reject
/// this operation until they implement corresponding verified lowerings.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct PointwiseSpec {
    id: &'static str,
    version: &'static str,
    arity: usize,
    expression: PointwiseExpr,
}

impl PointwiseSpec {
    pub fn new(
        id: &'static str,
        version: &'static str,
        arity: usize,
        expression: PointwiseExpr,
    ) -> Result<Self, NeuralError> {
        if id.is_empty() || version.is_empty() || arity == 0 {
            return Err(NeuralError::ContractViolation {
                module: id,
                detail: "pointwise primitive requires id, version and at least one input",
            });
        }
        // Bounds recursion and artifact sizes; never execute opaque Rust code.
        if !expression.valid(arity, 64) {
            return Err(NeuralError::ContractViolation {
                module: id,
                detail: "expression refers to an invalid input or exceeds 63 levels",
            });
        }
        Ok(Self {
            id,
            version,
            arity,
            expression,
        })
    }

    pub fn id(&self) -> &'static str {
        self.id
    }
    pub fn version(&self) -> &'static str {
        self.version
    }
    pub const fn arity(&self) -> usize {
        self.arity
    }
    pub fn expression(&self) -> &PointwiseExpr {
        &self.expression
    }

    pub fn apply(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        graph.apply(Operation::Pointwise(self.clone()), inputs)
    }

    /// Host reference only, not a floating-point certification or GPU backend.
    pub fn evaluate_host(
        &self,
        inputs: &[crate::Tensor<f32>],
    ) -> Result<crate::Tensor<f32>, NeuralError> {
        let shapes = inputs
            .iter()
            .map(|tensor| tensor.shape().clone())
            .collect::<Vec<_>>();
        let output_shape = Operation::Pointwise(self.clone()).infer_shape(&shapes)?;
        let values = (0..output_shape.element_count())
            .map(|element| {
                self.expression
                    .evaluate(&|port| inputs[port].values()[element])
            })
            .collect::<Vec<_>>();
        crate::Tensor::new(output_shape, values)
    }
}

#[cfg(test)]
mod lean_term_tests {
    use super::PointwiseExpr;

    #[test]
    fn substituted_matmul_application_is_one_lean_argument() {
        let matmul = "VeriNeural.matmul (m := 2) (k := 2) (n := 2) p_0 p_1";
        let input = |_port| matmul.to_owned();
        let relu = PointwiseExpr::input(0).relu();
        assert_eq!(relu.lean(&input), format!("(VeriNeural.relu ({matmul}))"));
        assert_eq!(
            relu.nonnegative_lean(&input),
            Some(format!("VeriNeural.relu_nonnegative ({matmul})"))
        );

        // Parenthesization must hold for multiple substituted operands too.
        let sum = PointwiseExpr::input(0).add(PointwiseExpr::input(1));
        assert_eq!(
            sum.lean(&input),
            format!("(VeriNeural.add ({matmul}) ({matmul}))")
        );
    }
}

FILE	crates/verineural/src/proof.rs
//! Lean 4 proof generation for the deliberately narrow, ideal-integer fragment.
//!
//! The verified statement concerns the generated Lean model, not Rust f32
//! execution, FP32 rounding, generated PTX, or physical GPU execution.

use std::collections::{BTreeMap, BTreeSet};
use std::error::Error;
use std::fmt;
use std::fs;
use std::path::{Path, PathBuf};
use std::process::Command;

use crate::{
    ContractClaim, DType, Domain, FixedScan, ModuleInstanceRef, NeuralError, NeuralGraph, NodeId,
    Operation, Predicate, Shape, ValueRef,
};

const LEAN_LIBRARY: &str = include_str!("../../../lean/VeriNeural/Basic.lean");

#[derive(Debug)]
pub enum ProofError {
    InvalidGraph(NeuralError),
    UnsupportedOperation {
        node: usize,
        operation: &'static str,
    },
    UnsupportedGuarantee {
        node: usize,
    },
    InvalidAssumption {
        node: usize,
    },
    InvalidGoalName,
    InvalidOutputs,
    ModuleDefinitionMismatch {
        representative: usize,
        other: usize,
    },
    InvalidScan,
    Io(std::io::Error),
    LeanRejected {
        details: String,
    },
}

impl fmt::Display for ProofError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::InvalidGraph(error) => write!(f, "invalid neural graph: {error}"),
            Self::UnsupportedOperation { node, operation } => {
                write!(
                    f,
                    "Lean proof backend cannot model {operation} at node {node}"
                )
            }
            Self::UnsupportedGuarantee { node } => {
                write!(
                    f,
                    "Lean proof backend cannot establish requested guarantee at node {node}"
                )
            }
            Self::InvalidAssumption { node } => {
                write!(
                    f,
                    "global proof assumption at node {node} must be a reachable source input"
                )
            }
            Self::InvalidGoalName => {
                write!(f, "property name must be a nonempty Lean-safe identifier")
            }
            Self::InvalidOutputs => {
                write!(
                    f,
                    "Lean proof requires a nonempty set of distinct output nodes"
                )
            }
            Self::ModuleDefinitionMismatch {
                representative,
                other,
            } => write!(
                f,
                "module instances {representative} and {other} do not share one reusable semantic definition"
            ),
            Self::InvalidScan => write!(f, "invalid bounded scan or missing state invariant claim"),
            Self::Io(error) => write!(f, "Lean checker I/O failure: {error}"),
            Self::LeanRejected { details } => write!(f, "Lean proof rejected: {details}"),
        }
    }
}

impl Error for ProofError {
    fn source(&self) -> Option<&(dyn Error + 'static)> {
        match self {
            Self::InvalidGraph(error) => Some(error),
            Self::Io(error) => Some(error),
            _ => None,
        }
    }
}

impl From<NeuralError> for ProofError {
    fn from(value: NeuralError) -> Self {
        Self::InvalidGraph(value)
    }
}

impl From<std::io::Error> for ProofError {
    fn from(value: std::io::Error) -> Self {
        Self::Io(value)
    }
}

/// A source-node hypothesis in the theorem, never an unconditional conclusion.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct ProofAssumption {
    pub input_node: usize,
    pub domain: Domain,
}

/// A requested independent ideal-integer property (not a shape theorem).
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum ProofGoalKind {
    Nonnegative {
        assumptions: Vec<NodeId>,
    },
    EqualTo {
        other: NodeId,
    },
    /// A single independent, explicitly typed mathematical relation.
    Predicate(Predicate),
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct ProofGoal {
    pub name: String,
    pub output: NodeId,
    pub kind: ProofGoalKind,
}

/// The certified policy admits Lean's foundational `propext` axiom as TCB.
/// Additional axioms require an explicit policy review.
const ALLOWED_LEAN_AXIOMS: &[&str] = &["propext"];

/// Exact audit result, including allowed transitive axiom dependencies.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct LeanAxiomAudit {
    pub lean_version: String,
    pub theorem_names: Vec<String>,
    pub axiom_dependencies: BTreeMap<String, Vec<String>>,
}

/// Require one exact Lean response for every expected theorem.
/// Fail closed on malformed output or any non-allowlisted dependency.
fn parse_axiom_report(
    stdout: &str,
    theorems: &[String],
) -> Result<BTreeMap<String, Vec<String>>, ProofError> {
    let lines = stdout
        .lines()
        .filter(|line| !line.trim().is_empty())
        .collect::<Vec<_>>();
    if lines.len() != theorems.len() {
        return Err(ProofError::LeanRejected {
            details: "unexpected axiom report length".into(),
        });
    }
    let mut dependencies = BTreeMap::new();
    for (name, line) in theorems.iter().zip(lines) {
        let expected = format!("'VeriNeural.Generated.{name}'");
        let rest = line
            .strip_prefix(&expected)
            .ok_or_else(|| ProofError::LeanRejected {
                details: format!("unexpected axiom theorem identity: {line}"),
            })?;
        let axioms = if rest == " does not depend on any axioms" {
            Vec::new()
        } else if let Some(items) = rest
            .strip_prefix(" depends on axioms: [")
            .and_then(|s| s.strip_suffix(']'))
        {
            items.split(", ").map(str::to_owned).collect::<Vec<_>>()
        } else {
            return Err(ProofError::LeanRejected {
                details: format!("malformed axiom report: {line}"),
            });
        };
        if axioms
            .iter()
            .any(|name| name.is_empty() || !ALLOWED_LEAN_AXIOMS.contains(&name.as_str()))
        {
            return Err(ProofError::LeanRejected {
                details: format!("unapproved axiom dependencies for {name}: {axioms:?}"),
            });
        }
        if dependencies.insert(name.clone(), axioms).is_some() {
            return Err(ProofError::LeanRejected {
                details: format!("duplicate theorem: {name}"),
            });
        }
    }
    Ok(dependencies)
}

/// Generated Lean source and a list of obligations. Generation is not proof.
#[derive(Clone, Debug)]
pub struct LeanProgram {
    source: String,
    theorems: Vec<String>,
    assumptions: Vec<ProofAssumption>,
}

impl LeanProgram {
    pub(crate) fn generated(
        source: String,
        theorems: Vec<String>,
        assumptions: Vec<ProofAssumption>,
    ) -> Self {
        Self {
            source,
            theorems,
            assumptions,
        }
    }

    pub fn source(&self) -> &str {
        &self.source
    }

    pub fn theorem_names(&self) -> &[String] {
        &self.theorems
    }

    pub fn assumptions(&self) -> &[ProofAssumption] {
        &self.assumptions
    }
}

/// Produced only after the configured Lean executable exits successfully
/// without warnings or other diagnostics. This is NOT a GPU certificate.
#[derive(Clone, Debug)]
pub struct CheckedLean {
    pub path: PathBuf,
    pub theorem_names: Vec<String>,
    pub assumptions: Vec<ProofAssumption>,
}

/// An external Lean 4 checker. The executable and Lean's kernel belong to TCB.
#[derive(Clone, Debug)]
pub struct LeanProofEngine {
    executable: PathBuf,
}

impl Default for LeanProofEngine {
    fn default() -> Self {
        Self::new("lean")
    }
}

impl LeanProofEngine {
    pub fn new(executable: impl Into<PathBuf>) -> Self {
        Self {
            executable: executable.into(),
        }
    }

    /// Produce Lean definitions and theorems for the ancestry of one output.
    ///
    /// Only Add, Mul, Relu and Reshape have integer ideal semantics in stage 3.
    /// Sqrt and MatMul fail closed, even though they are available to the Rust
    /// reference engine. The input nonnegativity assumptions are explicit.
    pub fn generate(&self, graph: &NeuralGraph, output: NodeId) -> Result<LeanProgram, ProofError> {
        self.generate_outputs(graph, &[output])
    }

    /// Generate one consistent Lean model and *all* reachable obligations for
    /// several outputs, including distinct named ports of a multi-output module.
    /// This is a single ideal-Int proof artifact, not a GPU or FP32 certificate.
    /// Requests are required to be nonempty and distinct; foreign nodes fail.
    pub fn generate_outputs(
        &self,
        graph: &NeuralGraph,
        outputs: &[NodeId],
    ) -> Result<LeanProgram, ProofError> {
        if outputs.is_empty() {
            return Err(ProofError::InvalidOutputs);
        }
        let mut seen = BTreeSet::new();
        for &output in outputs {
            graph.node(output)?;
            if !seen.insert(output.index()) {
                return Err(ProofError::InvalidOutputs);
            }
        }
        let used = graph.dependency_scope(outputs)?;
        for &index in &used {
            let node = &graph.nodes()[index];
            match node.operation {
                Operation::Pointwise(ref spec) if !spec.expression().has_ideal_int_semantics() => {
                    return Err(ProofError::UnsupportedOperation {
                        node: index,
                        operation: node.operation.name(),
                    });
                }
                Operation::Input
                | Operation::Add
                | Operation::Mul
                | Operation::MatMul
                | Operation::BiasAdd
                | Operation::Relu
                | Operation::PositiveMask
                | Operation::SelectPositive
                | Operation::Reshape(_)
                | Operation::Pointwise(_)
                | Operation::ReduceSum { .. }
                | Operation::ReverseAxis { .. }
                | Operation::Concat { .. }
                | Operation::SliceAxis { .. }
                | Operation::ArgMax { .. }
                | Operation::Take { .. } => {}
                Operation::Permute { ref axes } => {
                    let input = graph.node(node.inputs[0])?;
                    let identity = axes.iter().copied().eq(0..axes.len());
                    let transpose_2d = input.shape.rank() == 2 && axes.as_slice() == [1, 0];
                    if !identity && !transpose_2d {
                        return Err(ProofError::UnsupportedOperation {
                            node: index,
                            operation: node.operation.name(),
                        });
                    }
                }
                _ => {
                    return Err(ProofError::UnsupportedOperation {
                        node: index,
                        operation: node.operation.name(),
                    });
                }
            }
        }

        let sources = used
            .iter()
            .filter(|&&index| matches!(graph.nodes()[index].operation, Operation::Input))
            .copied()
            .collect::<Vec<_>>();
        let assumptions = sources
            .iter()
            .filter(|&&i| graph.nodes()[i].domain == Domain::NonNegativeFinite)
            .map(|&i| ProofAssumption {
                input_node: i,
                domain: Domain::NonNegativeFinite,
            })
            .collect::<Vec<_>>();

        let params = sources
            .iter()
            .map(|&i| {
                format!(
                    "(x_{i} : {})",
                    lean_value_type(
                        graph.nodes()[i].dtype,
                        graph.nodes()[i].shape.element_count()
                    )
                )
            })
            .collect::<Vec<_>>()
            .join(" ");
        let arguments = sources
            .iter()
            .map(|&i| format!("x_{i}"))
            .collect::<Vec<_>>()
            .join(" ");
        let hypothesis_params = assumptions
            .iter()
            .map(|a| {
                format!(
                    "(h_{} : VeriNeural.Nonnegative x_{})",
                    a.input_node, a.input_node
                )
            })
            .collect::<Vec<_>>()
            .join(" ");
        let hypothesis_args = assumptions
            .iter()
            .map(|a| format!("h_{}", a.input_node))
            .collect::<Vec<_>>()
            .join(" ");
        let proof_params = format!("{params} {hypothesis_params}");
        let proof_args = format!("{arguments} {hypothesis_args}");
        let call = |index: usize| format!("(node_{index} {arguments})");
        let proof_call = |index: usize| format!("node_{index}_nonnegative {proof_args}");
        let source_hypotheses = assumptions
            .iter()
            .map(|assumption| assumption.input_node)
            .collect::<BTreeSet<_>>();
        let claim_context = IdealNonnegativeClaimContext {
            params: &params,
            arguments: &arguments,
            assumptions: &assumptions,
            source_hypotheses: &source_hypotheses,
        };

        let mut source = String::from(LEAN_LIBRARY);
        source.push_str("\n\nnamespace VeriNeural.Generated\n\n");
        let mut theorems = Vec::new();

        for &index in &used {
            let node = &graph.nodes()[index];
            let count = node.shape.element_count();
            let rhs = match &node.operation {
                Operation::Input => format!("x_{index}"),
                Operation::Add => format!(
                    "VeriNeural.add {} {}",
                    call(node.inputs[0].index()),
                    call(node.inputs[1].index())
                ),
                Operation::Mul => format!(
                    "VeriNeural.mul {} {}",
                    call(node.inputs[0].index()),
                    call(node.inputs[1].index())
                ),
                Operation::MatMul => {
                    let left = graph.node(node.inputs[0])?;
                    let right = graph.node(node.inputs[1])?;
                    let m = left.shape.dims()[0];
                    let k = left.shape.dims()[1];
                    let n = right.shape.dims()[1];
                    format!(
                        "VeriNeural.matmul (m := {m}) (k := {k}) (n := {n}) {} {}",
                        call(node.inputs[0].index()),
                        call(node.inputs[1].index())
                    )
                }
                Operation::BiasAdd => {
                    let m = node.shape.dims()[0];
                    let n = node.shape.dims()[1];
                    format!(
                        "VeriNeural.biasAdd (m := {m}) (n := {n}) {} {}",
                        call(node.inputs[0].index()),
                        call(node.inputs[1].index())
                    )
                }
                Operation::Relu => {
                    format!("VeriNeural.relu {}", call(node.inputs[0].index()))
                }
                Operation::PositiveMask => {
                    format!("VeriNeural.positiveMask {}", call(node.inputs[0].index()))
                }
                Operation::SelectPositive => {
                    format!(
                        "VeriNeural.selectPositive {} {} {}",
                        call(node.inputs[0].index()),
                        call(node.inputs[1].index()),
                        call(node.inputs[2].index())
                    )
                }
                Operation::Reshape(_) => {
                    format!("VeriNeural.reshape {}", call(node.inputs[0].index()))
                }
                Operation::Pointwise(spec) => spec
                    .expression()
                    .lean(&|port| call(node.inputs[port].index())),
                Operation::ReduceSum { axis } => {
                    let input = graph.node(node.inputs[0])?;
                    let (outer, width, inner) = axis_factors(&input.shape, *axis);
                    format!(
                        "VeriNeural.reduceSumAxis (outer := {outer}) (width := {width}) \
                         (inner := {inner}) {}",
                        call(node.inputs[0].index())
                    )
                }
                Operation::Permute { axes } => {
                    let input = graph.node(node.inputs[0])?;
                    if axes.iter().copied().eq(0..axes.len()) {
                        format!("VeriNeural.reshape {}", call(node.inputs[0].index()))
                    } else {
                        let dims = input.shape.dims();
                        format!(
                            "VeriNeural.transpose2D (rows := {}) (cols := {}) {}",
                            dims[0],
                            dims[1],
                            call(node.inputs[0].index())
                        )
                    }
                }
                Operation::ReverseAxis { axis } => {
                    let input = graph.node(node.inputs[0])?;
                    let (outer, width, inner) = axis_factors(&input.shape, *axis);
                    format!(
                        "VeriNeural.reverseAxis (outer := {outer}) (width := {width}) \
                         (inner := {inner}) {}",
                        call(node.inputs[0].index())
                    )
                }
                Operation::SliceAxis { axis, start, len } => {
                    let input = graph.node(node.inputs[0])?;
                    let (outer, width, inner) = axis_factors(&input.shape, *axis);
                    format!(
                        "VeriNeural.sliceAxis (outer := {outer}) (width := {width})                          (inner := {inner}) (start := {start}) (len := {len}) {}",
                        call(node.inputs[0].index())
                    )
                }
                Operation::Concat { axis } => {
                    let left = graph.node(node.inputs[0])?;
                    let right = graph.node(node.inputs[1])?;
                    let (outer, left_width, inner) = axis_factors(&left.shape, *axis);
                    let (_, right_width, _) = axis_factors(&right.shape, *axis);
                    format!(
                        "VeriNeural.concatAxis (outer := {outer}) (leftWidth := {left_width}) \
                         (rightWidth := {right_width}) (inner := {inner}) {} {}",
                        call(node.inputs[0].index()),
                        call(node.inputs[1].index())
                    )
                }
                Operation::ArgMax { axis, .. } => {
                    let input = graph.node(node.inputs[0])?;
                    let (outer, width, inner) = axis_factors(&input.shape, *axis);
                    format!(
                        "VeriNeural.argMaxFirstAxis (outer := {outer}) (width := {width}) \
                         (inner := {inner}) {}",
                        call(node.inputs[0].index())
                    )
                }
                Operation::Take { axis } => {
                    let data = graph.node(node.inputs[0])?;
                    let (outer, width, inner) = axis_factors(&data.shape, *axis);
                    format!(
                        "VeriNeural.takeAxis (outer := {outer}) (width := {width}) \
                         (inner := {inner}) {} {}",
                        call(node.inputs[0].index()),
                        call(node.inputs[1].index())
                    )
                }
                _ => unreachable!("checked while collecting ancestors"),
            };

            // Every node accepts the shared graph inputs for stable calling
            // conventions. An input node consumes only its own binder; mark
            // the other binders intentionally unused to avoid Lean warnings.
            let definition_params = if matches!(node.operation, Operation::Input) {
                sources
                    .iter()
                    .map(|&source_index| {
                        let binder = if source_index == index {
                            format!("x_{source_index}")
                        } else {
                            format!("_x_{source_index}")
                        };
                        format!(
                            "({binder} : {})",
                            lean_value_type(
                                graph.nodes()[source_index].dtype,
                                graph.nodes()[source_index].shape.element_count()
                            )
                        )
                    })
                    .collect::<Vec<_>>()
                    .join(" ")
            } else {
                params.clone()
            };
            let value_type = lean_value_type(node.dtype, count);
            source.push_str(&format!(
                "def node_{index} {definition_params} : {value_type} :=\n  {rhs}\n\n"
            ));

            let name = format!("node_{index}_shape");
            emit_decidable(
                &mut source,
                &mut theorems,
                name,
                format!("VeriNeural.shapeSize {} = {count}", shape_expr(&node.shape)),
            );

            for (port, &input_id) in node.inputs.iter().enumerate() {
                let predecessor = graph.node(input_id)?;
                let name = format!("node_{index}_input_{port}_shape");
                let premise = if matches!(node.operation, Operation::MatMul) {
                    let left = graph.node(node.inputs[0])?;
                    let right = graph.node(node.inputs[1])?;
                    format!("{} = {}", left.shape.dims()[1], right.shape.dims()[0])
                } else if matches!(node.operation, Operation::BiasAdd) && port == 1 {
                    format!("{} = {}", predecessor.shape.dims()[0], node.shape.dims()[1])
                } else if matches!(node.operation, Operation::ReduceSum { .. }) {
                    let dims = predecessor.shape.dims();
                    let axis = match &node.operation {
                        Operation::ReduceSum { axis } => *axis,
                        _ => unreachable!(),
                    };
                    let outer = dims[..axis].iter().product::<usize>();
                    let width = dims[axis];
                    let inner = dims[axis + 1..].iter().product::<usize>();
                    format!(
                        "VeriNeural.shapeSize {} = {outer} * {width} * {inner}",
                        shape_expr(&predecessor.shape)
                    )
                } else if matches!(node.operation, Operation::Permute { .. }) {
                    format!(
                        "VeriNeural.shapeSize {} = VeriNeural.shapeSize {}",
                        shape_expr(&predecessor.shape),
                        shape_expr(&node.shape)
                    )
                } else if matches!(node.operation, Operation::SliceAxis { .. }) {
                    let (axis, start, len) = match &node.operation {
                        Operation::SliceAxis { axis, start, len } => (*axis, *start, *len),
                        _ => unreachable!(),
                    };
                    let (outer, width, inner) = axis_factors(&predecessor.shape, axis);
                    format!(
                        "VeriNeural.shapeSize {} = {outer} * {width} * {inner} ∧                          {start} + {len} ≤ {width}",
                        shape_expr(&predecessor.shape)
                    )
                } else if matches!(node.operation, Operation::Concat { .. }) {
                    let axis = match &node.operation {
                        Operation::Concat { axis } => *axis,
                        _ => unreachable!(),
                    };
                    let (outer, width, inner) = axis_factors(&predecessor.shape, axis);
                    format!(
                        "VeriNeural.shapeSize {} = {outer} * {width} * {inner}",
                        shape_expr(&predecessor.shape)
                    )
                } else if matches!(node.operation, Operation::ArgMax { .. }) {
                    let axis = match &node.operation {
                        Operation::ArgMax { axis, .. } => *axis,
                        _ => unreachable!(),
                    };
                    let (outer, width, inner) = axis_factors(&predecessor.shape, axis);
                    format!(
                        "VeriNeural.shapeSize {} = {outer} * {width} * {inner}",
                        shape_expr(&predecessor.shape)
                    )
                } else if matches!(node.operation, Operation::Take { .. }) {
                    if port == 0 {
                        let axis = match &node.operation {
                            Operation::Take { axis } => *axis,
                            _ => unreachable!(),
                        };
                        let (outer, width, inner) = axis_factors(&predecessor.shape, axis);
                        format!(
                            "VeriNeural.shapeSize {} = {outer} * {width} * {inner}",
                            shape_expr(&predecessor.shape)
                        )
                    } else {
                        format!(
                            "VeriNeural.shapeSize {} = 1",
                            shape_expr(&predecessor.shape)
                        )
                    }
                } else if matches!(node.operation, Operation::Reshape(_)) {
                    format!(
                        "VeriNeural.shapeSize {} = VeriNeural.shapeSize {}",
                        shape_expr(&predecessor.shape),
                        shape_expr(&node.shape)
                    )
                } else {
                    format!(
                        "{} = {}",
                        shape_expr(&predecessor.shape),
                        shape_expr(&node.shape)
                    )
                };
                emit_decidable(&mut source, &mut theorems, name, premise);
            }

            let name = format!("node_{index}_semantics");
            source.push_str(&format!(
                "theorem {name} {params} (i : Fin {count}) :\n  node_{index} {arguments} i = ({rhs}) i := by\n  rfl\n\n"
            ));
            theorems.push(name);

            if node.domain == Domain::NonNegativeFinite {
                let proof = match node.operation {
                    Operation::Input => format!("h_{index}"),
                    Operation::Relu => {
                        format!(
                            "VeriNeural.relu_nonnegative {}",
                            call(node.inputs[0].index())
                        )
                    }
                    Operation::PositiveMask => {
                        format!(
                            "VeriNeural.positiveMask_nonnegative {}",
                            call(node.inputs[0].index())
                        )
                    }
                    Operation::SelectPositive => {
                        let yes = node.inputs[1].index();
                        let no = node.inputs[2].index();
                        format!(
                            "VeriNeural.selectPositive_nonnegative {} {} {} ({}) ({})",
                            call(node.inputs[0].index()),
                            call(yes),
                            call(no),
                            proof_call(yes),
                            proof_call(no)
                        )
                    }
                    Operation::Reshape(_) => {
                        let prev = node.inputs[0].index();
                        format!(
                            "VeriNeural.reshape_nonnegative {} ({})",
                            call(prev),
                            proof_call(prev)
                        )
                    }
                    Operation::Permute { ref axes } => {
                        let prev = node.inputs[0].index();
                        if axes.iter().copied().eq(0..axes.len()) {
                            format!(
                                "VeriNeural.reshape_nonnegative {} ({})",
                                call(prev),
                                proof_call(prev)
                            )
                        } else {
                            let dims = graph.nodes()[prev].shape.dims();
                            format!(
                                "VeriNeural.transpose2D_nonnegative (rows := {}) (cols := {}) {} ({})",
                                dims[0],
                                dims[1],
                                call(prev),
                                proof_call(prev)
                            )
                        }
                    }
                    Operation::ReverseAxis { axis } => {
                        let prev = node.inputs[0].index();
                        let (outer, width, inner) = axis_factors(&graph.nodes()[prev].shape, axis);
                        format!(
                            "VeriNeural.reverseAxis_nonnegative (outer := {outer}) \
                             (width := {width}) (inner := {inner}) {} ({})",
                            call(prev),
                            proof_call(prev)
                        )
                    }
                    Operation::SliceAxis { axis, start, len } => {
                        let input = node.inputs[0].index();
                        let (outer, width, inner) = axis_factors(&graph.nodes()[input].shape, axis);
                        format!(
                            "VeriNeural.sliceAxis_nonnegative (outer := {outer})                              (width := {width}) (inner := {inner}) (start := {start})                              (len := {len}) {} ({})",
                            call(input),
                            proof_call(input)
                        )
                    }
                    Operation::Concat { axis } => {
                        let left = node.inputs[0].index();
                        let right = node.inputs[1].index();
                        let (outer, left_width, inner) =
                            axis_factors(&graph.nodes()[left].shape, axis);
                        let (_, right_width, _) = axis_factors(&graph.nodes()[right].shape, axis);
                        format!(
                            "VeriNeural.concatAxis_nonnegative (outer := {outer}) \
                             (leftWidth := {left_width}) (rightWidth := {right_width}) \
                             (inner := {inner}) {} {} ({}) ({})",
                            call(left),
                            call(right),
                            proof_call(left),
                            proof_call(right)
                        )
                    }
                    Operation::Take { axis } => {
                        let data = node.inputs[0].index();
                        let selected = node.inputs[1].index();
                        let (outer, width, inner) = axis_factors(&graph.nodes()[data].shape, axis);
                        format!(
                            "VeriNeural.takeAxis_nonnegative (outer := {outer}) \
                             (width := {width}) (inner := {inner}) {} {} ({})",
                            call(data),
                            call(selected),
                            proof_call(data)
                        )
                    }
                    _ => return Err(ProofError::UnsupportedGuarantee { node: index }),
                };
                let name = format!("node_{index}_nonnegative");
                // Node-level input proofs only consume their own source hypothesis;
                // ReLU nonnegativity is unconditional. Keep every positional
                // parameter so existing proof applications remain unchanged, but
                // mark only genuinely unused binders with Lean's underscore prefix.
                let node_proof_params = if matches!(
                    node.operation,
                    Operation::Input | Operation::Relu | Operation::PositiveMask
                ) {
                    let hypothesis_binders = assumptions
                        .iter()
                        .map(|assumption| {
                            let source = assumption.input_node;
                            let used =
                                matches!(node.operation, Operation::Input) && source == index;
                            let binder = if used {
                                format!("h_{source}")
                            } else {
                                format!("_h_{source}")
                            };
                            format!("({binder} : VeriNeural.Nonnegative x_{source})")
                        })
                        .collect::<Vec<_>>()
                        .join(" ");
                    format!("{params} {hypothesis_binders}")
                } else {
                    proof_params.clone()
                };
                source.push_str(&format!(
                    "theorem {name} {node_proof_params} :\n  VeriNeural.Nonnegative {} := by\n  exact {proof}\n\n",
                    call(index)
                ));
                theorems.push(name);
            }
        }

        for (module_index, module) in graph.modules().iter().enumerate() {
            if !used.contains(&module.output.index()) {
                continue;
            }
            for (port, (&input, required)) in module
                .inputs
                .iter()
                .zip(&module.contract.requires)
                .enumerate()
            {
                let actual = graph.node(input)?;
                let name = format!("module_{module_index}_input_{port}_shape");
                emit_decidable(
                    &mut source,
                    &mut theorems,
                    name,
                    format!(
                        "{} = {}",
                        shape_expr(&actual.shape),
                        shape_expr(&required.shape)
                    ),
                );
                if required.domain == Domain::NonNegativeFinite {
                    if actual.domain != Domain::NonNegativeFinite {
                        return Err(ProofError::UnsupportedGuarantee {
                            node: input.index(),
                        });
                    }
                    emit_nonnegative_alias(
                        &mut source,
                        &mut theorems,
                        format!("module_{module_index}_input_{port}_nonnegative"),
                        &proof_params,
                        &call(input.index()),
                        &proof_call(input.index()),
                    );
                }
            }

            let actual = graph.node(module.output)?;
            emit_decidable(
                &mut source,
                &mut theorems,
                format!("module_{module_index}_output_shape"),
                format!(
                    "{} = {}",
                    shape_expr(&actual.shape),
                    shape_expr(&module.contract.ensures.shape)
                ),
            );
            if module.contract.ensures.domain == Domain::NonNegativeFinite {
                if actual.domain != Domain::NonNegativeFinite {
                    return Err(ProofError::UnsupportedGuarantee {
                        node: module.output.index(),
                    });
                }
                emit_nonnegative_alias(
                    &mut source,
                    &mut theorems,
                    format!("module_{module_index}_output_nonnegative"),
                    &proof_params,
                    &call(module.output.index()),
                    &proof_call(module.output.index()),
                );
            }
            for (claim_index, claim) in module.contract.claims.iter().enumerate() {
                let name = format!("module_{module_index}_claim_{claim_index}");
                match claim {
                    ContractClaim::Nonnegative => {
                        emit_ideal_nonnegative_claim(
                            graph,
                            &mut source,
                            &mut theorems,
                            name,
                            module.output,
                            &claim_context,
                        )?;
                    }
                    ContractClaim::EqualsInput(port) => {
                        let Some(&input) = module.inputs.get(*port) else {
                            return Err(ProofError::UnsupportedGuarantee {
                                node: module.output.index(),
                            });
                        };
                        let input_node = graph.node(input)?;
                        if actual.shape != input_node.shape || actual.dtype != input_node.dtype {
                            return Err(ProofError::UnsupportedGuarantee {
                                node: module.output.index(),
                            });
                        }
                        source.push_str(&format!(
                            "theorem {name} {params} : {} = {} := by\n  rfl\n\n",
                            call(module.output.index()),
                            call(input.index())
                        ));
                        theorems.push(name);
                    }
                    ContractClaim::Predicate(predicate) => {
                        emit_module_predicate(
                            graph,
                            &mut source,
                            &mut theorems,
                            name,
                            predicate,
                            (&module.inputs, module.output),
                            &claim_context,
                        )?;
                    }
                }
            }
        }

        for (module_index, module) in graph.multi_modules().iter().enumerate() {
            if !module.outputs.iter().any(|o| used.contains(&o.index())) {
                continue;
            }

            // All input ports are part of the declared module interface, even
            // if a particular output does not use the associated tensor.
            for (port_index, (&input, port)) in module
                .inputs
                .iter()
                .zip(&module.contract.inputs)
                .enumerate()
            {
                let actual = graph.node(input)?;
                emit_decidable(
                    &mut source,
                    &mut theorems,
                    format!("multi_{module_index}_input_{port_index}_shape"),
                    format!(
                        "{} = {}",
                        shape_expr(&actual.shape),
                        shape_expr(&port.port.shape)
                    ),
                );
                if port.port.domain == Domain::NonNegativeFinite {
                    if actual.domain != Domain::NonNegativeFinite {
                        return Err(ProofError::UnsupportedGuarantee {
                            node: input.index(),
                        });
                    }
                    emit_nonnegative_alias(
                        &mut source,
                        &mut theorems,
                        format!("multi_{module_index}_input_{port_index}_nonnegative"),
                        &proof_params,
                        &call(input.index()),
                        &proof_call(input.index()),
                    );
                }
            }

            for (port_index, (&output, port)) in module
                .outputs
                .iter()
                .zip(&module.contract.outputs)
                .enumerate()
            {
                if !used.contains(&output.index()) {
                    continue;
                }
                let actual = graph.node(output)?;
                emit_decidable(
                    &mut source,
                    &mut theorems,
                    format!("multi_{module_index}_port_{port_index}_shape"),
                    format!(
                        "{} = {}",
                        shape_expr(&actual.shape),
                        shape_expr(&port.port.shape)
                    ),
                );
                if port.port.domain == Domain::NonNegativeFinite {
                    if actual.domain != Domain::NonNegativeFinite {
                        return Err(ProofError::UnsupportedGuarantee {
                            node: output.index(),
                        });
                    }
                    emit_nonnegative_alias(
                        &mut source,
                        &mut theorems,
                        format!("multi_{module_index}_port_{port_index}_nonnegative"),
                        &proof_params,
                        &call(output.index()),
                        &proof_call(output.index()),
                    );
                }
                for (claim_index, claim) in port.claims.iter().enumerate() {
                    let name =
                        format!("multi_{module_index}_port_{port_index}_claim_{claim_index}");
                    match claim {
                        ContractClaim::Nonnegative => {
                            emit_ideal_nonnegative_claim(
                                graph,
                                &mut source,
                                &mut theorems,
                                name,
                                output,
                                &claim_context,
                            )?;
                        }
                        ContractClaim::EqualsInput(index) => {
                            let Some(&input) = module.inputs.get(*index) else {
                                return Err(ProofError::UnsupportedGuarantee {
                                    node: output.index(),
                                });
                            };
                            let input_node = graph.node(input)?;
                            if actual.shape != input_node.shape || actual.dtype != input_node.dtype
                            {
                                return Err(ProofError::UnsupportedGuarantee {
                                    node: output.index(),
                                });
                            }
                            source.push_str(&format!(
                                "theorem {name} {params} : {} = {} := by\n  rfl\n\n",
                                call(output.index()),
                                call(input.index())
                            ));
                            theorems.push(name);
                        }
                        ContractClaim::Predicate(predicate) => {
                            emit_module_predicate(
                                graph,
                                &mut source,
                                &mut theorems,
                                name,
                                predicate,
                                (&module.inputs, output),
                                &claim_context,
                            )?;
                        }
                    }
                }
            }
        }

        source.push_str("end VeriNeural.Generated\n");
        Ok(LeanProgram {
            source,
            theorems,
            assumptions,
        })
    }

    /// Generate one reusable ideal-Int definition theorem for repeated
    /// single-output module instances, plus a separate application theorem for
    /// each concrete instance. The definition proof is shared; every instance
    /// must independently discharge the required input nonnegativity.
    ///
    /// First profile: F32 output with an explicit Nonnegative claim and the
    /// ideal-Int operations supported by the normal proof backend. Instances
    /// must agree on name, semantic version, contract and normalized body.
    pub fn generate_reusable_module_nonnegative(
        &self,
        graph: &NeuralGraph,
        module_indices: &[usize],
        name: &str,
    ) -> Result<LeanProgram, ProofError> {
        let valid_name = !name.is_empty()
            && name.as_bytes()[0].is_ascii_alphabetic()
            && name.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'_');
        if !valid_name {
            return Err(ProofError::InvalidGoalName);
        }
        if module_indices.is_empty() {
            return Err(ProofError::InvalidOutputs);
        }
        let mut distinct = BTreeSet::new();
        for &index in module_indices {
            if !distinct.insert(index) {
                return Err(ProofError::InvalidOutputs);
            }
        }

        let representative_index = module_indices[0];
        let representative = graph
            .modules()
            .get(representative_index)
            .ok_or(ProofError::InvalidOutputs)?;
        let representative_output = graph.node(representative.output)?;
        if representative_output.dtype != DType::F32
            || !representative
                .contract
                .claims
                .contains(&ContractClaim::Nonnegative)
        {
            return Err(ProofError::UnsupportedGuarantee {
                node: representative.output.index(),
            });
        }

        let representative_definition =
            normalize_module_nonnegative_definition(graph, representative_index)?;
        for &index in &module_indices[1..] {
            let module = graph
                .modules()
                .get(index)
                .ok_or(ProofError::InvalidOutputs)?;
            let output = graph.node(module.output)?;
            if module.name != representative.name
                || module.semantic_version != representative.semantic_version
                || module.contract != representative.contract
                || output.dtype != DType::F32
                || !module.contract.claims.contains(&ContractClaim::Nonnegative)
                || normalize_module_nonnegative_definition(graph, index)?
                    != representative_definition
            {
                return Err(ProofError::ModuleDefinitionMismatch {
                    representative: representative_index,
                    other: index,
                });
            }
        }

        let outputs = module_indices
            .iter()
            .map(|&index| graph.modules()[index].output)
            .collect::<Vec<_>>();
        let mut program = self.generate_outputs(graph, &outputs)?;
        let namespace_end = "end VeriNeural.Generated\n";
        if !program.source.ends_with(namespace_end) {
            return Err(ProofError::LeanRejected {
                details: "generated Lean source has no namespace terminator".into(),
            });
        }
        program
            .source
            .truncate(program.source.len() - namespace_end.len());

        let definition_name = format!("module_definition_{name}");
        let theorem_name = format!("{definition_name}_nonnegative");
        let expression_tokens = representative_definition
            .expression
            .split(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
            .collect::<BTreeSet<_>>();
        let mut definition_port_params = Vec::new();
        let mut theorem_port_params = Vec::new();
        for (port, &input) in representative.inputs.iter().enumerate() {
            let node = graph.node(input)?;
            let value_type = lean_value_type(node.dtype, node.shape.element_count());
            let binder = if expression_tokens.contains(format!("p_{port}").as_str()) {
                format!("p_{port}")
            } else {
                format!("_p_{port}")
            };
            definition_port_params.push(format!("({binder} : {value_type})"));
            theorem_port_params.push(format!("(p_{port} : {value_type})"));
        }
        let definition_port_params = definition_port_params.join(" ");
        let theorem_port_params = theorem_port_params.join(" ");
        let proof_tokens = representative_definition
            .proof_term
            .split(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
            .collect::<BTreeSet<_>>();
        let required_params = representative_definition
            .required_ports
            .iter()
            .map(|&port| {
                let name = format!("h_port_{port}");
                let binder = if proof_tokens.contains(name.as_str()) {
                    name
                } else {
                    format!("_h_port_{port}")
                };
                format!("({binder} : VeriNeural.Nonnegative p_{port})")
            })
            .collect::<Vec<_>>()
            .join(" ");
        program.source.push_str(&format!(
            "-- Reusable module definition; instance compatibility is proved separately.\n             def {definition_name} {definition_port_params} : VeriNeural.Tensor {} :=\n  {}\n\n             theorem {theorem_name} {theorem_port_params} {required_params} :\n               VeriNeural.Nonnegative ({definition_name} {}) := by\n               exact {}\n\n",
            representative_output.shape.element_count(),
            representative_definition.expression,
            (0..representative.inputs.len())
                .map(|port| format!("p_{port}"))
                .collect::<Vec<_>>()
                .join(" "),
            representative_definition.proof_term,
        ));
        program.theorems.push(theorem_name.clone());

        let mut used = BTreeSet::new();
        for &output in &outputs {
            used.extend(collect_used_nodes(graph, output)?);
        }
        let sources = used
            .iter()
            .filter(|&&index| matches!(graph.nodes()[index].operation, Operation::Input))
            .copied()
            .collect::<Vec<_>>();
        let params = sources
            .iter()
            .map(|&index| {
                format!(
                    "(x_{index} : {})",
                    lean_value_type(
                        graph.nodes()[index].dtype,
                        graph.nodes()[index].shape.element_count()
                    )
                )
            })
            .collect::<Vec<_>>()
            .join(" ");
        let arguments = sources
            .iter()
            .map(|&index| format!("x_{index}"))
            .collect::<Vec<_>>()
            .join(" ");
        let source_hypotheses = program
            .assumptions()
            .iter()
            .map(|assumption| assumption.input_node)
            .collect::<BTreeSet<_>>();

        for &module_index in module_indices {
            let module = &graph.modules()[module_index];
            let port_values = module
                .inputs
                .iter()
                .map(|input| format!("(node_{} {arguments})", input.index()))
                .collect::<Vec<_>>();
            let mut input_proofs = Vec::new();
            for &port in &representative_definition.required_ports {
                let input = module.inputs[port];
                input_proofs.push(prove_ideal_nonnegative(
                    graph,
                    input,
                    &arguments,
                    &source_hypotheses,
                    &mut BTreeMap::new(),
                )?);
            }
            let proof_text = input_proofs.join(" ");
            let hypothesis_params = program
                .assumptions()
                .iter()
                .map(|assumption| {
                    let wanted = format!("h_{}", assumption.input_node);
                    let used = input_proofs.iter().any(|proof| {
                        proof
                            .split(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
                            .any(|token| token == wanted)
                    });
                    let binder = if used {
                        wanted
                    } else {
                        format!("_h_{}", assumption.input_node)
                    };
                    format!(
                        "({binder} : VeriNeural.Nonnegative x_{})",
                        assumption.input_node
                    )
                })
                .collect::<Vec<_>>()
                .join(" ");
            let instance_name = format!("{definition_name}_instance_{module_index}");
            program.source.push_str(&format!(
                "theorem {instance_name} {params} {hypothesis_params} :\n                   VeriNeural.Nonnegative (node_{} {arguments}) := by\n                   change VeriNeural.Nonnegative ({definition_name} {})\n                   exact {theorem_name} {}{}\n\n",
                module.output.index(),
                port_values.join(" "),
                port_values.join(" "),
                if proof_text.is_empty() {
                    String::new()
                } else {
                    format!(" {proof_text}")
                },
            ));
            program.theorems.push(instance_name);
        }

        program.source.push_str(namespace_end);
        Ok(program)
    }

    /// Reuse one ideal-Int theorem for a named multi-output module definition.
    /// A single right-nested tensor product represents every output; the
    /// theorem proves all output Nonnegative claims together. Each concrete
    /// invocation receives a separate checked application for every port.
    ///
    /// Supported profile: at least two F32 outputs, all claiming Nonnegative.
    /// All required input sign conditions must be declared in the contract.
    pub fn generate_reusable_multi_module_nonnegative(
        &self,
        graph: &NeuralGraph,
        module_indices: &[usize],
        name: &str,
    ) -> Result<LeanProgram, ProofError> {
        if name.is_empty()
            || !name.as_bytes()[0].is_ascii_alphabetic()
            || !name.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'_')
        {
            return Err(ProofError::InvalidGoalName);
        }
        if module_indices.is_empty()
            || module_indices
                .iter()
                .copied()
                .collect::<BTreeSet<_>>()
                .len()
                != module_indices.len()
        {
            return Err(ProofError::InvalidOutputs);
        }
        let representative_index = module_indices[0];
        let representative = graph
            .multi_modules()
            .get(representative_index)
            .ok_or(ProofError::InvalidOutputs)?;
        let definition = normalize_multi_nonnegative_definition(graph, representative_index)?;
        for &index in &module_indices[1..] {
            let instance = graph
                .multi_modules()
                .get(index)
                .ok_or(ProofError::InvalidOutputs)?;
            if instance.name != representative.name
                || instance.semantic_version != representative.semantic_version
                || instance.contract != representative.contract
                || normalize_multi_nonnegative_definition(graph, index)? != definition
            {
                return Err(ProofError::ModuleDefinitionMismatch {
                    representative: representative_index,
                    other: index,
                });
            }
        }
        let outputs = module_indices
            .iter()
            .flat_map(|&index| graph.multi_modules()[index].outputs.iter().copied())
            .collect::<Vec<_>>();
        let mut program = self.generate_outputs(graph, &outputs)?;
        let end = "end VeriNeural.Generated\n";
        if !program.source.ends_with(end) {
            return Err(ProofError::LeanRejected {
                details: "generated Lean source has no namespace terminator".into(),
            });
        }
        program.source.truncate(program.source.len() - end.len());

        let definition_name = format!("module_definition_{name}");
        let theorem_name = format!("{definition_name}_nonnegative");
        let expr_tokens = definition
            .outputs
            .iter()
            .flat_map(|out| {
                out.expression
                    .split(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
            })
            .collect::<BTreeSet<_>>();
        let proof_tokens = definition
            .outputs
            .iter()
            .flat_map(|out| {
                out.proof_term
                    .split(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
            })
            .collect::<BTreeSet<_>>();
        let mut def_params = Vec::new();
        let mut theorem_params = Vec::new();
        for (port, &input) in representative.inputs.iter().enumerate() {
            let node = graph.node(input)?;
            let ty = lean_value_type(node.dtype, node.shape.element_count());
            let binder = if expr_tokens.contains(format!("p_{port}").as_str()) {
                format!("p_{port}")
            } else {
                format!("_p_{port}")
            };
            def_params.push(format!("({binder} : {ty})"));
            theorem_params.push(format!("(p_{port} : {ty})"));
        }
        let required = definition
            .required_ports
            .iter()
            .map(|&port| {
                let binder = format!("h_port_{port}");
                let binder = if proof_tokens.contains(binder.as_str()) {
                    binder
                } else {
                    format!("_h_port_{port}")
                };
                format!("({binder} : VeriNeural.Nonnegative p_{port})")
            })
            .collect::<Vec<_>>()
            .join(" ");
        let port_args = (0..representative.inputs.len())
            .map(|port| format!("p_{port}"))
            .collect::<Vec<_>>()
            .join(" ");
        let type_expr = representative
            .outputs
            .iter()
            .map(|&id| {
                let node = graph.node(id)?;
                Ok(lean_value_type(node.dtype, node.shape.element_count()))
            })
            .collect::<Result<Vec<_>, ProofError>>()?
            .into_iter()
            .rev()
            .reduce(|tail, head| format!("({head} × {tail})"))
            .ok_or(ProofError::InvalidOutputs)?;
        let value_expr = definition
            .outputs
            .iter()
            .map(|out| out.expression.clone())
            .rev()
            .reduce(|tail, head| format!("({head}, {tail})"))
            .ok_or(ProofError::InvalidOutputs)?;
        let projection = |port: usize| {
            let mut fields = vec!["2"; port];
            if port + 1 != definition.outputs.len() {
                fields.push("1");
            }
            fields.join(".")
        };
        let properties = (0..definition.outputs.len())
            .map(|port| {
                format!(
                    "VeriNeural.Nonnegative (({definition_name} {port_args}).{})",
                    projection(port)
                )
            })
            .collect::<Vec<_>>()
            .join(" ∧ ");
        let property_proof = definition
            .outputs
            .iter()
            .map(|out| out.proof_term.clone())
            .rev()
            .reduce(|tail, head| format!("And.intro ({head}) ({tail})"))
            .ok_or(ProofError::InvalidOutputs)?;
        program.source.push_str(&format!(
            "-- One normalized multi-output definition and all-port property.\n\
             def {definition_name} {} : {type_expr} :=\n  {value_expr}\n\n\
             theorem {theorem_name} {} {required} :\n  {properties} := by\n\
               exact {property_proof}\n\n",
            def_params.join(" "),
            theorem_params.join(" "),
        ));
        program.theorems.push(theorem_name.clone());

        let mut used = BTreeSet::new();
        for &output in &outputs {
            used.extend(collect_used_nodes(graph, output)?);
        }
        let sources = used
            .iter()
            .filter(|&&i| matches!(graph.nodes()[i].operation, Operation::Input))
            .copied()
            .collect::<Vec<_>>();
        let params = sources
            .iter()
            .map(|&i| {
                format!(
                    "(x_{i} : {})",
                    lean_value_type(
                        graph.nodes()[i].dtype,
                        graph.nodes()[i].shape.element_count()
                    )
                )
            })
            .collect::<Vec<_>>()
            .join(" ");
        let args = sources
            .iter()
            .map(|&i| format!("x_{i}"))
            .collect::<Vec<_>>()
            .join(" ");
        let source_hypotheses = program
            .assumptions()
            .iter()
            .map(|a| a.input_node)
            .collect::<BTreeSet<_>>();
        for &instance_index in module_indices {
            let instance = &graph.multi_modules()[instance_index];
            let input_values = instance
                .inputs
                .iter()
                .map(|id| format!("(node_{} {args})", id.index()))
                .collect::<Vec<_>>()
                .join(" ");
            let premises = definition
                .required_ports
                .iter()
                .map(|&port| {
                    prove_ideal_nonnegative(
                        graph,
                        instance.inputs[port],
                        &args,
                        &source_hypotheses,
                        &mut BTreeMap::new(),
                    )
                })
                .collect::<Result<Vec<_>, _>>()?;
            let hypothesis_params = program
                .assumptions()
                .iter()
                .map(|a| {
                    let needed = format!("h_{}", a.input_node);
                    let used = premises.iter().any(|term| {
                        term.split(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
                            .any(|token| token == needed)
                    });
                    let binder = if used {
                        needed
                    } else {
                        format!("_h_{}", a.input_node)
                    };
                    format!("({binder} : VeriNeural.Nonnegative x_{})", a.input_node)
                })
                .collect::<Vec<_>>()
                .join(" ");
            let premise_args = if premises.is_empty() {
                String::new()
            } else {
                format!(" {}", premises.join(" "))
            };
            for (port, &output) in instance.outputs.iter().enumerate() {
                let property_name =
                    format!("{definition_name}_instance_{instance_index}_port_{port}");
                let path = projection(port);
                program.source.push_str(&format!(
                    "theorem {property_name} {params} {hypothesis_params} :\n\
                     VeriNeural.Nonnegative (node_{} {args}) := by\n\
                     change VeriNeural.Nonnegative (({definition_name} {input_values}).{path})\n\
                     exact ({theorem_name} {input_values}{premise_args}).{path}\n\n",
                    output.index(),
                ));
                program.theorems.push(property_name);
            }
        }

        program.source.push_str(end);
        Ok(program)
    }

    /// Prove one explicit architecture-level ideal-Int property:
    /// the selected output is elementwise nonnegative under the listed source
    /// hypotheses. This theorem composes top-level module proofs over their
    /// dependency DAG. It does not claim FP32 finiteness or GPU equivalence.
    pub fn generate_global_nonnegative(
        &self,
        graph: &NeuralGraph,
        output: NodeId,
        assumptions: &[NodeId],
    ) -> Result<LeanProgram, ProofError> {
        let mut program = self.generate(graph, output)?;
        let used = collect_used_nodes(graph, output)?;
        let sources = used
            .iter()
            .filter(|&&index| matches!(graph.nodes()[index].operation, Operation::Input))
            .copied()
            .collect::<Vec<_>>();
        let source_set = sources.iter().copied().collect::<BTreeSet<_>>();

        let mut assumption_set = program
            .assumptions
            .iter()
            .map(|assumption| assumption.input_node)
            .collect::<BTreeSet<_>>();
        for &assumption in assumptions {
            let node = graph.node(assumption)?;
            if !matches!(node.operation, Operation::Input)
                || !source_set.contains(&assumption.index())
            {
                return Err(ProofError::InvalidAssumption {
                    node: assumption.index(),
                });
            }
            assumption_set.insert(assumption.index());
        }

        let params = sources
            .iter()
            .map(|&index| {
                format!(
                    "(x_{index} : VeriNeural.Tensor {})",
                    graph.nodes()[index].shape.element_count()
                )
            })
            .collect::<Vec<_>>()
            .join(" ");
        let arguments = sources
            .iter()
            .map(|&index| format!("x_{index}"))
            .collect::<Vec<_>>()
            .join(" ");
        let call = |index: usize| format!("(node_{index} {arguments})");

        // Module hierarchy is heterogeneous: one application order contains
        // both single- and multi-output invocations. Global composition reasons
        // about a concrete output port, not merely a module index.
        let ordered = ordered_global_module_keys(graph);
        let eligible = ordered
            .iter()
            .copied()
            .filter(|&(_, key)| {
                global_module_outputs(graph, key)
                    .is_ok_and(|outputs| outputs.iter().any(|id| used.contains(&id.index())))
            })
            .collect::<Vec<_>>();
        let top_level = eligible
            .iter()
            .copied()
            .filter(|&child| {
                !eligible
                    .iter()
                    .copied()
                    .any(|parent| global_module_contains(graph, parent, child))
            })
            .collect::<Vec<_>>();

        let mut producers = BTreeMap::<usize, GlobalModuleOutputKey>::new();
        for (sequence, module) in top_level {
            for (port, output) in global_module_outputs(graph, module)?
                .into_iter()
                .enumerate()
            {
                if !used.contains(&output.index()) {
                    continue;
                }
                let key = GlobalModuleOutputKey {
                    sequence,
                    module,
                    port,
                };
                if producers.insert(output.index(), key).is_some() {
                    return Err(ProofError::UnsupportedGuarantee {
                        node: output.index(),
                    });
                }
            }
        }
        let Some(&final_module) = producers.get(&output.index()) else {
            return Err(ProofError::UnsupportedGuarantee {
                node: output.index(),
            });
        };

        let mut normalized_definitions =
            BTreeMap::<GlobalModuleOutputKey, NormalizedModuleNonnegativeDefinition>::new();
        let mut selected = BTreeSet::<GlobalModuleOutputKey>::new();
        let mut required_assumptions = BTreeSet::<usize>::new();
        let mut pending = vec![final_module];
        while let Some(module_key) = pending.pop() {
            if !selected.insert(module_key) {
                continue;
            }
            let definition = normalize_global_module_output(graph, module_key)?;
            let inputs = global_module_inputs(graph, module_key.module)?;
            for &port in &definition.required_ports {
                let input = inputs[port];
                if assumption_set.contains(&input.index()) {
                    required_assumptions.insert(input.index());
                    continue;
                }
                let Some(&producer) = producers.get(&input.index()) else {
                    return Err(ProofError::UnsupportedGuarantee {
                        node: input.index(),
                    });
                };
                if producer.sequence >= module_key.sequence {
                    return Err(ProofError::UnsupportedGuarantee {
                        node: input.index(),
                    });
                }
                pending.push(producer);
            }
            normalized_definitions.insert(module_key, definition);
        }

        let namespace_end = "end VeriNeural.Generated\n";
        if !program.source.ends_with(namespace_end) {
            return Err(ProofError::LeanRejected {
                details: "generated Lean source has no namespace terminator".to_owned(),
            });
        }
        program
            .source
            .truncate(program.source.len() - namespace_end.len());

        // Reuse a definition theorem only for the same module kind, stable
        // name/version/full interface, target output port and normalized proof.
        let mut definition_groups = Vec::<Vec<GlobalModuleOutputKey>>::new();
        for &module_key in &selected {
            let mut matching_group = None;
            for (group_index, group) in definition_groups.iter().enumerate() {
                let representative = group[0];
                if module_key.port == representative.port
                    && global_module_same_interface(
                        graph,
                        module_key.module,
                        representative.module,
                    )?
                {
                    if normalized_definitions[&module_key]
                        != normalized_definitions[&representative]
                    {
                        return Err(ProofError::ModuleDefinitionMismatch {
                            representative: representative.sequence,
                            other: module_key.sequence,
                        });
                    }
                    matching_group = Some(group_index);
                    break;
                }
            }
            let group_index = match matching_group {
                Some(group_index) => group_index,
                None => {
                    definition_groups.push(Vec::new());
                    definition_groups.len() - 1
                }
            };
            definition_groups[group_index].push(module_key);
        }

        for group in &definition_groups {
            let representative_key = group[0];
            let inputs = global_module_inputs(graph, representative_key.module)?;
            let representative_output = graph.node(global_module_output(
                graph,
                representative_key.module,
                representative_key.port,
            )?)?;
            if representative_output.dtype != DType::F32 {
                return Err(ProofError::UnsupportedGuarantee {
                    node: representative_output.id.index(),
                });
            }
            let definition = &normalized_definitions[&representative_key];
            let definition_name = global_definition_name(representative_key);
            let theorem_name = format!("{definition_name}_nonnegative");
            let expression_tokens = definition
                .expression
                .split(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
                .collect::<BTreeSet<_>>();
            let proof_tokens = definition
                .proof_term
                .split(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
                .collect::<BTreeSet<_>>();
            let mut definition_port_params = Vec::new();
            let mut theorem_port_params = Vec::new();
            for (port, &input) in inputs.iter().enumerate() {
                let input_node = graph.node(input)?;
                let value_type =
                    lean_value_type(input_node.dtype, input_node.shape.element_count());
                let definition_binder = if expression_tokens.contains(format!("p_{port}").as_str())
                {
                    format!("p_{port}")
                } else {
                    format!("_p_{port}")
                };
                definition_port_params.push(format!("({definition_binder} : {value_type})"));
                theorem_port_params.push(format!("(p_{port} : {value_type})"));
            }
            let required_params = definition
                .required_ports
                .iter()
                .map(|&port| {
                    let binder = format!("h_port_{port}");
                    let binder = if proof_tokens.contains(binder.as_str()) {
                        binder
                    } else {
                        format!("_h_port_{port}")
                    };
                    format!("({binder} : VeriNeural.Nonnegative p_{port})")
                })
                .collect::<Vec<_>>()
                .join(" ");
            program.source.push_str(&format!(
                "-- One normalized ideal-Int theorem shared by every compatible module invocation.\n\
                 def {definition_name} {} : VeriNeural.Tensor {} :=\n  {}\n\n\
                 theorem {theorem_name} {} {required_params} :\n  \
                 VeriNeural.Nonnegative ({definition_name} {}) := by\n  exact {}\n\n",
                definition_port_params.join(" "),
                representative_output.shape.element_count(),
                definition.expression,
                theorem_port_params.join(" "),
                (0..inputs.len())
                    .map(|port| format!("p_{port}"))
                    .collect::<Vec<_>>()
                    .join(" "),
                definition.proof_term,
            ));
            program.theorems.push(theorem_name.clone());

            for &module_key in group {
                let inputs = global_module_inputs(graph, module_key.module)?;
                let output = global_module_output(graph, module_key.module, module_key.port)?;
                let definition = &normalized_definitions[&module_key];
                let port_values = inputs
                    .iter()
                    .map(|input| call(input.index()))
                    .collect::<Vec<_>>();
                let proof_params = definition
                    .required_ports
                    .iter()
                    .map(|&port| {
                        format!(
                            "({} : VeriNeural.Nonnegative {})",
                            global_input_hypothesis_name(module_key, port),
                            call(inputs[port].index())
                        )
                    })
                    .collect::<Vec<_>>()
                    .join(" ");
                let theorem_params = if proof_params.is_empty() {
                    params.clone()
                } else {
                    format!("{params} {proof_params}")
                };
                let input_proofs = definition
                    .required_ports
                    .iter()
                    .map(|&port| global_input_hypothesis_name(module_key, port))
                    .collect::<Vec<_>>()
                    .join(" ");
                let instance_name = global_instance_name(module_key);
                program.source.push_str(&format!(
                    "-- Concrete invocation: only its premises are instance-specific.\n\
                     theorem {instance_name} {theorem_params} :\n  \
                     VeriNeural.Nonnegative {} := by\n  \
                     change VeriNeural.Nonnegative ({definition_name} {})\n  \
                     exact {theorem_name} {}{}\n\n",
                    call(output.index()),
                    port_values.join(" "),
                    port_values.join(" "),
                    if input_proofs.is_empty() {
                        String::new()
                    } else {
                        format!(" {input_proofs}")
                    },
                ));
                program.theorems.push(instance_name);
            }
        }

        let global_hypotheses = required_assumptions
            .iter()
            .map(|&index| format!("(arch_h_{index} : VeriNeural.Nonnegative x_{index})"))
            .collect::<Vec<_>>()
            .join(" ");
        let global_params = if global_hypotheses.is_empty() {
            params.clone()
        } else {
            format!("{params} {global_hypotheses}")
        };
        program.source.push_str(&format!(
            "-- Explicit user-requested architecture property in the ideal-Int model.\n\
             theorem architecture_global_nonnegative {global_params} :\n  \
             VeriNeural.Nonnegative {} := by\n",
            call(output.index())
        ));

        let mut proofs = required_assumptions
            .iter()
            .map(|&index| (index, format!("arch_h_{index}")))
            .collect::<BTreeMap<_, _>>();
        for &module_key in &selected {
            let definition = &normalized_definitions[&module_key];
            let inputs = global_module_inputs(graph, module_key.module)?;
            let output = global_module_output(graph, module_key.module, module_key.port)?;
            let mut args = sources
                .iter()
                .map(|&index| format!("x_{index}"))
                .collect::<Vec<_>>();
            for &port in &definition.required_ports {
                let input = inputs[port].index();
                let Some(input_proof) = proofs.get(&input) else {
                    return Err(ProofError::UnsupportedGuarantee { node: input });
                };
                args.push(input_proof.clone());
            }
            let have_name = global_have_name(module_key);
            let instance_name = global_instance_name(module_key);
            program.source.push_str(&format!(
                "  have {have_name} := {instance_name} {}\n",
                args.join(" ")
            ));
            proofs.insert(output.index(), have_name);
        }
        let Some(final_proof) = proofs.get(&output.index()) else {
            return Err(ProofError::UnsupportedGuarantee {
                node: output.index(),
            });
        };
        program
            .source
            .push_str(&format!("  exact {final_proof}\n\n{namespace_end}"));
        program
            .theorems
            .push("architecture_global_nonnegative".to_owned());

        for index in required_assumptions {
            if !program
                .assumptions
                .iter()
                .any(|assumption| assumption.input_node == index)
            {
                program.assumptions.push(ProofAssumption {
                    input_node: index,
                    domain: Domain::NonNegativeFinite,
                });
            }
        }
        program
            .assumptions
            .sort_by_key(|assumption| assumption.input_node);

        Ok(program)
    }

    /// Produce an independently requested theorem. Every goal gets its own
    /// program and result; invalid equality is rejected by Lean, never inferred
    /// from the output shape or a generator-created RHS.
    pub fn generate_goal(
        &self,
        graph: &NeuralGraph,
        goal: &ProofGoal,
    ) -> Result<LeanProgram, ProofError> {
        let valid = !goal.name.is_empty()
            && goal
                .name
                .bytes()
                .all(|c| c.is_ascii_alphanumeric() || c == b'_')
            && goal.name.as_bytes()[0].is_ascii_alphabetic();
        if !valid {
            return Err(ProofError::InvalidGoalName);
        }
        match &goal.kind {
            ProofGoalKind::Nonnegative { assumptions } => {
                let mut program =
                    self.generate_global_nonnegative(graph, goal.output, assumptions)?;
                program.source = program.source.replace(
                    "architecture_global_nonnegative",
                    &format!("architecture_property_{}", goal.name),
                );
                if let Some(last) = program.theorems.last_mut() {
                    *last = format!("architecture_property_{}", goal.name);
                }
                Ok(program)
            }
            // Legacy public constructors are adapters to the same predicate
            // proof path, rather than maintaining another theorem generator.
            ProofGoalKind::EqualTo { other } => self.generate_goal(
                graph,
                &ProofGoal {
                    name: goal.name.clone(),
                    output: goal.output,
                    kind: ProofGoalKind::Predicate(Predicate::equal(
                        ValueRef::Output,
                        ValueRef::Node(*other),
                    )),
                },
            ),
            ProofGoalKind::Predicate(predicate) => {
                let resolve = |value: &ValueRef| -> Result<NodeId, ProofError> {
                    let id = match value {
                        ValueRef::Node(id) => *id,
                        ValueRef::Output => goal.output,
                        ValueRef::Input(_) => {
                            return Err(ProofError::UnsupportedGuarantee {
                                node: goal.output.index(),
                            });
                        }
                    };
                    graph.node(id)?;
                    Ok(id)
                };
                match predicate {
                    Predicate::Nonnegative(value) => {
                        if resolve(value)? != goal.output {
                            return Err(ProofError::UnsupportedGuarantee {
                                node: goal.output.index(),
                            });
                        }
                        self.generate_goal(
                            graph,
                            &ProofGoal {
                                name: goal.name.clone(),
                                output: goal.output,
                                kind: ProofGoalKind::Nonnegative {
                                    assumptions: vec![],
                                },
                            },
                        )
                    }
                    Predicate::Equal(a, b) | Predicate::PointwiseLe(a, b) => {
                        let left = resolve(a)?;
                        let right = resolve(b)?;
                        let used = collect_used_nodes(graph, goal.output)?;
                        let left_node = graph.node(left)?;
                        let right_node = graph.node(right)?;
                        if !used.contains(&left.index())
                            || !used.contains(&right.index())
                            || left_node.shape != right_node.shape
                            || left_node.dtype != right_node.dtype
                            || (matches!(predicate, Predicate::PointwiseLe(_, _))
                                && left_node.dtype != DType::F32)
                        {
                            return Err(ProofError::UnsupportedGuarantee {
                                node: goal.output.index(),
                            });
                        }
                        let mut program = self.generate(graph, goal.output)?;
                        let sources = used
                            .iter()
                            .filter(|&&index| {
                                matches!(graph.nodes()[index].operation, Operation::Input)
                            })
                            .copied()
                            .collect::<Vec<_>>();
                        let params = sources
                            .iter()
                            .map(|&i| {
                                format!(
                                    "(x_{i} : VeriNeural.Tensor {})",
                                    graph.nodes()[i].shape.element_count()
                                )
                            })
                            .collect::<Vec<_>>()
                            .join(" ");
                        let args = sources
                            .iter()
                            .map(|&i| format!("x_{i}"))
                            .collect::<Vec<_>>()
                            .join(" ");
                        let terminator = "end VeriNeural.Generated\n";
                        program
                            .source
                            .truncate(program.source.len() - terminator.len());
                        let name = format!("architecture_property_{}", goal.name);
                        let term = |id: NodeId| format!("(node_{} {args})", id.index());
                        let (proposition, proof) = match predicate {
                            Predicate::Equal(_, _) => (
                                format!("{} = {}", term(left), term(right)),
                                "  rfl".to_owned(),
                            ),
                            Predicate::PointwiseLe(_, _) => {
                                let derived =
                                    derived_pointwise_le(graph, left, right, &term, used.len() + 1);
                                (
                                    format!(
                                        "VeriNeural.PointwiseLe {} {}",
                                        term(left),
                                        term(right)
                                    ),
                                    format!(
                                        "  exact {}",
                                        derived.unwrap_or_else(|| format!(
                                            "VeriNeural.pointwise_le_relu {}",
                                            term(left)
                                        ))
                                    ),
                                )
                            }
                            Predicate::Nonnegative(_) => unreachable!(),
                        };
                        program.source.push_str(&format!(
                            "theorem {name} {params} : {proposition} := by\n{proof}\n\n{terminator}"
                        ));
                        program.theorems.push(name);
                        Ok(program)
                    }
                }
            }
        }
    }

    /// Produce a single ideal-Int theorem covering every state of a *fixed*
    /// horizon, by composing per-step consumer-owned Nonnegative claims.
    /// Only the stated horizon is covered. This is not an FP32 or GPU proof.
    pub fn generate_fixed_scan_nonnegative(
        &self,
        graph: &NeuralGraph,
        scan: &FixedScan,
        name: &str,
    ) -> Result<LeanProgram, ProofError> {
        if name.is_empty()
            || !name.as_bytes()[0].is_ascii_alphabetic()
            || !name.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'_')
        {
            return Err(ProofError::InvalidGoalName);
        }
        if scan.outputs.is_empty()
            || scan.states.len() != scan.outputs.len() + 1
            || scan.module_indices.len() != scan.outputs.len()
        {
            return Err(ProofError::InvalidScan);
        }
        let mut claim_names = Vec::new();
        let mut seen = BTreeSet::new();
        for (step, &index) in scan.module_indices.iter().enumerate() {
            let module = graph
                .multi_modules()
                .get(index)
                .ok_or(ProofError::InvalidScan)?;
            if !seen.insert(index)
                || module.inputs.len() != 2
                || module.outputs.len() != 2
                || module.contract.inputs.len() != 2
                || module.contract.outputs.len() != 2
                || module.contract.inputs[0].name != "state"
                || module.contract.inputs[1].name != "input"
                || module.contract.outputs[0].name != "next_state"
                || module.contract.outputs[1].name != "output"
                || module.inputs[0] != scan.states[step]
                || module.outputs[0] != scan.states[step + 1]
                || module.outputs[1] != scan.outputs[step]
            {
                return Err(ProofError::InvalidScan);
            }
            let claim = module.contract.outputs[0]
                .claims
                .iter()
                .position(|c| *c == ContractClaim::Nonnegative)
                .ok_or(ProofError::InvalidScan)?;
            claim_names.push(format!("multi_{index}_port_0_claim_{claim}"));
        }
        let mut targets = scan.proof_outputs();
        targets.push(scan.states[0]);
        let mut program = self.generate_outputs(graph, &targets)?;
        let mut used = BTreeSet::new();
        for &target in &targets {
            used.extend(collect_used_nodes(graph, target)?);
        }
        let sources = used
            .iter()
            .filter(|&&i| matches!(graph.nodes()[i].operation, Operation::Input))
            .copied()
            .collect::<Vec<_>>();
        let params = sources
            .iter()
            .map(|&i| {
                format!(
                    "(x_{i} : VeriNeural.Tensor {})",
                    graph.nodes()[i].shape.element_count()
                )
            })
            .collect::<Vec<_>>()
            .join(" ");
        let args = sources
            .iter()
            .map(|i| format!("x_{i}"))
            .collect::<Vec<_>>()
            .join(" ");
        let hypotheses = program
            .assumptions()
            .iter()
            .map(|a| {
                format!(
                    "(h_{} : VeriNeural.Nonnegative x_{})",
                    a.input_node, a.input_node
                )
            })
            .collect::<Vec<_>>()
            .join(" ");
        let hypothesis_args = program
            .assumptions()
            .iter()
            .map(|a| format!("h_{}", a.input_node))
            .collect::<Vec<_>>()
            .join(" ");
        let source_hypotheses = program
            .assumptions()
            .iter()
            .map(|a| a.input_node)
            .collect::<BTreeSet<_>>();
        let base = prove_ideal_nonnegative(
            graph,
            scan.states[0],
            &args,
            &source_hypotheses,
            &mut BTreeMap::new(),
        )?;
        let end = "end VeriNeural.Generated\n";
        if !program.source.ends_with(end) {
            return Err(ProofError::LeanRejected {
                details: "generated Lean source has no namespace terminator".into(),
            });
        }
        program.source.truncate(program.source.len() - end.len());
        let theorem = format!("scan_{name}_global_nonnegative");
        let propositions = scan
            .states
            .iter()
            .map(|state| format!("VeriNeural.Nonnegative (node_{} {args})", state.index()))
            .collect::<Vec<_>>()
            .join(" ∧\n    ");
        program.source.push_str(&format!(
            "-- Ideal-Int states 0..{}; no arbitrary-horizon induction.\n\
             theorem {theorem} {params} {hypotheses} :\n    {propositions} := by\n",
            scan.outputs.len()
        ));
        program.source.push_str(&format!(
            "  have scan_state_0 : VeriNeural.Nonnegative (node_{} {args}) := by\n    exact {base}\n",
            scan.states[0].index()
        ));
        for (step, state) in scan.states.iter().enumerate().skip(1) {
            program.source.push_str(&format!(
                "  have scan_state_{step} : VeriNeural.Nonnegative (node_{} {args}) := by\n    exact {} {args} {hypothesis_args}\n",
                state.index(), claim_names[step - 1]
            ));
        }
        let mut conjunction = format!("scan_state_{}", scan.outputs.len());
        for step in (0..scan.outputs.len()).rev() {
            conjunction = format!("And.intro scan_state_{step} ({conjunction})");
        }
        program
            .source
            .push_str(&format!("  exact {conjunction}\n\n{end}"));
        program.theorems.push(theorem);
        Ok(program)
    }

    /// Build an arbitrary-horizon ideal-Int invariant from one reusable
    /// consumer-defined state transition. Unlike FixedScan, this theorem does
    /// not unroll time: Lean performs induction over Nat and reuses the
    /// transition's checked next_state Nonnegative claim at every successor.
    ///
    /// First supported profile: exactly two direct F32 sources named
    /// state/input, two outputs named next_state/output, state-preserving
    /// shape/dtype, and NonNegativeFinite source hypotheses.
    pub fn generate_inductive_state_nonnegative(
        &self,
        graph: &NeuralGraph,
        module_index: usize,
        name: &str,
    ) -> Result<LeanProgram, ProofError> {
        if name.is_empty()
            || !name.as_bytes()[0].is_ascii_alphabetic()
            || !name.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'_')
        {
            return Err(ProofError::InvalidGoalName);
        }
        let module = graph
            .multi_modules()
            .get(module_index)
            .ok_or(ProofError::InvalidScan)?;
        if module.inputs.len() != 2
            || module.outputs.len() != 2
            || module.contract.inputs.len() != 2
            || module.contract.outputs.len() != 2
            || module.contract.inputs[0].name != "state"
            || module.contract.inputs[1].name != "input"
            || module.contract.outputs[0].name != "next_state"
            || module.contract.outputs[1].name != "output"
        {
            return Err(ProofError::InvalidScan);
        }

        let state = module.inputs[0];
        let input = module.inputs[1];
        let next_state = module.outputs[0];
        let state_node = graph.node(state)?;
        let input_node = graph.node(input)?;
        let next_node = graph.node(next_state)?;
        if state == input
            || !matches!(state_node.operation, Operation::Input)
            || !matches!(input_node.operation, Operation::Input)
            || state_node.dtype != DType::F32
            || input_node.dtype != DType::F32
            || state_node.domain != Domain::NonNegativeFinite
            || input_node.domain != Domain::NonNegativeFinite
            || state_node.shape != next_node.shape
            || state_node.dtype != next_node.dtype
        {
            return Err(ProofError::InvalidScan);
        }
        let claim = module.contract.outputs[0]
            .claims
            .iter()
            .position(|claim| *claim == ContractClaim::Nonnegative)
            .ok_or(ProofError::InvalidScan)?;
        let claim_name = format!("multi_{module_index}_port_0_claim_{claim}");

        let mut program = self.generate_outputs(graph, &module.outputs)?;
        let mut used = BTreeSet::new();
        for &target in &module.outputs {
            used.extend(collect_used_nodes(graph, target)?);
        }
        let sources = used
            .iter()
            .filter(|&&index| matches!(graph.nodes()[index].operation, Operation::Input))
            .copied()
            .collect::<Vec<_>>();
        if sources.len() != 2
            || !sources.contains(&state.index())
            || !sources.contains(&input.index())
        {
            return Err(ProofError::InvalidScan);
        }
        let assumption_nodes = program
            .assumptions()
            .iter()
            .map(|assumption| assumption.input_node)
            .collect::<BTreeSet<_>>();
        if assumption_nodes != BTreeSet::from([state.index(), input.index()]) {
            return Err(ProofError::InvalidScan);
        }

        let state_count = state_node.shape.element_count();
        let input_count = input_node.shape.element_count();
        let step_args = |state_value: &str, input_value: &str| {
            sources
                .iter()
                .map(|source| {
                    if *source == state.index() {
                        state_value.to_owned()
                    } else {
                        input_value.to_owned()
                    }
                })
                .collect::<Vec<_>>()
                .join(" ")
        };
        let hypothesis_args = program
            .assumptions()
            .iter()
            .map(|assumption| {
                if assumption.input_node == state.index() {
                    "ih".to_owned()
                } else {
                    "(h_input t)".to_owned()
                }
            })
            .collect::<Vec<_>>()
            .join(" ");
        let definition = format!("scan_{name}_state");
        let theorem = format!("scan_{name}_inductive_nonnegative");
        let end = "end VeriNeural.Generated\n";
        if !program.source.ends_with(end) {
            return Err(ProofError::LeanRejected {
                details: "generated Lean source has no namespace terminator".into(),
            });
        }
        program.source.truncate(program.source.len() - end.len());

        let successor_args = step_args(&format!("({definition} initial inputAt t)"), "(inputAt t)");
        program.source.push_str(&format!(
            "def {definition}\n                 (initial : VeriNeural.Tensor {state_count})\n                 (inputAt : Nat → VeriNeural.Tensor {input_count}) :\n                 Nat → VeriNeural.Tensor {state_count}\n               | 0 => initial\n               | Nat.succ t => node_{} {successor_args}\n\n",
            next_state.index()
        ));
        program.source.push_str(&format!(
            concat!(
                "theorem {theorem}\n",
                "    (initial : VeriNeural.Tensor {state_count})\n",
                "    (inputAt : Nat → VeriNeural.Tensor {input_count})\n",
                "    (h_initial : VeriNeural.Nonnegative initial)\n",
                "    (h_input : ∀ t, VeriNeural.Nonnegative (inputAt t)) :\n",
                "    ∀ t, VeriNeural.Nonnegative ({definition} initial inputAt t) := by\n",
                "  intro t\n",
                "  induction t with\n",
                "  | zero =>\n",
                "      simpa [{definition}] using h_initial\n",
                "  | succ t ih =>\n",
                "      simp only [{definition}]\n",
                "      exact {claim_name} {successor_args} {hypothesis_args}\n\n",
                "{end}",
            ),
            theorem = theorem,
            state_count = state_count,
            input_count = input_count,
            definition = definition,
            claim_name = claim_name,
            successor_args = successor_args,
            hypothesis_args = hypothesis_args,
            end = end,
        ));
        program.theorems.push(theorem);
        Ok(program)
    }

    /// Certified profile: only explicitly allowlisted foundational Lean axioms
    /// are admitted. Checker, kernel and imported library remain explicit TCB.
    pub fn verify_certified(
        &self,
        program: &LeanProgram,
        output_file: &Path,
    ) -> Result<(CheckedLean, LeanAxiomAudit), ProofError> {
        let checked = self.verify(program, output_file)?;
        let audit = self.audit_file(output_file, &program.theorems)?;
        Ok((checked, audit))
    }

    /// Recheck saved theorems and record actual axioms. User axioms, `sorryAx`
    /// and unreviewed axioms remain forbidden; `propext` is declared TCB.
    pub fn audit_file(
        &self,
        source_file: &Path,
        theorems: &[String],
    ) -> Result<LeanAxiomAudit, ProofError> {
        if theorems.is_empty()
            || theorems.iter().any(|name| {
                name.is_empty() || !name.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'_')
            })
        {
            return Err(ProofError::InvalidGoalName);
        }
        let version = Command::new(&self.executable).arg("--version").output()?;
        if !version.status.success() {
            return Err(ProofError::LeanRejected {
                details: "Lean version unavailable".into(),
            });
        }
        let version = String::from_utf8_lossy(&version.stdout).trim().to_owned();
        let audit_path = source_file.with_extension("axiom-audit.lean");
        let mut audit_source = fs::read_to_string(source_file)?;
        for name in theorems {
            audit_source.push_str(&format!("\n#print axioms VeriNeural.Generated.{name}\n"));
        }
        fs::write(&audit_path, audit_source)?;
        let result = Command::new(&self.executable).arg(&audit_path).output();
        let _ = fs::remove_file(&audit_path);
        let result = result?;
        let stdout = String::from_utf8_lossy(&result.stdout);
        let stderr = String::from_utf8_lossy(&result.stderr);
        if !result.status.success() || !stderr.trim().is_empty() {
            return Err(ProofError::LeanRejected {
                details: format!(
                    "axiom audit failed: exit={:?}; stderr={stderr}",
                    result.status.code()
                ),
            });
        }
        let axiom_dependencies = parse_axiom_report(&stdout, theorems)?;
        Ok(LeanAxiomAudit {
            lean_version: version,
            theorem_names: theorems.to_vec(),
            axiom_dependencies,
        })
    }

    /// Write and run Lean. Even a successful generation is *unverified* until
    /// this returns Ok. Any Lean warning or diagnostic fails the check.
    pub fn verify(
        &self,
        program: &LeanProgram,
        output_file: &Path,
    ) -> Result<CheckedLean, ProofError> {
        if let Some(parent) = output_file
            .parent()
            .filter(|path| !path.as_os_str().is_empty())
        {
            fs::create_dir_all(parent)?;
        }
        fs::write(output_file, program.source())?;
        self.check_file(output_file)?;
        Ok(CheckedLean {
            path: output_file.to_path_buf(),
            theorem_names: program.theorems.clone(),
            assumptions: program.assumptions.clone(),
        })
    }

    /// Rerun the trusted Lean checker for a saved file.
    pub fn check_file(&self, source_file: &Path) -> Result<(), ProofError> {
        let output = Command::new(&self.executable).arg(source_file).output()?;
        let stdout = String::from_utf8_lossy(&output.stdout);
        let stderr = String::from_utf8_lossy(&output.stderr);
        if !output.status.success() || !stdout.trim().is_empty() || !stderr.trim().is_empty() {
            return Err(ProofError::LeanRejected {
                details: format!(
                    "exit={:?}\nstdout:\n{stdout}\nstderr:\n{stderr}",
                    output.status.code()
                ),
            });
        }
        Ok(())
    }
}

#[derive(Clone, Debug, PartialEq, Eq)]
struct NormalizedModuleNonnegativeDefinition {
    expression: String,
    proof_term: String,
    required_ports: Vec<usize>,
}

fn normalize_module_nonnegative_definition(
    graph: &NeuralGraph,
    module_index: usize,
) -> Result<NormalizedModuleNonnegativeDefinition, ProofError> {
    normalize_module_nonnegative_definition_impl(graph, module_index, true)
}

fn normalize_module_global_nonnegative_definition(
    graph: &NeuralGraph,
    module_index: usize,
) -> Result<NormalizedModuleNonnegativeDefinition, ProofError> {
    normalize_module_nonnegative_definition_impl(graph, module_index, false)
}

fn normalize_module_nonnegative_definition_impl(
    graph: &NeuralGraph,
    module_index: usize,
    require_declared_nonnegative_inputs: bool,
) -> Result<NormalizedModuleNonnegativeDefinition, ProofError> {
    let module = graph
        .modules()
        .get(module_index)
        .ok_or(ProofError::InvalidOutputs)?;
    let boundary = module
        .inputs
        .iter()
        .enumerate()
        .map(|(port, input)| (input.index(), port))
        .collect::<BTreeMap<_, _>>();
    let mut expression_cache = BTreeMap::new();
    let expression = normalized_module_expression(
        graph,
        module.body_start,
        module.body_end,
        module.output.index(),
        &boundary,
        &mut expression_cache,
    )?;
    let mut required_ports = BTreeSet::new();
    let mut proof_cache = BTreeMap::new();
    let proof_term = normalized_module_nonnegative_proof(
        graph,
        module.body_start,
        module.body_end,
        module.output.index(),
        &boundary,
        &mut required_ports,
        &mut proof_cache,
    )?;
    if require_declared_nonnegative_inputs {
        for &port in &required_ports {
            let required = &module.contract.requires[port];
            if required.dtype != DType::F32 || required.domain != Domain::NonNegativeFinite {
                return Err(ProofError::UnsupportedGuarantee {
                    node: module.output.index(),
                });
            }
        }
    }
    // Interface requires remain obligations even when the selected property
    // happens to be provable without them (for example final ReLU).
    for (port, required) in module.contract.requires.iter().enumerate() {
        if required.domain == Domain::NonNegativeFinite {
            if required.dtype != DType::F32 {
                return Err(ProofError::UnsupportedGuarantee {
                    node: module.output.index(),
                });
            }
            required_ports.insert(port);
        }
    }
    Ok(NormalizedModuleNonnegativeDefinition {
        expression,
        proof_term,
        required_ports: required_ports.into_iter().collect(),
    })
}

#[derive(Clone, Debug, PartialEq, Eq)]
struct NormalizedMultiNonnegativeDefinition {
    outputs: Vec<NormalizedModuleNonnegativeDefinition>,
    required_ports: Vec<usize>,
}

fn normalize_multi_nonnegative_definition(
    graph: &NeuralGraph,
    index: usize,
) -> Result<NormalizedMultiNonnegativeDefinition, ProofError> {
    let module = graph
        .multi_modules()
        .get(index)
        .ok_or(ProofError::InvalidOutputs)?;
    if module.outputs.len() < 2 {
        return Err(ProofError::InvalidOutputs);
    }
    let boundary = module
        .inputs
        .iter()
        .enumerate()
        .map(|(port, input)| (input.index(), port))
        .collect::<BTreeMap<_, _>>();
    let mut required = BTreeSet::new();
    let mut outputs = Vec::new();
    for (port, &output) in module.outputs.iter().enumerate() {
        if graph.node(output)?.dtype != DType::F32
            || !module.contract.outputs[port]
                .claims
                .contains(&ContractClaim::Nonnegative)
        {
            return Err(ProofError::UnsupportedGuarantee {
                node: output.index(),
            });
        }
        let expression = normalized_module_expression(
            graph,
            module.body_start,
            module.body_end,
            output.index(),
            &boundary,
            &mut BTreeMap::new(),
        )?;
        let mut needed = BTreeSet::new();
        let proof_term = normalized_module_nonnegative_proof(
            graph,
            module.body_start,
            module.body_end,
            output.index(),
            &boundary,
            &mut needed,
            &mut BTreeMap::new(),
        )?;
        for &port in &needed {
            let contract = &module.contract.inputs[port].port;
            if contract.dtype != DType::F32 || contract.domain != Domain::NonNegativeFinite {
                return Err(ProofError::UnsupportedGuarantee {
                    node: output.index(),
                });
            }
        }
        required.extend(needed.iter().copied());
        outputs.push(NormalizedModuleNonnegativeDefinition {
            expression,
            proof_term,
            required_ports: needed.into_iter().collect(),
        });
    }
    // Even unused declared requires remain obligations of each instance.
    for (port, input) in module.contract.inputs.iter().enumerate() {
        if input.port.domain == Domain::NonNegativeFinite {
            if input.port.dtype != DType::F32 {
                return Err(ProofError::UnsupportedGuarantee {
                    node: module.outputs[0].index(),
                });
            }
            required.insert(port);
        }
    }
    Ok(NormalizedMultiNonnegativeDefinition {
        outputs,
        required_ports: required.into_iter().collect(),
    })
}

fn normalized_module_expression(
    graph: &NeuralGraph,
    body_start: usize,
    body_end: usize,
    index: usize,
    boundary: &BTreeMap<usize, usize>,
    cache: &mut BTreeMap<usize, String>,
) -> Result<String, ProofError> {
    if let Some(expression) = cache.get(&index) {
        return Ok(expression.clone());
    }
    if let Some(&port) = boundary.get(&index) {
        return Ok(format!("p_{port}"));
    }
    if index < body_start || index >= body_end {
        return Err(ProofError::UnsupportedGuarantee { node: index });
    }
    let node = &graph.nodes()[index];
    let expr = |input: NodeId, cache: &mut BTreeMap<usize, String>| {
        normalized_module_expression(graph, body_start, body_end, input.index(), boundary, cache)
    };
    let result = match &node.operation {
        Operation::Add => format!(
            "VeriNeural.add ({}) ({})",
            expr(node.inputs[0], cache)?,
            expr(node.inputs[1], cache)?
        ),
        Operation::Mul => format!(
            "VeriNeural.mul ({}) ({})",
            expr(node.inputs[0], cache)?,
            expr(node.inputs[1], cache)?
        ),
        Operation::MatMul => {
            let left = graph.node(node.inputs[0])?;
            let right = graph.node(node.inputs[1])?;
            format!(
                "VeriNeural.matmul (m := {}) (k := {}) (n := {}) ({}) ({})",
                left.shape.dims()[0],
                left.shape.dims()[1],
                right.shape.dims()[1],
                expr(node.inputs[0], cache)?,
                expr(node.inputs[1], cache)?
            )
        }
        Operation::BiasAdd => format!(
            "VeriNeural.biasAdd (m := {}) (n := {}) ({}) ({})",
            node.shape.dims()[0],
            node.shape.dims()[1],
            expr(node.inputs[0], cache)?,
            expr(node.inputs[1], cache)?
        ),
        Operation::Relu => format!("VeriNeural.relu ({})", expr(node.inputs[0], cache)?),
        Operation::PositiveMask => {
            format!("VeriNeural.positiveMask ({})", expr(node.inputs[0], cache)?)
        }
        Operation::SelectPositive => format!(
            "VeriNeural.selectPositive ({}) ({}) ({})",
            expr(node.inputs[0], cache)?,
            expr(node.inputs[1], cache)?,
            expr(node.inputs[2], cache)?
        ),
        Operation::Reshape(_) => {
            format!("VeriNeural.reshape ({})", expr(node.inputs[0], cache)?)
        }
        Operation::ReduceSum { axis } => {
            let input = graph.node(node.inputs[0])?;
            let (outer, width, inner) = axis_factors(&input.shape, *axis);
            format!(
                "VeriNeural.reduceSumAxis (outer := {outer}) (width := {width}) (inner := {inner}) ({})",
                expr(node.inputs[0], cache)?
            )
        }
        Operation::Permute { axes } => {
            let input = graph.node(node.inputs[0])?;
            if axes.iter().copied().eq(0..axes.len()) {
                format!("VeriNeural.reshape ({})", expr(node.inputs[0], cache)?)
            } else if input.shape.rank() == 2 && axes.as_slice() == [1, 0] {
                format!(
                    "VeriNeural.transpose2D (rows := {}) (cols := {}) ({})",
                    input.shape.dims()[0],
                    input.shape.dims()[1],
                    expr(node.inputs[0], cache)?
                )
            } else {
                return Err(ProofError::UnsupportedOperation {
                    node: index,
                    operation: node.operation.name(),
                });
            }
        }
        Operation::ReverseAxis { axis } => {
            let input = graph.node(node.inputs[0])?;
            let (outer, width, inner) = axis_factors(&input.shape, *axis);
            format!(
                "VeriNeural.reverseAxis (outer := {outer}) (width := {width}) (inner := {inner}) ({})",
                expr(node.inputs[0], cache)?
            )
        }
        Operation::Concat { axis } => {
            let left = graph.node(node.inputs[0])?;
            let right = graph.node(node.inputs[1])?;
            let (outer, left_width, inner) = axis_factors(&left.shape, *axis);
            let (_, right_width, _) = axis_factors(&right.shape, *axis);
            format!(
                "VeriNeural.concatAxis (outer := {outer}) (leftWidth := {left_width}) (rightWidth := {right_width}) (inner := {inner}) ({}) ({})",
                expr(node.inputs[0], cache)?,
                expr(node.inputs[1], cache)?
            )
        }
        Operation::SliceAxis { axis, start, len } => {
            let input = graph.node(node.inputs[0])?;
            let (outer, width, inner) = axis_factors(&input.shape, *axis);
            format!(
                "VeriNeural.sliceAxis (outer := {outer}) (width := {width}) (inner := {inner}) (start := {start}) (len := {len}) ({})",
                expr(node.inputs[0], cache)?
            )
        }
        Operation::ArgMax { axis, .. } => {
            let input = graph.node(node.inputs[0])?;
            let (outer, width, inner) = axis_factors(&input.shape, *axis);
            format!(
                "VeriNeural.argMaxFirstAxis (outer := {outer}) (width := {width}) (inner := {inner}) ({})",
                expr(node.inputs[0], cache)?
            )
        }
        Operation::Take { axis } => {
            let data = graph.node(node.inputs[0])?;
            let (outer, width, inner) = axis_factors(&data.shape, *axis);
            format!(
                "VeriNeural.takeAxis (outer := {outer}) (width := {width}) (inner := {inner}) ({}) ({})",
                expr(node.inputs[0], cache)?,
                expr(node.inputs[1], cache)?
            )
        }
        Operation::Pointwise(spec) if spec.expression().has_ideal_int_semantics() => {
            spec.expression().lean(&|port| {
                normalized_module_expression(
                    graph,
                    body_start,
                    body_end,
                    node.inputs[port].index(),
                    boundary,
                    &mut BTreeMap::new(),
                )
                .unwrap_or_else(|_| "__unsupported".to_owned())
            })
        }
        _ => {
            return Err(ProofError::UnsupportedOperation {
                node: index,
                operation: node.operation.name(),
            });
        }
    };
    if result.contains("__unsupported") {
        return Err(ProofError::UnsupportedGuarantee { node: index });
    }
    cache.insert(index, result.clone());
    Ok(result)
}

fn normalized_module_nonnegative_proof(
    graph: &NeuralGraph,
    body_start: usize,
    body_end: usize,
    index: usize,
    boundary: &BTreeMap<usize, usize>,
    required_ports: &mut BTreeSet<usize>,
    cache: &mut BTreeMap<usize, String>,
) -> Result<String, ProofError> {
    if let Some(proof) = cache.get(&index) {
        return Ok(proof.clone());
    }
    if let Some(&port) = boundary.get(&index) {
        required_ports.insert(port);
        return Ok(format!("h_port_{port}"));
    }
    if index < body_start || index >= body_end {
        return Err(ProofError::UnsupportedGuarantee { node: index });
    }
    let node = &graph.nodes()[index];
    let term = |input: NodeId| {
        normalized_module_expression(
            graph,
            body_start,
            body_end,
            input.index(),
            boundary,
            &mut BTreeMap::new(),
        )
    };
    let prove = |input: NodeId,
                 required_ports: &mut BTreeSet<usize>,
                 cache: &mut BTreeMap<usize, String>| {
        normalized_module_nonnegative_proof(
            graph,
            body_start,
            body_end,
            input.index(),
            boundary,
            required_ports,
            cache,
        )
    };
    let proof = match &node.operation {
        Operation::Add | Operation::Mul | Operation::MatMul | Operation::BiasAdd => {
            let left = node.inputs[0];
            let right = node.inputs[1];
            let hl = prove(left, required_ports, cache)?;
            let hr = prove(right, required_ports, cache)?;
            let lemma = match node.operation {
                Operation::Add => "VeriNeural.add_nonnegative".to_owned(),
                Operation::Mul => "VeriNeural.mul_nonnegative".to_owned(),
                Operation::MatMul => {
                    let l = graph.node(left)?.shape.dims();
                    let r = graph.node(right)?.shape.dims();
                    format!(
                        "VeriNeural.matmul_nonnegative (m := {}) (k := {}) (n := {})",
                        l[0], l[1], r[1]
                    )
                }
                Operation::BiasAdd => format!(
                    "VeriNeural.biasAdd_nonnegative (m := {}) (n := {})",
                    node.shape.dims()[0],
                    node.shape.dims()[1]
                ),
                _ => unreachable!(),
            };
            format!("{lemma} ({}) ({}) ({hl}) ({hr})", term(left)?, term(right)?)
        }
        Operation::Relu => {
            format!("VeriNeural.relu_nonnegative ({})", term(node.inputs[0])?)
        }
        Operation::PositiveMask => {
            format!(
                "VeriNeural.positiveMask_nonnegative ({})",
                term(node.inputs[0])?
            )
        }
        Operation::SelectPositive => {
            let yes = node.inputs[1];
            let no = node.inputs[2];
            let hy = prove(yes, required_ports, cache)?;
            let hn = prove(no, required_ports, cache)?;
            format!(
                "VeriNeural.selectPositive_nonnegative ({}) ({}) ({}) ({hy}) ({hn})",
                term(node.inputs[0])?,
                term(yes)?,
                term(no)?
            )
        }
        Operation::Reshape(_) => {
            let input = node.inputs[0];
            let h = prove(input, required_ports, cache)?;
            format!("VeriNeural.reshape_nonnegative ({}) ({h})", term(input)?)
        }
        Operation::Permute { axes } => {
            let input = node.inputs[0];
            let h = prove(input, required_ports, cache)?;
            let input_node = graph.node(input)?;
            if axes.iter().copied().eq(0..axes.len()) {
                format!("VeriNeural.reshape_nonnegative ({}) ({h})", term(input)?)
            } else if input_node.shape.rank() == 2 && axes.as_slice() == [1, 0] {
                format!(
                    "VeriNeural.transpose2D_nonnegative (rows := {}) (cols := {}) ({}) ({h})",
                    input_node.shape.dims()[0],
                    input_node.shape.dims()[1],
                    term(input)?
                )
            } else {
                return Err(ProofError::UnsupportedGuarantee { node: index });
            }
        }
        Operation::ReverseAxis { axis } => {
            let input = node.inputs[0];
            let (outer, width, inner) = axis_factors(&graph.node(input)?.shape, *axis);
            let h = prove(input, required_ports, cache)?;
            format!(
                "VeriNeural.reverseAxis_nonnegative (outer := {outer}) (width := {width}) (inner := {inner}) ({}) ({h})",
                term(input)?
            )
        }
        Operation::Concat { axis } => {
            let left = node.inputs[0];
            let right = node.inputs[1];
            let (outer, left_width, inner) = axis_factors(&graph.node(left)?.shape, *axis);
            let (_, right_width, _) = axis_factors(&graph.node(right)?.shape, *axis);
            let hl = prove(left, required_ports, cache)?;
            let hr = prove(right, required_ports, cache)?;
            format!(
                "VeriNeural.concatAxis_nonnegative (outer := {outer}) (leftWidth := {left_width}) (rightWidth := {right_width}) (inner := {inner}) ({}) ({}) ({hl}) ({hr})",
                term(left)?,
                term(right)?
            )
        }
        Operation::SliceAxis { axis, start, len } => {
            let input = node.inputs[0];
            let (outer, width, inner) = axis_factors(&graph.node(input)?.shape, *axis);
            let h = prove(input, required_ports, cache)?;
            format!(
                "VeriNeural.sliceAxis_nonnegative (outer := {outer}) (width := {width}) (inner := {inner}) (start := {start}) (len := {len}) ({}) ({h})",
                term(input)?
            )
        }
        Operation::ReduceSum { axis } => {
            let input = node.inputs[0];
            let (outer, width, inner) = axis_factors(&graph.node(input)?.shape, *axis);
            let h = prove(input, required_ports, cache)?;
            format!(
                "VeriNeural.reduceSumAxis_nonnegative (outer := {outer}) (width := {width}) (inner := {inner}) ({}) ({h})",
                term(input)?
            )
        }
        Operation::Take { axis } => {
            let data = node.inputs[0];
            let selected = node.inputs[1];
            let (outer, width, inner) = axis_factors(&graph.node(data)?.shape, *axis);
            let h = prove(data, required_ports, cache)?;
            format!(
                "VeriNeural.takeAxis_nonnegative (outer := {outer}) (width := {width}) (inner := {inner}) ({}) ({}) ({h})",
                term(data)?,
                term(selected)?
            )
        }
        Operation::Pointwise(spec) => spec
            .expression()
            .nonnegative_lean(&|port| {
                normalized_module_expression(
                    graph,
                    body_start,
                    body_end,
                    node.inputs[port].index(),
                    boundary,
                    &mut BTreeMap::new(),
                )
                .unwrap_or_else(|_| "__unsupported".to_owned())
            })
            .filter(|proof| !proof.contains("__unsupported"))
            .ok_or(ProofError::UnsupportedGuarantee { node: index })?,
        _ => return Err(ProofError::UnsupportedGuarantee { node: index }),
    };
    cache.insert(index, proof.clone());
    Ok(proof)
}

// Constructively prove a narrow, architecture-neutral relational fragment:
// nonnegative branches built from ReLU/Add/Mul, and transitive lower bounds
// across arbitrary reachable Add/ReLU chains. Never assume a source's
// runtime Domain is also a Lean theorem hypothesis.
fn derived_nonnegative(
    graph: &NeuralGraph,
    node: NodeId,
    term: &impl Fn(NodeId) -> String,
    fuel: usize,
) -> Option<String> {
    if fuel == 0 {
        return None;
    }
    let item = graph.node(node).ok()?;
    match &item.operation {
        Operation::Relu => Some(format!(
            "(VeriNeural.relu_nonnegative {})",
            term(item.inputs[0])
        )),
        Operation::Add | Operation::Mul => {
            let left = item.inputs[0];
            let right = item.inputs[1];
            let hl = derived_nonnegative(graph, left, term, fuel - 1)?;
            let hr = derived_nonnegative(graph, right, term, fuel - 1)?;
            let lemma = if matches!(item.operation, Operation::Add) {
                "VeriNeural.add_nonnegative"
            } else {
                "VeriNeural.mul_nonnegative"
            };
            Some(format!(
                "({lemma} {} {} {hl} {hr})",
                term(left),
                term(right)
            ))
        }
        _ => None,
    }
}

fn derived_pointwise_le(
    graph: &NeuralGraph,
    lower: NodeId,
    upper: NodeId,
    term: &impl Fn(NodeId) -> String,
    fuel: usize,
) -> Option<String> {
    if fuel == 0 {
        return None;
    }
    if lower == upper {
        return Some(format!("(VeriNeural.pointwise_le_refl {})", term(lower)));
    }
    let item = graph.node(upper).ok()?;
    match &item.operation {
        Operation::Relu => {
            let inner = item.inputs[0];
            // Direct bound permits a nonnegative sibling of arbitrary
            // supported composition depth, not only a naked ReLU.
            let source = graph.node(inner).ok()?;
            if matches!(source.operation, Operation::Add) {
                let left = source.inputs[0];
                let right = source.inputs[1];
                if lower == left {
                    if let Some(hb) = derived_nonnegative(graph, right, term, fuel - 1) {
                        return Some(format!(
                            "(VeriNeural.pointwise_le_relu_add_of_nonnegative {} {} {hb})",
                            term(left),
                            term(right)
                        ));
                    }
                }
            }
            let hnext = format!("(VeriNeural.pointwise_le_relu {})", term(inner));
            if lower == inner {
                return Some(hnext);
            }
            let previous = derived_pointwise_le(graph, lower, inner, term, fuel - 1)?;
            Some(format!(
                "(VeriNeural.pointwise_le_trans {} {} {} {previous} {hnext})",
                term(lower),
                term(inner),
                term(upper)
            ))
        }
        Operation::Add => {
            let left = item.inputs[0];
            let right = item.inputs[1];
            // Either operand may provide the lower bound if the opposite
            // branch is independently proven nonnegative.
            for (base, other, lemma) in [
                (left, right, "VeriNeural.pointwise_le_add_of_nonnegative"),
                (
                    right,
                    left,
                    "VeriNeural.pointwise_le_add_of_nonnegative_left",
                ),
            ] {
                let Some(nonnegative) = derived_nonnegative(graph, other, term, fuel - 1) else {
                    continue;
                };
                let step = format!("({lemma} {} {} {nonnegative})", term(left), term(right));
                if lower == base {
                    return Some(step);
                }
                if let Some(previous) = derived_pointwise_le(graph, lower, base, term, fuel - 1) {
                    return Some(format!(
                        "(VeriNeural.pointwise_le_trans {} {} {} {previous} {step})",
                        term(lower),
                        term(base),
                        term(upper)
                    ));
                }
            }
            None
        }
        _ => None,
    }
}

fn collect_used_nodes(graph: &NeuralGraph, output: NodeId) -> Result<BTreeSet<usize>, ProofError> {
    Ok(graph.dependency_scope(&[output])?)
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
enum GlobalModuleKey {
    Single(usize),
    Multi(usize),
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct GlobalModuleOutputKey {
    sequence: usize,
    module: GlobalModuleKey,
    port: usize,
}

fn ordered_global_module_keys(graph: &NeuralGraph) -> Vec<(usize, GlobalModuleKey)> {
    let mut single = 0usize;
    let mut multi = 0usize;
    graph
        .module_instances()
        .enumerate()
        .map(|(sequence, instance)| {
            let key = match instance {
                ModuleInstanceRef::Single(_) => {
                    let key = GlobalModuleKey::Single(single);
                    single += 1;
                    key
                }
                ModuleInstanceRef::Multi(_) => {
                    let key = GlobalModuleKey::Multi(multi);
                    multi += 1;
                    key
                }
            };
            (sequence, key)
        })
        .collect()
}

fn global_module_ref(
    graph: &NeuralGraph,
    key: GlobalModuleKey,
) -> Result<ModuleInstanceRef<'_>, ProofError> {
    match key {
        GlobalModuleKey::Single(index) => graph
            .modules()
            .get(index)
            .map(ModuleInstanceRef::Single)
            .ok_or(ProofError::InvalidOutputs),
        GlobalModuleKey::Multi(index) => graph
            .multi_modules()
            .get(index)
            .map(ModuleInstanceRef::Multi)
            .ok_or(ProofError::InvalidOutputs),
    }
}

fn global_module_inputs(
    graph: &NeuralGraph,
    key: GlobalModuleKey,
) -> Result<&[NodeId], ProofError> {
    Ok(global_module_ref(graph, key)?.inputs())
}

fn global_module_outputs(
    graph: &NeuralGraph,
    key: GlobalModuleKey,
) -> Result<Vec<NodeId>, ProofError> {
    Ok(global_module_ref(graph, key)?.outputs())
}

fn global_module_output(
    graph: &NeuralGraph,
    key: GlobalModuleKey,
    port: usize,
) -> Result<NodeId, ProofError> {
    global_module_outputs(graph, key)?
        .get(port)
        .copied()
        .ok_or(ProofError::InvalidOutputs)
}

fn global_module_contains(
    graph: &NeuralGraph,
    parent: (usize, GlobalModuleKey),
    child: (usize, GlobalModuleKey),
) -> bool {
    if child.0 >= parent.0 {
        return false;
    }
    let Ok(parent) = global_module_ref(graph, parent.1) else {
        return false;
    };
    let Ok(child) = global_module_ref(graph, child.1) else {
        return false;
    };
    let parent = parent.body_range();
    let child = child.body_range();
    child.start >= parent.start && child.end <= parent.end
}

fn global_module_same_interface(
    graph: &NeuralGraph,
    left: GlobalModuleKey,
    right: GlobalModuleKey,
) -> Result<bool, ProofError> {
    Ok(match (left, right) {
        (GlobalModuleKey::Single(left), GlobalModuleKey::Single(right)) => {
            let left = graph
                .modules()
                .get(left)
                .ok_or(ProofError::InvalidOutputs)?;
            let right = graph
                .modules()
                .get(right)
                .ok_or(ProofError::InvalidOutputs)?;
            left.name == right.name
                && left.semantic_version == right.semantic_version
                && left.contract == right.contract
        }
        (GlobalModuleKey::Multi(left), GlobalModuleKey::Multi(right)) => {
            let left = graph
                .multi_modules()
                .get(left)
                .ok_or(ProofError::InvalidOutputs)?;
            let right = graph
                .multi_modules()
                .get(right)
                .ok_or(ProofError::InvalidOutputs)?;
            left.name == right.name
                && left.semantic_version == right.semantic_version
                && left.contract == right.contract
        }
        _ => false,
    })
}

fn normalize_multi_global_nonnegative_definition(
    graph: &NeuralGraph,
    index: usize,
    output_port: usize,
) -> Result<NormalizedModuleNonnegativeDefinition, ProofError> {
    let module = graph
        .multi_modules()
        .get(index)
        .ok_or(ProofError::InvalidOutputs)?;
    let output = module
        .outputs
        .get(output_port)
        .copied()
        .ok_or(ProofError::InvalidOutputs)?;
    if graph.node(output)?.dtype != DType::F32 {
        return Err(ProofError::UnsupportedGuarantee {
            node: output.index(),
        });
    }
    let boundary = module
        .inputs
        .iter()
        .enumerate()
        .map(|(port, input)| (input.index(), port))
        .collect::<BTreeMap<_, _>>();
    let expression = normalized_module_expression(
        graph,
        module.body_start,
        module.body_end,
        output.index(),
        &boundary,
        &mut BTreeMap::new(),
    )?;
    let mut required_ports = BTreeSet::new();
    let proof_term = normalized_module_nonnegative_proof(
        graph,
        module.body_start,
        module.body_end,
        output.index(),
        &boundary,
        &mut required_ports,
        &mut BTreeMap::new(),
    )?;
    // A concrete global application still owes every declared nonnegative
    // interface requirement, even if this particular output proof ignores it.
    for (port, input) in module.contract.inputs.iter().enumerate() {
        if input.port.domain == Domain::NonNegativeFinite {
            if input.port.dtype != DType::F32 {
                return Err(ProofError::UnsupportedGuarantee {
                    node: output.index(),
                });
            }
            required_ports.insert(port);
        }
    }
    Ok(NormalizedModuleNonnegativeDefinition {
        expression,
        proof_term,
        required_ports: required_ports.into_iter().collect(),
    })
}

fn normalize_global_module_output(
    graph: &NeuralGraph,
    key: GlobalModuleOutputKey,
) -> Result<NormalizedModuleNonnegativeDefinition, ProofError> {
    match key.module {
        GlobalModuleKey::Single(index) => {
            if key.port != 0 {
                return Err(ProofError::InvalidOutputs);
            }
            normalize_module_global_nonnegative_definition(graph, index)
        }
        GlobalModuleKey::Multi(index) => {
            normalize_multi_global_nonnegative_definition(graph, index, key.port)
        }
    }
}

fn global_definition_name(key: GlobalModuleOutputKey) -> String {
    match key.module {
        GlobalModuleKey::Single(_) => {
            format!("architecture_module_definition_{}", key.sequence)
        }
        GlobalModuleKey::Multi(_) => format!(
            "architecture_module_definition_{}_port_{}",
            key.sequence, key.port
        ),
    }
}

fn global_instance_name(key: GlobalModuleOutputKey) -> String {
    match key.module {
        GlobalModuleKey::Single(_) => format!("architecture_module_instance_{}", key.sequence),
        GlobalModuleKey::Multi(_) => format!(
            "architecture_module_instance_{}_port_{}",
            key.sequence, key.port
        ),
    }
}

fn global_input_hypothesis_name(key: GlobalModuleOutputKey, input_port: usize) -> String {
    match key.module {
        GlobalModuleKey::Single(_) => {
            format!("h_module_{}_input_{input_port}", key.sequence)
        }
        GlobalModuleKey::Multi(_) => format!(
            "h_module_{}_port_{}_input_{input_port}",
            key.sequence, key.port
        ),
    }
}

fn global_have_name(key: GlobalModuleOutputKey) -> String {
    match key.module {
        GlobalModuleKey::Single(_) => format!("arch_module_{}", key.sequence),
        GlobalModuleKey::Multi(_) => format!("arch_module_{}_port_{}", key.sequence, key.port),
    }
}

/// A claim is about the ideal-Int interpretation of the graph, not the
/// conservative FP32 value domain. Never infer proof from \`Domain::Any\` or
/// from a user assertion: build it from trusted Lean operation lemmas and
/// explicitly declared source assumptions.
fn prove_ideal_nonnegative(
    graph: &NeuralGraph,
    id: NodeId,
    arguments: &str,
    source_hypotheses: &BTreeSet<usize>,
    cache: &mut BTreeMap<usize, String>,
) -> Result<String, ProofError> {
    let index = id.index();
    if let Some(term) = cache.get(&index) {
        return Ok(term.clone());
    }
    let node = graph.node(id)?;
    let call = |id: NodeId| format!("(node_{} {arguments})", id.index());
    let proof = match node.operation {
        Operation::Input if source_hypotheses.contains(&index) => format!("h_{index}"),
        Operation::Relu => format!("VeriNeural.relu_nonnegative {}", call(node.inputs[0])),
        Operation::PositiveMask => {
            format!(
                "VeriNeural.positiveMask_nonnegative {}",
                call(node.inputs[0])
            )
        }
        Operation::SelectPositive => {
            let yes = node.inputs[1];
            let no = node.inputs[2];
            let hy = prove_ideal_nonnegative(graph, yes, arguments, source_hypotheses, cache)?;
            let hn = prove_ideal_nonnegative(graph, no, arguments, source_hypotheses, cache)?;
            format!(
                "VeriNeural.selectPositive_nonnegative {} {} {} ({hy}) ({hn})",
                call(node.inputs[0]),
                call(yes),
                call(no)
            )
        }
        Operation::Reshape(_) => {
            let input = node.inputs[0];
            let h = prove_ideal_nonnegative(graph, input, arguments, source_hypotheses, cache)?;
            format!("VeriNeural.reshape_nonnegative {} ({h})", call(input))
        }
        Operation::Permute { ref axes } => {
            let input = node.inputs[0];
            let h = prove_ideal_nonnegative(graph, input, arguments, source_hypotheses, cache)?;
            if axes.iter().copied().eq(0..axes.len()) {
                format!("VeriNeural.reshape_nonnegative {} ({h})", call(input))
            } else {
                let dims = graph.node(input)?.shape.dims();
                format!(
                    "VeriNeural.transpose2D_nonnegative (rows := {}) (cols := {}) {} ({h})",
                    dims[0],
                    dims[1],
                    call(input)
                )
            }
        }
        Operation::ReverseAxis { axis } => {
            let input = node.inputs[0];
            let (outer, width, inner) = axis_factors(&graph.node(input)?.shape, axis);
            let h = prove_ideal_nonnegative(graph, input, arguments, source_hypotheses, cache)?;
            format!(
                "VeriNeural.reverseAxis_nonnegative (outer := {outer}) \
                 (width := {width}) (inner := {inner}) {} ({h})",
                call(input)
            )
        }
        Operation::SliceAxis { axis, start, len } => {
            let input = node.inputs[0];
            let (outer, width, inner) = axis_factors(&graph.node(input)?.shape, axis);
            let h = prove_ideal_nonnegative(graph, input, arguments, source_hypotheses, cache)?;
            format!(
                "VeriNeural.sliceAxis_nonnegative (outer := {outer})                  (width := {width}) (inner := {inner}) (start := {start})                  (len := {len}) {} ({h})",
                call(input)
            )
        }
        Operation::Concat { axis } => {
            let left = node.inputs[0];
            let right = node.inputs[1];
            let (outer, left_width, inner) = axis_factors(&graph.node(left)?.shape, axis);
            let (_, right_width, _) = axis_factors(&graph.node(right)?.shape, axis);
            let hl = prove_ideal_nonnegative(graph, left, arguments, source_hypotheses, cache)?;
            let hr = prove_ideal_nonnegative(graph, right, arguments, source_hypotheses, cache)?;
            format!(
                "VeriNeural.concatAxis_nonnegative (outer := {outer}) \
                 (leftWidth := {left_width}) (rightWidth := {right_width}) \
                 (inner := {inner}) {} {} ({hl}) ({hr})",
                call(left),
                call(right)
            )
        }
        Operation::Take { axis } => {
            let data = node.inputs[0];
            let selected = node.inputs[1];
            let (outer, width, inner) = axis_factors(&graph.node(data)?.shape, axis);
            let h = prove_ideal_nonnegative(graph, data, arguments, source_hypotheses, cache)?;
            format!(
                "VeriNeural.takeAxis_nonnegative (outer := {outer}) \
                 (width := {width}) (inner := {inner}) {} {} ({h})",
                call(data),
                call(selected)
            )
        }
        Operation::Pointwise(ref spec) => spec
            .expression()
            .nonnegative_lean(&|port| call(node.inputs[port]))
            .ok_or(ProofError::UnsupportedGuarantee { node: index })?,
        Operation::ReduceSum { axis } => {
            let input = node.inputs[0];
            let dims = graph.node(input)?.shape.dims();
            let outer = dims[..axis].iter().product::<usize>();
            let width = dims[axis];
            let inner = dims[axis + 1..].iter().product::<usize>();
            let proof = prove_ideal_nonnegative(graph, input, arguments, source_hypotheses, cache)?;
            format!(
                "VeriNeural.reduceSumAxis_nonnegative (outer := {outer}) \
                 (width := {width}) (inner := {inner}) {} ({proof})",
                call(input)
            )
        }
        Operation::Add | Operation::Mul | Operation::MatMul | Operation::BiasAdd => {
            let a = node.inputs[0];
            let b = node.inputs[1];
            let ha = prove_ideal_nonnegative(graph, a, arguments, source_hypotheses, cache)?;
            let hb = prove_ideal_nonnegative(graph, b, arguments, source_hypotheses, cache)?;
            let lemma = match node.operation {
                Operation::Add => "VeriNeural.add_nonnegative".to_owned(),
                Operation::Mul => "VeriNeural.mul_nonnegative".to_owned(),
                Operation::MatMul => {
                    let left = graph.node(a)?.shape.dims();
                    let right = graph.node(b)?.shape.dims();
                    format!(
                        "VeriNeural.matmul_nonnegative (m := {}) (k := {}) (n := {})",
                        left[0], left[1], right[1]
                    )
                }
                Operation::BiasAdd => {
                    let dims = node.shape.dims();
                    format!(
                        "VeriNeural.biasAdd_nonnegative (m := {}) (n := {})",
                        dims[0], dims[1]
                    )
                }
                _ => unreachable!("handled binary primitive"),
            };
            format!("{lemma} {} {} ({ha}) ({hb})", call(a), call(b))
        }
        _ => return Err(ProofError::UnsupportedGuarantee { node: index }),
    };
    cache.insert(index, proof.clone());
    Ok(proof)
}

/// Shared, borrowed proof signature for independently claimed ideal-Int
/// postconditions. Keeps source hypotheses explicit without bloating callers.
struct IdealNonnegativeClaimContext<'a> {
    params: &'a str,
    arguments: &'a str,
    assumptions: &'a [ProofAssumption],
    source_hypotheses: &'a BTreeSet<usize>,
}

/// Resolve module-local references to concrete graph handles, without
/// accepting globally captured nodes in an ostensibly closed contract.
fn resolve_module_value(
    graph: &NeuralGraph,
    value: &ValueRef,
    inputs: &[NodeId],
    output: NodeId,
) -> Result<NodeId, ProofError> {
    let id = match value {
        ValueRef::Input(index) => inputs.get(*index).copied(),
        ValueRef::Output => Some(output),
        ValueRef::Node(_) => None,
    }
    .ok_or(ProofError::UnsupportedGuarantee {
        node: output.index(),
    })?;
    graph.node(id)?;
    Ok(id)
}

fn emit_module_predicate(
    graph: &NeuralGraph,
    source: &mut String,
    theorems: &mut Vec<String>,
    name: String,
    predicate: &Predicate,
    module: (&[NodeId], NodeId),
    context: &IdealNonnegativeClaimContext<'_>,
) -> Result<(), ProofError> {
    let (inputs, output) = module;
    match predicate {
        Predicate::Nonnegative(value) => {
            let target = resolve_module_value(graph, value, inputs, output)?;
            emit_ideal_nonnegative_claim(graph, source, theorems, name, target, context)
        }
        Predicate::Equal(a, b) | Predicate::PointwiseLe(a, b) => {
            let left = resolve_module_value(graph, a, inputs, output)?;
            let right = resolve_module_value(graph, b, inputs, output)?;
            let left_node = graph.node(left)?;
            let right_node = graph.node(right)?;
            if left_node.shape != right_node.shape
                || left_node.dtype != right_node.dtype
                || (matches!(predicate, Predicate::PointwiseLe(_, _))
                    && left_node.dtype != DType::F32)
            {
                return Err(ProofError::UnsupportedGuarantee {
                    node: output.index(),
                });
            }
            let call = |id: NodeId| format!("(node_{} {})", id.index(), context.arguments);
            let (proposition, proof) = match predicate {
                Predicate::Equal(_, _) => (
                    format!("{} = {}", call(left), call(right)),
                    "  rfl\n".to_owned(),
                ),
                Predicate::PointwiseLe(_, _) => (
                    format!("VeriNeural.PointwiseLe {} {}", call(left), call(right)),
                    format!("  exact VeriNeural.pointwise_le_relu {}\n", call(left)),
                ),
                Predicate::Nonnegative(_) => unreachable!(),
            };
            source.push_str(&format!(
                "theorem {name} {} : {proposition} := by\n{proof}\n",
                context.params
            ));
            theorems.push(name);
            Ok(())
        }
    }
}

fn emit_ideal_nonnegative_claim(
    graph: &NeuralGraph,
    source: &mut String,
    names: &mut Vec<String>,
    theorem: String,
    output: NodeId,
    context: &IdealNonnegativeClaimContext<'_>,
) -> Result<(), ProofError> {
    let params = context.params;
    let arguments = context.arguments;
    let assumptions = context.assumptions;
    let proof = prove_ideal_nonnegative(
        graph,
        output,
        arguments,
        context.source_hypotheses,
        &mut BTreeMap::new(),
    )?;
    // Keep the full positional hypothesis interface for every theorem, but
    // mark unused binders to avoid Lean's unused-variable diagnostics.
    let hypothesis_params = assumptions
        .iter()
        .map(|a| {
            let idx = a.input_node;
            let wanted = format!("h_{idx}");
            let identifier = if proof
                .split(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
                .any(|token| token == wanted)
            {
                format!("h_{idx}")
            } else {
                format!("_h_{idx}")
            };
            format!("({identifier} : VeriNeural.Nonnegative x_{idx})")
        })
        .collect::<Vec<_>>()
        .join(" ");
    source.push_str(&format!(
        "theorem {theorem} {params} {hypothesis_params} :\n  \
         VeriNeural.Nonnegative (node_{} {arguments}) := by\n  \
         exact {proof}\n\n",
        output.index()
    ));
    names.push(theorem);
    Ok(())
}

fn shape_expr(shape: &Shape) -> String {
    let dims = shape
        .dims()
        .iter()
        .map(usize::to_string)
        .collect::<Vec<_>>()
        .join(", ");
    format!("([{dims}] : List Nat)")
}

fn lean_value_type(dtype: DType, count: usize) -> String {
    match dtype {
        DType::F32 => format!("VeriNeural.Tensor {count}"),
        DType::Index => format!("VeriNeural.IndexTensor {count}"),
    }
}

fn axis_factors(shape: &Shape, axis: usize) -> (usize, usize, usize) {
    let dims = shape.dims();
    (
        dims[..axis].iter().product(),
        dims[axis],
        dims[axis + 1..].iter().product(),
    )
}

fn emit_decidable(
    source: &mut String,
    theorems: &mut Vec<String>,
    name: String,
    statement: String,
) {
    source.push_str(&format!(
        "theorem {name} :\n  {statement} := by\n  decide\n\n"
    ));
    theorems.push(name);
}

fn emit_nonnegative_alias(
    source: &mut String,
    theorems: &mut Vec<String>,
    name: String,
    proof_params: &str,
    term: &str,
    proof_term: &str,
) {
    source.push_str(&format!(
        "theorem {name} {proof_params} :\n  VeriNeural.Nonnegative {term} := by\n  exact {proof_term}\n\n"
    ));
    theorems.push(name);
}

#[cfg(test)]
mod axiom_audit_tests {
    use super::*;

    fn names() -> Vec<String> {
        vec!["node_2_nonnegative".into(), "node_3_shape".into()]
    }

    #[test]
    fn propext_is_allowed_but_visible_in_dependencies() {
        let stdout = "'VeriNeural.Generated.node_2_nonnegative' depends on axioms: [propext]\n\
                      'VeriNeural.Generated.node_3_shape' does not depend on any axioms\n";
        let deps = parse_axiom_report(stdout, &names()).unwrap();
        assert_eq!(deps["node_2_nonnegative"], vec!["propext"]);
        assert!(deps["node_3_shape"].is_empty());
    }

    #[test]
    fn forbidden_axioms_and_forged_reports_fail_closed() {
        for axiom in [
            "sorryAx",
            "user.hidden",
            "Classical.choice",
            "propext, sorryAx",
        ] {
            let stdout = format!(
                "'VeriNeural.Generated.node_2_nonnegative' depends on axioms: [{axiom}]\n\
                 'VeriNeural.Generated.node_3_shape' does not depend on any axioms\n"
            );
            assert!(parse_axiom_report(&stdout, &names()).is_err());
        }
        for stdout in [
            "'VeriNeural.Generated.unexpected' does not depend on any axioms\n\
             'VeriNeural.Generated.node_3_shape' does not depend on any axioms\n",
            "'VeriNeural.Generated.node_2_nonnegative' does not depend on any axioms\n",
            "'VeriNeural.Generated.node_2_nonnegative' does not depend on any axioms\n\
             'VeriNeural.Generated.node_3_shape' does not depend on any axioms\n\
             unexpected extra line\n",
        ] {
            assert!(parse_axiom_report(stdout, &names()).is_err());
        }
    }
}

FILE	crates/verineural/src/special.rs
//! Stage 8: narrow binary32 exceptional-value semantics, independent of host FP32.
//!
//! Only the enumerated operations have a defined expected result. None means
//! outside this boundary slice, not "probably correct". Quiet-NaN payloads
//! are deliberately *not* asserted. This is neither an IEEE-754 completeness
//! claim nor a proof of GPU/SASS behavior.

/// Bit-class expected by the restricted special-value oracle.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Fp32SpecialExpected {
    Exact(u32),
    QuietNaN,
}

impl Fp32SpecialExpected {
    /// Exact bits are required except where NaN payload/sign may vary.
    pub fn accepts(self, observed_bits: u32) -> bool {
        match self {
            Self::Exact(bits) => observed_bits == bits,
            Self::QuietNaN => is_quiet_nan(observed_bits),
        }
    }

    pub fn description(self) -> String {
        match self {
            Self::Exact(bits) => format!("exact:{bits:08x}"),
            Self::QuietNaN => "quiet_nan:any_payload".to_owned(),
        }
    }
}

const SIGN: u32 = 0x8000_0000;
const ABS_MASK: u32 = 0x7fff_ffff;
const INFINITY: u32 = 0x7f80_0000;
const MAX_FINITE: u32 = 0x7f7f_ffff;
const ONE: u32 = 0x3f80_0000;
const TWO: u32 = 0x4000_0000;

fn is_infinite(bits: u32) -> bool {
    bits & ABS_MASK == INFINITY
}

fn is_quiet_nan(bits: u32) -> bool {
    bits & 0x7f80_0000 == INFINITY && bits & 0x0040_0000 != 0
}

fn is_signaling_nan(bits: u32) -> bool {
    bits & 0x7f80_0000 == INFINITY && bits & 0x007f_ffff != 0 && bits & 0x0040_0000 == 0
}

fn is_zero(bits: u32) -> bool {
    bits & ABS_MASK == 0
}

fn sign_of(bits: u32) -> u32 {
    bits & SIGN
}

/// Selected exact/special multiplication cases. No floating host operations.
pub fn special_mul_boundary(lhs: u32, rhs: u32) -> Option<Fp32SpecialExpected> {
    if is_signaling_nan(lhs) || is_signaling_nan(rhs) {
        return None;
    }
    if is_quiet_nan(lhs) || is_quiet_nan(rhs) {
        return Some(Fp32SpecialExpected::QuietNaN);
    }
    let sign = sign_of(lhs) ^ sign_of(rhs);
    if is_infinite(lhs) || is_infinite(rhs) {
        return Some(if is_zero(lhs) || is_zero(rhs) {
            Fp32SpecialExpected::QuietNaN
        } else {
            Fp32SpecialExpected::Exact(sign | INFINITY)
        });
    }
    if is_zero(lhs) || is_zero(rhs) {
        return Some(Fp32SpecialExpected::Exact(sign));
    }
    // The two exactly representable overflow witnesses; not general overflow.
    if (lhs & ABS_MASK == MAX_FINITE && rhs & ABS_MASK == TWO)
        || (rhs & ABS_MASK == MAX_FINITE && lhs & ABS_MASK == TWO)
    {
        return Some(Fp32SpecialExpected::Exact(sign | INFINITY));
    }
    // Multiplication by +/-1 preserves all *finite* binary32 magnitudes.
    if lhs & ABS_MASK == ONE {
        return Some(Fp32SpecialExpected::Exact(sign | (rhs & ABS_MASK)));
    }
    if rhs & ABS_MASK == ONE {
        return Some(Fp32SpecialExpected::Exact(sign | (lhs & ABS_MASK)));
    }
    None
}

/// Narrow exact add: signed zero, identity by zero, equal infinities,
/// opposite infinities, +/-1 cancellation and a max-finite overflow witness.
pub fn special_add_boundary(
    lhs: Fp32SpecialExpected,
    rhs_bits: u32,
) -> Option<Fp32SpecialExpected> {
    if is_signaling_nan(rhs_bits) {
        return None;
    }
    if matches!(lhs, Fp32SpecialExpected::QuietNaN) || is_quiet_nan(rhs_bits) {
        return Some(Fp32SpecialExpected::QuietNaN);
    }
    let Fp32SpecialExpected::Exact(lhs_bits) = lhs else {
        return None;
    };
    if is_signaling_nan(lhs_bits) || is_quiet_nan(lhs_bits) {
        return None;
    }
    if is_infinite(lhs_bits) || is_infinite(rhs_bits) {
        return Some(
            if is_infinite(lhs_bits)
                && is_infinite(rhs_bits)
                && sign_of(lhs_bits) != sign_of(rhs_bits)
            {
                Fp32SpecialExpected::QuietNaN
            } else {
                Fp32SpecialExpected::Exact(if is_infinite(lhs_bits) {
                    lhs_bits
                } else {
                    rhs_bits
                })
            },
        );
    }
    if is_zero(lhs_bits) && is_zero(rhs_bits) {
        // Round-to-nearest: -0 + -0 is -0; opposite signed zeros give +0.
        return Some(Fp32SpecialExpected::Exact(
            sign_of(lhs_bits) & sign_of(rhs_bits),
        ));
    }
    if is_zero(lhs_bits) {
        return Some(Fp32SpecialExpected::Exact(rhs_bits));
    }
    if is_zero(rhs_bits) {
        return Some(Fp32SpecialExpected::Exact(lhs_bits));
    }
    if lhs_bits & ABS_MASK == ONE
        && rhs_bits & ABS_MASK == ONE
        && sign_of(lhs_bits) != sign_of(rhs_bits)
    {
        return Some(Fp32SpecialExpected::Exact(0));
    }
    if lhs_bits & ABS_MASK == MAX_FINITE
        && rhs_bits & ABS_MASK == MAX_FINITE
        && sign_of(lhs_bits) == sign_of(rhs_bits)
    {
        return Some(Fp32SpecialExpected::Exact(sign_of(lhs_bits) | INFINITY));
    }
    None
}

/// ReLU as implemented by the IR: qNaN remains qNaN (payload unspecified),
/// positive FP32 values stay unchanged and negative values including -0
/// become +0.
pub fn special_relu_boundary(input: Fp32SpecialExpected) -> Fp32SpecialExpected {
    match input {
        Fp32SpecialExpected::QuietNaN => Fp32SpecialExpected::QuietNaN,
        Fp32SpecialExpected::Exact(bits) if sign_of(bits) != 0 => Fp32SpecialExpected::Exact(0),
        exact => exact,
    }
}

/// Composes exactly the supported Mul -> BiasAdd -> ReLU fragment.
pub fn special_mul_bias_relu_boundary(
    lhs: u32,
    rhs: u32,
    bias: u32,
) -> Option<Fp32SpecialExpected> {
    let product = special_mul_boundary(lhs, rhs)?;
    let biased = special_add_boundary(product, bias)?;
    Some(special_relu_boundary(biased))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn exceptional_values_use_class_or_exact_bits_without_floating_host_ops() {
        let lanes = [
            (INFINITY, ONE, 0, Fp32SpecialExpected::Exact(INFINITY)),
            (SIGN | INFINITY, ONE, 0, Fp32SpecialExpected::Exact(0)),
            (0, INFINITY, 0, Fp32SpecialExpected::QuietNaN),
            (0x7fc0_0123, ONE, 0, Fp32SpecialExpected::QuietNaN),
            (MAX_FINITE, TWO, 0, Fp32SpecialExpected::Exact(INFINITY)),
            (SIGN | MAX_FINITE, TWO, 0, Fp32SpecialExpected::Exact(0)),
            (SIGN, ONE, 0, Fp32SpecialExpected::Exact(0)),
            (0, SIGN | ONE, SIGN, Fp32SpecialExpected::Exact(0)),
            (ONE, ONE, SIGN | ONE, Fp32SpecialExpected::Exact(0)),
            (ONE, ONE, 0, Fp32SpecialExpected::Exact(ONE)),
            (SIGN | 1, ONE, 0, Fp32SpecialExpected::Exact(0)),
            (1, ONE, 0, Fp32SpecialExpected::Exact(1)),
            (INFINITY, SIGN | ONE, 0, Fp32SpecialExpected::Exact(0)),
        ];
        for (lhs, rhs, bias, expected) in lanes {
            assert_eq!(
                special_mul_bias_relu_boundary(lhs, rhs, bias),
                Some(expected)
            );
        }
        assert!(Fp32SpecialExpected::QuietNaN.accepts(0x7fc0_0000));
        assert!(Fp32SpecialExpected::QuietNaN.accepts(0xffd2_0000));
        assert!(!Fp32SpecialExpected::QuietNaN.accepts(0x7f80_0001));
        assert!(!Fp32SpecialExpected::QuietNaN.accepts(INFINITY));
    }

    #[test]
    fn exceptional_oracle_fails_closed_for_unmodeled_values() {
        assert_eq!(special_mul_boundary(0x7f80_0001, ONE), None);
        assert_eq!(
            special_add_boundary(Fp32SpecialExpected::Exact(ONE), 0x7f80_0001),
            None
        );
        assert_eq!(special_mul_boundary(0x3fc0_0000, 0x3fc0_0000), None);
        assert_eq!(
            special_add_boundary(Fp32SpecialExpected::Exact(ONE), ONE),
            None
        );
        assert_eq!(special_mul_bias_relu_boundary(ONE, ONE, 0x7f80_0001), None);
        assert_eq!(
            special_add_boundary(Fp32SpecialExpected::Exact(SIGN), SIGN),
            Some(Fp32SpecialExpected::Exact(SIGN))
        );
    }
}

FILE	crates/verineural/src/subnormal.rs
//! Stage 8 boundary-only binary32 oracle, independent from host FP32 arithmetic.
//!
//! Supports finite binary32 multiplication iff the correctly rounded output
//! is a subnormal, signed zero or the smallest normal. The exact product is
//! evaluated in integer significand/exponent form, then rounded RNE on the
//! 2^-149 subnormal lattice. Addition is only supported when both operands
//! are subnormal/zero/smallest-normal and their exact sum is representable
//! within that same interval. This does NOT establish a general IEEE-754
//! model, machine execution or CUDA correctness.

fn decode_finite(bits: u32) -> Option<(bool, u128, i32)> {
    let biased = (bits >> 23) & 0xff;
    if biased == 0xff {
        return None;
    }
    let negative = (bits >> 31) != 0;
    let fraction = bits & 0x7f_ffff;
    if biased == 0 {
        Some((negative, u128::from(fraction), -149))
    } else {
        Some((
            negative,
            u128::from((1 << 23) | fraction),
            biased as i32 - 127 - 23,
        ))
    }
}

/// Independently compute RNE for a finite binary32 product at gradual
/// underflow, with integer arithmetic only. None means the result leaves
/// the supported subnormal/min-normal boundary profile.
pub fn subnormal_mul_rne_bits(lhs: u32, rhs: u32) -> Option<u32> {
    let (lhs_neg, lhs_sig, lhs_exp) = decode_finite(lhs)?;
    let (rhs_neg, rhs_sig, rhs_exp) = decode_finite(rhs)?;
    let magnitude = lhs_sig.checked_mul(rhs_sig)?;
    let shift = lhs_exp.checked_add(rhs_exp)?.checked_add(149)?;
    let rounded = if shift >= 0 {
        // checked_shl checks the shift count, not discarded high bits.
        // Bound before shifting so a huge normal product cannot wrap into
        // a plausible-looking subnormal result.
        let left = shift as u32;
        if left >= 128 || magnitude > (0x80_0000u128 >> left) {
            return None;
        }
        magnitude << left
    } else {
        let right = (-shift) as u32;
        if right >= 128 {
            0
        } else {
            let whole = magnitude >> right;
            let remainder = magnitude & ((1u128 << right) - 1);
            let half = 1u128 << (right - 1);
            let increment = remainder > half || (remainder == half && whole & 1 != 0);
            whole + u128::from(increment)
        }
    };
    if rounded > 0x80_0000 {
        return None;
    }
    let sign = (u32::from(lhs_neg ^ rhs_neg)) << 31;
    Some(sign | (rounded as u32))
}

/// Exact addition on the 2^-149 lattice, limited to subnormals, signed +0,
/// and the smallest positive or negative normal. Negative zero is not
/// supported as an operand because sign-of-zero needs a separate contract.
pub fn subnormal_add_exact_bits(lhs: u32, rhs: u32) -> Option<u32> {
    fn ticks(bits: u32) -> Option<i64> {
        if bits == 0 {
            return Some(0);
        }
        if bits == 0x8000_0000 {
            return None; // signed-zero addition requires a separate policy
        }
        let magnitude = bits & 0x7fff_ffff;
        if magnitude > 0x0080_0000 {
            return None;
        }
        let value = i64::from(magnitude);
        Some(if bits >> 31 == 0 { value } else { -value })
    }
    let sum = ticks(lhs)?.checked_add(ticks(rhs)?)?;
    if sum.unsigned_abs() > 0x80_0000 {
        return None;
    }
    let sign = if sum < 0 { 1u32 << 31 } else { 0 };
    Some(sign | (sum.unsigned_abs() as u32))
}

/// Bit-level ReLU convention used by the Stage 8 subnormal probe only.
/// Negative values, including -0, become +0. NaNs/infinities are rejected.
pub fn subnormal_relu_bits(bits: u32) -> Option<u32> {
    if bits & 0x7f80_0000 == 0x7f80_0000 {
        return None;
    }
    Some(if bits >> 31 != 0 { 0 } else { bits })
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn tie_to_even_and_gradual_underflow_have_independent_bit_oracles() {
        let half = 0x3f00_0000;
        let quarter_ulp = 0x3380_0000; // 2^-24
        assert_eq!(subnormal_mul_rne_bits(0x0080_0000, half), Some(0x0040_0000));
        assert_eq!(subnormal_mul_rne_bits(0x0080_0000, quarter_ulp), Some(0));
        assert_eq!(subnormal_mul_rne_bits(1, half), Some(0));
        assert_eq!(subnormal_mul_rne_bits(3, half), Some(2));
        assert_eq!(subnormal_mul_rne_bits(0x0080_0001, half), Some(0x0040_0000));
        assert_eq!(
            subnormal_mul_rne_bits(0x8000_0001, 0x3f80_0000),
            Some(0x8000_0001)
        );
        assert_eq!(subnormal_add_exact_bits(0x007f_ffff, 1), Some(0x0080_0000));
        assert_eq!(subnormal_add_exact_bits(1, 1), Some(2));
        assert_eq!(subnormal_add_exact_bits(0x8000_0001, 1), Some(0));
        assert_eq!(subnormal_relu_bits(0x8000_0001), Some(0));
        assert_eq!(subnormal_relu_bits(0x0000_0001), Some(1));
    }

    #[test]
    fn boundary_oracle_rejects_values_and_additions_outside_domain() {
        assert_eq!(
            subnormal_mul_rne_bits(f32::INFINITY.to_bits(), 0x3f00_0000),
            None
        );
        assert_eq!(
            subnormal_mul_rne_bits(f32::NAN.to_bits(), 0x3f00_0000),
            None
        );
        assert_eq!(subnormal_mul_rne_bits(0x3f80_0000, 0x3f80_0000), None);
        assert_eq!(subnormal_add_exact_bits(0x0080_0000, 1), None);
        assert_eq!(subnormal_add_exact_bits(0x8000_0000, 0), None);
        assert_eq!(subnormal_add_exact_bits(0x3f80_0000, 0), None);
        assert_eq!(subnormal_relu_bits(f32::NAN.to_bits()), None);
    }
}

FILE	crates/verineural/src/symbolic.rs
//! Symbolic shape contracts resolved to validated concrete binary32 Tensor IR.
//!
//! This is static specialization, not dynamic tensor shapes or polymorphic GPU
//! kernels. An instance is lowered to the existing concrete NeuralModule DAG:
//! Lean/GPU never receive unresolved symbolic dimensions.

use std::collections::BTreeMap;

use crate::{
    ContractClaim, Domain, MathContract, NeuralError, NeuralGraph, NeuralModule, NodeId,
    PortContract, Shape,
};

#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Dimension {
    Fixed(usize),
    Symbol(&'static str),
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct SymbolicShape {
    pub dims: Vec<Dimension>,
}

impl SymbolicShape {
    pub fn new(dims: Vec<Dimension>) -> Self {
        Self { dims }
    }
}

/// Binary32, contiguous row-major port; shape is specialized before lowering.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct SymbolicPort {
    pub shape: SymbolicShape,
    pub domain: Domain,
}

impl SymbolicPort {
    pub fn new(shape: SymbolicShape, domain: Domain) -> Self {
        Self { shape, domain }
    }
}

/// Restrictions on a named dimension; all bounds refer to positive sizes.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum DimensionConstraint {
    AtLeast(&'static str, usize),
    AtMost(&'static str, usize),
    MultipleOf(&'static str, usize),
}

/// A declared, reusable contract for concrete specializations.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct ParametricSignature {
    pub inputs: Vec<SymbolicPort>,
    pub output: SymbolicPort,
    pub constraints: Vec<DimensionConstraint>,
    pub claims: Vec<ContractClaim>,
}

/// Bindings are immutable records of the actual positive dimensions.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct DimensionBindings {
    values: BTreeMap<&'static str, usize>,
}

impl DimensionBindings {
    pub fn get(&self, symbol: &str) -> Option<usize> {
        self.values.get(symbol).copied()
    }

    pub fn values(&self) -> &BTreeMap<&'static str, usize> {
        &self.values
    }
}

fn valid_symbol(name: &str) -> bool {
    let Some(first) = name.bytes().next() else {
        return false;
    };
    first.is_ascii_alphabetic()
        && name
            .bytes()
            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_')
}

fn violation(module: &'static str, detail: &'static str) -> NeuralError {
    NeuralError::ContractViolation { module, detail }
}

impl ParametricSignature {
    /// Bind every repeated symbol across input axes, check explicit constraints,
    /// and resolve the output. Unbound outputs or unknown constraint symbols
    /// are errors, not implicit free dimensions.
    pub fn specialize(
        &self,
        owner: &'static str,
        actual_inputs: &[Shape],
    ) -> Result<(MathContract, DimensionBindings), NeuralError> {
        if actual_inputs.len() != self.inputs.len() {
            return Err(violation(owner, "symbolic module input arity mismatch"));
        }
        let mut bindings = BTreeMap::new();
        for (actual, expected) in actual_inputs.iter().zip(&self.inputs) {
            if actual.rank() != expected.shape.dims.len() {
                return Err(violation(owner, "symbolic tensor rank mismatch"));
            }
            for (&size, dimension) in actual.dims().iter().zip(&expected.shape.dims) {
                match dimension {
                    Dimension::Fixed(0) => {
                        return Err(violation(owner, "zero symbolic constant dimension"));
                    }
                    Dimension::Fixed(expected_size) if size != *expected_size => {
                        return Err(violation(owner, "fixed dimension mismatch"));
                    }
                    Dimension::Symbol(name) => {
                        if !valid_symbol(name) {
                            return Err(violation(owner, "invalid dimension symbol name"));
                        }
                        if let Some(&previous) = bindings.get(name) {
                            if previous != size {
                                return Err(violation(owner, "symbolic dimension mismatch"));
                            }
                        } else {
                            bindings.insert(*name, size);
                        }
                    }
                    Dimension::Fixed(_) => {}
                }
            }
        }

        for constraint in &self.constraints {
            let (symbol, limit) = match *constraint {
                DimensionConstraint::AtLeast(symbol, limit)
                | DimensionConstraint::AtMost(symbol, limit)
                | DimensionConstraint::MultipleOf(symbol, limit) => (symbol, limit),
            };
            let Some(&actual) = bindings.get(symbol) else {
                return Err(violation(owner, "constraint uses unbound dimension symbol"));
            };
            if limit == 0 {
                return Err(violation(
                    owner,
                    "dimension constraint requires positive bound",
                ));
            }
            let satisfied = match *constraint {
                DimensionConstraint::AtLeast(..) => actual >= limit,
                DimensionConstraint::AtMost(..) => actual <= limit,
                DimensionConstraint::MultipleOf(..) => actual % limit == 0,
            };
            if !satisfied {
                return Err(violation(owner, "symbolic dimension constraint violated"));
            }
        }

        let output_dims = self
            .output
            .shape
            .dims
            .iter()
            .map(|dim| match dim {
                Dimension::Fixed(0) => Err(violation(owner, "zero symbolic constant dimension")),
                Dimension::Fixed(size) => Ok(*size),
                Dimension::Symbol(symbol) => {
                    if !valid_symbol(symbol) {
                        return Err(violation(owner, "invalid dimension symbol name"));
                    }
                    bindings
                        .get(symbol)
                        .copied()
                        .ok_or_else(|| violation(owner, "output uses unbound dimension symbol"))
                }
            })
            .collect::<Result<Vec<_>, _>>()?;
        let output = Shape::new(output_dims)?;
        let requires = actual_inputs
            .iter()
            .zip(&self.inputs)
            .map(|(actual, declared)| PortContract::new(actual.clone(), declared.domain))
            .collect::<Vec<_>>();
        let mut contract =
            MathContract::new(requires, PortContract::new(output, self.output.domain));
        contract.claims.clone_from(&self.claims);
        Ok((contract, DimensionBindings { values: bindings }))
    }
}

/// One consumer module with one symbolic interface, specialized per invocation.
/// Only the supported concrete graph DSL can be emitted by build().
pub trait ParametricModule {
    fn name(&self) -> &'static str;
    fn semantic_version(&self) -> &'static str;
    fn signature(&self) -> &ParametricSignature;
    fn build(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError>;
}

struct BoundModule<'a, M: ParametricModule> {
    module: &'a M,
    contract: MathContract,
}

impl<M: ParametricModule> NeuralModule for BoundModule<'_, M> {
    fn name(&self) -> &'static str {
        self.module.name()
    }
    fn semantic_version(&self) -> &'static str {
        self.module.semantic_version()
    }
    fn contract(&self) -> &MathContract {
        &self.contract
    }
    fn build(&self, graph: &mut NeuralGraph, inputs: &[NodeId]) -> Result<NodeId, NeuralError> {
        self.module.build(graph, inputs)
    }
}

impl NeuralGraph {
    /// Resolve a symbolic consumer interface to a concrete module instance.
    /// All failures preserve the graph, including hidden captures and post-
    /// condition failures, because apply_module commits transactionally.
    pub fn apply_parametric_module<M: ParametricModule>(
        &mut self,
        module: &M,
        inputs: &[NodeId],
    ) -> Result<(NodeId, DimensionBindings), NeuralError> {
        let shapes = inputs
            .iter()
            .map(|&input| Ok(self.node(input)?.shape.clone()))
            .collect::<Result<Vec<_>, NeuralError>>()?;
        let (contract, bindings) = module.signature().specialize(module.name(), &shapes)?;
        let bounded = BoundModule { module, contract };
        let output = self.apply_module(&bounded, inputs)?;
        Ok((output, bindings))
    }
}

FILE	crates/verineural/src/temporal.rs
//! Finite-window unroll of any named recurrent Model into one ordinary IR DAG.
//! Shared parameters, explicit state edges and one supervised scalar VJP.
use crate::{
    DType, Domain, Model, NeuralError, NeuralGraph, NodeId, Operation, SourceRole, Tensor,
};
use std::collections::{BTreeMap, BTreeSet};
use std::error::Error;
use std::fmt;

#[derive(Debug)]
pub enum TemporalError {
    Neural(NeuralError),
    Invalid(String),
}
impl From<NeuralError> for TemporalError {
    fn from(e: NeuralError) -> Self {
        Self::Neural(e)
    }
}
impl fmt::Display for TemporalError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::Neural(e) => write!(f, "{e}"),
            Self::Invalid(e) => write!(f, "invalid temporal unroll: {e}"),
        }
    }
}
impl Error for TemporalError {}

pub struct TemporalUnroll {
    graph: NeuralGraph,
    parameters: BTreeMap<String, NodeId>,
    initial_states: BTreeMap<String, NodeId>,
    inputs: Vec<BTreeMap<String, NodeId>>,
    outputs: Vec<NodeId>,
    cotangents: Vec<NodeId>,
    terminal_states: BTreeMap<String, NodeId>,
    objective: NodeId,
}
impl TemporalUnroll {
    pub fn graph(&self) -> &NeuralGraph {
        &self.graph
    }
    pub fn parameters(&self) -> &BTreeMap<String, NodeId> {
        &self.parameters
    }
    pub fn initial_states(&self) -> &BTreeMap<String, NodeId> {
        &self.initial_states
    }
    pub fn inputs(&self) -> &[BTreeMap<String, NodeId>] {
        &self.inputs
    }
    pub fn outputs(&self) -> &[NodeId] {
        &self.outputs
    }
    pub fn cotangents(&self) -> &[NodeId] {
        &self.cotangents
    }
    pub fn terminal_states(&self) -> &BTreeMap<String, NodeId> {
        &self.terminal_states
    }
    pub fn objective(&self) -> NodeId {
        self.objective
    }

    /// Strictly checks all named parameter and state sources, every timestep
    /// input and cotangent. No silent default tensors or duplicate bindings.
    pub fn bindings(
        &self,
        base: &[(String, Tensor<f32>)],
        steps: &[Vec<(String, Tensor<f32>)>],
        cotangents: &[Tensor<f32>],
    ) -> Result<Vec<(NodeId, Tensor<f32>)>, TemporalError> {
        if steps.len() != self.inputs.len() || cotangents.len() != self.inputs.len() {
            return Err(TemporalError::Invalid(
                "step/cotangent count mismatch".into(),
            ));
        }
        let mut base_values = BTreeMap::new();
        for (name, value) in base {
            if base_values.insert(name.as_str(), value).is_some() {
                return Err(TemporalError::Invalid("duplicate base binding".into()));
            }
        }
        let expected = self
            .parameters
            .keys()
            .chain(self.initial_states.keys())
            .map(String::as_str)
            .collect::<BTreeSet<_>>();
        if base_values.keys().copied().collect::<BTreeSet<_>>() != expected {
            return Err(TemporalError::Invalid(
                "missing or extra base binding".into(),
            ));
        }
        let mut bound = Vec::new();
        for (name, &node) in self.parameters.iter().chain(self.initial_states.iter()) {
            bound.push((node, (*base_values[name.as_str()]).clone()));
        }
        for (t, values) in steps.iter().enumerate() {
            let mut supplied = BTreeMap::new();
            for (name, value) in values {
                if supplied.insert(name.as_str(), value).is_some() {
                    return Err(TemporalError::Invalid("duplicate step input".into()));
                }
            }
            let expected = self.inputs[t]
                .keys()
                .map(String::as_str)
                .collect::<BTreeSet<_>>();
            if supplied.keys().copied().collect::<BTreeSet<_>>() != expected {
                return Err(TemporalError::Invalid(format!(
                    "missing or extra timestep source at {t}"
                )));
            }
            for (name, &node) in &self.inputs[t] {
                bound.push((node, (*supplied[name.as_str()]).clone()));
            }
            bound.push((self.cotangents[t], cotangents[t].clone()));
        }
        for (id, tensor) in &bound {
            let node = self.graph.node(*id)?;
            if tensor.shape() != &node.shape {
                return Err(TemporalError::Invalid(
                    "source tensor shape mismatch".into(),
                ));
            }
            tensor.validate_domain(node.domain)?;
        }
        Ok(bound)
    }
}

/// Unroll 1..=16 steps. Parameter nodes are shared; state feedback connects
/// pure prior-step producers to new consumers. A new initial state is an explicit
/// truncated-BPTT boundary (no gradient into a previous window).
/// The scalar objective is sum_t dot(output[t], cotangent[t]).
pub fn unroll_model(
    model: &Model,
    output_name: &str,
    steps: usize,
) -> Result<TemporalUnroll, TemporalError> {
    unroll_model_impl(model, output_name, steps, false)
}

/// Opt-in temporal common-subgraph reuse for computations depending ONLY on
/// named parameters. Within one BPTT window parameters are immutable: a
/// parameter-only node has the same value at every step. We materialize it
/// once and reuse its NodeId, including for all consumers and reverse-mode AD.
///
/// No state, token input, or state-dependent computation is hoisted. This
/// transformation changes the training IR/fingerprint; consumers must not
/// silently resume a checkpoint produced by the unoptimized unroll.
/// Mathematical equivalence does not imply identical FP32 AD reductions.
pub fn unroll_model_hoisted(
    model: &Model,
    output_name: &str,
    steps: usize,
) -> Result<TemporalUnroll, TemporalError> {
    unroll_model_impl(model, output_name, steps, true)
}

fn unroll_model_impl(
    model: &Model,
    output_name: &str,
    steps: usize,
    hoist_parameter_only: bool,
) -> Result<TemporalUnroll, TemporalError> {
    if !(1..=16).contains(&steps) {
        return Err(TemporalError::Invalid(
            "window length must be 1..=16".into(),
        ));
    }
    let root = model
        .output(output_name)
        .ok_or_else(|| TemporalError::Invalid("unknown supervised output".into()))?;
    let output = model.graph().node(root)?;
    if output.dtype != DType::F32 || output.shape.rank() != 2 || output.shape.dims()[0] != 1 {
        return Err(TemporalError::Invalid(
            "supervised output must be F32 [1,N]".into(),
        ));
    }
    let old_nodes = model.graph().nodes();
    let source_by_id = model
        .sources()
        .iter()
        .map(|(name, &(id, role))| (id.index(), (name.clone(), role)))
        .collect::<BTreeMap<_, _>>();
    if source_by_id.len() != model.sources().len() {
        return Err(TemporalError::Invalid(
            "duplicate named source nodes".into(),
        ));
    }
    // Only node values transitively determined by Parameter sources may be
    // reused. Build the predicate on the original topological model graph.
    // Recurrent State and timestep Input sources are always variant.
    let mut parameter_only = vec![false; old_nodes.len()];
    if hoist_parameter_only {
        for node in old_nodes {
            parameter_only[node.id.index()] = if matches!(node.operation, Operation::Input) {
                source_by_id
                    .get(&node.id.index())
                    .is_some_and(|(_, role)| *role == SourceRole::Parameter)
            } else {
                node.inputs
                    .iter()
                    .all(|id| parameter_only.get(id.index()) == Some(&true))
            };
        }
    }
    let mut cached_parameter_only = vec![None; old_nodes.len()];
    let mut graph = NeuralGraph::new(model.graph().policy());
    let mut params = BTreeMap::new();
    let mut initial = BTreeMap::new();
    for (name, &(id, role)) in model.sources() {
        if role == SourceRole::Input {
            continue;
        }
        let node = model.graph().node(id)?;
        let src = graph.input(node.shape.clone(), node.domain);
        match role {
            SourceRole::Parameter => {
                params.insert(name.clone(), src);
            }
            SourceRole::State => {
                initial.insert(name.clone(), src);
            }
            SourceRole::Input => unreachable!(),
        }
    }
    let mut previous = initial.clone();
    let mut step_inputs = Vec::new();
    let mut outputs = Vec::new();
    let mut cotangents = Vec::new();
    let mut objective = None;
    for _ in 0..steps {
        let mut mapping: Vec<Option<NodeId>> = vec![None; old_nodes.len()];
        let mut inputs = BTreeMap::new();
        for node in old_nodes {
            let index = node.id.index();
            // Cache hits are permitted only for parameter-only nodes.
            // All other nodes follow exactly the historical builder path.
            let new = if hoist_parameter_only && let Some(reused) = cached_parameter_only[index] {
                reused
            } else if matches!(node.operation, Operation::Input) {
                let (name, role) = source_by_id
                    .get(&node.id.index())
                    .ok_or_else(|| TemporalError::Invalid("unregistered original input".into()))?;
                match role {
                    SourceRole::Parameter => params[name],
                    SourceRole::State => previous[name],
                    SourceRole::Input => {
                        let src = graph.input(node.shape.clone(), node.domain);
                        inputs.insert(name.clone(), src);
                        src
                    }
                }
            } else {
                let ids = node
                    .inputs
                    .iter()
                    .map(|id| {
                        mapping[id.index()].ok_or_else(|| {
                            TemporalError::Invalid("original nodes not in topological order".into())
                        })
                    })
                    .collect::<Result<Vec<_>, _>>()?;
                graph.apply(node.operation.clone(), &ids)?
            };
            if hoist_parameter_only && parameter_only[index] {
                cached_parameter_only[index] = Some(new);
            }
            mapping[node.id.index()] = Some(new);
        }
        let logits = mapping[root.index()]
            .ok_or_else(|| TemporalError::Invalid("missing remapped model output".into()))?;
        let seed = graph.input(output.shape.clone(), Domain::Finite);
        let transposed = graph.permute(seed, &[1, 0])?;
        let scalar = graph.matmul(logits, transposed)?;
        objective = Some(match objective {
            None => scalar,
            Some(sum) => graph.add(sum, scalar)?,
        });
        let mut next = BTreeMap::new();
        for (name, &old) in model.state_links() {
            next.insert(
                name.clone(),
                mapping[old.index()]
                    .ok_or_else(|| TemporalError::Invalid("missing remapped transition".into()))?,
            );
        }
        if next.len() != initial.len() {
            return Err(TemporalError::Invalid(
                "missing temporal state transition".into(),
            ));
        }
        previous = next;
        step_inputs.push(inputs);
        outputs.push(logits);
        cotangents.push(seed);
    }
    Ok(TemporalUnroll {
        graph,
        parameters: params,
        initial_states: initial,
        inputs: step_inputs,
        outputs,
        cotangents,
        terminal_states: previous,
        objective: objective.expect("nonempty checked window"),
    })
}

FILE	crates/verineural/src/tensor.rs
use crate::{ArgMaxTieBreak, DType, Domain, NeuralError, Operation};

/// Validated, immutable tensor dimensions. An empty dimension list is a scalar.
#[derive(Clone, Debug, PartialEq, Eq, Hash)]
pub struct Shape(Vec<usize>);

impl Shape {
    pub fn new(dims: impl Into<Vec<usize>>) -> Result<Self, NeuralError> {
        let dims = dims.into();
        if dims.contains(&0) {
            return Err(NeuralError::ZeroDimension);
        }
        dims.iter()
            .try_fold(1usize, |acc, &d| acc.checked_mul(d))
            .ok_or(NeuralError::ElementCountOverflow)?;
        Ok(Self(dims))
    }

    pub fn dims(&self) -> &[usize] {
        &self.0
    }

    pub fn rank(&self) -> usize {
        self.0.len()
    }

    pub fn element_count(&self) -> usize {
        // Checked on construction and immutable afterwards.
        self.0.iter().product()
    }

    /// Canonical contiguous row-major strides in elements.
    pub fn row_major_strides(&self) -> Vec<usize> {
        let mut strides = vec![0; self.0.len()];
        let mut stride = 1usize;
        for axis in (0..self.0.len()).rev() {
            strides[axis] = stride;
            stride = stride
                .checked_mul(self.0[axis])
                .expect("Shape::new already validated element count");
        }
        strides
    }
}

/// Shape information for a tensor. Custom implementations are revalidated.
pub trait TensorShape: Clone {
    fn dims(&self) -> &[usize];
}

impl TensorShape for Shape {
    fn dims(&self) -> &[usize] {
        self.dims()
    }
}

/// Owned host tensor. Shape and number of elements are checked at construction.
#[derive(Clone, Debug, PartialEq)]
pub struct Tensor<T, S: TensorShape = Shape> {
    shape: S,
    values: Vec<T>,
}

/// Runtime value preserving the Semantic IR element type across host/device
/// boundaries. Index tensors use host `usize`, while the supported CUDA ABI
/// stores them as checked nonnegative i32 values.
#[derive(Clone, Debug, PartialEq)]
pub enum TensorValue {
    F32(Tensor<f32>),
    Index(Tensor<usize>),
}

impl TensorValue {
    pub const fn dtype(&self) -> DType {
        match self {
            Self::F32(_) => DType::F32,
            Self::Index(_) => DType::Index,
        }
    }

    pub fn shape(&self) -> &Shape {
        match self {
            Self::F32(tensor) => tensor.shape(),
            Self::Index(tensor) => tensor.shape(),
        }
    }

    pub const fn as_f32(&self) -> Option<&Tensor<f32>> {
        match self {
            Self::F32(tensor) => Some(tensor),
            Self::Index(_) => None,
        }
    }

    pub const fn as_index(&self) -> Option<&Tensor<usize>> {
        match self {
            Self::F32(_) => None,
            Self::Index(tensor) => Some(tensor),
        }
    }

    pub fn into_f32(self) -> Option<Tensor<f32>> {
        match self {
            Self::F32(tensor) => Some(tensor),
            Self::Index(_) => None,
        }
    }

    pub fn into_index(self) -> Option<Tensor<usize>> {
        match self {
            Self::F32(_) => None,
            Self::Index(tensor) => Some(tensor),
        }
    }
}

fn unravel_index(mut index: usize, dims: &[usize]) -> Vec<usize> {
    let mut coords = vec![0; dims.len()];
    for axis in (0..dims.len()).rev() {
        coords[axis] = index % dims[axis];
        index /= dims[axis];
    }
    coords
}

fn ravel_index(coords: &[usize], dims: &[usize]) -> usize {
    coords
        .iter()
        .zip(dims)
        .fold(0usize, |flat, (&coord, &dim)| flat * dim + coord)
}

impl<T, S: TensorShape> Tensor<T, S> {
    pub fn new(shape: S, values: Vec<T>) -> Result<Self, NeuralError> {
        let checked = Shape::new(shape.dims().to_vec())?;
        if checked.element_count() != values.len() {
            return Err(NeuralError::DataLengthMismatch {
                expected: checked.element_count(),
                actual: values.len(),
            });
        }
        Ok(Self { shape, values })
    }

    pub fn shape(&self) -> &S {
        &self.shape
    }

    pub fn values(&self) -> &[T] {
        &self.values
    }

    pub fn into_values(self) -> Vec<T> {
        self.values
    }
}

impl<T> Tensor<T> {
    /// Construct a tensor without creating a Shape separately.
    pub fn from_vec(dims: impl Into<Vec<usize>>, values: Vec<T>) -> Result<Self, NeuralError> {
        Self::new(Shape::new(dims)?, values)
    }

    /// Copy borrowed values into a shape-validated tensor.
    pub fn from_slice(dims: impl Into<Vec<usize>>, values: &[T]) -> Result<Self, NeuralError>
    where
        T: Clone,
    {
        Self::from_vec(dims, values.to_vec())
    }

    /// Create a tensor filled with T::default(), zero for numeric types.
    pub fn zeros(dims: impl Into<Vec<usize>>) -> Result<Self, NeuralError>
    where
        T: Default + Clone,
    {
        let shape = Shape::new(dims)?;
        Self::new(shape.clone(), vec![T::default(); shape.element_count()])
    }
}

impl<T: Clone> Tensor<T> {
    /// Reorder axes in row-major order. `axes[output_axis] = input_axis`.
    pub fn permute(&self, axes: &[usize]) -> Result<Self, NeuralError> {
        let operation = Operation::Permute {
            axes: axes.to_vec(),
        };
        let shape = operation.infer_shape(std::slice::from_ref(&self.shape))?;
        let mut values = Vec::with_capacity(self.values.len());
        for output_index in 0..shape.element_count() {
            let output_coords = unravel_index(output_index, shape.dims());
            let mut input_coords = vec![0; self.shape.rank()];
            for (output_axis, &input_axis) in axes.iter().enumerate() {
                input_coords[input_axis] = output_coords[output_axis];
            }
            values.push(self.values[ravel_index(&input_coords, self.shape.dims())].clone());
        }
        Self::new(shape, values)
    }

    /// Explicit right-aligned broadcast; singleton input axes repeat.
    pub fn broadcast_to(&self, output: Shape) -> Result<Self, NeuralError> {
        let op = Operation::BroadcastTo(output);
        let shape = op.infer_shape(std::slice::from_ref(&self.shape))?;
        let offset = shape.rank() - self.shape.rank();
        let mut values = Vec::with_capacity(shape.element_count());
        for index in 0..shape.element_count() {
            let out = unravel_index(index, shape.dims());
            let coords = self
                .shape
                .dims()
                .iter()
                .enumerate()
                .map(
                    |(axis, &width)| {
                        if width == 1 { 0 } else { out[offset + axis] }
                    },
                )
                .collect::<Vec<_>>();
            values.push(self.values[ravel_index(&coords, self.shape.dims())].clone());
        }
        Self::new(shape, values)
    }

    /// Reverse one row-major axis without changing shape.
    pub fn reverse_axis(&self, axis: usize) -> Result<Self, NeuralError> {
        let operation = Operation::ReverseAxis { axis };
        let shape = operation.infer_shape(std::slice::from_ref(&self.shape))?;
        let mut values = Vec::with_capacity(self.values.len());
        for output_index in 0..shape.element_count() {
            let mut input_coords = unravel_index(output_index, shape.dims());
            input_coords[axis] = shape.dims()[axis] - 1 - input_coords[axis];
            values.push(self.values[ravel_index(&input_coords, self.shape.dims())].clone());
        }
        Self::new(shape, values)
    }

    /// Static contiguous slice of one row-major axis.
    pub fn slice_axis(&self, axis: usize, start: usize, len: usize) -> Result<Self, NeuralError> {
        let operation = Operation::SliceAxis { axis, start, len };
        let shape = operation.infer_shape(std::slice::from_ref(&self.shape))?;
        let mut values = Vec::with_capacity(shape.element_count());
        for output_index in 0..shape.element_count() {
            let mut input_coords = unravel_index(output_index, shape.dims());
            input_coords[axis] += start;
            values.push(self.values[ravel_index(&input_coords, self.shape.dims())].clone());
        }
        Self::new(shape, values)
    }

    /// Concatenate two tensors along one axis.
    pub fn concat(&self, rhs: &Self, axis: usize) -> Result<Self, NeuralError> {
        let operation = Operation::Concat { axis };
        let shape = operation.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        let left_width = self.shape.dims()[axis];
        let mut values = Vec::with_capacity(shape.element_count());
        for output_index in 0..shape.element_count() {
            let output_coords = unravel_index(output_index, shape.dims());
            if output_coords[axis] < left_width {
                values.push(self.values[ravel_index(&output_coords, self.shape.dims())].clone());
            } else {
                let mut right_coords = output_coords;
                right_coords[axis] -= left_width;
                values.push(rhs.values[ravel_index(&right_coords, rhs.shape.dims())].clone());
            }
        }
        Self::new(shape, values)
    }

    /// Select one lane from an axis using a one-element host index tensor.
    pub fn take(&self, index: &Tensor<usize>, axis: usize) -> Result<Self, NeuralError> {
        let operation = Operation::Take { axis };
        let shape = operation.infer_shape(&[self.shape.clone(), index.shape.clone()])?;
        let selected = index.values[0];
        let bound = self.shape.dims()[axis];
        if selected >= bound {
            return Err(NeuralError::IndexOutOfBounds {
                axis,
                index: selected,
                bound,
            });
        }
        let mut values = Vec::with_capacity(shape.element_count());
        for output_index in 0..shape.element_count() {
            let output_coords = unravel_index(output_index, shape.dims());
            let mut input_coords = Vec::with_capacity(self.shape.rank());
            let mut output_axis = 0;
            for input_axis in 0..self.shape.rank() {
                if input_axis == axis {
                    input_coords.push(selected);
                } else {
                    input_coords.push(output_coords[output_axis]);
                    output_axis += 1;
                }
            }
            values.push(self.values[ravel_index(&input_coords, self.shape.dims())].clone());
        }
        Self::new(shape, values)
    }
}

impl Tensor<f32> {
    /// Independently validate concrete input values against a graph assumption.
    pub fn validate_domain(&self, domain: Domain) -> Result<(), NeuralError> {
        for (index, &v) in self.values.iter().enumerate() {
            let valid = match domain {
                Domain::Any => true,
                Domain::Finite => v.is_finite(),
                Domain::NonNegativeFinite => v.is_finite() && v >= 0.0,
            };
            if !valid {
                return Err(NeuralError::ValueOutsideDomain {
                    index,
                    required: domain,
                });
            }
        }
        Ok(())
    }

    /// Pure host reference calculation. Not a certified FP32 kernel.
    pub fn add(&self, rhs: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::Add.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        let values = self
            .values
            .iter()
            .zip(&rhs.values)
            .map(|(&a, &b)| a + b)
            .collect();
        Self::new(shape, values)
    }

    /// Pure elementwise host reference calculation, without broadcasting.
    pub fn mul(&self, rhs: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::Mul.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        let values = self
            .values
            .iter()
            .zip(&rhs.values)
            .map(|(&a, &b)| a * b)
            .collect();
        Self::new(shape, values)
    }

    /// Elementwise subtraction, without implicit broadcasting.
    pub fn sub(&self, rhs: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::Add.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        Self::new(
            shape,
            self.values
                .iter()
                .zip(&rhs.values)
                .map(|(&a, &b)| a - b)
                .collect(),
        )
    }

    /// Elementwise division (including IEEE NaN/inf on zero denominator).
    pub fn div(&self, rhs: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::Mul.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        Self::new(
            shape,
            self.values
                .iter()
                .zip(&rhs.values)
                .map(|(&a, &b)| a / b)
                .collect(),
        )
    }

    /// Elementwise exponential. Host f32 reference, not certified.
    pub fn exp(&self) -> Result<Self, NeuralError> {
        Self::new(
            self.shape.clone(),
            self.values.iter().map(|x| x.exp()).collect(),
        )
    }

    /// Add one rank-1 bias vector to every matrix row.
    pub fn bias_add(&self, rhs: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::BiasAdd.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        let columns = shape.dims()[1];
        let values = self
            .values
            .iter()
            .enumerate()
            .map(|(i, &x)| x + rhs.values[i % columns])
            .collect();
        Self::new(shape, values)
    }

    /// Matrix multiplication of two rank-2 tensors. Accumulates left to right.
    pub fn matmul(&self, rhs: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::MatMul.infer_shape(&[self.shape.clone(), rhs.shape.clone()])?;
        let [m, k] = self.shape.dims() else {
            unreachable!("shape checked above")
        };
        let n = rhs.shape.dims()[1];
        let mut values = vec![0.0f32; shape.element_count()];
        for row in 0..*m {
            for col in 0..n {
                let mut sum = 0.0f32;
                for inner in 0..*k {
                    sum += self.values[row * *k + inner] * rhs.values[inner * n + col];
                }
                values[row * n + col] = sum;
            }
        }
        Self::new(shape, values)
    }

    /// Canonical 0/1 positive mask: NaN and signed zero both take false.
    /// This host operation is a reference, not an IEEE/GPU proof.
    pub fn positive_mask(&self) -> Self {
        Self {
            shape: self.shape.clone(),
            values: self
                .values
                .iter()
                .map(|&v| if v > 0.0 { 1.0 } else { 0.0 })
                .collect(),
        }
    }

    /// Select the original binary32 payload from one branch, without arithmetic,
    /// using a strict positive comparison. The result has the branches' shape.
    pub fn select_positive(&self, yes: &Self, no: &Self) -> Result<Self, NeuralError> {
        let shape = Operation::SelectPositive.infer_shape(&[
            self.shape.clone(),
            yes.shape.clone(),
            no.shape.clone(),
        ])?;
        let values = self
            .values
            .iter()
            .zip(&yes.values)
            .zip(&no.values)
            .map(
                |((&mask, &on_true), &on_false)| {
                    if mask > 0.0 { on_true } else { on_false }
                },
            )
            .collect();
        Self::new(shape, values)
    }

    /// Elementwise max(x, 0), preserving NaN instead of silently hiding it.
    pub fn relu(&self) -> Self {
        Self {
            shape: self.shape.clone(),
            values: self
                .values
                .iter()
                .map(|&v| if v.is_nan() || v > 0.0 { v } else { 0.0 })
                .collect(),
        }
    }

    /// Reject negative and non-finite arguments, as specified by the IR domain.
    pub fn sqrt(&self) -> Result<Self, NeuralError> {
        self.validate_domain(Domain::NonNegativeFinite)?;
        Self::new(
            self.shape.clone(),
            self.values.iter().map(|v| v.sqrt()).collect(),
        )
    }

    /// Deterministic row-major argmax. Equal maxima keep the first lane. NaN
    /// never replaces a numeric best; an initial NaN is replaced by the first
    /// numeric lane. If every lane is NaN, the first lane wins.
    pub fn argmax(
        &self,
        axis: usize,
        tie_break: ArgMaxTieBreak,
    ) -> Result<Tensor<usize>, NeuralError> {
        let operation = Operation::ArgMax { axis, tie_break };
        let shape = operation.infer_shape(std::slice::from_ref(&self.shape))?;
        let width = self.shape.dims()[axis];
        let inner = self.shape.dims()[axis + 1..].iter().product::<usize>();
        let mut values = Vec::with_capacity(shape.element_count());
        for output_index in 0..shape.element_count() {
            let outer = output_index / inner;
            let suffix = output_index % inner;
            let mut best = 0usize;
            let mut best_value = self.values[(outer * width) * inner + suffix];
            for lane in 1..width {
                let candidate = self.values[(outer * width + lane) * inner + suffix];
                match tie_break {
                    ArgMaxTieBreak::First => {
                        if !candidate.is_nan() && (best_value.is_nan() || candidate > best_value) {
                            best = lane;
                            best_value = candidate;
                        }
                    }
                }
            }
            values.push(best);
        }
        Tensor::new(shape, values)
    }

    /// Row-major sum over any axis, with an explicit left-to-right f32 fold.
    /// This is a host reference, NOT a proof of its rounding or GPU behavior.
    pub fn reduce_sum(&self, axis: usize) -> Result<Self, NeuralError> {
        let output_shape =
            Operation::ReduceSum { axis }.infer_shape(std::slice::from_ref(&self.shape))?;
        let width = self.shape.dims()[axis];
        let inner = self.shape.dims()[axis + 1..].iter().product::<usize>();
        let mut values = Vec::with_capacity(output_shape.element_count());
        for index in 0..output_shape.element_count() {
            let outer = index / inner;
            let suffix = index % inner;
            let mut sum = 0.0f32;
            for lane in 0..width {
                sum += self.values[(outer * width + lane) * inner + suffix];
            }
            values.push(sum);
        }
        Self::new(output_shape, values)
    }

    /// Deterministic maximum, preserving NaN and taking the first maximum
    /// on ties. f32 semantics are reference-only until a backend is audited.
    pub fn reduce_max(&self, axis: usize) -> Result<Self, NeuralError> {
        let output_shape =
            Operation::ReduceMax { axis }.infer_shape(std::slice::from_ref(&self.shape))?;
        let width = self.shape.dims()[axis];
        let inner = self.shape.dims()[axis + 1..].iter().product::<usize>();
        let mut values = Vec::with_capacity(output_shape.element_count());
        for index in 0..output_shape.element_count() {
            let outer = index / inner;
            let suffix = index % inner;
            let mut best = self.values[(outer * width) * inner + suffix];
            for lane in 1..width {
                let candidate = self.values[(outer * width + lane) * inner + suffix];
                if candidate.is_nan() || (!best.is_nan() && candidate > best) {
                    best = candidate;
                }
            }
            values.push(best);
        }
        Self::new(output_shape, values)
    }

    /// Same values, new dimensions with the same element count.
    pub fn reshape(self, shape: Shape) -> Result<Self, NeuralError> {
        Operation::Reshape(shape.clone()).infer_shape(std::slice::from_ref(&self.shape))?;
        Self::new(shape, self.values)
    }
}

FILE	crates/verineural/src/translation.rs
//! Bounded structural translation validation, not a semantic proof of LLVM or PTX.
//! The expected kernel plan comes from the checked Semantic Neural IR, fusion
//! decisions and memory contracts; it is NOT inferred from LLVM/PTX text.
//! Unknown kernels, missing entries, changed FP32 operation sequences, shapes,
//! address templates or rounding modes fail closed. CUDA JIT/SASS stays trusted.

use std::collections::{BTreeMap, BTreeSet};
use std::fmt;

use crate::gpu::audit_fp32_ptx;

/// LLVM IR requires precisely representable floating literals for type `float`.
/// The decimal 1.442695e+00 is rejected by LLVM, whereas this hex encoding
/// of the nearest binary32 log2(e) (bits 0x3FB8AA3B) is accepted.
/// Shared by codegen and structural translation validation.
pub(crate) const LOG2_E_F32_LLVM: &str = "0x3FF7154760000000";

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum TranslationKind {
    Add,
    Mul,
    /// Experimental two-instruction Mul -> Add, never contracted to FMA.
    /// Retains the original Add operand order.
    MulAdd {
        multiply_on_right: bool,
    },
    /// Two independent Add/Mul RN instructions, without reassociation.
    BinaryChain {
        first_add: bool,
        second_add: bool,
        producer_on_right: bool,
    },
    /// Strictly rounded Sqrt→Add→Div, preserving the Add operand order.
    SqrtAddDiv {
        sqrt_on_right: bool,
    },
    /// Mul(Mul(a,b),a|b) then Add then Div, four explicit RNE operations.
    MulMulAddDiv {
        reused_source: u8,
        multiply_on_right: bool,
        add_on_right: bool,
    },
    /// Independent left Mul and repeated right Mul, then rounded Add.
    MulDiamondAdd {
        reused_source: u8,
        right_mul_on_right: bool,
        left_mul_on_right: bool,
    },
    /// Two selected independent Add/Mul outputs share a kernel. `earlier`
    /// is an additional writable output, not a kernel input.
    DualPointwise {
        earlier: usize,
        first_mul: bool,
        second_mul: bool,
    },
    MulAddMul {
        add_mul_on_right: bool,
        mul_add_on_right: bool,
        reused_source: u8,
    },
    /// IEEE binary32 subtraction with explicit round-to-nearest-even.
    Sub,
    /// IEEE binary32 division, round-to-nearest-even.
    DivRne,
    /// Explicit experimental ex2.approx-based natural exponential.
    ExpApprox,
    SqrtRne,
    BiasAdd {
        columns: usize,
    },
    MatMul {
        inner: usize,
        columns: usize,
    },
    Transpose2D {
        rows: usize,
        columns: usize,
    },
    ReverseRows2D {
        rows: usize,
        columns: usize,
    },
    ReverseColumns2D {
        rows: usize,
        columns: usize,
    },
    ConcatAxis0 {
        left: usize,
    },
    SliceLastRow {
        start: usize,
        source_width: usize,
    },
    BroadcastScalar,
    ArgMaxLast {
        width: usize,
    },
    TakeAxis0 {
        lane: usize,
    },
    Relu,
    AddRelu,
    MulRelu,
    BiasAddRelu {
        columns: usize,
    },
    AddBiasRelu {
        columns: usize,
    },
    MulBiasRelu {
        columns: usize,
    },
}

impl TranslationKind {
    pub const fn name(self) -> &'static str {
        match self {
            Self::Add => "add",
            Self::Mul => "mul",
            Self::MulAdd { .. } => "mul_add",
            Self::BinaryChain { .. } => "binary_chain",
            Self::SqrtAddDiv { .. } => "sqrt_add_div",
            Self::MulMulAddDiv { .. } => "mul_mul_add_div",
            Self::MulDiamondAdd { .. } => "mul_diamond_add",
            Self::DualPointwise { .. } => "dual_pointwise",
            Self::MulAddMul { .. } => "mul_add_mul",
            Self::Sub => "sub_rn",
            Self::DivRne => "div_rn",
            Self::ExpApprox => "exp_approx",
            Self::SqrtRne => "sqrt_rn",
            Self::BiasAdd { .. } => "bias_add",
            Self::MatMul { .. } => "matmul",
            Self::Transpose2D { .. } => "transpose2d",
            Self::ReverseRows2D { .. } => "reverse_rows2d",
            Self::ReverseColumns2D { .. } => "reverse_columns2d",
            Self::ConcatAxis0 { .. } => "concat_axis0",
            Self::SliceLastRow { .. } => "slice_last_row",
            Self::BroadcastScalar => "broadcast_scalar",
            Self::ArgMaxLast { .. } => "argmax_last",
            Self::TakeAxis0 { .. } => "take_axis0",
            Self::Relu => "relu",
            Self::AddRelu => "add_relu",
            Self::MulRelu => "mul_relu",
            Self::BiasAddRelu { .. } => "bias_relu",
            Self::AddBiasRelu { .. } => "add_bias_relu",
            Self::MulBiasRelu { .. } => "mul_bias_relu",
        }
    }

    fn counts(self) -> (usize, usize, usize) {
        match self {
            Self::Add | Self::BiasAdd { .. } => (1, 0, 0),
            Self::Mul => (0, 1, 0),
            Self::MulAdd { .. } => (1, 1, 0),
            Self::BinaryChain {
                first_add,
                second_add,
                ..
            } => {
                let adds = usize::from(first_add) + usize::from(second_add);
                (adds, 2 - adds, 0)
            }
            Self::MulAddMul { .. } => (1, 2, 0),
            Self::MulMulAddDiv { .. } => (1, 2, 0),
            Self::MulDiamondAdd { .. } => (1, 3, 0),
            Self::DualPointwise {
                first_mul,
                second_mul,
                ..
            } => {
                let muls = usize::from(first_mul) + usize::from(second_mul);
                (2 - muls, muls, 0)
            }
            Self::SqrtAddDiv { .. } => (1, 0, 0),
            Self::Sub | Self::DivRne | Self::SqrtRne => (0, 0, 0),
            Self::ExpApprox => (0, 1, 0),
            Self::MatMul { .. } => (1, 1, 0),
            Self::Transpose2D { .. }
            | Self::ReverseRows2D { .. }
            | Self::ReverseColumns2D { .. }
            | Self::ConcatAxis0 { .. }
            | Self::SliceLastRow { .. }
            | Self::BroadcastScalar
            | Self::ArgMaxLast { .. }
            | Self::TakeAxis0 { .. } => (0, 0, 0),
            Self::Relu => (0, 0, 1),
            Self::AddRelu | Self::BiasAddRelu { .. } => (1, 0, 1),
            Self::MulRelu => (0, 1, 1),
            Self::AddBiasRelu { .. } => (2, 0, 1),
            Self::MulBiasRelu { .. } => (1, 1, 1),
        }
    }

    fn expected_inputs(self) -> usize {
        match self {
            Self::Relu
            | Self::ExpApprox
            | Self::SqrtRne
            | Self::Transpose2D { .. }
            | Self::ReverseRows2D { .. }
            | Self::ReverseColumns2D { .. }
            | Self::SliceLastRow { .. }
            | Self::BroadcastScalar
            | Self::ArgMaxLast { .. } => 1,
            Self::AddBiasRelu { .. }
            | Self::MulBiasRelu { .. }
            | Self::MulAdd { .. }
            | Self::MulAddMul { .. }
            | Self::BinaryChain { .. }
            | Self::SqrtAddDiv { .. } => 3,
            Self::MulMulAddDiv { .. } | Self::MulDiamondAdd { .. } | Self::DualPointwise { .. } => {
                4
            }
            _ => 2,
        }
    }

    fn columns(self) -> usize {
        match self {
            Self::BiasAdd { columns }
            | Self::BiasAddRelu { columns }
            | Self::AddBiasRelu { columns }
            | Self::MulBiasRelu { columns }
            | Self::MatMul { columns, .. }
            | Self::Transpose2D { columns, .. }
            | Self::ReverseRows2D { columns, .. }
            | Self::ReverseColumns2D { columns, .. } => columns,
            Self::SliceLastRow { source_width, .. } => source_width,
            Self::DualPointwise { earlier, .. } => earlier,
            _ => 0,
        }
    }

    fn inner(self) -> usize {
        match self {
            Self::MatMul { inner, .. } => inner,
            Self::Transpose2D { rows, .. }
            | Self::ReverseRows2D { rows, .. }
            | Self::ReverseColumns2D { rows, .. } => rows,
            Self::ConcatAxis0 { left } => left,
            Self::SliceLastRow { start, .. } => start,
            Self::ArgMaxLast { width } => width,
            Self::TakeAxis0 { lane } => lane,
            Self::MulAdd { multiply_on_right } => usize::from(multiply_on_right),
            Self::BinaryChain {
                first_add,
                second_add,
                producer_on_right,
            } => {
                usize::from(first_add)
                    + 2 * usize::from(second_add)
                    + 4 * usize::from(producer_on_right)
            }
            Self::SqrtAddDiv { sqrt_on_right } => usize::from(sqrt_on_right),
            Self::MulMulAddDiv {
                reused_source,
                multiply_on_right,
                add_on_right,
            } => {
                usize::from(reused_source)
                    + 2 * usize::from(multiply_on_right)
                    + 4 * usize::from(add_on_right)
            }
            Self::DualPointwise {
                first_mul,
                second_mul,
                ..
            } => usize::from(first_mul) + 2 * usize::from(second_mul),
            Self::MulDiamondAdd {
                reused_source,
                right_mul_on_right,
                left_mul_on_right,
            } => {
                usize::from(reused_source)
                    + 2 * usize::from(right_mul_on_right)
                    + 4 * usize::from(left_mul_on_right)
            }
            Self::MulAddMul {
                add_mul_on_right,
                mul_add_on_right,
                reused_source,
            } => {
                usize::from(add_mul_on_right)
                    + 2 * usize::from(mul_add_on_right)
                    + 4 * usize::from(reused_source)
            }
            _ => 0,
        }
    }

    pub(crate) fn extra_writes(self, elements: usize) -> Vec<(usize, usize)> {
        if let Self::DualPointwise { earlier, .. } = self {
            vec![(earlier, elements)]
        } else {
            Vec::new()
        }
    }

    fn parse(name: &str, columns: usize, inner: usize) -> Result<Self, TranslationError> {
        let kind = match name {
            "add" => Self::Add,
            "mul" => Self::Mul,
            "mul_add" => Self::MulAdd {
                multiply_on_right: inner == 1,
            },
            "binary_chain" if inner < 8 => Self::BinaryChain {
                first_add: inner & 1 != 0,
                second_add: inner & 2 != 0,
                producer_on_right: inner & 4 != 0,
            },
            "sqrt_add_div" if inner < 2 => Self::SqrtAddDiv {
                sqrt_on_right: inner == 1,
            },
            "mul_mul_add_div" if inner < 8 => Self::MulMulAddDiv {
                reused_source: (inner & 1) as u8,
                multiply_on_right: inner & 2 != 0,
                add_on_right: inner & 4 != 0,
            },
            "dual_pointwise" if inner < 4 => Self::DualPointwise {
                earlier: columns,
                first_mul: inner & 1 != 0,
                second_mul: inner & 2 != 0,
            },
            "mul_diamond_add" if inner < 8 => Self::MulDiamondAdd {
                reused_source: (inner & 1) as u8,
                right_mul_on_right: inner & 2 != 0,
                left_mul_on_right: inner & 4 != 0,
            },
            "mul_add_mul" if inner < 12 => Self::MulAddMul {
                add_mul_on_right: inner & 1 != 0,
                mul_add_on_right: inner & 2 != 0,
                reused_source: (inner >> 2) as u8,
            },
            "sub_rn" => Self::Sub,
            "div_rn" => Self::DivRne,
            "exp_approx" => Self::ExpApprox,
            "sqrt_rn" => Self::SqrtRne,
            "bias_add" => Self::BiasAdd { columns },
            "matmul" => Self::MatMul { inner, columns },
            "transpose2d" => Self::Transpose2D {
                rows: inner,
                columns,
            },
            "reverse_rows2d" => Self::ReverseRows2D {
                rows: inner,
                columns,
            },
            "reverse_columns2d" => Self::ReverseColumns2D {
                rows: inner,
                columns,
            },
            "concat_axis0" => Self::ConcatAxis0 { left: inner },
            "slice_last_row" => Self::SliceLastRow {
                start: inner,
                source_width: columns,
            },
            "broadcast_scalar" => Self::BroadcastScalar,
            "argmax_last" => Self::ArgMaxLast { width: inner },
            "take_axis0" => Self::TakeAxis0 { lane: inner },
            "relu" => Self::Relu,
            "add_relu" => Self::AddRelu,
            "mul_relu" => Self::MulRelu,
            "bias_relu" => Self::BiasAddRelu { columns },
            "add_bias_relu" => Self::AddBiasRelu { columns },
            "mul_bias_relu" => Self::MulBiasRelu { columns },
            _ => return Err(TranslationError(format!("unknown lowering kind: {name}"))),
        };
        if kind.columns() != columns || kind.inner() != inner {
            return Err(TranslationError("unexpected lowering dimensions".into()));
        }
        Ok(kind)
    }
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct TranslationKernel {
    pub node: usize,
    /// First producer using this exact LLVM/PTX function specialization.
    /// Separate graph nodes keep their own buffer extents and launch args.
    pub entry_node: usize,
    pub kind: TranslationKind,
    pub reads: Vec<(usize, usize)>,
    pub writes: usize,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct TranslationPlan {
    pub threads_per_block: u32,
    pub kernels: Vec<TranslationKernel>,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct TranslationReport {
    pub kernel_count: usize,
    pub rounded_adds: usize,
    pub rounded_muls: usize,
    pub relu_guards: usize,
    pub details: String,
}

impl TranslationReport {
    pub fn to_text(&self) -> String {
        format!(
            "assurance=structural-translation-validation\n\
             semantic_fp32_equivalence=not-proven\n\
             llvm_ptx_memory_execution=not-proven\n\
             cuda_jit_sass_hardware=trusted\n\
             kernels={}\nrounded_adds={}\nrounded_muls={}\nrelu_guards={}\n{}",
            self.kernel_count, self.rounded_adds, self.rounded_muls, self.relu_guards, self.details
        )
    }
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct TranslationError(pub String);

impl fmt::Display for TranslationError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str(&self.0)
    }
}

impl std::error::Error for TranslationError {}

fn invalid(reason: impl Into<String>) -> TranslationError {
    TranslationError(reason.into())
}

/// Check the two independent pointwise result *bindings*, not the scheduling
/// order of their arithmetic instructions. LLVM/NVPTX may reorder independent
/// RNE instructions even at -O0. Both public results must still be stored
/// separately and in their declared output order. Unknown PTX lowering fails
/// closed rather than guessing about a register move or a vectorized store.
fn validate_dual_pointwise_ptx(
    asm: &str,
    first: &str,
    second: &str,
    node: usize,
) -> Result<(), TranslationError> {
    let mut arithmetic = Vec::new();
    let mut stores = Vec::new();
    for (line_number, raw_line) in asm.lines().enumerate() {
        let line = raw_line.split("//").next().unwrap_or("").trim();
        let line = if line.starts_with('@') {
            line.split_once(char::is_whitespace)
                .map_or("", |(_, body)| body.trim_start())
        } else {
            line
        };
        let Some((opcode, arguments)) = line.split_once(char::is_whitespace) else {
            continue;
        };
        match opcode {
            "add.rn.f32" | "mul.rn.f32" => {
                let register = arguments
                    .split_once(',')
                    .map(|(register, _)| register.trim())
                    .ok_or_else(|| invalid("malformed DualPointwise PTX arithmetic operands"))?;
                arithmetic.push((line_number, opcode, register));
            }
            // NVPTX may write the exact binary32 payload through either a
            // typed F32 store or a raw 32-bit store. Both must consume the
            // original RNE result register, checked below.
            "st.global.f32" | "st.global.b32" => {
                let (address, value) = arguments
                    .trim()
                    .trim_end_matches(';')
                    .split_once(',')
                    .ok_or_else(|| invalid("malformed DualPointwise PTX store operands"))?;
                stores.push((line_number, address.trim(), value.trim()));
            }
            opcode if opcode.starts_with("st.global.") => {
                return Err(invalid(format!(
                    "unrecognized DualPointwise PTX store opcode at node {node}: {opcode}"
                )));
            }
            _ => {}
        }
    }
    if arithmetic.len() != 2 || stores.len() != 2 {
        return Err(invalid(format!(
            "DualPointwise PTX requires two RNE values and two scalar F32 stores at node {node}: arithmetic={}, stores={}",
            arithmetic.len(),
            stores.len()
        )));
    }
    if stores[0].1 == stores[1].1 || stores[0].2 == stores[1].2 {
        return Err(invalid(format!(
            "DualPointwise PTX stores alias an address or result register at node {node}"
        )));
    }
    for (store, expected) in stores.iter().zip([first, second]) {
        let producers = arithmetic
            .iter()
            .filter(|&&(at, opcode, result)| {
                at < store.0 && opcode == expected && result == store.2
            })
            .count();
        if producers != 1 {
            return Err(invalid(format!(
                "DualPointwise PTX output/register binding mismatch at node {node}: expected {expected}"
            )));
        }
    }
    Ok(())
}

impl TranslationPlan {
    fn check(&self) -> Result<(), TranslationError> {
        if !matches!(self.threads_per_block, 64 | 128 | 256 | 512) {
            return Err(invalid("unsupported CUDA launch width in translation plan"));
        }
        let mut previous = None;
        let mut seen_entries = BTreeSet::new();
        for kernel in &self.kernels {
            if previous.is_some_and(|n| kernel.node <= n) {
                return Err(invalid("kernel roots not strictly ordered"));
            }
            previous = Some(kernel.node);
            if kernel.entry_node > kernel.node
                || (kernel.entry_node != kernel.node && !seen_entries.contains(&kernel.entry_node))
            {
                return Err(invalid(format!(
                    "kernel {} references unknown or future entry {}",
                    kernel.node, kernel.entry_node
                )));
            }
            if kernel.entry_node == kernel.node {
                seen_entries.insert(kernel.node);
            }
            if kernel.writes == 0
                || kernel.writes > i32::MAX as usize
                || kernel.reads.len() != kernel.kind.expected_inputs()
                || kernel.reads.iter().any(|&(source, size)| {
                    source >= kernel.node || size == 0 || size > i32::MAX as usize
                })
                || matches!(kernel.kind, TranslationKind::DualPointwise { earlier, .. } if earlier >= kernel.node || earlier == 0)
            {
                return Err(invalid(format!(
                    "invalid source/write extents for node {}",
                    kernel.node
                )));
            }
            let columns = kernel.kind.columns();
            if (matches!(
                kernel.kind,
                TranslationKind::BiasAdd { .. }
                    | TranslationKind::BiasAddRelu { .. }
                    | TranslationKind::AddBiasRelu { .. }
                    | TranslationKind::MulBiasRelu { .. }
                    | TranslationKind::MatMul { .. }
            ) && columns == 0)
                || (columns != 0
                    && !matches!(kernel.kind, TranslationKind::DualPointwise { .. })
                    && (columns > i32::MAX as usize
                        || (!matches!(kernel.kind, TranslationKind::SliceLastRow { .. })
                            && kernel.writes % columns != 0)))
            {
                return Err(invalid("unrepresentable column extent"));
            }
            if let TranslationKind::MatMul { inner, columns } = kernel.kind {
                if inner == 0
                    || inner > i32::MAX as usize
                    || kernel.reads.len() != 2
                    || kernel.reads[0].1 != (kernel.writes / columns).saturating_mul(inner)
                    || kernel.reads[1].1 != inner.saturating_mul(columns)
                {
                    return Err(invalid("MatMul source shape differs from reduction shape"));
                }
            }
            if matches!(
                kernel.kind,
                TranslationKind::MulAdd { .. }
                    | TranslationKind::MulAddMul { .. }
                    | TranslationKind::BinaryChain { .. }
                    | TranslationKind::SqrtAddDiv { .. }
                    | TranslationKind::MulMulAddDiv { .. }
                    | TranslationKind::MulDiamondAdd { .. }
                    | TranslationKind::DualPointwise { .. }
            ) {
                if kernel.reads.iter().any(|&(_, size)| size != kernel.writes) {
                    return Err(invalid("mul-add source shape mismatch"));
                }
                if let TranslationKind::MulDiamondAdd { reused_source, .. } = kernel.kind {
                    if reused_source > 1 {
                        return Err(invalid("MulDiamondAdd source selector must be 0..=1"));
                    }
                }
                if let TranslationKind::MulMulAddDiv { reused_source, .. } = kernel.kind {
                    if reused_source > 1 {
                        return Err(invalid("MulMulAddDiv source selector must be 0..=1"));
                    }
                }
                if let TranslationKind::MulAddMul { reused_source, .. } = kernel.kind {
                    if reused_source > 2 {
                        return Err(invalid("MulAddMul source selector must be 0..=2"));
                    }
                }
            }
            if let TranslationKind::BiasAdd { columns } | TranslationKind::BiasAddRelu { columns } =
                kernel.kind
            {
                if kernel.reads[0].1 != kernel.writes || kernel.reads[1].1 != columns {
                    return Err(invalid("BiasAdd source shape mismatch"));
                }
            }
            if let TranslationKind::AddBiasRelu { columns }
            | TranslationKind::MulBiasRelu { columns } = kernel.kind
            {
                if kernel.reads[0].1 != kernel.writes
                    || kernel.reads[1].1 != kernel.writes
                    || kernel.reads[2].1 != columns
                {
                    return Err(invalid("fused chain shape mismatch"));
                }
            }
            match kernel.kind {
                TranslationKind::Transpose2D { rows, columns }
                    if rows == 0
                        || columns == 0
                        || rows.saturating_mul(columns) != kernel.writes
                        || kernel.reads[0].1 != kernel.writes =>
                {
                    return Err(invalid("transpose2d source shape mismatch"));
                }
                TranslationKind::ReverseRows2D { rows, columns }
                | TranslationKind::ReverseColumns2D { rows, columns }
                    if rows == 0
                        || columns == 0
                        || rows.saturating_mul(columns) != kernel.writes
                        || kernel.reads[0].1 != kernel.writes =>
                {
                    return Err(invalid("reverse2d source shape mismatch"));
                }
                TranslationKind::SliceLastRow {
                    start,
                    source_width,
                } if source_width == 0
                    || source_width > i32::MAX as usize
                    || kernel.reads[0].1 != source_width
                    || start
                        .checked_add(kernel.writes)
                        .is_none_or(|end| end > source_width) =>
                {
                    return Err(invalid("last-row slice source mismatch"));
                }
                TranslationKind::BroadcastScalar if kernel.reads[0].1 != 1 => {
                    return Err(invalid("scalar broadcast source mismatch"));
                }
                TranslationKind::ConcatAxis0 { left }
                    if left == 0
                        || kernel.reads[0].1 != left
                        || kernel.reads[0].1.saturating_add(kernel.reads[1].1) != kernel.writes =>
                {
                    return Err(invalid("concat_axis0 source shape mismatch"));
                }
                TranslationKind::ArgMaxLast { width }
                    if width == 0 || kernel.reads[0].1 != kernel.writes.saturating_mul(width) =>
                {
                    return Err(invalid("argmax_last source shape mismatch"));
                }
                TranslationKind::TakeAxis0 { lane }
                    if lane != kernel.writes
                        || kernel.reads[1].1 != 1
                        || kernel.reads[0].1 < lane
                        || kernel.reads[0].1 % lane != 0 =>
                {
                    return Err(invalid("take_axis0 source shape mismatch"));
                }
                _ => {}
            }
            if matches!(
                kernel.kind,
                TranslationKind::Add
                    | TranslationKind::Mul
                    | TranslationKind::Sub
                    | TranslationKind::DivRne
                    | TranslationKind::ExpApprox
                    | TranslationKind::SqrtRne
                    | TranslationKind::Relu
                    | TranslationKind::AddRelu
                    | TranslationKind::MulRelu
            ) && kernel.reads.iter().any(|&(_, size)| size != kernel.writes)
            {
                return Err(invalid("pointwise source shape mismatch"));
            }
        }
        Ok(())
    }

    /// Deterministic, versioned plan. Generated from a graph, never from PTX.
    pub fn to_text(&self) -> String {
        let mut out = format!(
            "vn-translation-plan-v2\nthreads={}\n",
            self.threads_per_block
        );
        for kernel in &self.kernels {
            let reads = kernel
                .reads
                .iter()
                .map(|(source, size)| format!("{source}:{size}"))
                .collect::<Vec<_>>()
                .join(",");
            out.push_str(&format!(
                "kernel\t{}\t{}\t{}\t{}\t{}\t{}\t{}\n",
                kernel.node,
                kernel.entry_node,
                kernel.kind.name(),
                kernel.writes,
                reads,
                kernel.kind.columns(),
                kernel.kind.inner()
            ));
        }
        out
    }

    /// Offline reader rejects unknown schema/kinds, malformed nodes and sizes.
    /// The saved plan is SHA-pinned evidence, NOT by itself a semantic proof.
    pub fn from_text(source: &str) -> Result<Self, TranslationError> {
        let mut lines = source.lines();
        // Version 1 artifacts had one physical entrypoint per graph node.
        // Version 2 records each node's function owner explicitly.
        let legacy = match lines.next() {
            Some("vn-translation-plan-v1") => true,
            Some("vn-translation-plan-v2") => false,
            _ => return Err(invalid("unsupported translation plan version")),
        };
        let threads_per_block = lines
            .next()
            .and_then(|line| line.strip_prefix("threads="))
            .and_then(|value| value.parse::<u32>().ok())
            .ok_or_else(|| invalid("invalid launch width in translation plan"))?;
        let mut kernels = Vec::new();
        for line in lines {
            let fields = line.split('\t').collect::<Vec<_>>();
            if fields.len() != (if legacy { 7 } else { 8 }) || fields[0] != "kernel" {
                return Err(invalid("malformed translation kernel row"));
            }
            let number = |field: &str| -> Result<usize, TranslationError> {
                field
                    .parse()
                    .map_err(|_| invalid("invalid translation integer"))
            };
            let node = number(fields[1])?;
            let entry_node = if legacy { node } else { number(fields[2])? };
            let offset = usize::from(!legacy);
            let writes = number(fields[3 + offset])?;
            let reads = fields[4 + offset]
                .split(',')
                .map(|pair| {
                    let (source, count) = pair
                        .split_once(':')
                        .ok_or_else(|| invalid("malformed translation source"))?;
                    Ok((number(source)?, number(count)?))
                })
                .collect::<Result<Vec<_>, TranslationError>>()?;
            let columns = number(fields[5 + offset])?;
            let inner = number(fields[6 + offset])?;
            let kind = TranslationKind::parse(fields[2 + offset], columns, inner)?;
            kernels.push(TranslationKernel {
                node,
                entry_node,
                kind,
                reads,
                writes,
            });
        }
        let plan = Self {
            threads_per_block,
            kernels,
        };
        plan.check()?;
        Ok(plan)
    }

    /// Compares each IR kernel against its independent lowering contract,
    /// and each PTX entry against that kernel, rather than global opcode sums.
    /// This is a bounded structural validation of known templates only.
    pub fn validate(&self, llvm: &str, ptx: &str) -> Result<TranslationReport, TranslationError> {
        self.check()?;
        let mut llvm_parts = BTreeMap::new();
        let sections = llvm
            .split("define ptx_kernel void @vn_node_")
            .collect::<Vec<_>>();
        if sections[0].contains("define ") {
            return Err(invalid("unrecognized LLVM function"));
        }
        if llvm.matches("define ").count() != sections.len() - 1 {
            return Err(invalid("unknown LLVM function or entrypoint"));
        }
        for section in sections.into_iter().skip(1) {
            let digits = section
                .chars()
                .take_while(char::is_ascii_digit)
                .collect::<String>();
            let node = digits
                .parse::<usize>()
                .map_err(|_| invalid("invalid LLVM kernel name"))?;
            if !section[digits.len()..].starts_with('(')
                || !section.contains("i32 %length) {")
                || !section.lines().any(|line| line.trim() == "}")
            {
                return Err(invalid(format!("malformed LLVM kernel {node}")));
            }
            if llvm_parts.insert(node, section).is_some() {
                return Err(invalid("duplicate LLVM kernel"));
            }
        }

        let mut ptx_parts: BTreeMap<usize, String> = BTreeMap::new();
        let mut current = None;
        for raw_line in ptx.lines() {
            let line = raw_line.split("//").next().unwrap_or("");
            let fields = line.split_whitespace().collect::<Vec<_>>();
            if let Some(i) = fields.iter().position(|&token| token == ".entry") {
                let name = fields
                    .get(i + 1)
                    .ok_or_else(|| invalid("PTX entry missing name"))?;
                let stripped = name
                    .strip_prefix("vn_node_")
                    .ok_or_else(|| invalid("unexpected PTX entry"))?;
                let digits = stripped
                    .chars()
                    .take_while(char::is_ascii_digit)
                    .collect::<String>();
                let node = digits
                    .parse::<usize>()
                    .map_err(|_| invalid("invalid PTX entry name"))?;
                if !stripped[digits.len()..].starts_with('(')
                    || ptx_parts.insert(node, String::new()).is_some()
                {
                    return Err(invalid("duplicate or malformed PTX entrypoint"));
                }
                current = Some(node);
            }
            if let Some(node) = current {
                ptx_parts
                    .get_mut(&node)
                    .expect("current PTX kernel inserted")
                    .push_str(&format!("{raw_line}\n"));
            }
        }
        let expected_entries = self
            .kernels
            .iter()
            .map(|kernel| kernel.entry_node)
            .collect::<BTreeSet<_>>();
        if llvm_parts.keys().copied().collect::<BTreeSet<_>>() != expected_entries
            || ptx_parts.keys().copied().collect::<BTreeSet<_>>() != expected_entries
        {
            return Err(invalid(format!(
                "kernel entry set mismatch: semantic nodes={}, distinct entries={}, LLVM={}, PTX={}",
                self.kernels.len(),
                expected_entries.len(),
                llvm_parts.len(),
                ptx_parts.len()
            )));
        }

        let mut report = TranslationReport {
            kernel_count: self.kernels.len(),
            rounded_adds: 0,
            rounded_muls: 0,
            relu_guards: 0,
            details: String::new(),
        };
        for kernel in &self.kernels {
            let node = kernel.node;
            let entry = kernel.entry_node;
            let ir = llvm_parts
                .get(&entry)
                .ok_or_else(|| invalid(format!("LLVM entry {entry} for node {node} missing")))?;
            let asm = ptx_parts
                .get(&entry)
                .ok_or_else(|| invalid(format!("PTX entry {entry} for node {node} missing")))?;
            let (add, mul, relu) = kernel.kind.counts();
            let structural_requirements: Option<Vec<String>> = match kernel.kind {
                TranslationKind::Transpose2D { rows, columns } => Some(vec![
                    format!("urem i32 %idx, {rows}"),
                    format!("udiv i32 %idx, {rows}"),
                    format!("mul i32 %in_row, {columns}"),
                    "%ap = getelementptr float, ptr addrspace(1) %a, i32 %source_idx".into(),
                    "store float %x, ptr addrspace(1) %op, align 4".into(),
                ]),
                TranslationKind::ReverseRows2D { rows, columns } => Some(vec![
                    format!("udiv i32 %idx, {columns}"),
                    format!("urem i32 %idx, {columns}"),
                    format!("%rows_minus_one = add i32 0, {}", rows - 1),
                    "%reversed_row = sub i32 %rows_minus_one, %row".into(),
                    "%ap = getelementptr float, ptr addrspace(1) %a, i32 %source_idx".into(),
                    "store float %x, ptr addrspace(1) %op, align 4".into(),
                ]),
                TranslationKind::ReverseColumns2D { columns, .. } => Some(vec![
                    format!("udiv i32 %idx, {columns}"),
                    format!("urem i32 %idx, {columns}"),
                    format!("%columns_minus_one = add i32 0, {}", columns - 1),
                    "%reversed_col = sub i32 %columns_minus_one, %col".into(),
                    "%ap = getelementptr float, ptr addrspace(1) %a, i32 %source_idx".into(),
                    "store float %x, ptr addrspace(1) %op, align 4".into(),
                ]),
                TranslationKind::SliceLastRow { start, .. } => Some(vec![
                    format!("%source_idx = add i32 %idx, {start}"),
                    "%ap = getelementptr float, ptr addrspace(1) %a, i32 %source_idx".into(),
                    "store float %x, ptr addrspace(1) %op, align 4".into(),
                ]),
                TranslationKind::BroadcastScalar => Some(vec![
                    "%ap = getelementptr float, ptr addrspace(1) %a, i32 0".into(),
                    "%x = load float, ptr addrspace(1) %ap, align 4".into(),
                    "store float %x, ptr addrspace(1) %op, align 4".into(),
                ]),
                TranslationKind::ConcatAxis0 { left } => Some(vec![
                    format!("icmp ult i32 %idx, {left}"),
                    format!("sub i32 %idx, {left}"),
                    "phi float [ %left_value, %left ], [ %right_value, %right ]".into(),
                    "store float %value, ptr addrspace(1) %op, align 4".into(),
                ]),
                TranslationKind::ArgMaxLast { width } => Some(vec![
                    format!("mul i32 %idx, {width}"),
                    format!("icmp ult i32 %lane, {width}"),
                    "%candidate_numeric = fcmp ord float %candidate, %candidate".into(),
                    "%best_nan = fcmp uno float %best_value, %best_value".into(),
                    "%greater = fcmp ogt float %candidate, %best_value".into(),
                    "store i32 %best_lane, ptr addrspace(1) %op, align 4".into(),
                ]),
                TranslationKind::TakeAxis0 { lane } => Some(vec![
                    "load i32, ptr addrspace(1) %bp, align 4".into(),
                    format!("mul i32 %selected, {lane}"),
                    "%ap = getelementptr float, ptr addrspace(1) %a, i32 %source_idx".into(),
                    "store float %x, ptr addrspace(1) %op, align 4".into(),
                ]),
                _ => None,
            };
            if let Some(requirements) = structural_requirements {
                if !ir.contains("icmp ult i32 %idx, %length")
                    || !ir.contains("br i1 %valid, label %compute, label %done")
                    || requirements.iter().any(|required| !ir.contains(required))
                    || ir.contains("call float asm sideeffect \"add.rn.f32")
                    || ir.contains("call float asm sideeffect \"mul.rn.f32")
                {
                    return Err(invalid(format!(
                        "structural LLVM lowering mismatch at node {node}"
                    )));
                }
                audit_fp32_ptx("", asm)
                    .map_err(|err| invalid(format!("PTX node {node}: {err}")))?;
                let reads = kernel
                    .reads
                    .iter()
                    .map(|(source, size)| format!("{source}:{size}"))
                    .collect::<Vec<_>>()
                    .join(",");
                report.details.push_str(&format!(
                    "node={node} kind={} reads={reads} writes={} add.rn.f32=0 mul.rn.f32=0 relu=0 status=structural-pass\n",
                    kernel.kind.name(), kernel.writes
                ));
                continue;
            }
            if let TranslationKind::DualPointwise {
                earlier,
                first_mul,
                second_mul,
            } = kernel.kind
            {
                let first = if first_mul {
                    "mul.rn.f32"
                } else {
                    "add.rn.f32"
                };
                let second = if second_mul {
                    "mul.rn.f32"
                } else {
                    "add.rn.f32"
                };
                let required = [
                    "ptr addrspace(1) %a, ptr addrspace(1) %b, ptr addrspace(1) %c, ptr addrspace(1) %d, ptr addrspace(1) %extra, ptr addrspace(1) %out, i32 %length",
                    "%ap = getelementptr float, ptr addrspace(1) %a, i32 %idx",
                    "%bp = getelementptr float, ptr addrspace(1) %b, i32 %idx",
                    "%cp = getelementptr float, ptr addrspace(1) %c, i32 %idx",
                    "%dp = getelementptr float, ptr addrspace(1) %d, i32 %idx",
                    "%x = load float, ptr addrspace(1) %ap, align 4",
                    "%y = load float, ptr addrspace(1) %bp, align 4",
                    "%z = load float, ptr addrspace(1) %cp, align 4",
                    "%w = load float, ptr addrspace(1) %dp, align 4",
                    "%extra_ptr = getelementptr float, ptr addrspace(1) %extra, i32 %idx",
                    "%op = getelementptr float, ptr addrspace(1) %out, i32 %idx",
                    "store float %first, ptr addrspace(1) %extra_ptr, align 4",
                    "store float %second, ptr addrspace(1) %op, align 4",
                    "icmp ult i32 %idx, %length",
                ];
                let first_instruction = format!(
                    "%first = call float asm sideeffect \"{first} $0, $1, $2;\", \"=f,f,f\"(float %x, float %y)"
                );
                let second_instruction = format!(
                    "%second = call float asm sideeffect \"{second} $0, $1, $2;\", \"=f,f,f\"(float %z, float %w)"
                );
                if earlier >= node
                    || required.iter().any(|text| !ir.contains(text))
                    || !matches!((ir.find(&first_instruction), ir.find(&second_instruction)), (Some(a), Some(b)) if a < b)
                    || ir.matches("call float asm sideeffect").count() != 2
                    || ir.matches("store float ").count() != 2
                    || ir.contains("fcmp ")
                {
                    return Err(invalid(format!(
                        "DualPointwise LLVM template mismatch at node {node}"
                    )));
                }
                audit_fp32_ptx(ir, asm)
                    .map_err(|err| invalid(format!("PTX node {node}: {err}")))?;
                // Independent instructions may be scheduled in either
                // order; each typed result must reach its own public store.
                validate_dual_pointwise_ptx(asm, first, second, node)?;
                let (add, mul, _) = kernel.kind.counts();
                report.rounded_adds += add;
                report.rounded_muls += mul;
                report.details.push_str(&format!("node={node} kind=dual_pointwise additional_output={earlier} reads={:?} writes={} status=structural-pass\n", kernel.reads, kernel.writes));
                continue;
            }
            if let TranslationKind::MulDiamondAdd {
                reused_source,
                right_mul_on_right,
                left_mul_on_right,
            } = kernel.kind
            {
                if reused_source > 1 {
                    return Err(invalid("invalid MulDiamondAdd source selector"));
                }
                let repeated = if reused_source == 0 { "%z" } else { "%w" };
                let repeat_args = if right_mul_on_right {
                    format!("(float {repeated}, float %right)")
                } else {
                    format!("(float %right, float {repeated})")
                };
                let add_args = if left_mul_on_right {
                    "(float %repeated, float %left)"
                } else {
                    "(float %left, float %repeated)"
                };
                let first = "%left = call float asm sideeffect \"mul.rn.f32 $0, $1, $2;\", \"=f,f,f\"(float %x, float %y)";
                let second = "%right = call float asm sideeffect \"mul.rn.f32 $0, $1, $2;\", \"=f,f,f\"(float %z, float %w)";
                let third = format!(
                    "%repeated = call float asm sideeffect \"mul.rn.f32 $0, $1, $2;\", \"=f,f,f\"{repeat_args}"
                );
                let fourth = format!(
                    "%value = call float asm sideeffect \"add.rn.f32 $0, $1, $2;\", \"=f,f,f\"{add_args}"
                );
                let required = [
                    "%ap = getelementptr float, ptr addrspace(1) %a, i32 %idx",
                    "%bp = getelementptr float, ptr addrspace(1) %b, i32 %idx",
                    "%cp = getelementptr float, ptr addrspace(1) %c, i32 %idx",
                    "%dp = getelementptr float, ptr addrspace(1) %d, i32 %idx",
                    "%x = load float, ptr addrspace(1) %ap, align 4",
                    "%y = load float, ptr addrspace(1) %bp, align 4",
                    "%z = load float, ptr addrspace(1) %cp, align 4",
                    "%w = load float, ptr addrspace(1) %dp, align 4",
                    "icmp ult i32 %idx, %length",
                    "br i1 %valid, label %compute, label %done",
                    "store float %value, ptr addrspace(1) %op, align 4",
                ];
                if required.iter().any(|&x| !ir.contains(x))
                    || !matches!(
                        (ir.find(first), ir.find(second), ir.find(&third), ir.find(&fourth)),
                        (Some(a), Some(b), Some(c), Some(d)) if a < b && b < c && c < d
                    )
                    || ir.matches("call float asm sideeffect").count() != 4
                    || ir.contains("fcmp ")
                {
                    return Err(invalid(format!(
                        "MulDiamondAdd LLVM template mismatch at node {node}"
                    )));
                }
                audit_fp32_ptx(ir, asm).map_err(|e| invalid(format!("PTX node {node}: {e}")))?;
                let sequence = asm
                    .lines()
                    .map(|line| line.split("//").next().unwrap_or(""))
                    .filter_map(|line| {
                        if line.contains("mul.rn.f32") {
                            Some("mul")
                        } else if line.contains("add.rn.f32") {
                            Some("add")
                        } else {
                            None
                        }
                    })
                    .collect::<Vec<_>>();
                if sequence != ["mul", "mul", "mul", "add"] {
                    return Err(invalid(format!(
                        "MulDiamondAdd PTX instruction order mismatch at node {node}"
                    )));
                }
                report.rounded_muls += 3;
                report.rounded_adds += 1;
                report.details.push_str(&format!(
                    "node={node} kind=mul_diamond_add reads={:?} writes={} FP32=mul-mul-mul-add.rn hardware=trusted\n",
                    kernel.reads, kernel.writes
                ));
                continue;
            }
            if let TranslationKind::MulMulAddDiv {
                reused_source,
                multiply_on_right,
                add_on_right,
            } = kernel.kind
            {
                if reused_source > 1 {
                    return Err(invalid("invalid MulMulAddDiv source selector"));
                }
                let factor = if reused_source == 0 { "%x" } else { "%y" };
                let second_args = if multiply_on_right {
                    format!("(float {factor}, float %first)")
                } else {
                    format!("(float %first, float {factor})")
                };
                let add_args = if add_on_right {
                    "(float %z, float %second)"
                } else {
                    "(float %second, float %z)"
                };
                let first = "%first = call float asm sideeffect \"mul.rn.f32 $0, $1, $2;\", \"=f,f,f\"(float %x, float %y)";
                let second = format!(
                    "%second = call float asm sideeffect \"mul.rn.f32 $0, $1, $2;\", \"=f,f,f\"{second_args}"
                );
                let third = format!(
                    "%third = call float asm sideeffect \"add.rn.f32 $0, $1, $2;\", \"=f,f,f\"{add_args}"
                );
                let fourth = "%value = call float asm sideeffect \"div.rn.f32 $0, $1, $2;\", \"=f,f,f\"(float %third, float %w)";
                let required = [
                    "%ap = getelementptr float, ptr addrspace(1) %a, i32 %idx",
                    "%bp = getelementptr float, ptr addrspace(1) %b, i32 %idx",
                    "%cp = getelementptr float, ptr addrspace(1) %c, i32 %idx",
                    "%dp = getelementptr float, ptr addrspace(1) %d, i32 %idx",
                    "%x = load float, ptr addrspace(1) %ap, align 4",
                    "%y = load float, ptr addrspace(1) %bp, align 4",
                    "%z = load float, ptr addrspace(1) %cp, align 4",
                    "%w = load float, ptr addrspace(1) %dp, align 4",
                    "icmp ult i32 %idx, %length",
                    "br i1 %valid, label %compute, label %done",
                    "store float %value, ptr addrspace(1) %op, align 4",
                ];
                if required.iter().any(|&x| !ir.contains(x))
                    || !matches!(
                        (ir.find(first), ir.find(&second), ir.find(&third), ir.find(fourth)),
                        (Some(a), Some(b), Some(c), Some(d)) if a < b && b < c && c < d
                    )
                    || ir.matches("call float asm sideeffect").count() != 4
                    || ir.contains("fcmp ")
                {
                    return Err(invalid(format!(
                        "MulMulAddDiv LLVM template mismatch at node {node}"
                    )));
                }
                audit_fp32_ptx(ir, asm).map_err(|e| invalid(format!("PTX node {node}: {e}")))?;
                let sequence = asm
                    .lines()
                    .map(|line| line.split("//").next().unwrap_or(""))
                    .filter_map(|line| {
                        if line.contains("mul.rn.f32") {
                            Some("mul")
                        } else if line.contains("add.rn.f32") {
                            Some("add")
                        } else if line.contains("div.rn.f32") {
                            Some("div")
                        } else {
                            None
                        }
                    })
                    .collect::<Vec<_>>();
                if sequence != ["mul", "mul", "add", "div"] {
                    return Err(invalid(format!(
                        "MulMulAddDiv PTX instruction order mismatch at node {node}"
                    )));
                }
                report.rounded_muls += 2;
                report.rounded_adds += 1;
                report.details.push_str(&format!(
                    "node={node} kind=mul_mul_add_div reads={:?} writes={} FP32=mul-mul-add-div.rn hardware=trusted\n",
                    kernel.reads, kernel.writes
                ));
                continue;
            }
            if let TranslationKind::SqrtAddDiv { sqrt_on_right } = kernel.kind {
                let add_operands = if sqrt_on_right {
                    "(float %y, float %root)"
                } else {
                    "(float %root, float %y)"
                };
                let expected = [
                    "%ap = getelementptr float, ptr addrspace(1) %a, i32 %idx",
                    "%bp = getelementptr float, ptr addrspace(1) %b, i32 %idx",
                    "%biasp = getelementptr float, ptr addrspace(1) %bias, i32 %idx",
                    "%x = load float, ptr addrspace(1) %ap, align 4",
                    "%y = load float, ptr addrspace(1) %bp, align 4",
                    "%z = load float, ptr addrspace(1) %biasp, align 4",
                    "%root = call float asm sideeffect \"sqrt.rn.f32 $0, $1;\", \"=f,f\"(float %x)",
                    "%value = call float asm sideeffect \"div.rn.f32 $0, $1, $2;\", \"=f,f,f\"(float %z, float %shifted)",
                    "icmp ult i32 %idx, %length",
                    "br i1 %valid, label %compute, label %done",
                    "store float %value, ptr addrspace(1) %op, align 4",
                ];
                let middle = format!(
                    "%shifted = call float asm sideeffect \"add.rn.f32 $0, $1, $2;\", \"=f,f,f\"{add_operands}"
                );
                if expected.iter().any(|&needle| !ir.contains(needle))
                    || !matches!(
                        (ir.find(expected[6]), ir.find(&middle), ir.find(expected[7])),
                        (Some(a), Some(b), Some(c)) if a < b && b < c
                    )
                    || ir.matches("call float asm sideeffect").count() != 3
                    || ir.matches("fcmp ").count() != 0
                {
                    return Err(invalid(format!(
                        "SqrtAddDiv LLVM operand/order mismatch at node {node}"
                    )));
                }
                audit_fp32_ptx(ir, asm).map_err(|e| invalid(format!("PTX node {node}: {e}")))?;
                let operations = asm
                    .lines()
                    .map(|line| line.split("//").next().unwrap_or(""))
                    .filter_map(|line| {
                        if line.contains("sqrt.rn.f32") {
                            Some("sqrt")
                        } else if line.contains("add.rn.f32") {
                            Some("add")
                        } else if line.contains("div.rn.f32") {
                            Some("div")
                        } else {
                            None
                        }
                    })
                    .collect::<Vec<_>>();
                if operations != ["sqrt", "add", "div"] {
                    return Err(invalid(format!(
                        "SqrtAddDiv PTX instruction order mismatch at node {node}"
                    )));
                }
                report.rounded_adds += 1;
                report.details.push_str(&format!(
                    "node={node} kind=sqrt_add_div reads={:?} writes={} fp32=sqrt.rn-add.rn-div.rn hardware=trusted\n",
                    kernel.reads, kernel.writes
                ));
                continue;
            }
            if let TranslationKind::BinaryChain {
                first_add,
                second_add,
                producer_on_right,
            } = kernel.kind
            {
                let first = if first_add {
                    "add.rn.f32"
                } else {
                    "mul.rn.f32"
                };
                let second = if second_add {
                    "add.rn.f32"
                } else {
                    "mul.rn.f32"
                };
                let operands = if producer_on_right {
                    "(float %z, float %middle)"
                } else {
                    "(float %middle, float %z)"
                };
                let middle = format!(
                    "%middle = call float asm sideeffect \"{first} $0, $1, $2;\", \"=f,f,f\"(float %x, float %y)"
                );
                let value = format!(
                    "%value = call float asm sideeffect \"{second} $0, $1, $2;\", \"=f,f,f\"{operands}"
                );
                let required = [
                    "%ap = getelementptr float, ptr addrspace(1) %a, i32 %idx",
                    "%bp = getelementptr float, ptr addrspace(1) %b, i32 %idx",
                    "%biasp = getelementptr float, ptr addrspace(1) %bias, i32 %idx",
                    "%x = load float, ptr addrspace(1) %ap, align 4",
                    "%y = load float, ptr addrspace(1) %bp, align 4",
                    "%z = load float, ptr addrspace(1) %biasp, align 4",
                    "icmp ult i32 %idx, %length",
                    "br i1 %valid, label %compute, label %done",
                    "store float %value, ptr addrspace(1) %op, align 4",
                ];
                if required.iter().any(|&x| !ir.contains(x))
                    || !matches!((ir.find(&middle), ir.find(&value)),
                        (Some(a), Some(b)) if a < b)
                    || ir.matches("call float asm sideeffect").count() != 2
                    || ir.matches("fcmp ").count() != 0
                {
                    return Err(invalid(format!(
                        "binary pointwise LLVM template mismatch at node {node}"
                    )));
                }
                audit_fp32_ptx(ir, asm).map_err(|e| invalid(format!("PTX node {node}: {e}")))?;
                let sequence = asm
                    .lines()
                    .map(|line| line.split("//").next().unwrap_or(""))
                    .filter_map(|line| {
                        if line.contains("mul.rn.f32") {
                            Some("mul.rn.f32")
                        } else if line.contains("add.rn.f32") {
                            Some("add.rn.f32")
                        } else {
                            None
                        }
                    })
                    .collect::<Vec<_>>();
                if sequence != [first, second] {
                    return Err(invalid(format!(
                        "binary pointwise PTX instruction order mismatch at node {node}"
                    )));
                }
                report.rounded_adds += usize::from(first_add) + usize::from(second_add);
                report.rounded_muls += usize::from(!first_add) + usize::from(!second_add);
                report.details.push_str(&format!(
                    "node={node} kind=binary_chain reads={:?} writes={} hardware=trusted\n",
                    kernel.reads, kernel.writes
                ));
                continue;
            }
            if let TranslationKind::MulAddMul {
                add_mul_on_right,
                mul_add_on_right,
                reused_source,
            } = kernel.kind
            {
                if reused_source > 2 {
                    return Err(invalid("invalid MulAddMul source selector"));
                }
                let additive = if add_mul_on_right {
                    "(float %z, float %product)"
                } else {
                    "(float %product, float %z)"
                };
                let factor = ["%x", "%y", "%z"][usize::from(reused_source)];
                let final_args = if mul_add_on_right {
                    format!("(float {factor}, float %middle)")
                } else {
                    format!("(float %middle, float {factor})")
                };
                let required = [
                    "%ap = getelementptr float, ptr addrspace(1) %a, i32 %idx",
                    "%bp = getelementptr float, ptr addrspace(1) %b, i32 %idx",
                    "%biasp = getelementptr float, ptr addrspace(1) %bias, i32 %idx",
                    "%x = load float, ptr addrspace(1) %ap, align 4",
                    "%y = load float, ptr addrspace(1) %bp, align 4",
                    "%z = load float, ptr addrspace(1) %biasp, align 4",
                    "%product = call float asm sideeffect \"mul.rn.f32 $0, $1, $2;\", \"=f,f,f\"(float %x, float %y)",
                    "icmp ult i32 %idx, %length",
                    "br i1 %valid, label %compute, label %done",
                    "store float %value, ptr addrspace(1) %op, align 4",
                ];
                let add = format!(
                    "%middle = call float asm sideeffect \"add.rn.f32 $0, $1, $2;\", \"=f,f,f\"{additive}"
                );
                let last = format!(
                    "%value = call float asm sideeffect \"mul.rn.f32 $0, $1, $2;\", \"=f,f,f\"{final_args}"
                );
                if required.iter().any(|&x| !ir.contains(x))
                    || !matches!((ir.find(required[6]), ir.find(&add), ir.find(&last)),
                       (Some(a), Some(b), Some(c)) if a < b && b < c)
                    || ir.matches("call float asm sideeffect").count() != 3
                    || ir.matches("fcmp ").count() != 0
                {
                    return Err(invalid(format!(
                        "MulAddMul LLVM template mismatch at node {node}"
                    )));
                }
                audit_fp32_ptx(ir, asm).map_err(|e| invalid(format!("PTX node {node}: {e}")))?;
                let sequence = asm
                    .lines()
                    .map(|line| line.split("//").next().unwrap_or(""))
                    .filter_map(|line| {
                        if line.contains("mul.rn.f32") {
                            Some("mul")
                        } else if line.contains("add.rn.f32") {
                            Some("add")
                        } else {
                            None
                        }
                    })
                    .collect::<Vec<_>>();
                if sequence != ["mul", "add", "mul"] {
                    return Err(invalid(format!(
                        "MulAddMul PTX instruction order changed at node {node}"
                    )));
                }
                report.rounded_adds += 1;
                report.rounded_muls += 2;
                report.details.push_str(&format!(
                    "node={node} kind=mul_add_mul reads={:?} writes={} hardware=trusted\n",
                    kernel.reads, kernel.writes
                ));
                continue;
            }
            if let TranslationKind::MulAdd { multiply_on_right } = kernel.kind {
                let operands = if multiply_on_right {
                    "(float %z, float %product)"
                } else {
                    "(float %product, float %z)"
                };
                let required = [
                    "%ap = getelementptr float, ptr addrspace(1) %a, i32 %idx",
                    "%bp = getelementptr float, ptr addrspace(1) %b, i32 %idx",
                    "%biasp = getelementptr float, ptr addrspace(1) %bias, i32 %idx",
                    "%x = load float, ptr addrspace(1) %ap, align 4",
                    "%y = load float, ptr addrspace(1) %bp, align 4",
                    "%z = load float, ptr addrspace(1) %biasp, align 4",
                    "%product = call float asm sideeffect \"mul.rn.f32 $0, $1, $2;\", \"=f,f,f\"(float %x, float %y)",
                    "icmp ult i32 %idx, %length",
                    "store float %value, ptr addrspace(1) %op, align 4",
                ];
                let add = format!(
                    "%value = call float asm sideeffect \"add.rn.f32 $0, $1, $2;\", \"=f,f,f\"{operands}"
                );
                let mul_pos = ir.find(required[6]);
                let add_pos = ir.find(&add);
                if required.iter().any(|&value| !ir.contains(value))
                    || !matches!((mul_pos, add_pos), (Some(m), Some(a)) if m < a)
                    || ir.matches("call float asm sideeffect").count() != 2
                    || ir.matches("fcmp ").count() != 0
                    || !ir.contains("br i1 %valid, label %compute, label %done")
                {
                    return Err(invalid(format!(
                        "mul-add FP32 template mismatch at node {node}"
                    )));
                }
                audit_fp32_ptx(ir, asm).map_err(|e| invalid(format!("PTX node {node}: {e}")))?;
                // This branch returns early, before the generic PTX-order
                // check below. Enforce it here as well: counts alone do not
                // establish mul-before-add semantics.
                let sequence = asm
                    .lines()
                    .map(|line| line.split("//").next().unwrap_or(""))
                    .filter_map(|line| {
                        if line.contains("mul.rn.f32") {
                            Some("mul")
                        } else if line.contains("add.rn.f32") {
                            Some("add")
                        } else {
                            None
                        }
                    })
                    .collect::<Vec<_>>();
                if sequence != ["mul", "add"] {
                    return Err(invalid(format!(
                        "PTX MulAdd instruction order changed at node {node}"
                    )));
                }
                report.rounded_adds += 1;
                report.rounded_muls += 1;
                report.details.push_str(&format!(
                    "node={node} kind=mul_add reads={:?} writes={} rounding=mul.rn-then-add.rn operand_slot={} hardware=trusted\n",
                    kernel.reads, kernel.writes, usize::from(multiply_on_right)
                ));
                continue;
            }
            // A deliberately narrow DSL lowering. IEEE sub/div are RNE; exp
            // is opt-in approximate and never presented as strict FP32.
            if matches!(
                kernel.kind,
                TranslationKind::Sub
                    | TranslationKind::DivRne
                    | TranslationKind::ExpApprox
                    | TranslationKind::SqrtRne
            ) {
                let (instruction, bound_result, expected_asm) = match kernel.kind {
                    TranslationKind::Sub => (
                        "sub.rn.f32",
                        "%value = call float asm sideeffect \"sub.rn.f32 $0, $1, $2;\", \"=f,f,f\"(float %x, float %y)",
                        1,
                    ),
                    TranslationKind::DivRne => (
                        "div.rn.f32",
                        "%value = call float asm sideeffect \"div.rn.f32 $0, $1, $2;\", \"=f,f,f\"(float %x, float %y)",
                        1,
                    ),
                    TranslationKind::SqrtRne => (
                        "sqrt.rn.f32",
                        "%value = call float asm sideeffect \"sqrt.rn.f32 $0, $1;\", \"=f,f\"(float %x)",
                        1,
                    ),
                    TranslationKind::ExpApprox => (
                        "ex2.approx.f32",
                        "%value = call float asm sideeffect \"ex2.approx.f32 $0, $1;\", \"=f,f\"(float %scaled)",
                        2,
                    ),
                    _ => unreachable!(),
                };
                let fp32_scales = usize::from(matches!(kernel.kind, TranslationKind::ExpApprox));
                let correct_operands = if matches!(kernel.kind, TranslationKind::SqrtRne) {
                    !ir.contains("%bp = getelementptr")
                } else if matches!(kernel.kind, TranslationKind::ExpApprox) {
                    ir.contains(&format!("%scaled = call float asm sideeffect \"mul.rn.f32 $0, $1, $2;\", \"=f,f,f\"(float %x, float {LOG2_E_F32_LLVM})"))
                        && !ir.contains("%bp = getelementptr")
                } else {
                    ir.contains("%bp = getelementptr float, ptr addrspace(1) %b, i32 %idx")
                        && ir.contains("%y = load float, ptr addrspace(1) %bp")
                };
                if !ir.contains(bound_result)
                    || !ir.contains(instruction)
                    || !correct_operands
                    || !ir.contains("icmp ult i32 %idx, %length")
                    || !ir.contains("br i1 %valid, label %compute, label %done")
                    || !ir.contains("%ap = getelementptr float, ptr addrspace(1) %a, i32 %idx")
                    || !ir.contains("store float %value, ptr addrspace(1) %op, align 4")
                    || ir.matches("call float asm sideeffect").count() != expected_asm
                    || ir.matches("fcmp ").count() != 0
                {
                    return Err(invalid(format!(
                        "pointwise LLVM operands or FP32 policy changed at node {node}"
                    )));
                }
                audit_fp32_ptx(ir, asm)
                    .map_err(|err| invalid(format!("PTX node {node}: {err}")))?;
                report.rounded_muls += fp32_scales;
                report.details.push_str(&format!(
                    "node={node} kind={} reads={:?} writes={} numeric={} translation=template-checked hardware=trusted\n",
                    kernel.kind.name(), kernel.reads, kernel.writes,
                    if matches!(kernel.kind, TranslationKind::ExpApprox) {
                        "approx-ex2-not-certified"
                    } else { "RNE-instruction-not-proven" }
                ));
                continue;
            }
            let actual_add = ir.matches("call float asm sideeffect \"add.rn.f32").count();
            let actual_mul = ir.matches("call float asm sideeffect \"mul.rn.f32").count();
            let actual_relu = ir.matches("fcmp uno float").count();
            if (actual_add, actual_mul, actual_relu) != (add, mul, relu)
                || ir.matches("call float asm").count() != add + mul
                || ir.matches("fcmp ogt float").count() != relu
                || ir.matches("select i1 %").count() != relu
                || !ir.contains("icmp ult i32 %idx, %length")
                || !ir.contains("br i1 %valid, label %compute, label %done")
                || !ir.contains("store float ")
                || !ir.contains("ptr addrspace(1) %op, align 4")
                || !ir.contains("%ap = getelementptr float, ptr addrspace(1) %a")
                || !ir.contains("%x = load float, ptr addrspace(1) %ap")
            {
                return Err(invalid(format!(
                    "LLVM skeleton or FP32 semantics mismatch at node {node}"
                )));
            }
            if kernel.reads.len() >= 2
                && (!ir.contains("%bp = getelementptr float, ptr addrspace(1) %b")
                    || !ir.contains("%y = load float, ptr addrspace(1) %bp"))
            {
                return Err(invalid(format!("LLVM second input missing at node {node}")));
            }
            // Index-address obligations are checked against the known lowering
            // templates. This is a text-level check, NOT pointer/race safety
            // or translation to the physical SASS address calculations.
            let is_matmul = matches!(kernel.kind, TranslationKind::MatMul { .. });
            let lhs_index = if is_matmul { "%lhsIdx" } else { "%idx" };
            let lhs_address =
                format!("%ap = getelementptr float, ptr addrspace(1) %a, i32 {lhs_index}");
            if !ir.contains(&lhs_address) {
                return Err(invalid(format!("LLVM lhs address changed at node {node}")));
            }
            if kernel.reads.len() >= 2 {
                let rhs_index = if is_matmul {
                    "%rhsIdx"
                } else if matches!(
                    kernel.kind,
                    TranslationKind::BiasAdd { .. } | TranslationKind::BiasAddRelu { .. }
                ) {
                    "%col"
                } else {
                    "%idx"
                };
                let rhs_address =
                    format!("%bp = getelementptr float, ptr addrspace(1) %b, i32 {rhs_index}");
                if !ir.contains(&rhs_address) {
                    return Err(invalid(format!("LLVM rhs address changed at node {node}")));
                }
            }
            if kernel.reads.len() == 3
                && !ir.contains("%biasp = getelementptr float, ptr addrspace(1) %bias, i32 %col")
            {
                return Err(invalid(format!(
                    "LLVM broadcast source changed at node {node}"
                )));
            }
            let third = kernel.reads.len() == 3;
            if ir.contains("ptr addrspace(1) %bias,") != third
                || (third && !ir.contains("%bias_value = load float, ptr addrspace(1) %biasp"))
            {
                return Err(invalid(format!(
                    "LLVM kernel signature mismatch at node {node}"
                )));
            }
            let columns = kernel.kind.columns();
            if columns > 0 {
                let expected = format!("urem i32 %idx, {columns}");
                if !ir.contains(&expected) {
                    return Err(invalid(format!("broadcast column mismatch at node {node}")));
                }
            }
            if let TranslationKind::MatMul { inner, columns } = kernel.kind {
                let requirements = [
                    format!("icmp ult i32 %j, {inner}"),
                    format!("udiv i32 %idx, {columns}"),
                    format!("urem i32 %idx, {columns}"),
                    format!("mul i32 %row, {inner}"),
                    format!("mul i32 %j, {columns}"),
                    "phi float [ 0.000000e+00, %compute ], [ %updated, %body ]".into(),
                    "%product = call float asm sideeffect \"mul.rn.f32".into(),
                    "%updated = call float asm sideeffect \"add.rn.f32".into(),
                ];
                if requirements.iter().any(|needed| !ir.contains(needed)) {
                    return Err(invalid(format!(
                        "MatMul accumulation or addressing changed at node {node}"
                    )));
                }
            } else if matches!(
                kernel.kind,
                TranslationKind::AddBiasRelu { .. } | TranslationKind::MulBiasRelu { .. }
            ) {
                if !ir.contains("%inner = call float asm sideeffect")
                    || !ir.contains("%biased = call float asm sideeffect \"add.rn.f32")
                    || !ir.contains("%result = select i1 %keep")
                {
                    return Err(invalid(format!(
                        "fused three-operation chain changed at node {node}"
                    )));
                }
            } else if relu != 0
                && !(ir.contains("%fused_result = select i1 %keep_fused")
                    || ir.contains("%value = select i1 %keep"))
            {
                return Err(invalid(format!(
                    "ReLU branch semantics changed at node {node}"
                )));
            }
            // Each supported template has a fixed operand/result binding.
            // Opcode counts alone would allow an optimizer to use a different
            // source register while preserving the same totals.
            let required_binding = match kernel.kind {
                TranslationKind::Add
                | TranslationKind::BiasAdd { .. }
                | TranslationKind::AddRelu
                | TranslationKind::BiasAddRelu { .. } => Some(
                    "%value = call float asm sideeffect \"add.rn.f32 $0, $1, $2;\", \"=f,f,f\"(float %x, float %y)",
                ),
                TranslationKind::Mul | TranslationKind::MulRelu => Some(
                    "%value = call float asm sideeffect \"mul.rn.f32 $0, $1, $2;\", \"=f,f,f\"(float %x, float %y)",
                ),
                TranslationKind::Relu => {
                    Some("%value = select i1 %keep, float %x, float 0.000000e+00")
                }
                TranslationKind::Sub
                | TranslationKind::DivRne
                | TranslationKind::ExpApprox
                | TranslationKind::SqrtRne
                | TranslationKind::MatMul { .. }
                | TranslationKind::Transpose2D { .. }
                | TranslationKind::ReverseRows2D { .. }
                | TranslationKind::ReverseColumns2D { .. }
                | TranslationKind::ConcatAxis0 { .. }
                | TranslationKind::SliceLastRow { .. }
                | TranslationKind::BroadcastScalar
                | TranslationKind::ArgMaxLast { .. }
                | TranslationKind::TakeAxis0 { .. }
                | TranslationKind::AddBiasRelu { .. }
                | TranslationKind::MulBiasRelu { .. }
                // These fusion templates were validated above, with
                // explicit FP32 operand order and an early continue.
                // Keep this match exhaustive without weakening validation.
                | TranslationKind::BinaryChain { .. }
                | TranslationKind::SqrtAddDiv { .. }
                | TranslationKind::MulMulAddDiv { .. }
                | TranslationKind::MulDiamondAdd { .. }
                | TranslationKind::DualPointwise { .. }
                | TranslationKind::MulAdd { .. }
                | TranslationKind::MulAddMul { .. } => None,
            };
            if required_binding.is_some_and(|binding| !ir.contains(binding)) {
                return Err(invalid(format!(
                    "LLVM result operands changed at node {node}"
                )));
            }
            if add != 0 && mul != 0 {
                let mul_at = ir
                    .find("call float asm sideeffect \"mul.rn.f32")
                    .ok_or_else(|| invalid("missing rounded multiply"))?;
                let add_at = ir
                    .find("call float asm sideeffect \"add.rn.f32")
                    .ok_or_else(|| invalid("missing rounded add"))?;
                if mul_at > add_at {
                    return Err(invalid(format!(
                        "incorrect separate multiply/add order at node {node}"
                    )));
                }
            }
            // The existing strict PTX parser checks *all* FP32 opcodes and
            // exact round counts inside each entry. An instruction in a
            // different kernel can never satisfy this kernel's obligation.
            let llvm_expectation = format!(
                "{}{}",
                "call float asm sideeffect \"add.rn.f32\n".repeat(add),
                "call float asm sideeffect \"mul.rn.f32\n".repeat(mul)
            );
            audit_fp32_ptx(&llvm_expectation, asm)
                .map_err(|err| invalid(format!("PTX node {node}: {err}")))?;
            if add != 0 && mul != 0 {
                let operations = asm
                    .lines()
                    .map(|line| line.split("//").next().unwrap_or(""))
                    .filter_map(|line| {
                        if line.contains("mul.rn.f32") {
                            Some("mul")
                        } else if line.contains("add.rn.f32") {
                            Some("add")
                        } else {
                            None
                        }
                    })
                    .collect::<Vec<_>>();
                if operations != ["mul", "add"] {
                    return Err(invalid(format!(
                        "PTX separate mul/add order changed at node {node}"
                    )));
                }
            }
            report.rounded_adds += add;
            report.rounded_muls += mul;
            report.relu_guards += relu;
            let reads = kernel
                .reads
                .iter()
                .map(|(source, size)| format!("{source}:{size}"))
                .collect::<Vec<_>>()
                .join(",");
            report.details.push_str(&format!(
                "node={node} kind={} reads={reads} writes={} add.rn.f32={add} mul.rn.f32={mul} relu={relu} status=structural-pass\n",
                kernel.kind.name(), kernel.writes
            ));
        }
        // Reject unguarded instructions outside named kernels, too.
        audit_fp32_ptx(llvm, ptx).map_err(|err| invalid(format!("global PTX check: {err}")))?;
        Ok(report)
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn round_trip_and_fail_closed_on_unknown_schemas() {
        let plan = TranslationPlan {
            threads_per_block: 256,
            kernels: vec![TranslationKernel {
                node: 2,
                entry_node: 2,
                kind: TranslationKind::MulBiasRelu { columns: 1 },
                reads: vec![(0, 1), (1, 1), (1, 1)],
                writes: 1,
            }],
        };
        assert_eq!(TranslationPlan::from_text(&plan.to_text()).unwrap(), plan);

        let reverse = TranslationPlan {
            threads_per_block: 128,
            kernels: vec![TranslationKernel {
                node: 1,
                entry_node: 1,
                kind: TranslationKind::ReverseRows2D {
                    rows: 2,
                    columns: 3,
                },
                reads: vec![(0, 6)],
                writes: 6,
            }],
        };
        let reverse_text = reverse.to_text();
        assert!(reverse_text.contains("reverse_rows2d\t6\t0:6\t3\t2"));
        assert_eq!(TranslationPlan::from_text(&reverse_text).unwrap(), reverse);
        let legacy = reverse_text
            .replace("vn-translation-plan-v2", "vn-translation-plan-v1")
            .replace("kernel\t1\t1\t", "kernel\t1\t");
        assert_eq!(TranslationPlan::from_text(&legacy).unwrap(), reverse);

        for invalid_text in [
            plan.to_text()
                .replace("vn-translation-plan-v2", "vn-translation-plan-v0"),
            plan.to_text().replace("mul_bias_relu", "unknown"),
            plan.to_text().replace("threads=256", "threads=0"),
            plan.to_text().replace("0:1", "3:1"),
            plan.to_text().replace("\t1\t0\n", "\t0\t0\n"),
        ] {
            assert!(TranslationPlan::from_text(&invalid_text).is_err());
        }
    }
}

FILE	docs/verineural/AUTO_BUILD.md
# Автоматическая сборка VeriNeural: Rust IR → Lean → NVIDIA NVPTX

Первый библиотечный вертикальный срез: `ArchitectureAutoCompiler`. Пользователь определяет собственные `NeuralModule`, `MultiOutputModule`, `PrimitiveSpec` или `ParametricModule`, собирает `NeuralGraph`, перечисляет архитектурные выходы и **явные** математические цели. Готовые Transformer/RNN/LLM классы для этого не требуются.

## Публичный API

```rust
let compiler = ArchitectureAutoCompiler::default();
let tasks = vec![ArchitectureProofTask::Goal(ProofGoal {
    name: "root_property".into(),
    output: final_output,
    kind: ProofGoalKind::Nonnegative { assumptions: vec![] },
})];
let report = compiler.build(
    &graph,
    &[intermediate_output, final_output],
    &tasks,
    GpuRequirement::AllOutputs,
    std::path::Path::new("target/my-architecture"),
)?;
```

Для фиксированного рекуррентного горизонта: `ArchitectureProofTask::FixedScanNonnegative { name, scan }`. Программное создание `NeuralGraph` и объявление контрактов остаются на Rust, а не на отдельном несинхронизированном GPU/Lean DSL.

- `plan()`: повторно проверяет DAG-зависимости, арность, shape/domain контрактов, захваты через границы модуля и привязки output-портов; запрещает цели вне зависимостей выбранных выходов; генерирует одну Lean-модель для **всех выбранных выходов**, индивидуальные Lean-цели и GPU-планы для каждого выхода. Без вызовов Lean/LLVM или записи файлов. Ошибочная форма/порт и неподтверждаемая известными правилами цель отклоняются. Произвольное ложное равенство остаётся Lean-обязательством и отклоняется при `build`, а не объявляется доказанным при `plan`.
- `build()`: перезаписывает **только зарезервированный подкаталог `<root>/auto-build/`**, запускает Lean kernel и `#print axioms` для общего файла и каждой независимой цели, выполняет `GpuEngine::lower` и его проверку LLVM/PTX для каждого поддерживаемого выхода. `report.txt` появляется **только после успеха всех обязательных шагов**. При неуспехе прежняя успешная запись не сохраняется.
- `GpuRequirement::AllOutputs`: отсутствие GPU lowering **хотя бы одного** выбранного выхода даёт ошибку.
- `GpuRequirement::AllowUnsupported`: поддерживаемые выходы компилируются, неподдерживаемые явно маркируются `unsupported` без ложного PTX/certificate.
- В `report.txt`: входные гипотезы Lean, доказанные имена и число теорем для отдельных целей, транзитивные аксиомы каждого проверенного theorem, версия Lean, число структурно проверенных связей и портов, статусы PTX по выходам.

- `auto-build/semantic.ir` является канонической graph-only сериализацией `NeuralGraph::canonical_ir()`: узлы, операции, формы, домены, версии и интерфейсы модулей входят в неё; process-local graph ID, выбранные outputs, proof goals и GPU policy не входят. Выборы конкретной сборки связываются реконструируемым `AutoBuildPlan`, производными Lean/GPU/DOT артефактами и полным `SHA256SUMS`.
- Канонический формат имеет явную версию (`verineural-semantic-ir-v3`); dtype узлов и портов входит в canonical semantics. Bundle старого формата не мигрируется неявно: его нужно пересобрать из текущего Rust-графа, чтобы новый fingerprint, DOT и `SHA256SUMS` снова описывали одну сборку.
- По успешной сборке `auto-build/SHA256SUMS` охватывает `semantic.ir`, `architecture.dot`, `architecture.png`, каждый Lean исходник, `lean/audit.txt`, `report.txt`, все сохранённые `graph.ll`, `graph.ptx`, `translation.plan` и `translation.report`. `AutoBuildReport::manifest_sha256` возвращает хеш самого манифеста для внешнего закрепления; старые данные удаляются до сборки.
- `ArchitectureAutoCompiler::build` сохраняет полный детерминированный `architecture.dot` из того же `semantic.ir`, что участвует в Lean/NVPTX сборке. В DOT: все узлы и реальные зависимости (ровно одно ребро на IR-вход), вложенные кластеры обычных и многовыходных consumer-модулей, именованные входные/выходные порты, контракты/домены/shape/dtype, reachability и отдельные статусы математической проверки/GPU. DOT содержит `vn_ir_sha256`, равный SHA-256 сохранённого `semantic.ir`; Graphviz из Nix devShell сразу создаёт `architecture.png` из сохранённого DOT. Никаких relay-рёбер для портов, не требующих IR-связи, не добавляется.
- `ArchitectureAutoCompiler::verify_bundle(&graph, &outputs, &tasks, gpu_policy, root, pinned_sha256)` проверяет наличие **ровно ожидаемого набора** манифестных записей, содержимое файлов, каноническую связь с **текущим** Rust IR, байтовое совпадение DOT с повторной генерацией и PNG с повторным Graphviz-рендером, заново запускает Lean и аудит разрешённых аксиом, а также повторно проверяет сохранённый PTX против сформированного по текущему графу LLVM/translation plan. **CUDA драйвер не требуется**, но для воспроизведения PNG нужен Graphviz из devShell. `pinned_sha256: Some(...)` сравнивает digest с внешним эталоном; `None` означает replay без проверки происхождения.


Рабочий пример: `task auto-architecture` либо `cargo run -p verineural --example auto_architecture`. Повторная проверка без LLVM-компиляции и CUDA: `task verify-auto-architecture`; для проверки отдельно сохранённого эталона digest: `cargo run -p verineural --example auto_architecture -- --verify --pinned-sha256 <SHA256SUMS digest>`. Создаёт два пользовательских блока ReLU и модуль объединения `Add`, проверяет `Nonnegative` всей fork/fan-in композиции и компилирует три выбранных выхода в NVPTX.

## Многовыходный NVIDIA CUDA Graph

- `GpuEngine::compile_outputs(&graph, &[...])` собирает единый DAG зависимостей выбранных узлов. Один kernel принадлежит одному вычисляемому IR-узлу: общий producer исполняется один раз; `Reshape` остаётся zero-copy alias; источник, явно выданный как output, запрещено устранять через experimental fusion.
- `GpuProgram::outputs()`, `GpuProgram::kernel_count()` и `GpuExecution::read_outputs()` дают упорядоченный список всех результатов одного captured CUDA Graph. `GpuExecution::update_inputs` меняет общий входной набор без повторного захвата. Старые `compile`, `prepare`, `read_output`, `execute` работают через один выход и сохраняются.
- Если все выбранные архитектурные выходы поддерживаются и число выходов больше одного, `ArchitectureAutoCompiler` теперь в дополнение к совместимым `gpu_{i}` создаёт `gpu_shared/graph.ll`, `graph.ptx`, `translation.plan`, `translation.report`. Эти артефакты входят в `SHA256SUMS` и заново валидируются при `verify_bundle`. При `AllowUnsupported` и хотя бы одном неподдерживаемом выходе **общий GPU план не выпускается**, иначе возможно ложное заявление о поддержке всей архитектуры.
- `task gpu-multi-output` запускает consumer-пример с четырьмя выходами, объединённой Lean-моделью и двумя воспроизведениями **одного** CUDA Graph (два набора f32 входов), сверенными с независимыми точными fixtures. Команда требует NVIDIA CUDA GPU и Nix devShell, в отличие от offline `task verify-auto-architecture`.

Существование общего PTX и проверка конкретных GPU-результатов не доказывают LLVM/PTX/JIT/SASS или полное соответствие FP32 математической модели. Аудит Lean-аксиом остаётся независимым от CUDA-выполнения.

## Границы гарантии

**Lean proven** относится к идеальной `Int`-математике и исключительно к сформулированным свойствам для выбранного подграфа с явными предпосылками. **Связанность/типы модулей** повторно проверяются структурно на Rust IR; такая проверка не является доказательством соответствия GPU-программы Lean-модели. Проверка `TranslationPlan` обнаруживает известные несовместимости LLVM/PTX, но не доказывает битовую IEEE-754 или корректность PTX/SASS/железа. GPU-код *сгенерирован*, не *запущен*. Модели в которых есть неподдерживаемые операции, не получат GPU `proven`.

Пока нет глобального пользовательского языка произвольных математических предикатов, автоматического запуска общей CUDA Graph execution непосредственно из `ArchitectureAutoCompiler::build` и индукционного доказательства произвольного горизонта. Общий многовыходный API GPU и его отдельный CUDA-пример теперь существуют. DOT/PNG являются производными визуальными артефактами, не формальным доказательством LLVM/PTX/JIT. Манифест является защитой целостности и привязкой к актуальному графу, а не криптографической подписью издателя. `snapshot_architecture` и auto-build имеют разные presentation/build metadata, но используют одну canonical graph serialization и одну нормализованную модель иерархии module instances. Эти пункты остаются открытыми.

FILE	docs/verineural/ROADMAP.md
# VeriNeural: 10 крупных этапов реализации

**Назначение:** план реализации [целевой спецификации](SPEC.md). В отличие от SPEC.md, здесь этапы перечислены намеренно. Целевая спецификация охватывает **архитектурно-нейтральный конструктор** для собственных нейросетевых алгоритмов, в том числе альтернативных Transformer моделей языка; не стандартную LLM, её готовые блоки или инфраструктуру.

**Последовательность:** ядро конструктора на Rust и Semantic Neural IR → Lean/GPU → связанный отчёт → расширяемые операции и иерархические блоки → управляемая GPU-компиляция → FP32/композиционные доказательства → собственная крупная архитектура → certified build. Сначала реальные end-to-end результаты, затем глубина гарантий.

**Обязательные принципы:** KISS, DRY, Pragmatic Engineering, Risk-based Verification, Modular Verification, Architecture Neutrality и Hierarchical Composition. Предпочитать проверяемое узкое подмножество широкой декларативной поддержке.

**Вне обязательной области:** готовые Transformer, Attention/MHA/GQA, KV Cache, специализированные LLM-блоки, чат/API/serving, распределённая инфраструктура, деплой. Минимальный CUDA runtime для исполнения и проверки результатов остаётся необходимым. Dense/FFN на раннем этапе — **пример композиции общих операций**, а не переход к разработке фиксированной LLM.

## 1. Инициализация workspace и проектного контракта — РЕАЛИЗОВАН (локальная проверка не подтверждена)

**Работы:** Cargo workspace, импортируемый crate `verineural`, корневые `flake.nix` и `Taskfile.yml`, правила `AGENTS.md`, документация полной цели и план. Без реализации GPU, Lean или архитектуры.

**Готово, когда:** новый crate корректно подключён к workspace, пути единообразны, спецификация и правила сохранены. Локальную сборку выполняет пользователь; факт сборки не заявляется, пока пользователь её не провёл.

## 2. Rust Neural API и Semantic Neural IR — РЕАЛИЗОВАН (локальные проверки пройдены)

**Текущая реализация:** динамические проверяемые формы, владеющий данными `Tensor<T, Shape>`, операции Add/Mul/MatMul/ReLU/Sqrt/Reshape, символический DAG через Rust builder, структурные и доменные контракты `NeuralModule`, явная FP32 policy и метка отсутствующего GPU lowering. Входные домены пока задаются как предположения, которые необходимо проверять на конкретных данных. GPU, Lean и формальные численные доказательства принадлежат следующим этапам. Поддерживается ограниченный Rust DSL, не анализ произвольного Rust-кода.

**Работы:** `Tensor<T, Shape>`, `NeuralModule`, `NeuralGraph`, `MathContract`, `FP32Policy`; API чистых операций, проверка форм, граф и зависимости; три семантических слоя — Ideal, FP32, GPU. Поддерживаемое подмножество Rust/операций объявлено явно. Не плодить crates ради названий из спецификации.

**Готово, когда:** Rust-функция/модуль формирует валидный Semantic Neural IR с математическим контрактом и ошибками неверных форм/доменов, а архитектурные компоненты могут композиционно выстраиваться в граф.

## 3. Lean 4 Proof Engine: операции, контракты и композиция — БАЗОВЫЙ СРЕЗ ЛОКАЛЬНО ПРОВЕРЕН (включая форматирование)

**Текущая реализация:** Rust IR → генератор Lean 4 → запуск проверяющего Lean kernel, явные теоремы о формах, поэлементной идеальной целочисленной семантике и неотрицательности ReLU/Reshape, в том числе при композиции модулей. Исходные предположения о неотрицательности остаются гипотезами теорем; отсутствие Lean или любая ошибка/предупреждение приводят к отказу. На момент локальной проверки этапа 3 proof backend охватывал только Add/Mul/Relu/Reshape над Int; MatMul/BiasAdd позднее добавлены в коде этапа 6. Sqrt, FP32/IEEE-754, произвольная пользовательская математика и GPU-исполнение по-прежнему не доказаны. Этот результат не удостоверяет численное поведение Rust f32 или аппаратного GPU.

**Работы:** минимальные формальные определения тензоров, индексов, форм, элементарных операций и модулей; генерация Lean-моделей и proof obligations из Semantic Neural IR; библиотека проверенных лемм; связь `requires`/`ensures` между модулями. Запрет `sorry`/необоснованных аксиом.

**Готово, когда:** одна Rust-функция порождает теоремы и проверяемые Lean-доказательства вычислительных и композиционных инвариантов, а недоказанный контракт отклоняется.

## 4. GPU Compiler и CUDA Runtime: исполняемый вертикальный срез — ЛОКАЛЬНО ПОДТВЕРЖДЁН

**Текущая реализация:** Semantic Neural IR → LLVM NVPTX IR → `llc` → PTX → CUDA Driver API (`libcuda.so.1`). Поэлементные Add, Mul и ReLU выполняются отдельными kernels; Reshape переиспользует GPU-буфер. Реализованы проверки форм и входных доменов, выделение и освобождение памяти, синхронизация и сравнение с независимым CPU reference. В проверенном срезе этапа 4 MatMul/Sqrt отклонялись (MatMul и BiasAdd позднее добавлены в код этапа 6); код GPU и FP32 не доказаны Lean. Пользователь подтвердил GPU-прогон (6/6 значений FP32 совпали по битам), 17/17 Rust-тестов, Clippy без ошибок и Lean 25 обязательств.

**Работы:** GPU IR с памятью и потоками, LLVM IR → LLVM NVPTX → PTX, загрузка/запуск через CUDA Driver API, буферы, синхронизация, элементарные tensor kernels, связь с исходным графом.

**Готово, когда:** тот же модуль компилируется из Rust в PTX и локально исполняется на GPU с независимой численной проверкой. Этот этап ещё не означает формально доказанное аппаратное исполнение.

## 5. Сведение доказательств и исполнения, первичный сертификат — ЛОКАЛЬНО ПОДТВЕРЖДЁН

**Текущая реализация:** один Rust IR используется Lean и LLVM NVPTX/CUDA backend'ами; после проверки Lean и совпадения FP32 выходов по битам сохраняется JSON отчёт, исходный IR, Lean, LLVM IR, PTX, конкретные входы и результаты, SHA-256 манифест и внешний хеш для закрепления. Повторная команда проверяет целостность относительно манифеста и повторно запускает Lean. IEEE-754, PTX и машинное исполнение не доказаны; TCB и статусы обозначены явно. При ошибке отчёт удаляется. Пользователь подтвердил успешный локальный проход Stage 5 (Lean и CUDA, формирование и повторная проверка отчёта). Это не устраняет перечисленные границы доверия.

**Работы:** сертификаты по слоям mathematical, numerical, composition и compilation; привязка IR, Lean-теорем и GPU-артефактов хешами; отчёт о TCB, явная область входов, принцип fail-closed. Без недоказанных гарантий машинного кода.

**Готово, когда:** один пример проходит Rust → IR → Lean + PTX → запуск → проверяемый отчёт, различающий `proven`, `validated`, `trusted` и `unsupported`.

## 6. Расширяемые вычислительные примитивы и иерархический конструктор — БАЗОВЫЙ СРЕЗ ЛОКАЛЬНО ПОДТВЕРЖДЁН

**Текущая реализация:** Rust IR поддерживает row-major MatMul и BiasAdd ([M,N] + [N]) с CPU reference, Lean-моделью над идеальными `Int` и простыми CUDA kernels. Добавлены `Dense`, `ResidualAdd`, `ResidualFfn` как **демонстрации** `NeuralModule` и проверок контрактов, а также пример Rust → IR → Lean + PTX → NVIDIA GPU → отчёт. Это не заготовка обязательного Transformer/FFN-стека. Lean пока проверяет модель/формы и отдельные свойства, **не** корректность FP32/GPU lowering и **не** произвольные пользовательские глобальные теоремы.

**Работы:** универсальные строительные средства (тензорная арифметика, линейная алгебра, reshape/indexing/gather/scatter, редукции, сравнения, условные вычисления и пользовательская математика по мере потребности); интерфейс добавления операций с семантикой и контрактами; параметризованные повторно используемые блоки, вложенные подграфы, экспортированные порты и проверяемая связь между ними. Для циклов/состояния, если они нужны пользователю, определить явную семантику и безопасный поддерживаемый фрагмент. Каждый **новый поддерживаемый** оператор должен иметь GPU-lowering и Lean-модель либо честный статус `unsupported`.

**Новый P0 structural/indexing slice, ожидающий локальной проверки:** IR различает `DType::F32` и `DType::Index`; добавлены `permute`, `reverse_axis`, бинарный `concat` с variadic public facade, детерминированный `argmax` с policy `First` и `take`. Shape/dtype/domain validation выполняется до изменения графа, host reference задаёт row-major semantics и bounds checks, canonical IR v3 и DOT сохраняют dtype/axis/permutation/tie policy. Lean покрывает identity/rank-2 transpose permutation, reverse, concat, first-tie argmax и take; неподдерживаемые permutations и весь GPU/numeric lowering нового среза fail-closed. Это закрывает API-дыру, из-за которой routing consumer вынужден был представлять индекс как host integer и подсовывать производный rotated tensor как внешний параметр, но не объявляет GPU lowering уже выполненным.

**Готово, когда:** разработчик описывает нетиповой математический оператор/композицию на Rust, собирает из него несколько переиспользуемых блоков и крупный модуль; всё компилируется из одного IR в исполняемый PTX и Lean-модели, локальные нетривиальные контрактные цели проверяются, ошибки форм/предпосылок отклоняются. Не требуется набор Attention, MoE или KV Cache.

**Multi-output pointwise P0 (код добавлен, NVIDIA acceptance ожидается):** независимые выбранные выходы двух `Add/Mul` одинаковой формы могут исполняться одним CUDA Graph kernel при включённом pointwise fusion. Выходы остаются отдельными наблюдаемыми буферами и не удаляются из Semantic IR; memory contract перечисляет обе записи, translation validation проверяет два FP32 RNE opcode и две записи, capability audit запрещает зависимые, разделяемые и неподдерживаемые пути. На первом срезе поддерживаются только две независимые поэлементные F32 операции с четырьмя материальными источниками, а не произвольный multi-output DAG. NVIDIA побитовую проверку запускает `task verify-gpu-dual-pointwise-outputs`; она **не выполнена агентом**. Сквозная EMA4 диагностика выводит средние host-wall интервалы по H2D, replay, D2H, CE, AdamW, feedback validation/snapshot/D2D/sync и checkpoint. Эти интервалы включают синхронизацию и не равны CUDA-event kernel timings; ускорение обучения без повторных реальных измерений не заявляется.

**P0/P1 runtime-патч, NVIDIA-приёмка и измерение ожидаются:** правило dual-output Add/Mul теперь допускает downstream fanout, только если все реальные потребители раннего выхода расположены строго после более позднего fused root. В обоих случаях сохраняются отдельные writable buffers и отдельные RNE операции; потребитель между корнями блокирует преобразование. Это ограниченный локальный pass, **не** произвольный region fusion. Эталонная GPU-побитовая проверка дополнительно читает downstream output. `task benchmark-gpu-adamw` теперь выводит накопленный `training_profile_avg_ms` и CUDA-event `fused_cuda_graph_event_average_ms` для обеих веток, разделяя стоимость replay и feedback.

## 7. Управляемый NVIDIA GPU Backend и доказательства преобразований — GRAPH REUSE / CHAIN FUSION / МАСШТАБНЫЙ BENCH ЛОКАЛЬНО ПОДТВЕРЖДЕНЫ; ОПТИМИЗАЦИЯ RUNTIME В КОДЕ

**Подтверждённый срез:** CUDA Graph-only на явном non-blocking stream; подготовленный `CUgraphExec`, многократный replay и обновление входных тензоров без изменения GPU-графа; конфигурируемая сетка 64/128/256/512 threads/block и experimental chain fusion `Add/Mul → BiasAdd → Relu`, сокращающий три kernels до одного при эксклюзивных зависимостях. Пользователь локально подтвердил fmt/check/test/clippy, Lean, CUDA, SHA-256, побитовую валидацию CPU/GPU, benchmark на 1K/16K/256K/1M и отказ неверных входных данных. На 1M элементов без профилирования медиана CUDA-event replay составила 28.884 мкс baseline и 14.629 мкс fused (≈1.97× быстрее); на малых массивах эффект невелик и результаты шумные. При Nsight Systems `--cuda-graph-trace=node` график replay существенно меняется из-за overhead профилировщика. Отдельные kernels агрегированы под именами `vn_node_3/4/5`, поэтому суммарная сводка без разбивки по размеру не доказывает конкретную скорость fused kernel на каждом размере.

**Новый срез, ожидающий локальной проверки:** каждый `CudaSession` теперь удерживает один reference на device primary CUDA context (`cuDevicePrimaryCtxRetain/Release`) вместо создания и разрушения private `CUcontext` для каждого `GpuExecution`. NVIDIA primary context разделяется между сессиями на том же GPU, а stream/module/graph/allocations остаются уникальными. Система по-прежнему использует `cuCtxPushCurrent_v2`/`cuCtxPopCurrent_v2` и не передаёт операции в legacy/default stream. Отдельный пул pinned staging буферов рециклирует host allocations **только после stream synchronization**, сохраняя их живыми при async H2D/D2H копировании. Дополнительные результаты `task gpu-stage7-bench` сравнивают затраты `GpuEngine::prepare` (включая llc/JIT/allocations/graph capture), CUDA-event replay и wall-clock полного обновления данных H2D→replay→D2H. Ожидаемое преимущество этих оптимизаций — снижение накладных расходов подготовки и циклических трансферов, **не** ускорение отдельных вычислительных kernels.

**Обязательное ограничение:** CUDA Graph-only и явный `CU_STREAM_NON_BLOCKING`, никаких CUDA Legacy/NULL/default streams, kernel launch вне Graph или fallback. Оптимизация fusion остается экспериментальной; Lean-леммы фиксируют только идеальную `Int`-математику. Сравнение `f32` по битам не доказывает IEEE-754 и PTX; GPU driver/JIT/оборудование и компиляция LLVM остаются доверенной границей.

**Новый срез проверки индексов и буферов (локальная проверка ожидается):** Rust компилятор порождает для каждого выбранного kernel memory contract с реальными входными диапазонами и выходной длиной; валидирует соответствие тензорным формам, topology DAG, отсутствие недопустимого переполнения CUDA grid. Перед графовым capture runtime дополнительно сверяет все read/write spans с выделенными device allocations, запрещает in-place output и общие writable output buffers. Lean 4 универсально доказывает границы pointwise, modulo-bias и двух row-major MatMul-адресов при активном output lane и корректном j. Из реально скомпилированных baseline/fused graph порождаются *отдельные* `memory_baseline.lean` и `memory_fused.lean` с конкретными параметрами; оба проверяются Lean, входят в Stage 7 SHA-256 manifest и повторно проверяются без GPU. Это **арифметические доказательства индексации при предпосылках**, а не доказательство корректности LLVM/PTX адресов, реальной памяти CUDA, race freedom или IEEE-754.\n\n**Оставшаяся работа этапа 7:** доказательства/translation validation для IR → GPU IR → LLVM IR → PTX, инварианты адресации/памяти/гонок и синхронизации, допустимость каждого преобразования в заявленной семантике; расширение универсального scheduling/tiling/fusion там, где полезно и подтверждено измерениями. Stage 8 по формальной FP32-композиции не объявлен выполненным и не подменяет незакрытые обязательства Stage 7.

**Готово, когда:** один нестандартный составной блок работает только через CUDA Graph без CUDA Legacy Stream, имеет несколько контролируемых вариантов GPU lowering, измеряемое исполнение и проверяемые свидетельства корректности **каждого разрешённого** преобразования в поддерживаемой семантике. Непроверенные преобразования отклоняются в certified-режиме; GPU драйвер/JIT/аппаратура честно остаются в TCB, где их поведение не доказано.

## 8. FP32 Verification Engine и численно осведомлённая композиция — ARCHITECTURE COMPOSITION ПОДТВЕРЖДЕНА

**Подтверждённый целочисленный срез:** на коммите `4414613` пользователь локально подтвердил 49/49 Rust-тестов, fmt/check/clippy, Lean-доказательства диапазонов, baseline/fused CUDA Graph для аддитивного графа (6/6 + 6/6 совпадений), baseline/fused MatMul-графа (4/4 + 4/4), SHA-256 и повторную Lean-проверку без GPU. Всего 20/20 значений побитово совпали с независимым `i64`-эталоном. `ExactFp32Plan` покрывает `Input/Add/Mul/MatMul/BiasAdd/Relu/Reshape`; `compile_with_input_bound` доказывает консервативные границы произведений и всех left-to-right частичных сумм MatMul внутри `[-2^24,2^24]`. Подтверждённые итоговые bounds: `3 145 728` для аддитивной цепочки при входах `±2^20` и `1 544` для `MatMul → Mul → BiasAdd → Relu` при входах `±8`. Манифест подтверждённого прогона: `66978a69a62d8ca0e642c25b30daa067024d3ec74546e0ee5e40af67777c2040`. Это остаётся доказательством идеальной `Int`-модели плюс численной проверкой конкретного GPU-запуска, а не доказательством IEEE-754/LLVM/PTX.

**Подтверждённый дробный RNE/ε срез:** additive профиль был подтверждён на `2930a4f`, а fractional `Mul/MatMul` после formatting-коммита `6806fe2` также прошёл `cargo check`, 54 Rust-теста, Clippy, `task numeric-stage8` и offline `task verify-numeric-stage8`. Baseline/fused fractional MatMul совпал с separate-mul/add integer RNE oracle; q20→q40 trace имеет observed error 2 ticks и conservative `ε=41 943 040` ticks. Актуальный подтверждённый manifest: `87f3d550c94aee99e5733626eb888f8c449a319af7f762a1ac84c8d450396746`. LLVM/PTX/JIT/GPU соответствие формальной модели всё ещё остаётся TCB.

**Подтверждённый range/module slice:** на `27db27b` прошли fmt, 56 Rust-тестов, `task numeric-stage8` и offline `task verify-numeric-stage8`; 32-файловый manifest SHA-256: `725e652961cb14a65b2b0d22578fadfad18aff71fb705356c147ef426f44588e`. `RneRangePlan` принимает source dyadic scale и interval bound, затем консервативно выводит per-node `ideal_bound`, `epsilon`, `actual_bound=ideal_bound+epsilon` и output scale для `Input/Add/Mul/MatMul/BiasAdd/Relu/Reshape`. Worst-case RNE step вычисляется из максимального pre-round magnitude. Lean `ApproxContract`, `binary32_rne_shift_le_of_bound`, `binary32_rne_within_maxStep`, `approx_contract_scale/add_rne/mul_rne/relu` являются reusable theorem rules с произвольными Int-значениями. Генерируемый `numeric_range.lean` инстанцирует их bounds каждого reachable node. `RneRangePlan::module_contracts()` экспортирует boundary summary; контрольный `ResidualFfn(1,2,2)` при q=10 и source bound 16 получает q_out=30, ideal bound 34 095 104 ticks и `ε=170` ticks. `numeric_range.lean` и `range_contract.txt` входят в Stage 8 manifest.

**Подтверждённый whole-module slice:** после formatting-коммита `489f5eb` пользователь подтвердил check/test/clippy, Stage 5 cert/verify, 57 Rust-тестов, `task numeric-stage8` и offline verify. Lean принял `module_0_global_contract` полного `ResidualFfn(1,2,2)`; undeclared graph capture regression также прошёл. Stage 8 manifest этого прогона: `0fdf33efe2bc38014016d5777b35590753622cd3d32b51c74a0405b24bb60896`.

**Подтверждённый architecture-composition slice:** после formatting-коммита `a942802` пользователь подтвердил `cargo check`, 58 Rust-тестов (31 unit + 10 Stage 7 + 17 Stage 8), Clippy, `task numeric-stage8` и offline `task verify-numeric-stage8`. Lean принял `architecture_global_contract`, который для совместимой линейной цепочки `ModuleInvocation` вызывает уже доказанные whole-module теоремы и передаёт их output `ApproxContract` дальше по архитектуре. Контрольный граф из двух последовательных `ResidualFfn(1,2,2)` при q10/source bound 16 дал q50, ideal bound 53 928 163 016 704 ticks и `ε=184 963 072` ticks. `numeric_architecture.lean` и `architecture_contract.txt` входят в 34-файловый evidence bundle; manifest SHA-256: `134c321f0af061ab3fe5165ad3f5beec5ebf8e6e9f0bd79f8ca38b389f46d9d6`.

**Подтверждённый DAG/nested slice:** после formatting-коммита `8a6fe41` пользователь подтвердил `cargo check`, 60 Rust-тестов (31 unit + 10 Stage 7 + 19 Stage 8), Clippy, полный `task numeric-stage8` и offline `task verify-numeric-stage8`. Lean принял fork/fan-in `architecture_global_contract` и nested whole-module reuse. Контрольный граф `ResidualFfn_A(X) + ResidualFfn_B(X)` через `ResidualAdd` дал q30, ideal bound 68 190 208 ticks и `ε=348` ticks; `NestedResidualPair` сохранил q50 / 53 928 163 016 704 / ε=184 963 072. Подтверждённый 38-файловый manifest SHA-256: `916e64b60599d1bc1aa95d315d57a96fb733a1708b58307973dbc6bb285fa384`.

**Подтверждённый deep-nesting slice:** после formatting-коммита `41e6c37` пользователь подтвердил `cargo check`, 61 Rust-тест (31 unit + 10 Stage 7 + 20 Stage 8), Clippy, `task numeric-stage8` и offline verify. Lean принял `numeric_nested_deep.lean`; depth=3 `DeepNestedWrapper → NestedResidualPair → ResidualFfn` сохранил q50 / 53 928 163 016 704 / ε=184 963 072. Подтверждённый 40-файловый manifest SHA-256: `c244df753c4a3cbffa3e00830c33d057c94b0ed9285539ab6f9591c5c2809121`.

**Подтверждённый global-property slice:** после formatting-коммита `c3927a4` пользователь подтвердил 63 Rust-теста (33 unit + 10 Stage 7 + 20 Stage 8), fmt/check/clippy, `task numeric-stage8` и offline verify. Lean принял `architecture_global_nonnegative` для Add/Mul fork/fan-in DAG с тремя явными nonnegative source assumptions; отсутствие обязательной гипотезы отклоняется. Подтверждённый 42-файловый manifest SHA-256: `e41a973676c30f2614a30abf99db767bdf1b9aa456a38d33f5e03e031b8077ae`.

**Подтверждённый nested-global-property slice:** на formatting-коммите `6112ed8` пользователь подтвердил 65 Rust-тестов (35 unit + 10 Stage 7 + 20 Stage 8) и полный Stage 8 Lean/GPU/evidence прогон, manifest `5a5a049e7252daf83dca11603b07389dd748bad21ae066c68954bd8133d76880`; после исправления `44693a6` fmt/check/test/Clippy/offline verify снова прошли. Lean доказал depth=3 `architecture_global_nonnegative` через direct child modules без скрытых dependencies.

**Подтверждённый MatMul/BiasAdd global-property slice:** после formatting-коммита `ae24512` и Lean zero-base fix `eaf701e` пользователь подтвердил 67 Rust-тестов (37 unit + 10 Stage 7 + 20 Stage 8), fmt/check/clippy, `task numeric-stage8` с GPU и 12 Lean-файлами, а также offline `task verify-numeric-stage8`. Reusable ideal-Int леммы `flatGet_nonnegative`, `matmul_nonnegative` (каждая left-to-right частичная сумма) и `biasAdd_nonnegative` (broadcast через `i % n`) приняты Lean. Модульный `architecture_global_nonnegative` доказан для `MatMul(2×3,3×2) → BiasAdd(2×2,2)`; недостающая bias-hypothesis отклоняется. Подтверждённый 46-файловый SHA-256 manifest: `ad5f0aa1927ce9765cf9980e49f072b80e82e1231aaaa82820c0b9100f02d4ff`. Обязательства машинного LLVM/PTX/GPU correspondence остаются TCB.

**Threshold-margin slice (локально подтверждён после Lean fix `2a6531e`):** Rust `RneRangePlan::classify_relu_input` декодирует синтетическое/наблюдаемое pre-ReLU binary32 на dyadic lattice узла и выводит интервал идеального аргумента `[actual−ε, actual+ε]` только при предпосылке `ApproxContract`. При `actual−ε>0` ветвь `Positive`; при `actual+ε≤0` ветвь `NonPositive`; иначе `Indeterminate`. Прочие узлы, недостижимые ReLU, off-lattice, subnormal, -0, NaN/Inf и выход за actual bound fail-closed.

Lean `approx_contract_relu_positive_branch` / `approx_contract_relu_nonpositive_branch` дают общие условные доказательства; `RneRangePlan::lean_source()` порождает специализированные правила для каждого ReLU. `numeric_threshold.lean` дополнительно предъявляет два допустимых идеальных аргумента разных знаков для одной неопределённой точки. `threshold_certificates.txt` явно указывает на синтетические pre-activation observations, доказательные гипотезы и доверенный LLVM/PTX/GPU слой. Пользователь подтвердил полный `task numeric-stage8` с восемью успешными baseline/fused GPU-профилями и Lean, затем offline `task verify-numeric-stage8`: 13 Lean-файлов и 48 файлов SHA-256 bundle приняты. Внешне закреплённый SHA-256 manifest: `60355e39deceac555771e31a3c79924d3e361f14060dea7d958608a41261229f`. В этом логе нет повторного полного `task test`; machine FP32, LLVM/PTX/JIT/GPU correspondence не доказаны.

**FP32 FMA/contraction audit slice (локально подтверждён после `83ecaec`):** для поддерживаемых CUDA Graph kernels Add/Mul/MatMul/BiasAdd и guarded fused chains LLVM генерирует side-effecting `add.rn.f32`/`mul.rn.f32` inline PTX, а отдельный аудитор проверяет итоговый PTX после `llc`. Отказ происходит при FP32 `fma/mad`, FTZ, неявном округлении, неразрешённых FP32 arithmetic opcode либо несовпадении ожидаемого количества инструкций. Поскольку исходное LLVM IR и PTX являются входами текстового аудитора, он не доказывает их полную семантическую эквивалентность и не покрывает SASS/JIT. Stage 8 запускает baseline/fused FMA-discriminating `Mul → BiasAdd → ReLU` fixture с независимым сравнением `f32::mul_add` и отдельного округления. Обе пары LLVM/PTX, входные/выходные биты и статический отчет добавлены в SHA-256 evidence; offline verify перепроверяет сохранённый PTX. Пользователь подтвердил Cargo check, 71 Rust-тест, Clippy, FMA-специфичные baseline/fused GPU fixtures, 13 Lean-файлов и offline SHA-256 verify 55 артефактов. Подтверждённый manifest: `4b511265597e8f66f7de3ef2bd7f245e90a5c05c01dbdd9f655269dd57cae652`.

**Gradual-underflow/FTZ subnormal boundary slice (локально подтверждён после `d6011bb`):** отдельный `subnormal_mul_rne_bits` читает IEEE754 significand/exponent из 32-битного представления без host float arithmetic, вычисляет точное tiny произведение в `u128` и округляет к `2^-149` lattice методом RNE, отказываясь при выходе из поддержанного subnormal/min-normal диапазона. `subnormal_add_exact_bits` допускает только точные операции в том же диапазоне и `subnormal_relu_bits` отсекает отрицательный аргумент в +0. Не расширяет `RneFp32Plan` и `ApproxContract`: они пока не доказывают IEEE underflow. Baseline/fused CUDA Graph проверяют 8 битовых FTZ/DAZ/tie-even/midpoint/sign/min-normal случаев и pin input/output/evidence bytes. Отдельная `numeric_subnormal.lean` доказывает частные half-tick свойства и несовпадение gradual underflow с FTZ для целочисленной модели. Подтверждены 73/73 Rust-теста, check/Clippy, baseline/fused 8/8 gradual-underflow значений, Lean 14 файлов и SHA-256 offline verify 63 артефактов. Подтверждённый manifest: `4af0ead91a2c210f1dff6c19399beba42e2e189eda8fe3305f06e5e1ca65dce1`. Общая FP32-семантика, JIT/SASS и полнота PTX аудита остаются открытыми.

**Exceptional-FP32 finite/special-value slice (локально подтверждён после Lean fix `c6b8d40`):** добавлен ограниченный независимый binary32 bit-oracle `special_mul_bias_relu_boundary` для конкретных NaN/Infinity/signed-zero, min-subnormal identity и maxFinite×2 overflow; неподдерживаемые случаи и signaling NaN явно отвергаются. При qNaN проверяется только quiet-NaN-класс, не payload/sign; для остальных выходов требуется точное совпадение битов. Два CUDA Graph профиля `baseline_special/fused_special` проверяют 13 строк на одном DAG `Mul→BiasAdd→ReLU`; snapshot обеих ветвей, входы, LLVM/PTX и отчёт об expected/observed входят в SHA-256, offline verify выполняет тот же проверяющий bit-oracle без GPU. Отдельный Lean `numeric_special.lean` показывает классификационные факты о конкретных кодировках binary32, без теорем о машинной арифметике. Пользователь подтвердил `task numeric-stage8` (14/14 GPU-профилей, включая по 13/13 special FP32 values в baseline/fused, все 15 Lean-файлов), затем `task verify-numeric-stage8` подтвердил сохранённый 72-файловый bundle. Актуальный SHA-256 manifest: `431dc70b2eadb5147b94c82b0567dd91f3680eb9c80cdda01bed1d5f9d7fe727`. В этом логе не представлен повторный полный `task test` на финальном HEAD; результат 75/75 Rust-тестов не подтверждается. LLVM/PTX/SASS/JIT, signaling NaN, произвольные overflow и полный IEEE-754 закрыты не были.

**Numeric Translation Validation: крупный срез локально подтверждён на `c63cd1f`, кроме Clippy.** Из Semantic Neural IR, guarded fusion и `GpuMemoryContract` строится `TranslationPlan` с ordered kernel roots, входами, shapes, broadcast и MatMul reduction; `GpuEngine::lower` выполняет структурную проверку LLVM/PTX до CUDA JIT, с fail-closed при нарушении RNE/FMA/FTZ, адресных шаблонов, ReLU guard или биекции entry points. Все 14 Stage 8 baseline/fused GPU-профилей прошли; каждый сохранил SHA-pinned `translation.plan`/`translation.report`, общий `translation_summary.txt` перепроверен командой `task verify-numeric-stage8`. Пользователь подтвердил `task fmt-check` (коммит `c63cd1f`), `task check`, **80/80 Rust-тестов**, CUDA+Lean, **101 evidence-файл** и успешный offline verify; manifest SHA-256 `7f4d473333b7360a5fbc75496b7bdbabc441c007fd862d29190719ddf03afa54`. `task clippy` на `c63cd1f` остановился на единственном `collapsible_if` в `translation.rs`; изменение синтаксиса подготовлено отдельно и его повторный локальный результат ещё ожидается. Проверка ограничена известными LLVM/PTX-шаблонами и не является доказательством полной семантической эквивалентности LLVM, PTX, JIT, SASS либо железа. Assurances: Lean ideal/dyadic conditional; per-kernel structural validation; concrete GPU oracle; JIT/SASS=TCB.

**Оставшиеся обязательства этапа 8:** моделировать устойчивость пороговых/условных вычислений с явными error margins; расширять содержательные invariants на другие операции по мере формализации; расширить диапазонную модель за текущие `i64`/60-bit ограничения там, где это нужно; формализовать FMA/contract, FTZ/subnormal, NaN/Infinity, signed zero, overflow и условные ветви; привязать численные теоремы к конкретным LLVM/PTX/JIT режимам либо честно оставить соответствующую часть в TCB. Предыдущий Stage 7 сохраняет незакрытые memory/race/translation-validation обязательства.

**Работы:** формальная семантика IEEE 754 binary32 (rounding, FMA, FTZ/subnormal, NaN/Infinity/signed zero, порядок вычислений/редукций), Exact FP32 или доказанные границы Numerical Error. Применять численные контракты к **любой** пользовательской функции, её вложенным блокам и их глобальной композиции; для условных решений учитывать пороги стабильности/переходы между ветвями. Никакие конкретные LLM-функции не обязательны для покрытия базовой арифметики.

**Готово, когда:** для поддерживаемого нестандартного составного вычисления Lean доказывает конкретную FP32-гарантию с областью входов и ε либо точное поведение, а межблочная композиция математически выводит применимый итоговый численный контракт; одного совпадения GPU и CPU недостаточно.

## 9. Собственная крупная архитектура, состояние и глобальные доказательства

**Работы:** Rust-проект-потребитель строит **новую архитектуру без шаблона Transformer** из иерархических проверяемых блоков. Стандартная организация нескольких исследований в одном workspace: `labs/<architecture-name>-<version>/`, где каждая лаборатория является отдельным Rust consumer package VeriNeural и владеет собственным artifact root. Предоставить средства для параметров и зависимостей, повторного использования блоков и, если требуется по выбранному примеру, состояния/переходов с явными инвариантами. Проверять зависимость сертификата от фактических значений или контрактов параметров. Сгенерировать не только отдельные теоремы для узлов, но и **содержательную теорему о заявленном свойстве всей композиции**. Добавить канонический экспорт полного Semantic Neural IR в один детерминированный Graphviz `architecture.dot`: nested module clusters без сокрытия внутренних узлов, stable instance paths, все tensor/parameter/state/control edges, shapes/dtypes/ports, domains, numerical contracts, proof/obligation statuses и GPU/lowering metadata. DOT должен быть самодостаточным для архитектурного анализа человеком или ИИ-агентом и содержать fingerprint исходного IR. После записи DOT pinned Graphviz из `flake.nix` обязан автоматически выполнить эквивалент `dot -Tpng architecture.dot -o architecture.png`; PNG выпускается вместе с DOT и `architecture.lean`, но остаётся производным визуальным артефактом. Пользовательские функции обновления параметров могут быть выражены общими вычислительными операциями; готовый Backward/optimizer для типовой LLM не требуется.

**Готово, когда:** как минимум одна нетиповая архитектура, состоящая из нескольких вложенных уровней блоков с собственными контрактами, компилируется в NVIDIA PTX, исполняется и проходит Lean-проверку локальных и **глобальной** теоремы. Для той же архитектуры автоматически создаётся один полный `architecture.dot`, по которому без обращения к другим файлам видны topology, hierarchy, shapes, component instances, parameter/state dependencies и статусы численных/формальных/GPU свойств; его IR fingerprint соответствует сертифицируемому Semantic Neural IR. Рядом автоматически создаётся `architecture.png` из этого DOT, а `architecture.lean` остаётся формальным sibling-артефактом в корне той же лаборатории/artifact root. Изменение параметров корректно проверяется на применимость гарантии. Не нужно демонстрировать Transformer, KV Cache, качество генерации текста или сервис инференса.

**Stage 9 первая крупная реализация (новая, локально не проверена):** самостоятельный Cargo workspace consumer `labs/coupled-field-0.1.0/` с глубиной 3 (`CoupledField → CoupledUnit → BoundaryCell`), 7 модулями, общими параметрами и парным fork/fan-in, без готовой LLM. Lean генерирует отдельную `architecture_global_nonnegative` для всего вложенного графа при явных исходных nonnegative гипотезах; GPU baseline/fused CUDA Graph сравниваются с независимым checked `i64`-oracle (`[4,10,8,12]`). Общий `snapshot_architecture` экспортирует детерминированный полный Semantic IR и самоописательный `architecture.dot` с module clusters, instance paths, shapes/domains/contracts, параметрами, provenance, input edges, GPU lowering metadata и SHA-256 fingerprint исходного IR; pinned Graphviz генерирует рядом `architecture.png`. Все 17 evidence-файлов, включая sibling `architecture.lean`, PNG, PTX/LLVM/translation и parameters.bits, включаются в SHA-256 manifest выбранного artifact root (по умолчанию lab package root). `--verify` без CUDA проверяет актуальность Rust IR/DOT, Lean и сохранённых GPU evidence; несовместимая id/version блокирует перезапись. Новый Rust API входит в reusable `verineural`, lab остаётся consumer. Выпуск новой лаборатории **не проверен** командами Cargo, Lean, Graphviz или CUDA; full Stage9 требования state/control/parameters proof/update, универсальный exporter и формальная GPU machine equivalence не объявлены закрытыми. Две новые Taskfile-команды `lab-stage9` и `verify-lab-stage9` локально выполняет пользователь. Stage10 `cargo verineural build --certified` намеренно не добавлен.


**P1 после review (исходный код, выполнение ещё не подтверждено):** экспорт DOT v3/auto-v3 больше не фиксирует все входы на одном ранге, различает ослабленные layout-ограничения для параметров и добавляет явные source/destination/module-port атрибуты рёбер. `ArchitectureSnapshot::verify` и auto-build используют одинаковое повторное рендеринг-сравнение PNG с сохранённым DOT. В `CoupledField` добавлена независимая `composition.lean` цель: первый результат ветви не превосходит итоговый `ReLU(Add(left, right))`, поскольку `right` имеет доказанную ReLU-неотрицательность; она не выводится исключительно из свойства последнего ReLU. Для новой сборки требуется 18 файлов в Stage 9 manifest. В репозитории пока остаются ранее сохранённые лабораторные DOT/PNG/manifest, созданные старой версией экспортёра: они должны быть **перегенерированы из Rust через `task lab-stage9` и `task lab-xor` в pinned devShell**, затем проверены offline и закоммичены только после успешного выполнения. Не считать старый bundle сертифицированным текущим генератором и не подменять новое GPU/Lean evidence ручным хешированием. Регрессионные Rust/Lean тесты и лабораторные CUDA прогоны должны быть подтверждены пользователем перед отметкой реализации как проверенной.



**P2 / VN-P13–VN-P14 (исходники подготовлены, локальная приёмка ожидается):** библиотечный `NeuralGraph::component("path")` вводит лёгкий путь для вызовов существующих модулей с позиционными или именованными портами, контекстными `BindingError` и атомарным rollback. `ProofGoal::nonnegative/bounded_above/generate_source/certify` позволяют объявить проверяемые цели без ручной сборки Lean-файла; `ObligationError` сообщает имя неподтверждённой теоремы, но не превращает генерацию исходника в proof. Независимый workspace consumer `labs/consumer-acceptance-0.1.0/` содержит три непохожих сценария: вложенный fork/fan-in DAG; двухшаговый state-transition со строгим invariant claim; tensor-heavy композицию matmul + пользовательский `PointwiseSpec` + mask/select + axis reduction (это **не** готовый Attention и не softmax). Для каждого сценария предусмотрены позитивные/негативные проверки, стабильный Semantic IR, явные theorem ids и GPU capability statuses. Собственная pointwise-операция в этой лаборатории не требует правок core, но остаётся **GPU unsupported** и не получает фиктивной FP32/SASS гарантии. Команды `task p2-consumers`, `task verify-p2-consumers` зависят от `prepare` (Rust autoformat). Наличие исходников **не является** доказательством прохождения тестов: для завершения P2 требуется локальное выполнение обеих задач, `task check`, `task clippy`, а также проверка, что ошибочные Lean-цели действительно отвергнуты.


**P2 frontend (исходники; локальная приёмка ожидается):** добавлены именованный `ModelBuilder`, атомарный `compose_inferred`, вывод структурных контрактов, привязка Tensor по имени с валидацией, выходы и независимые ProofGoal через `ArchitectureAutoCompiler::plan`. Четыре регрессионных теста покрывают рабочий блок, скрытый capture/rollback, незарегистрированные источники и некорректные binding. Пользователь локально подтвердил `task check`, `task test`, `task clippy` на `e829ff9` (151 Rust-тест пройден, 4 проигнорированы); это не Lean/GPU-сертификация. Для завершения выполнить локально `task check`, `task test`, `task clippy`. Параметры пока остаются IR input с метаданными роли, state/update и доказательство GPU hardware не реализованы.

**P2 consumer migration (исходники; новая локальная приёмка ожидается):** лаборатория XOR использует публичные ModelBuilder input/parameter/block/output/proof_goal и Model::bind/metadata/plan; consumer-специфичный 2→2→1 граф, четыре вложенных модуля и независимая Boolean XOR проверка остаются внутри lab/src/lib.rs. Убраны ручные MathContract, NeuralModule и input_roles, сохранён end-to-end sibling artifact workflow через исходный Semantic IR, Lean и CUDA Graph. Автоматическое доказательство всех именованных целей не следует из model planning: example как прежде kernel-check'ит только architecture_global_nonnegative, а proof_goal генерируется и проверяется на пригодность в Rust-тесте. Изменённый канонический IR делает прежние DOT/PNG/Lean/PTX/manifest устаревшими. Для нового среза выполнить task check, task test, task clippy, task test-lab-xor, task lab-xor, task verify-lab-xor; артефакты перегенерировать и проверить только из исходников, а не редактировать hashes вручную.

**P2 CoupledField migration (исходники; локальная проверка ожидается):** лаборатория Stage 9 объявляет три входа и два общих параметра через ModelBuilder, строит 7 вложенных модулей через ModelBuilder::block / NeuralGraph::compose_inferred и называет три выхода (final, left, right). Независимая реляционная цель coupled_branch_lower_bound теперь живёт в Model::proof_goals, а пример проверяет её Lean-кернелом через исходный composition.lean. Сохранены глобальная архитектурная nonnegative теорема для final, исходный i64-оракул, CUDA Graph baseline/fused и 18-файловая схема evidence. Тест Model::plan(AllOutputs) проверяет структурное планирование трёх выходов и общего multi-output NVPTX; исполняющий Stage9-пример по-прежнему запускает только final. Убраны ручные MathContract/NeuralModule и дублирование input_roles в лаборатории, но это не изменяет доказательную границу Lean/FP32/SASS. Перегенерация старых Stage9 Semantic IR, DOT/PNG, Lean/PTX и SHA-256 обязательна, ручное исправление манифеста недопустимо. Выполнение task check, task test, task clippy, task lab-stage9 и task verify-lab-stage9 ещё требуется.

## 10. Certified Build конструктора и проверка конечных критериев

**Работы:** целевой `cargo verineural build --certified` и интерфейс Taskfile; выбор architecture package через `--manifest-path`/эквивалент и настраиваемый `--artifact-root <path>` с Rust API-эквивалентом. По умолчанию artifact root равен корню выбранного Cargo package, поэтому стандартная лаборатория `labs/<architecture-name>-<version>/` хранит собственные `semantic.ir`, `architecture.dot`, `architecture.png`, `architecture.lean` и `SHA256SUMS` прямо в своём корне, а GPU/proof/certificate/report детали — в подпапках этого же root. Certified build проверяет deterministic DOT generation, соответствие `vn_ir_sha256` каноническому IR, автоматически рендерит PNG через pinned Graphviz, включает DOT/PNG в SHA-256 manifest и гарантирует, что все writers используют один выбранный artifact root. Относительный custom root разрешается относительно architecture package; абсолютный host path не влияет на semantic fingerprints; несовместимый bundle другой architecture id/version нельзя молча перезаписывать. Дополнительные SVG/PDF не являются источником истины и опциональны. End-to-end набор независимых архитектурно-нейтральных примеров; проверки критериев `SPEC.md`. Никакого serving/CI/деплоя в рамках этого этапа без отдельного разрешения.

**Готово, когда:** произвольная **поддерживаемая** пользовательская архитектура из Rust получает NVIDIA GPU-код, проверенные локальные/глобальные математические и заявленные численные гарантии, один полный самодостаточный `architecture.dot`, автоматически созданный из него `architecture.png`, явные границы TCB и воспроизводимый сертификат; недоказанная обязательная цель блокирует сертификацию. DOT байтово детерминирован для одинакового IR/config, DOT/PNG включены в manifest и однозначно связаны с Semantic Neural IR; PNG получен pinned Graphviz-рендером именно из сохранённого DOT. Две лаборатории с разными architecture id/version не конфликтуют артефактами при стандартных настройках, а custom artifact root не может молча перезаписать несовместимый bundle. Готовность определяется критериями архитектурно-нейтрального конструктора из `SPEC.md`, а не реализацией существующего LLM-стека.

**Stage 10, первый API-срез (исходники, локальная приёмка ещё не выполнена):** `Model::certify(CertifiedBuildConfig)` вызывает уже существующий `ArchitectureAutoCompiler::build`, обязательно проверяет все именованные цели Lean kernel + axiom audit и требует NVPTX lowering каждого именованного выхода. `Model::verify_certified` повторно проверяет current Semantic IR, DOT ↔ SHA-256, PNG, Lean, LLVM/PTX translation и SHA256SUMS без GPU. `identity.txt` связывает id/version, имена и роли источников, выходы и цели; сериализация декларации не зависит от Rust `Debug` или process-local `NodeId.graph`. Старый v1 Debug-shaped identity принимается при миграции только когда после удаления исключительно allocation-specific graph numbers вся декларация совпадает. Файл находится под SHA256SUMS, чужая id/version или изменённая декларация не может молча заместить bundle. Для XOR и CoupledField добавлены независимые thin-entrypoints `--verify`, `--artifact-root`, `--pinned-sha256` и Taskfile-команды `certified-xor`, `verify-certified-xor`, `certified-coupled`, `verify-certified-coupled`. Никакой новый semantic IR и собственный лабораторный Lean/CUDA backend не создаётся.

**Stage 10, продолжение (исходники, без локальной приёмки):** добавлен Cargo external subcommand `cargo-verineural`: `build --certified` / `verify --certified`, `--manifest-path`, `--artifact-root`, опциональный внешний SHA-256 pin при replay. Сборку выбранного consumer он делегирует в единственный `examples/<name>_certified.rs` пакета; определение самой архитектуры остаётся в `src/lib.rs`, а все доказательства/компиляция в едином библиотечном `Model::certify`. Для запуска без установки в PATH используются `task certified-build -- --manifest-path labs/xor-0.1.0/Cargo.toml` и `task verify-certified-build -- --manifest-path ...`. После успешной сертификации корневые `semantic.ir`, `architecture.dot`, `architecture.png`, `architecture.lean`, `SHA256SUMS`, `report.txt`, `identity.txt` являются относительными Unix symlink на единый `auto-build/`; старые файлы лаборатории с той же id/version переносятся в `.verineural-pre-stage10/`, неизвестные файлы не перезаписываются. Это важное ограничение: legacy migration нескольких ссылок не является единой атомарной операцией, публикация внутреннего `auto-build/` использует staging с возможным промежутком между directory renames. Настоящий one-switch root publish, полная поддержка произвольных consumer без certified example, формальная FP32/SASS гарантия и локальные Lean/LLVM/Graphviz/GPU тесты ещё не готовы; Stage 10 нельзя считать завершённым до подтверждённой приёмки. Старые Stage9 генераторы пишут в те же корневые имена, поэтому после certified-build их запуск может сделать bundle недействительным: выполнять Stage9 генерацию перед Stage10, повторно сертифицировать после изменений.

**Stage 10, повторная сертификация и pinned replay локально подтверждены (2026-10-23, `4871740`):** после обновления `dev` пользователь выполнил `task check` (успешно; `cargo fmt` автоматически создал и отправил `4871740`), `task verify-certified-stage10` (**4/4** tool-dependent теста, включая повторную публикацию существующего каталога через Linux atomic exchange, стабильный манифест, неверный внешний pin, чужую identity, ложную Lean-цель и tampering). Повторный `task certified-build` для XOR в существующий `/tmp/verineural-stage10-xor-v2` прошёл, `SHA256SUMS` сохранил хеш `6bc265ca583d2e4c6803fecf74c5b7df0f39f3817d7902d425ccc6deeda77797`, `task verify-certified-build --pinned-sha256 <этот-хеш>` прошёл с Lean 4.29.1. Предыдущий прогон на `84980ea` подтвердил `task test`, `task clippy` без предупреждений и первый build/replay обеих лабораторий (CoupledField manifest `0788971dd228bc51de0105780817d45d9141c832f1fc18d279cf386d83c47f44`). **Принят рабочий Stage 10 certified-build срез**: Rust API → Semantic IR → Lean kernel+axiom audit → LLVM/PTX structural validation → Graphviz DOT/PNG → SHA-256 → offline replay → deterministic reissue. **Полный Stage 10 по целевой SPEC.md остаётся открытым**: первая миграция семи root-alias не одна атомарная операция; потребителю нужен `examples/<name>_certified.rs`; проверки исполнения CUDA Graph на GPU и формальной LLVM/PTX/JIT/SASS/FP32 эквивалентности этот срез не предоставляет. Ни эти, ни численные гарантии сверх указанного не объявлять доказанными.

**Rotating-matrices P2 (код в dev; приёмка совместно с P1 ожидается):** общие конструкторы `Tensor::from_vec/from_slice/zeros`; `NeuralGraph::sub/div/exp/reduce_max/broadcast_to` и одноимённые CPU references; расширение `PointwiseExpr` и canonical IR, DOT, тесты форм, row-major семантики, NaN и честных unsupported GPU/Lean профилей. Лаборатория не объявляет собственный tensor helper и SHA256SUMS/copy-publish Stage10; structural/index routing GPU lowering уже закрыт отдельным P0 срезом. Никаких ready-made softmax/stochastic-choice примитивов или фиктивных FP32 доказательств.

**P1 state/execution — ФЛАГМАНСКИЙ CONSUMER ПОДКЛЮЧЁН, локальная приёмка ожидается:** `SourceRole::State`, `ModelBuilder::state/next_state/block_multi`, identity с transition links и owned `ModelExecution`. Runtime metadata копируется при prepare, поэтому execution не держит Rust lifetime на `Model`. Deterministic rotating-matrices использует один captured architecture CUDA Graph; parameters и dictionary обновляются один раз на forward, `token_bits` по шагам, state feedback выполняется D2D в `step()` без H2D rebinding. Stochastic/fixed-route policy тоже больше не использует raw `GpuExecution` и host-derived rotated matrices: host выбирает action, затем один из восьми route-specific `ModelExecution` исполняет rotation + transition из Semantic IR. Выполнить локально общий acceptance; аппаратный replay отдельно требует NVIDIA.

**P1 numeric branch stability (код; локальная Lean-приёмка ожидается):** добавлены generic `RneConditionEvidence` и `RneSelectPlan` для канонического `PositiveMask → SelectPositive`. Condition и обе ветви имеют независимые RNE contracts; stable positive/nonpositive decision наследует contract только выбранной ветви, а zero-crossing interval fail-closed через `UnstableBranch`. Lean `Numeric.lean` содержит отдельные conditional composition lemmas, а generated theorem сохраняет concrete q/bounds/ε и margin. Проверка: `task verify-numeric-branch`. Это conditional source-level RNE theorem, не GPU/LLVM/PTX/SASS proof и не общий comparison framework.

**P1 recurrent numeric rollout (код; локальная Lean-приёмка ожидается):** `RneRangePlan::compile_with_source_contracts` принимает уже доказанный source `ApproxContract`; `RneStateRolloutPlan` на fixed horizon переносит `next_state` contract в state source следующего шага, поэтому ε действительно накапливается, а не обнуляется на temporal boundary. Fresh non-state inputs остаются exact на каждом шаге. Feedback разрешён только при invariant q-scale; Mul/MatMul-подобный переход, меняющий q состояния, отклоняется. `task verify-numeric-state` проверяет Rust contract chain и kernel-check каждого step source. Это ещё не произвольная индукция по времени и не machine FP32 proof.

**P1 arbitrary-horizon state invariant (код; локальная Lean-приёмка ожидается):** `generate_inductive_state_nonnegative` берёт один reusable consumer transition `state,input → next_state,output`, требует прямые nonnegative F32 sources, state-preserving shape/dtype и явный `Nonnegative` claim на `next_state`. Lean определяет рекурсивное состояние по `Nat` и доказывает `∀ t` индукцией, повторно используя локальную theorem transition-а, а не генерируя N копий шага. Любой extra source или недостающий claim отклоняется. `task verify-inductive-invariant` проверяет positive/negative cases и real Lean+axiom audit. Это ideal-Int invariant, не FP32/GPU temporal proof.

**P1 reusable module-definition proof (код; локальная Lean-приёмка ожидается):** `generate_reusable_module_nonnegative` нормализует consumer-defined single-output module body в generic Lean definition, доказывает один definition-level `Nonnegative` theorem и создаёт отдельные application theorems для concrete instances. Reuse требует совпадения name/version/`MathContract` и normalized body semantics; одинаковая identity с отличающимся телом fail-closed. Каждый instance заново закрывает declared `NonNegativeFinite requires`, даже если generic property не использует их в proof term. Gate: `task verify-reusable-module-proof`. Persistent cache, multi-output definition reuse и общий theorem dependency graph остаются следующими срезами.

**P1 global reusable-module composition (код; локальная Lean-приёмка ожидается):** architecture-level `generate_global_nonnegative` теперь проходит общий application-order DAG `ModuleInstanceRef` и композирует как single-, так и multi-output modules по конкретным output ports. Совместимые invocations/ports группируются по kind/identity/full contract/normalized selected-output body, получают один shared definition theorem и отдельные concrete application theorem; global theorem использует именно applications и fail-closed при `ModuleDefinitionMismatch` либо недостающей premise конкретного вызова. Existing single-output theorem names сохранены; multi-output applications получают явный `_port_N`. Ограничение остаётся по свойству ideal-Int `Nonnegative`; общий typed theorem dependency graph для произвольных predicates ещё открыт.

**P1 multi-output reusable definition proof (код; локальная Lean-приёмка ожидается):** `generate_reusable_multi_module_nonnegative` связывает все выходные F32 `Nonnegative` свойства одного `MultiOutputModule` в одну generic conjunction theorem от общей нормализованной tuple-definition; каждый порт каждого concrete instance получает отдельную application theorem и закрывает declared premises. Reuse требует совпадения полной named contract/identity/version и всех output semantics; любое несовпадение fail-closed. Тот же тип module теперь участвует и в `generate_global_nonnegative` как producer конкретного output port; два compatible multi instances переиспользуют definition theorem выбранного порта, а mismatched selected-port semantics отклоняются. Проверка `task verify-reusable-module-proof` включает реальный Lean kernel/axiom audit. Не заявляется универсальная multi-output композиция произвольных предикатов или FP32/GPU машинных доказательств.

**P1 static tensor slice / attention-like consumer (код; локальная Lean-приёмка ожидается):** `Operation::SliceAxis { axis,start,len }`, `NeuralGraph::slice_axis` и `Tensor::slice_axis` реализуют статический contiguous interval с сохранением ранга, явными bounds и row-major семантикой. Canonical IR фиксирует axis/start/len; Lean `sliceAxis` и `sliceAxis_nonnegative` покрывают ideal-Int semantics/property. GPU и RNE backend пока честно отвергают slice. Независимый consumer режет packed [2,6] на Q/K/V-подобные [2,2], делает transpose/matmul и доказывает идеальную nonnegative композицию без готового Attention API. Проверки: `task verify-tensor-slice`, `task p2-consumers`, `task verify-p2-consumers`.

**P1/P12 explicit GPU capability plan (код; локальная проверка ожидается):** `GpuProgram::capability_plan` проверяет каждый запускаемый kernel против соответствующих memory и translation evidence и отклоняет необъяснённый удалённый fusion node. Fusion evidence повторно фиксирует single-use и сохранение selected outputs. `GpuAssuranceBoundary` разделяет generated memory Lean obligations, structural LLVM/PTX validation, отдельный numeric proof requirement, CUDA runtime acceptance и неустановленную JIT/SASS correspondence. `capability.plan` входит в auto-build bundle и offline replay. Gate: `task verify-gpu-capabilities`.

**P06/P12 certified memory obligations (код; локальная Lean-приёмка ожидается):** memory contracts теперь экспортируются как named `LeanProgram` theorems. Auto-build проверяет и axiom-audit'ит `gpu_N/memory.lean` и `gpu_shared/memory.lean`, добавляет зависимости в общий audit и SHA manifest; offline replay повторяет source comparison + kernel check + audit. Общий GPU compiler только генерирует obligations, поэтому это усиливает certified path без ложного утверждения об LLVM/PTX pointer semantics. Gate: `task verify-gpu-capabilities`.

**P1/P10 explicit storage semantics (код; локальная проверка ожидается):** текущий layout-профиль формализован как contiguous row-major strides. `NodeStorage` различает owned allocation и zero-copy `Reshape` alias, а `storage_root/aliases` разрешают alias chain. Canonical IR поднят до v4 и связывает storage metadata с fingerprint; DOT экспортирует тот же storage contract. GPU allocation и kernel planning читают `NodeStorage`, а не повторяют собственное знание о Reshape. Reordering ops вроде Permute/Slice остаются owned contiguous outputs. Gate: `task verify-storage-semantics`. Arbitrary strides/noncontiguous views остаются открыты.

**P1 hardware acceptance fixture (код, локальный CUDA-прогон ожидается):** `task gpu-state-replay` вызывает `examples/stateful_model_gpu.rs`, собирая один consumer-defined 3-output transition с двумя публичными readouts и приватной state link. Один GPU session/compiled CUDA Graph, `run` плюс пять `step`, точные FP32 bit fixtures для состояния и выходов, смена input и параметра без recapture, явный reset и отказы на неверные роли, формы, значения. CPU unit tests и ранее подтверждённый `task gpu-multi-output` не заменяют проверку этого D2D replay; статус GPU acceptance отмечать завершённым только после фактического успешного запуска на NVIDIA. Не выдавать это за доказательство CUDA/JIT/SASS/FP32 или произвольной рекуррентной сходимости.

**P1 P0 reliability fixes (код; локальная приёмка ожидается):** GPU prepare расширяет roots всеми State-источниками, не изменяя pure Semantic IR и состав proof/certificate roots. D2D feedback проверяется до первого replay. Публичные выходы, алиасные перезаписываемым state через Input или Reshape, получают GPU-only snapshots до feedback в `run/step`; чтение `output(name)` адресное, без копирования прочих output/next_state на CPU. Добавлен Rust preflight regression для полностью заменяемого unread state и GPU acceptance `task gpu-state-replay` с двумя state (включая полностью недостижимое из обычного DAG), прямым alias и reshape-view. Эти исправления не расширяют GPU операторы и не доказывают FP32/JIT/SASS или атомарность при CUDA-ошибках.

**P1 GPU feedback reliability / P2 IR transaction patch (код, совместная локальная приёмка ожидается):** feedback/snapshot D2D enqueue или sync error устанавливает `ExecutionPoisoned`; остальные операции `GpuExecution` fail-closed до пересоздания. Неверная схема state-link отклоняется ещё до копирования и не poison. CPU tests имитируют частичный DMA failure и synchronize failure, без заявления об аппаратной fault injection. Пять clone-based builders (`apply_module_with`, `compose_inferred`, `compose_multi_inferred`, `scan_fixed`, `apply_multi_module_with`) переведены на вложенные RAII append transactions с откатом `nodes`, `modules`, `multi_modules`, `module_order` на Err и unwind. Добавлены regressions nested rollback и catch_unwind. Проверить совместно с предыдущими P0: `task check`, `task test`, `task clippy`, `task gpu-state-replay`, затем `task gpu-multi-output` и зависимые потребительские проверки. CUDA/FP32/SASS формально не доказаны, после DMA failure автоматического восстановления нет.

**P1/P2 review fixes (код, локальная проверка ожидается):** `GpuExecution` реализует единый fail-closed lifecycle для CUDA H2D/D2D/D2H/Graph/synchronize/benchmark: `ExecutionPoisoned` после CUDA-ошибки, `OutputNotReady` до первого replay и после валидного source update; ошибки preflight не poison. Аппаратная приёмка `task gpu-state-replay` также проверяет запрет чтения неготовых результатов. `NeuralGraph::dependency_scope` больше не сканирует каждый модуль для каждого посещённого узла: строит локальный индекс module outputs и сохраняет declared unused inputs и duplicate output/module bindings. Совместно прогнать `task check`, `task test`, `task clippy`, `task gpu-state-replay`, `task gpu-multi-output`, `task p2-consumers`, `task verify-p2-consumers`. CUDA/FP32/SASS не доказаны.


**P0 structural/indexing GPU lowering — КОД ЗАКРЫТ, локальная приёмка ожидается:** GPU backend принимает только профиль, реально требуемый rotating-matrices: rank-2 transpose (`Permute [1,0]`), rank-2 `ReverseAxis(0/1)`, contiguous binary `Concat(0)`, rank-2 `ArgMax(axis=1, First)` и scalar `Take(axis=0)`. Для новых kernels добавлены memory contracts, deterministic translation-plan kinds и structural LLVM/PTX validation; неподдерживаемые axes/ranks/tie policies остаются fail-closed. Runtime output ABI теперь сохраняет `DType`: `TensorValue::{F32,Index}` проходит через `read_value/read_values`, `execute_value/execute_values` и `ModelExecution::output_value`; device ArgMax `i32` читается как Index, а старые F32-only методы отклоняют Index вместо bit reinterpretation. Добавлен отдельный ignored NVIDIA acceptance для публичного ArgMax output. Lean memory-address source покрывает row-major адреса transpose/reverse/concat/argmax/take на конкретных размерностях; `Take` формулирует предпосылку `selected < choices`, а reverse-row translation plan фиксирует `rows`. Evidence model rotating-matrices объявляет `recurrent_state` через `ModelBuilder::state` и связывает `next_state`; deterministic runtime теперь компилирует и replay-ит тот же единый graph `router → ArgMax → Take → transition → readout`, без host route/rotation. Stochastic training остаётся явно внешней sampling policy. Новый typed-output hardware regression агентом не запускался. Это арифметический proof слоя индексов и structural translation evidence, не доказательство CUDA pointers, LLVM/PTX/JIT/SASS/FP32.

**P0 VN-P01..VN-P06 acceptance — КОД ЗАКРЫТ, локальная проверка ожидается:** supported typed relational predicates, external versioned Pointwise primitive semantics, module capture/ownership rollback, independent multi-goal fork/fan-in composition and certified Lean axiom/fingerprint/SHA replay are wired into one developer gate: `task p0-acceptance`. Deliberately false predicates/claims and unsupported semantics remain fail-closed. This closes the P0 acceptance criteria only for the documented supported DSL; arbitrary user Lean text, arbitrary atomic math, IEEE-754 machine correspondence and signed provenance are not smuggled into the claim and remain outside P0.

## Общие ограничения для всех этапов

- **Никаких** CI/CD, GitHub Actions, hooks, контейнеризации и прочей инфраструктуры без явного согласия пользователя.
- **Не создавать pull request**. Изменения в `main` интегрировать только fast-forward, без merge-коммитов и принудительной перезаписи истории; порядок указан в корневом `AGENTS.md`.
- Команды сборки/тестирования описывать в Taskfile; по умолчанию их **выполняет локально пользователь**, а не агент.
- Все новые Rust-компоненты принадлежат **единому Cargo workspace**; необходимые инструменты включать в корневой `flake.nix`.
- Реализовывать крупные работающие срезы, не создавать бессвязную модуляризацию или абстракции «на будущее».
- Целевая спецификация описывает конечное состояние. В промежуточных версиях нельзя выдавать наличие контрактов, Lean-файлов или GPU-тестов за доказательство реального машинного исполнения.

**Stage 10, стабилизация публикации (код, локальная приёмка ожидается):** повторная замена существующего auto-build/ на Linux переведена на атомарный renameat2(RENAME_EXCHANGE), который fail-closed при отсутствии поддержки ядра/ФС. Первое создание auto-build/ требует одного rename. Старый bundle удаляется уже после переключения, ошибка его очистки не превращается в фиктивную неудачу доказательства. Симлинк вместо каталога auto-build запрещён. Лаборатории используют один библиотечный certified_example_main вместо копий CLI-кода. Добавлены unit-тесты swap, первого выпуска, несогласованных backup и внешних ссылок. Всё ещё отсутствует подтверждение выполнения Lean/LLVM/Graphviz, а первоначальная публикация семи root-alias и legacy migration не являются одной атомарной операцией. Tracked Stage9 артефакты в корнях лабораторий будут изменены при default migration; для проверки использовать --artifact-root /tmp/<unique-name>.

**Stage 10, регрессии после первой локальной приёмки:** `task check` прошёл, три `verify-certified-stage10` проверки Lean/SHA-256 прошли; полный `task test` остановился на некорректном домене входа теста `sqrt`, `task clippy` остановился на `too_many_arguments`, Cargo предупредил о совпадении имён двух `certified` examples. В следующем срезе test input изменён на `NonNegativeFinite` (контракт `sqrt` остаётся строгим), replay переиспользует один `AutoBuildPlan`, а имена executable examples различаются. Локальная повторная приёмка этих исправлений ожидается.

**Stage 10, первая успешная локальная end-to-end приёмка (2026-10-23, `84980ea`):** разработчик подтвердил `task check`, `task test --workspace` (все запущенные тесты прошли, отдельные tool-dependent тесты по умолчанию ignored), `task clippy` с `-D warnings` и `task verify-certified-stage10` (3/3 включая ложную цель, чужую identity и tamper). `task certified-build` и `task verify-certified-build` через Cargo CLI успешно собрали и перепроверили *обе* независимые модели с отдельными absolute artifact roots: XOR (`6bc265ca583d2e4c6803fecf74c5b7df0f39f3817d7902d425ccc6deeda77797`) и CoupledField (`0788971dd228bc51de0105780817d45d9141c832f1fc18d279cf386d83c47f44`). Lean checker: 4.29.1, по одной обязательной named goal на архитектуру. Это подтверждение Lean ideal-Int + структурного GPU lowering и offline replay, **не** GPU hardware/JIT/SASS equivalence. В этих логах нет второго build в тот же root, проверки неверного внешнего SHA-256 pin или запуска CUDA Graph. Добавлен четвёртый ignored acceptance-тест, воспроизводящий повторную публикацию, детерминированность SHA-256, верный/неверный pin и post-reissue replay; его локальный результат ещё ожидается. Первый root alias migration остаётся неатомарным; универсальному consumer пока нужен явно оформленный `examples/<name>_certified.rs`.

**Приёмка P0/P1/P2 и rotating GPU, новый код (локальный прогон ожидается):**
`task verify-api-acceptance` объединяет существующие P0 Lean/consumer gates без изменения
математических контрактов; `task verify-lab-rotating-gpu` запускает проверку
типизированного GPU `ArgMax/Index` и новый `labs/rotating-matrices-0.1.0/tests/gpu_parity.rs`.
Независимый CPU-оракул адресует все восемь пространственных маршрутов формулами
координат и проверяет многотокенный deterministic GPU forward, readout, state reset
и политику `ArgMax First` против одного переиспользуемого CUDA Graph. CPU smoke-test
требует различимых результатов всех маршрутов. Всё GPU/Lean acceptance — пока
**не проверено локально**; `task gpu-state-replay` и `task lab-rotating` остаются
обязательными отдельными аппаратными проверками. Это численная validation,
не доказательство FP32/LLVM/PTX/JIT/SASS.
\n**Stage 10 и P1 proof-boundary hardening (код; локальная приёмка ожидается):**\nкорневая миграция семи root alias при ошибке теперь откатывает установленные ссылки\nи возвращает исходные tracked legacy-файлы из backup; fault-injection tests\nпроверяют rollback fresh и legacy-публикации. Атомарность видимости\n*семи различных* root paths всё ещё не гарантируется, зато неуспешная миграция\nне оставляет частично перенесённые артефакты в штатном однопроцессном профиле.\nLean `PointwiseLe` generator переиспользует общие композиционные леммы\n(`refl/trans/add with nonnegative/Relu`) поверх DAG и самостоятельно доказывает\nнеотрицательность составной sibling-ветки из ReLU/Add/Mul, без присвоения\nruntime Domain статуса Lean-гипотезы. Преднамеренно ложные отношения\nпродолжают отклоняться kernel-check в certified-пути. Это поддерживаемый\nrelational фрагмент, не произвольный theorem-dependency framework;\nобязательная проверка structural LLVM/PTX/memory evidence и явные\n`fp32_machine_equivalence=not-proven`, `nvidia_jit_sass_equivalence=not-proven`\nостаются trust boundary. Команда `task verify-stage10-proof-boundary` запускает\nвсе связанные проверки при совместной локальной приёмке.\n\n**Совместная приёмка после Stage 10/P1 усиления:** `task verify-all-acceptance`\nобъединяет check/test/clippy, P0/P1/P2, root migration fault-injection,\nLean relational positive/negative claims, GPU memory/translation audit,\nStage10 certified replay, state feedback и rotating NVIDIA parity/training.\nОтдельный тест с намеренной заменой `add.rn.f32` на `add.ftz.f32`,\n`mul.rn.f32` на `fma.rn.f32` / `mul.approx.f32` и нарушенным\nколичеством операций обязан быть отклонён существующим FP32 PTX auditor.\nReport дополнительно различает проверенные условные Lean memory obligations,\nструктурный LLVM/PTX audit и отсутствие отдельного RNE bounds/cuda-runtime proof.\nВсе эти новые проверки **ожидают запуска пользователем**; полноценная\nформальная JIT/SASS или arbitrary-predicate theorem composition не заявлена.\n

**Torus16-Mix structural row profile (код, локальная приёмка ожидается):**
GPU lowering переиспользуемых операций дополнен узким профилем `SliceAxis(axis=1)`
для `[1,N]`, `BroadcastTo` из одного элемента в `[1,N]` и
`Concat(axis=1)` для двух однострочных тензоров. Последняя операция
переиспользует flat-concat адресацию только при доказуемой эквивалентности
форм. Планы памяти фиксируют исходные размеры и сдвиг, translation
validator проверяет LLVM-шаблоны и PTX FP32 policy; генератор Lean
выводит арифметическое обязательство для границ среза, не утверждая
полного доказательства CUDA. `crates/verineural/tests/structural_last_row.rs`
проверяет plan round-trip, поддерживаемые и отвергаемые формы и содержит
отдельный ignored NVIDIA CUDA Graph replay. Команды:
`task test-lab-torus16-mix`, `task verify-gpu-structural-last-row`.
Локальные Cargo/Lean/LLVM/CUDA проверки агентом **не выполнялись**.
`Exp`/`Div` и весь Torus16-Mix forward по-прежнему fail-closed,
поскольку строгая FP32 экспонента не реализована; для завершения лаборатории
нужны отдельная численная спецификация и проверенный lowering, не
скрытое approx-замещение. Никакие крупные нейросетевые блоки в библиотеку
не добавлены.

### Torus16-Mix: полный executable operator forward, экспериментальная numeric-область (2026-10-25)

Потребитель labs/torus16-mix-0.1.0 описывает единый 8-output операторный
граф с одной shared W и входным gated mixing до каждого MatMul.
Восемь выходов можно запускать в одном CUDA Graph через именованный
ModelExecution. Никаких предметных Torus/EMA/LLM-компонентов в ядре
VeriNeural нет.

Новые универсальные GPU-paths: pointwise subtraction (sub.rn.f32),
division (div.rn.f32), natural exponential via explicit experimental
opt-in GpuLaunchConfig::with_approximate_exp() (mul.rn.f32 x log2(e),
ex2.approx.f32). Доступны только версии AST Sub/Div/Exp с проверкой
канонического выражения и имени. Чужой PointwiseSpec, включая
совпадающее имя с изменённой математикой, отвергается.
LLVM/PTX translation validation проверяет регистры, инструкции,
rounding-режимы и численную метку ExpApprox, но не доказывает IEEE-754
error bound или PTX/SASS. Strict-сборка и certified-build по-прежнему
отклоняют Exp. Здесь нет молчаливого approximate fallback.

Приёмка: task test-lab-torus16-mix; task lab-torus16-mix-gpu;
task verify-gpu-torus16-mix. Аппаратный тест с ненулевым mix_gate
и нессиметричной W проверяет восемь выходов против независимого
Tensor reference. Авторские Cargo/Lean/CUDA проверки не запускались,
пользователь должен подтвердить результаты в локальном devShell.

Вне реализации: полная 4-layer EMA4-LM с Conv9/LayerNorm/SwiGLU,
recurrent state, backprop/AdamW, BPC и GPU memory benchmarks. Нельзя
выдавать готовность operator forward за воспроизведение обученного
результата 24 908-параметрической сети.

### EMA4-LM: 4-layer streaming consumer architecture (программный срез, приёмка ожидается)

В `labs/torus16-mix-0.1.0/src/ema4.rs` собрана полная конфигурация
**одного авторегрессионного inference-шaга** исходной 4-layer EMA4-LM
на универсальных VeriNeural primitives, без предметных компонентов в core:
tied character embedding/head, два LayerNorm и causal depthwise Conv9 на блок,
EMA с learnable decay, gated Torus16-Mix ролей 0..3, четыре SwiGLU
проекции ролей 4..7 и down через повторно используемые роли 0..1.
Потоковое состояние в `ModelBuilder`: 4 EMA vectors и 64 Conv9 history
vectors. Каждый `next_state` привязан к реальной зависимости общего IR,
исполняется persistent CUDA Graph через `ModelExecution.step()`;
никакой host recurrence в GPU path. Для словаря 104 параметров 24 908,
как в структуре исходного handoff (но значения не загружены из checkpoint).

Требуемая математическая операция `sqrt` расширена **универсальным**
versioned `PointwiseExpr::Sqrt`/`NeuralGraph::sqrt_ieee`
с LLVM/PTX `sqrt.rn.f32` и template audit. Отличие от
доменного `Operation::Sqrt` намеренно: pointwise-путь не придумывает
`NonNegativeFinite` для вычисленной дисперсии, разрешает NaN по
IEEE-семантике, а Lean proof для всего графа остаётся unsupported.
Поддерживаемая численная область всего forward использует explicit
experimental `ExpApprox`, в strict/certified-режиме fail-closed.

Независимый scalar Rust reference в `src/ema4_reference.rs`
проверяет последовательный причинный EMA/Conv9 step и logits.
Численная NVIDIA-приёмка сравнивает три шага с сохранением GPU
состояния (включая `mem_0`), task-команды
`lab-torus16-ema4`, `test-lab-torus16-ema4`,
`lab-torus16-ema4-gpu` и `verify-gpu-torus16-ema4`.
Запуск Cargo/Lean/CUDA задач агентом **не производился**.
Не реализованы autograd, AdamW, обучение, streaming quality/BPC,
checkpoint importer и сопоставление GPU FP32 с исходными обученными
весами. Это полный *streaming forward* на Rust/IR, не законченная
система обучения.

### Универсальный reverse-mode IR и первый trainable CUDA Graph vertical slice

Код `crates/verineural/src/autodiff.rs` строит reverse-mode VJP
в **той же** идентичности Semantic Neural IR: исходный forward
является неизменным префиксом, а производные являются обычными
узлами Add/Mul/MatMul/Permute/Reshape/Slice/Concat/Broadcast и
фиксированных versioned Pointwise. Учёт повторного использования
узлов через суммирование вкладов, seed явный. Проверка
достижимости и всех поддерживаемых reverse-правил выполняется
до построения производной; неизвестные операции fail-closed.
Контракт производной математический, **не** доказанная Lean
связь с точной FP32 производной приближённой `ex2.approx`.
Для выбранных параметров отсечение не относящихся к ним
ветвей уменьшает IR, не меняя семантику требуемого VJP.

`crates/verineural/src/optimizer.rs` добавляет архитектурно-
нейтральный **host AdamW** с атомарной валидацией named parameter
set, non-finite и shape guard. GPU backward исполняется без
нового backend через обычный CUDA Graph. Приёмка:
`task autodiff-stage`, `task verify-gpu-autodiff`,
`task train-lab-torus16-ema4` и структурный тест EMA4.
Аппаратная проверка ещё не была запущена при внесении кода.

Лабораторная команда демонстрирует *teacher-forced* CE,
GPU dL/d(final_beta), host AdamW и обновление параметра
в persistent GPU execution (только 48 trainable значений,
один токен, фиксированное состояние). Выводит toy-BPC,
который нельзя сравнивать с исследовательской метрикой.
Недостающие крупные части: unroll и 2+ шаговый truncated BPTT,
all-parameter train/optimizer на GPU, loss reduction внутри
Semantic IR, полноценная загрузка корпуса, стабильность градиента
на реальных данных, Lean численная сертификация reverse-pass.


### Finite-window BPTT and real-corpus EMA4 training: implementation awaiting local acceptance

Architecture-neutral verineural::unroll_model composes a named recurrent
Model across 1..=16 timesteps by cloning ordinary typed Semantic IR
operations, sharing single parameter sources, and wiring next_state
producers to later State consumers. It introduces explicit per-step
Input and cotangent sources and a scalar dot-product objective, so
the existing generic differentiate() produces reverse-mode VJPs
through time without lab backward kernels. Initial recurrent states
are explicit window-boundary sources, cutting the gradient graph there.
The new temporal.rs performs strict binding validation and rejects
unregistered sources, wrong shapes and missing transitions.
**New opt-in temporal reuse (code; CUDA acceptance pending):**
`unroll_model_hoisted` reuses a pure original-model operation across
window timesteps only when all of its transitive sources are named
`Parameter` inputs. `State` and per-timestep `Input` dependencies are
never hoisted. It shares the same public Neural IR and generic VJP/GPU
lowering; no architecture-specific kernels or new arithmetic are added.
The established `unroll_model` remains unchanged for old checkpoint
fingerprints. This transformation can alter the reverse AD accumulation
tree, so forward bitwise parity and gradient numeric parity require
separate NVIDIA acceptance via `task verify-gpu-temporal-bptt`.
A specific consumer training experiment is
`task benchmark-torus16-role-delta-hoisting`; speedup is not
confirmed until locally measured. Lean/strict-FP32/SASS semantics
are not upgraded by this graph sharing.
A tiny two-step CUDA test tests the *through-time* gradient analytically:
2.25 with the cross-time edge, versus 1.875 when detached.

The EMA4 consumer lists **all** nonconstant trainable parameters
(24,908 at vocab=104, including a single tied embedding/head and one
physical W per block), then uses a full-parameter window VJP and
generic host AdamW to update them. Between windows a snapshot of 68
terminal states is copied out before any state inputs are updated,
avoiding unsafe D2D overlap while retaining recurrent data and
explicitly detaching the past for TBPTT. Training uses a stable
host cross-entropy seed, compiled GPU forward+backward via CUDA Graph
and a held-out reset-state streaming validation pass.

The lab's CharCorpus::from_text uses a sorted Unicode character alphabet
and a 90/10 chronological split. The original handoff corpus_snapshot.txt is versioned in
labs/torus16-mix-0.1.0/data/ and selected by default through
CARGO_MANIFEST_DIR; TORUS16_CORPUS is optional for deliberate overrides.
SHA-256: c1d0509878099a43c85866c2f582be04fe8253292b137a83c58ebd04fb16ca85.
Expected handoff data: 524859 characters, 104 symbols. Commands:
task temporal-bptt-stage, task verify-gpu-temporal-bptt,
task train-lab-torus16-ema4-bptt (no external corpus path required).
Training default is BPTT=2 and two windows; the validation position
count is explicitly reported and by default capped at 64. No GPU run
of this new stage was performed by the agent, and full all-parameter
GPU compilation cost/VRAM are unknown.

Unfinished: proving floating-point reverse-mode correctness,
measuring end-to-end optimizer throughput, implementing in-GPU
AdamW/CE, ensuring parity of the research checkpoint/architecture,
exact handoff 51,648 validation positions protocol, checkpoint I/O,
long multi-seed learning and evaluating whether holdout BPC improves.


### Experimental Mul→Add NVIDIA GPU fusion for universal reverse-mode graphs (code, acceptance pending)

`GpuLaunchConfig::with_pointwise_fusion()` adds an opt-in typed,
exclusive-use `Mul → Add` compiler rewrite. Kernel combination is
valid only when Mul has exactly one reachable use, is not itself a
selected output, all three inputs/outputs have equal shape, and no
existing ReLU-chain fusion consumes either node. The unmodified
Semantic IR remains authoritative. A newly generated CUDA Graph launches
one kernel (separate `mul.rn.f32` then `add.rn.f32` without FMA) rather
than two. The exact original position of Mul in Add is encoded in the
translation plan. GPU memory contracts include all three actual source
addresses, explicit `GpuOptimizationCapability::MulAddFusion` records
the removed producer, and structural LLVM/PTX audit checks the template,
rounding and instruction counts. Unsupported cases remain unfused.

Acceptance: `task pointwise-mul-add-fusion`,
`task verify-gpu-mul-add-fusion`; selected-output/fan-out negative
tests plus bitwise NVIDIA parity for both Add operand positions.
The EMA4 full-parameter BPTT lab opts in, compares the fused and
non-fused **kernel counts before execution** and prints the reduction
(and optionally CUDA-event replay time). No measured hardware gain,
full training gradient parity or Lean/IEEE/JIT equivalence is claimed
until separately checked. More general backward fusion and
end-to-end train throughput/memory benchmarking remain open.

### Experimental three-operation fusion with bounded three-source GPU ABI

The existing opt-in `GpuLaunchConfig::with_pointwise_fusion()` additionally
selects a `Mul→Add→Mul` chain when both inner nodes have a sole reachable
consumer, no selected output or earlier fusion references them, every
operation/source has the same element shape, and the final Mul reuses
one of the three external sources. A fourth distinct source is explicitly
not supported in this bounded profile. Internal operation order and
both binary operand positions are encoded in versioned
`TranslationKind::MulAddMul`; LLVM template emits exactly
`mul.rn.f32`, `add.rn.f32`, `mul.rn.f32`, without FMA.
Memory contracts/capabilities explain two removed kernels and all
three source addresses. Structural LLVM/PTX audit checks exact operand
wiring, ordered instructions and byte-indexed pointer patterns.
No Lean proof, strict IEEE JIT/SASS guarantee or end-to-end speedup
claim arises from this pass.

Added CPU and ignored NVIDIA bitwise acceptance tests for all twelve
operand layouts, plus explicit fan-out, selected-output and fourth
distinct input negatives. EMA4 BPTT training logs real kernel counts,
CUDA-only replay comparison (optional TORUS16_BENCH_COMPARE), total
training wall time, tokens/s and per-window time. Device GPU benchmark
does not measure AdamW or transfers; full train step timing includes
those but excludes compilation. This new code has not undergone local
Cargo/NVIDIA acceptance and exact kernel counts remain unmeasured.


### Batched GPU I/O for generic Semantic IR programs (implementation, acceptance pending)

`GpuExecution::update_input_subset` sends prevalidated unique source
updates through pinned CUDA H2D staging and a single synchronization.
`GpuExecution::read_outputs_selected` reads only explicitly selected
F32 results, validates before enqueueing, retains output order and
state snapshot behavior, and synchronizes once after a session-owned
pinned D2H batch. Existing all-F32 `read_outputs` delegates to this
batch reader. No legacy stream or standalone kernel path introduced.
The EMA4 BPTT consumer now reads only supervised logits at the forward
phase and gradients plus terminal states after backward; it batches
input/seeds and 271 parameter + 68 recurrent-state updates. The
training task now uses Cargo --release, and labels CPU/GPU wall-clock
stage durations. All previous Semantic IR, autodiff and CUDA Graph
kernels remain unchanged.

Acceptance: `task verify-gpu-batch-transfers` (bitwise output parity,
duplicate/source/shape rejection without partial mutation, selected
reverse order, single input API compatibility). Then compare
end-to-end windows and `holdout_reset_streaming_bpc` with the
previous unfused-upload baseline on the same device. GPU time and
speedup are **not** established by source changes. Durable training
checkpoint + AdamW moment resume and faster GPU-side optimizer
are separate future milestones, not claimed here.


### Durable lab-owned EMA4 TBPTT restart snapshots (experimental, hardware acceptance pending)

Versioned binary snapshots persist exact named trainable parameters,
AdamW first/second moments and hyperparameters through the reusable
`AdamW::checkpoint()/from_checkpoint()` API, plus EMA4 initial-state
values at the next training window boundary, cumulative window cursor,
BPTT/vocabulary, exact corpus fingerprint, and a truncated-file
checksum. The checkpoint format and filesystem I/O remain private to
the EMA4 research lab, not VeriNeural core. Strict shape/name
validation and optimizer moment/step checks fail closed before resume;
atomic same-directory temporary file replacement preserves the previous
complete checkpoint on interruption. No extra Cargo dependency.
Automatic path: `target/torus16-ema4-bptt.ckpt`. Environment knobs:
`TORUS16_CHECKPOINT`, `TORUS16_CHECKPOINT_EVERY`,
`TORUS16_FRESH=1`. `TORUS16_TRAIN_WINDOWS` means total target windows.

CPU acceptance task: `task test-lab-torus16-ema4-checkpoint`
(round-trip, corrupted/truncated/wrong corpus/schema rejection, resumed
AdamW update matching uninterrupted update). GPU-level continuous vs
interrupted/resumed training equality remains to be measured. The
non-cryptographic fingerprint and file checksum do not guarantee
authenticity or proof of neural model correctness.

**P1 GPU feedback runtime safety (code, GPU acceptance pending):**
`GpuExecution::feedback_state` now rejects feedback before a completed
replay/benchmark or after source updates; errors from metadata preflight do not
mutate state. Observable selected outputs aliasing state destinations receive
CUDA D2D snapshots before feedback. Raw execution preserves all selected outputs;
named `ModelExecution` preserves only public outputs, avoiding extra state
snapshots for internal allocation roots. New replay/benchmark invalidates the
previous snapshots; every public read API uses the protected address. The
`ModelExecution::step` path avoids redundant manual snapshots. NVIDIA checks:
`task verify-gpu-feedback-runtime`, plus `task check`, `task test`, and
`task clippy`. No Lean proof of CUDA/JIT/SASS or hardware success is claimed.

**P1 device-domain guard и feedback CUDA Graph (экспериментальный код, NVIDIA-приёмка ожидается):** для динамических обязательств `Finite/NonNegativeFinite` отдельный runtime CUDA Graph проверяет битовый образ каждого F32 элемента на exponent=255 (NaN/Infinity), а для NonNegativeFinite дополнительно на отрицательный ненулевой битовый образ. `-0.0` допустим. Через D2H передаётся **один 32-bit status**, а полные значения читаются только при ошибке для получения точного host-oracle domain error. До проверки никакая feedback D2D-запись не выполняется. Стабильный набор D2D feedback копий кешируется во втором CUDA Graph и запускается на том же явном non-blocking stream; при смене списка связей проводится синхронизация и пересоздание. Обе вспомогательные графовые операции остаются доверенным NVIDIA runtime/PTX срезом, **не являются** автоматически Lean-certified семантикой. Без `task verify-gpu-adamw`, `task verify-gpu-feedback-runtime` и новых benchmark нельзя заявлять ни аппаратную корректность, ни ускорение. GPU AdamW остаётся экспериментальным, host остаётся default; общий multi-tensor/region fusion и proof of hardware FP32 correctness не реализованы.

### P2 GPU training numerical equivalence acceptance (code, NVIDIA run pending)

`task verify-gpu-p2-equivalence` runs the ignored multi-step exact
D2D-vs-host state-feedback regression and existing pointwise-fusion GPU
parity tests. The `TORUS16_VERIFY_FUSION` opt-in path runs the real EMA4
training graph both unfused/fused with identical next-window token and CE
labels, checks every logit, parameter gradient and terminal state as FP32
bits, and drops the baseline CUDA session before preparing the fused one.
Isolated 2+resume-to-4 and fresh 4-window executions compare CE/BPC and
AdamW step logs and byte-for-byte checkpoint contents. The check must not
reuse the user's primary checkpoint or infer any hardware result before the
actual NVIDIA run. This verifies a bounded numerical execution fixture,
not a formal FP32/PTX/JIT/SASS theorem; longer-horizon and
architecture-agnostic equivalence remain open.

### P3 experimental GPU AdamW (code only, NVIDIA acceptance pending)

`GpuAdamWPlan` composes the existing graph's gradient nodes with universal
tensor arithmetic for AdamW, creates explicit first/second moment sources
and bias-correction scalar inputs, and exposes D2D feedback plans. EMA4
opt-in `TORUS16_GPU_ADAMW=1` appends the optimizer to the same reverse
Semantic IR/CUDA Graph, eliminating per-window host AdamW, gradient
readback and trainable parameter uploads. One batched D2H finite-domain
validation of updated weights remains compulsory, because model parameter
sources require `Domain::Finite` and current FP32 graph operations cannot
prove it statically. Checkpoints preserve the legacy durable schema,
including moment tensors and cursor. No measured speedup or GPU utilization
claim; there are extra optimizer IR kernels. `task verify-gpu-adamw`
covers structural compilation, host numerical comparison, GPU bitwise
restart and EMA4 2+2 vs 4. Numeric discrepancy relative to CPU is
reported separately from strict GPU restart identity; CUDA/JIT/SASS and
arbitrary FP32 equivalence remain unproved.

### Independent CUDA Graph multi-stream scheduling (code; hardware acceptance pending)

The architecture-neutral `GpuEngine::prepare_independent` validates every
member of a batch of *independent* source inventories before allocating CUDA
resources, then prepares owned `GpuExecution` instances. Each owns its
CUDA Graph, allocations and explicit `CU_STREAM_NON_BLOCKING` stream in
the retained shared primary context. `GpuExecution::enqueue_replay` queues
work without a stream barrier; `complete_replay` synchronizes and publishes
the correct output epoch. `GpuExecution::replay_independent_batch` queues
all members before waiting, draining earlier launched sessions on enqueue
failure and waiting for every stream after a synchronization failure. The
single-session synchronous `replay` API remains unchanged.

While a graph is queued, all input updates, output readbacks, feedback,
benchmarks and repeat launches fail closed with `GpuError::ReplayPending`.
A failed CUDA enqueue/synchronization still permanently poisons the affected
session, and CUDA stream teardown synchronizes before freeing allocations.
This is real concurrent *independent* graph submission, not shared-weight
minibatch training, not gradient accumulation and not a guarantee of hardware
overlap. `task verify-gpu-independent-batch` checks bitwise serial/batch
parity, epochs, pending restrictions and new inputs; `task
benchmark-gpu-independent-batch` reports wall-clock serial vs queued replay
for four independent sessions. The GPU runtime remains CUDA Graph-only,
with no legacy streams or kernel launches outside Graph. Hardware acceptance
and throughput have not been executed by the agent.

**Still open:** a verified GPU-side compact finite-domain guard (the GPU
AdamW path still uses full D2H validation of changed Finite parameters),
more general multi-operation/region kernel fusion, tensorized *shared-weight*
minibatches with correct state separation and gradient aggregation, and a
sustained EMA4 end-to-end throughput comparison. Scheduling independent
programs does not automatically accelerate single-sequence EMA4 BPTT.

### Strict-order three-operation Sqrt→Add→Div fusion (code, hardware acceptance pending)

The opt-in architecture-neutral pointwise fusion pass now recognizes
`Div(numerator, Add(Sqrt(x), epsilon))` only when both intermediate nodes
are unobserved and have exactly one reachable consumer and all three source
tensors have identical shape. The original operand order of `Add` is
preserved. The generated three-input CUDA Graph kernel emits separate
`sqrt.rn.f32`, `add.rn.f32`, `div.rn.f32` instructions, retaining each
FP32 rounding boundary. The fusion removes two kernels per matched chain
but may not alter wall-clock time beneficially. A source-derived capability
plan explains both removed nodes, memory contracts validate three source
extents, and translation validation checks LLVM operand wiring and ordered
PTX instructions before device execution. No Lean IEEE/SASS theorem follows
from these structural checks.

`task verify-gpu-sqrt-add-div-fusion` exercises operand order, observed
intermediates, fan-out negatives, translation-plan serialization and actual
NVIDIA bitwise fused/unfused results. The generic GPU AdamW plan's unit
test checks that this fusion reduces its denominator expression. All GPU
and Cargo acceptance remain to be run by the developer. Full arbitrary
pointwise-region fusion and runtime-domain predicates remain open.

### P3 acceptance follow-up: rank-general scalar GPU broadcast (code, pending rerun)

The GPU `BroadcastScalar` memory contract and lowering already read source
index 0 and write one lane per output index. The former artificial target
shape restriction `[1,N]` has been lifted for scalar sources with exactly
one element, allowing zero-rank AdamW coefficients to broadcast to tensors
of any supported shape, including rank-1, rank-2 and rank-3 parameters.
General broadcasting of non-scalar sources remains GPU-unsupported and
fails closed, even where the Semantic IR shape rule permits it. CPU structural
and NVIDIA bit-pattern acceptance cases were added to `gpu_adamw`.
The AdamW GPU parity test now uses checked-domain feedback, retains both
checkpoint snapshots across restart, and specifies `f32` for floating
bit-pattern expectations. Hardware acceptance and throughput are not yet
established by these source repairs.

### P3 GPU AdamW hardware acceptance and measured throughput (developer-run)

On the tested NVIDIA system, `task verify-gpu-adamw` passed CUDA checks for
FP32 tolerance against the CPU AdamW oracle, GPU optimizer bitwise restart,
and finite-domain feedback validation. The four-window EMA4 checkpoint/resume
versus continuous training check passed byte-for-byte. `task check` and strict
`task clippy` passed; `task test` exposed a stale negative scalar
broadcast test in `structural_last_row.rs`, updated to accept scalar target
shape `[2,6]` while rejecting genuine axis-wise non-scalar broadcasting.

The first 256-window end-to-end benchmark on that system found **host AdamW
132.83 tokens/s** (3.854478 s, 6,892 post-fusion CUDA kernels per replay),
versus **GPU IR AdamW 61.17 tokens/s** (8.369581 s, 9,638 post-fusion
kernels). GPU AdamW was **2.17x slower** for this BPTT=2, width-48 model;
2,746 additional tiny kernels per replay are consistent with high GPU
scheduling overhead. This is not a profiler-proven breakdown. CPU AdamW
remains the default; GPU AdamW is experimental. Independent CUDA Graph
scheduling speedup is a separate benchmark, not single-sequence EMA4 speedup.

**Next performance acceptance criterion:** generic region/multi-output
pointwise fusion or true shared-parameter minibatch training must improve
wall-clock training throughput; a lower kernel count alone is insufficient.
Preserve FP32 order/rounding, memory contracts and hardware parity tests.

### Bounded four-op pointwise fusion, four-source CUDA Graph lowering (code, hardware pending)

The opt-in architecture-neutral compiler now recognizes the exclusive
shape-preserving subgraph `Div(Add(Mul(Mul(a,b), a|b), c), d)`.
It emits a single four-source CUDA Graph kernel with four separate
`mul.rn.f32`, `mul.rn.f32`, `add.rn.f32`, `div.rn.f32` instructions.
The repeated first multiplicand is reused in registers, and both operand
order selectors are represented explicitly in a versioned
`TranslationKind::MulMulAddDiv`. Each intermediate must have exactly
one reachable use, be unselected, and have the exact root shape. Shared
or observable intermediates fail to fuse. The capability report records all
three removed kernels, the memory contract bounds all four full-shape
sources, and the LLVM/PTX translation validator checks operand binding
and rounded instruction sequence. The CUDA runtime `launch4` captures
the kernel on the existing owned non-blocking stream, never the default
stream and never outside CUDA Graph capture.

This general pattern occurs in the second-moment update and bias
correction of the optional GPU AdamW, without introducing a specialized
optimizer kernel. Structural and independent NVIDIA bitwise comparisons
over all eight operand-order combinations are in
`task verify-gpu-four-op-fusion`; `task verify-gpu-adamw` checks optimizer
integration and restart. The end-to-end gate is
`task benchmark-gpu-adamw` using the same 256-window fixture as before.
The existing CPU baseline measured 132.83 tokens/s while the previous
GPU implementation reached 61.17 tokens/s. A smaller post-fusion kernel
count is not proof of faster execution; do not select GPU mode by default
unless measured sustained throughput improves. Full arbitrary-size
pointwise region fusion, source-sharing across arbitrary fanout, and
formal IEEE/SASS equivalence remain unsupported.

### Four-source selected-root diamond fusion after hardware regression (code, GPU pending)

The developer's first run of the bounded linear `Mul→Mul→Add→Div` fusion
passed its standalone NVIDIA FP32 parity test, but `task test` and the GPU
AdamW structural test failed: it expected one linear fusion while observing
zero. EMA4 reported `four_op_fusions=0` for both paths. The cause was
structural, not a CUDA rounding failure: the intermediate updated
second-moment `v` is a selected output for device feedback/checkpoints.
The linear rule must not erase that observable value. Measured on that
same run: CPU AdamW 158.17 tokens/s (3.236955 s/512 tokens, 6892 kernels);
GPU AdamW 66.05 tokens/s (7.752278 s, 9638 kernels). The GPU mode
remained significantly slower and is not recommended by default.

A separate architecture-neutral `MulDiamondAdd` rewrite now fuses
`Add(Mul(a,b), Mul(Mul(c,d), c|d))` when exactly three Mul values are
exclusive and full-shape. Unlike the linear Div-root rewrite, its Add
root remains a live output even if selected and can feed both the
next graph operation and feedback/checkpoint. The capability plan
checks the complete four-source memory contract and each removed
Mul producer; the versioned translation plan and LLVM/PTX audit
check every intermediate RN instruction and both operand orders.
The new kernel is captured via the existing four-input nonblocking
CUDA Graph API, with no standalone launch or lab-specific kernel.
`task verify-gpu-diamond-fusion` checks all eight selector combinations
plus selected/shared intermediate negative cases and NVIDIA bit parity.
GPU AdamW's structural fixture now requires exactly one diamond fusion
and **zero** linear Div-root fusion. EMA4 reports `diamond_fusions`.
The GPU AdamW acceptance and end-to-end benchmark must be rerun
after this change; no speedup is claimed yet. GPU-side finite-domain
validation without D2H remains open.

### Оптимизация GPU AdamW: групповой runtime и горизонтальное объединение IR

**Реализованный экспериментальный код, NVIDIA-приёмка и ускорение не подтверждены:**

- **P0:** EMA4 в режиме `TORUS16_GPU_ADAMW=1` не экспортирует градиенты как публичные outputs. Градиенты остаются внутренними зависимостями обновления AdamW. CPU-режим сохраняет исходный список выходов.
- **P0:** runtime `CudaSession` проверяет несколько тензорных доменов одной kernel-node на bucket и копирует независимые feedback-связи побитовым grouped CUDA Graph kernel вместо отдельной D2D node на тензор. Для обоих путей размерные bucket'ы и таблица дескрипторов фиксируются при захвате. Динамический guard возвращает на CPU status **до** любой записи; aliasing и невалидные адреса отвергаются заранее. CUDA/PTX остаётся TCB.
- **P1 (ограниченный срез):** `GpuLaunchConfig::with_internal_pointwise_fusion()` разрешает горизонтальное объединение двух независимых внутренних Add/Mul узлов одинаковой формы, с не более чем 64 просматриваемыми предыдущими кандидатами. Обе FP32 операции остаются независимыми и записывают два отдельных буфера. Используется существующий translation/memory/capability audit. В EMA4 опция включена только для экспериментального GPU AdamW. **Произвольный region fusion / grouped multi-tensor compute пока не реализованы.**
- **P2:** device-conditional feedback и tensorized shared-weight minibatching **не реализованы**. Первый требует согласованной семантики deferred host error и аппаратной проверки CUDA conditional nodes; второй требует доказанной границы агрегирования градиентов. Нельзя выдавать `prepare_independent` за shared-weight minibatch.

**Приёмка пользователем:** `task check`, `task test`, `task clippy`, `task verify-gpu-feedback-runtime`, `task verify-gpu-dual-pointwise-outputs`, `task verify-gpu-adamw`, `task benchmark-gpu-adamw`. В GPU тесты добавлены heterogeneous sizes, атомарный отказ guard, internal dual-output parity, а в обычные unit tests добавлены проверки bucket-плана и сохранения битов таблицы дескрипторов. Ускорение признаётся только по повторённой end-to-end производительности; количество kernels не является достаточным доказательством.


### Последующий runtime-срез: индекс выделений, стабильные планы, CUDA-event диагностика

В `CudaSession` таблица собственных device allocations теперь имеет адресный индекс `BTreeMap`, а порядок освобождения остаётся прежним. В неизменном захваченном `guard_graph` и `feedback_graph` валидированная таблица дескрипторов переиспользуется без повторного полного прохода по буферам. Любая смена адреса, размера или доменного требования выполняет новый fail-closed preflight и recapture. Проверка **самих FP32-значений** обязательна на каждом checked feedback, вне зависимости от кеша метаданных.

Для аппаратной локализации оставшихся затрат добавлен `GpuExecution::feedback_state_checked_device_profiled` и диагностический флаг лаборатории `TORUS16_GPU_FEEDBACK_EVENTS=1`. Флаг добавляет CUDA events вокруг **одного** исполнения grouped feedback Graph, не повторяя обновление. `feedback_device_event_ms` относится к stream elapsed time; `feedback_copy_sync` и `feedback_total` остаются host-wall измерениями. Первый запуск может включать ожидание host recapture между event record и graph launch; выводы следует делать на прогретых окнах. Включённый флаг добавляет явную event synchronization, поэтому **throughput в таком режиме не сравнивать** с обычным CPU/GPU benchmark. Без флага прежний путь не создаёт event-объекты и не получает новый барьер.

**Приёмка в dev: ожидается developer-run, здесь не подтверждена.** `task check`, `task test`, `task clippy`, `task verify-gpu-feedback-runtime`, `task verify-gpu-adamw`, затем `task benchmark-gpu-adamw` без event-флага. Отдельно `TORUS16_GPU_FEEDBACK_EVENTS=1 task benchmark-gpu-adamw` для сравнений `feedback_device_event_ms` vs host feedback time (скорость при флаге не учитывать). GPU tests проверяют повторный feedback, смену плана, профиль events и атомарный отказ домена. P2 device-conditional feedback и shared-weight minibatching пока не реализованы: эта работа не заменяет их и не расширяет Lean/FP32 сертификат.

**Проверка developer-run 2026-10-25 для предыдущего среза:** `task check`, `task test`, GPU feedback (3/3), GPU AdamW (4/4), побитовое checkpoint/resume совпадение прошли. `task clippy` остановился на `clippy::nonminimal_bool` в индексированной проверке адресов; эквивалентный предикат `Option::is_none_or` исправлен отдельным коммитом и ожидает повторной проверки. Один end-to-end benchmark на 256 окнах, BPTT=2: CPU 162,51 токена/с (3,150631 с), GPU IR 246,55 токена/с (2,076640 с), отношение скорости ≈1,52; измеренный `feedback_total` 0,6510 мс. `feedback_events=false`, то есть CUDA-event диагностика в этом прогоне **не выполнялась**; `feedback_device_event_ms=0` здесь не является длительностью GPU-копирования. Прирост требует нескольких повторов и сравнения медиан; Lean/IEEE/SASS доказательства этот запуск не добавляет.

### Продолжение: кешированный feedback preflight на уровне GpuExecution

Профиль разработчика с `TORUS16_GPU_FEEDBACK_EVENTS=1` подтвердил `feedback_device_event_ms=0.0285` мс при общем `feedback_total=0.6255` мс (256 окон, BPTT=2), `feedback_validation_d2h=0.1489` мс, `feedback_copy_sync=0.0751` мс. Остаток `0.4013` мс измерениями пока **не атрибутирован**. Проход по исходнику обнаружил повторное вычисление `feedback_copy_plan`, построение output lookup, списков domain-check и transfers на каждом вызове; это **гипотеза** для ускорения, а не доказанная причина всего остатка.

Новый ограниченный runtime-патч кеширует подготовленную схему `GpuExecution` по точному списку `(state,next)` и флагу runtime-domain checks, вместе с размерами, доменными требованиями и D2D transfers. Cache miss запускает полный предыдущий preflight; проверка актуальных FP32 битов на GPU остаётся **обязательной на каждом checked feedback**, включая повторы. Добавлена метрика `feedback_plan_host` для отделения host preflight/lookup от прочих этапов, а также GPU-regression `finite → finite → overflow` при неизменных связях для подтверждения отсутствия кеширования результата проверки значений.

**Проверки после патча пользовательские, ещё не выполнялись:** `task check`, `task test`, `task clippy`, `task verify-gpu-feedback-runtime`, `task verify-gpu-adamw`, `task benchmark-gpu-adamw`. Никакого device-conditional feedback, shared-weight minibatching или Lean/IEEE/SASS доказательства эта оптимизация не добавляет.

### Torus16-Mix: парное обучение LM с независимыми и преобразованными общими матрицами (код, developer-run ожидается)

**Исследовательская гипотеза (не вывод):** одна физическая матрица `W` для восьми ролей Torus16-Mix в каждом рекуррентном блоке может приближаться по качеству к восьми независимо обучаемым матрицам при меньшем числе параметров. Реализованное сравнение касается **разделения весов внутри Torus16-Mix**, а не одной общей матрицы для всей четырёхслойной EMA4-LM.

Лабораторный API `ema4::MatrixMode::{Independent,TorusShared}`, `architecture_model_for(vocab, mode)`, `Ema4Weights::{bindings_for,trainable_parameters_for,parameter_count_for}` строит обе версии исключительно через публичные Rust/VeriNeural ModelBuilder, Semantic Neural IR, autodiff BPTT, CUDA Graph и общий GPU IR AdamW. В `Independent` каждый из восьми projection role в каждом из четырёх EMA4-блоков имеет собственную матрицу 48×48; в `TorusShared` одна матрица 48×48 на блок преобразуется существующими роль-специфическими roll, transpose, row/col scale и gate. Остальные блоки, история Conv9, EMA память, embedding/head, роли, корпус и loss без изменений. **Все независимые W инициализируются побитовой копией W общего варианта**, чтобы начальные вычисления отличались только идентичностью объектов параметров, не значениями. Отсутствие численной ошибки GPU не является формальной теоремой о FP32.

На исследовательском корпусе 104 символа из существующего `corpus_snapshot.txt`: одинаковый хронологический 90/10 split, порядок токенов, нулевые состояния в начале и единые AdamW (lr 0.002, wd 0.01), BPTT=2. Параметров при 104-символьном словаре: **24 908** для `TorusShared` (4 матрицы), **89 420** для `Independent` (32 матрицы), прочие 15 692 параметра одинаковы. Эффект оценивается по `train_bpc` и его кривой (последовательные блоки по 1024 окна), по финальному `holdout_reset_streaming_bpc` на одном и том же validation fragment и по tokens/s/времени. Различия в числе параметров отражать явно: эксперимент сравнивает expressivity vs parameter efficiency, не равный budget и не доказывает превосходство архитектуры по одному seed.

Команда: `task compare-torus16-matrix-tying` (по умолчанию 16 384 окна × BPTT 2 и 512 validation chars, GPU AdamW; выполнение только локально на машине разработчика). Для продолжительного эксперимента доступны окружения `TORUS16_TRAIN_WINDOWS` (до 131072, с проверкой длины корпуса), `TORUS16_BPTT`, `TORUS16_VAL_LIMIT`, `TORUS16_CHECKPOINT_EVERY`, `TORUS16_MATRIX_ABLATION_DIR`, `TORUS16_CORPUS`. Результаты и отдельные checkpoints сохраняются в `target/torus16-matrix-ablation/{independent,torus_shared}.*`. Для одиночного прогона `TORUS16_MATRIX_MODE=independent|torus_shared` задаёт режим у существующего `ema4_bptt`, а старые вызовы по умолчанию сохраняют `torus_shared`. Модели отличаются явно именованными trainable W; попытка привязать независимые bindings к общей модели должна отвергаться.

Приёмка: `task check`, `task test`, `task clippy`, опционально `task verify-torus16-matrix-initial` для bitwise NVIDIA parity на начальных logits/EMA state, далее пользовательский `task compare-torus16-matrix-tying`. Проверять успех обоих прохождений, валидность checkpoint каждого режима, конечность train/holdout BPC, динамику train loss и полезность параметрического сжатия. **Никакой PyTorch parity, PyTorch зависимости или lab-specific CUDA kernel**. Никаких Lean-доказательств обучения/сходимости/оптимальности и статуса FP32/SASS certified не заявлять; результаты до локального прогона неизвестны.

### Torus16-Mix P1/P2: проверка обучения и воспроизводимые прогоны (патчи, developer-run ожидается)

Новый исследовательский срез сохраняет **только Rust + публичный VeriNeural API**: двухшаговый BPTT, autodiff, собственные CUDA Graph ядра VeriNeural, GPU IR AdamW, строгий режим проверки текущих доменов. Отдельных лабораторных kernels, Python/PyTorch либо PyTorch-parity нет.

**P1:**
- `Ema4Weights::deterministic_seeded(vocab, seed)` предоставляет воспроизводимую матричную инициализацию по целочисленному mixing, без скрытого RNG. `seed=0` сохраняет старые значения. `RoleInit::{Matched,Diverse}` для Independent: Matched оставляет побитово одинаковые исходные матрицы всех восьми ролей (контролируемое исследование weight tying), Diverse даёт независимые по роли воспроизводимые начальные значения. Остальные слои, embedding, decay, norm и роли не меняются между парными прогонами.
- `task verify-torus16-matrix-gradients`: отдельная NVIDIA численная проверка, что VJP по общей матрице совпадает в пределах явной FP32 погрешности с суммой восьми VJP по независимым ролям при Matched.
- `task verify-torus16-matrix-training`: аппаратный gate на настоящем 4-layer BPTT2/IR GPU AdamW и fused/unfused выходах/градиентах; в каждом режиме выполняет два окна, возобновляет до четырёх и сравнивает checkpoint с непрерывными четырьмя окнами побитово. Наблюдения не равнозначны Lean-сертификату GPU/FP32.
- `task compare-torus16-matrix-tying` по умолчанию 65 536 окон × BPTT2, 4096 holdout chars, validation каждые 8192 окна (и в конце) и checkpoint каждые 4096. Для полного train диапазона доступен `TORUS16_TRAIN_WINDOWS` до 1_000_000 с реальным ограничением длиной корпуса. Устанавливать `TORUS16_MATRIX_SEEDS="0 1 2"` для повторов; `TORUS16_INCLUDE_DIVERSE=1` включает третий, независимо инициализированный режим. Каждый seed берётся одинаковым в парных Matched-прогонах. Больше окон и повторов нужны для статистически содержательных выводов о holdout BPC, но также повышают время и расход GPU.

**P2:**
- Checkpoint **v2** содержит `architecture_fingerprint`, вычисленный из упорядоченных операций, входных зависимостей, формы, dtype, численных контрактов и профиля FP32 Semantic IR, выходов/состояний, seed/role_init и битовых значений начальных именованных тензоров. Сигнатура FNV64 служит **только детектором несовместимости**, не криптографической аттестацией и не доказательством корректности вычисления. Изменение математики, seed, значений constants или режима инициализации приводит к fail-closed reject до продолжения обучения.
- Checkpoint **v1 больше не читается** (небезопасная автоматическая миграция запрещена). Старые исследования остаются на диске; новый эксперимент начинается с чистого checkpoint в новой папке или при явно выбранном `TORUS16_FRESH`.
- При `TORUS16_EVAL_EVERY` выполняется reset-state chronological holdout на **одинаковом** фрагменте validation без обновления параметров. Validation boundary всегда сопровождается snapshot состояния и optimizer; печатаются `validation_window`, `holdout_reset_streaming_bpc`, `train_curve_window`. Лучший по этой метрике checkpoint сохраняется в `<name>.best.ckpt`; основной checkpoint продолжает фиксировать **последнюю** точку обучения и `best_validation_bpc` для корректного resume.
- `task compare-torus16-matrix-tying` возобновляет отдельные запуски из `<mode>-<init>-seed<seed>.ckpt` при наличии совместимого checkpoint (по умолчанию); `TORUS16_MATRIX_ABLATION_FRESH=1` принудительно создаёт свежий. Файлы `*.log`, `*.train_curve.log`, `*.validation_curve.log` хранят измерения; предшествующие interrupted log windows могут перекрываться при resume, поэтому для чистого графика использовать `validation_window` и подтверждённый cursor checkpoint, не считать каждую строку уникальным шагом. Счётчик времени при нулевых новых окнах не выдаётся за вновь измеренную производительность.

**Критерий приёмки:** `task check`, `task test`, `task clippy`, `task verify-torus16-matrix-initial`, `task verify-torus16-matrix-gradients`, `task verify-torus16-matrix-training`, затем `task compare-torus16-matrix-tying`. Это рекомендации для запуска на машине разработчика, **здесь ни Cargo, ни GPU обучение не выполнялись**. При ненулевых расхождениях/ошибках остановить исследование и исправлять причины. Никаких заявлений о сравнительном качестве моделей до фактических BPC-логов.

### Torus16-Mix: приоритетные исправления после P1/P2 code review (developer-run ожидается)

**P0: формат и компиляция.** Убран лишний позиционный аргумент вывода `experiment_matrix_mode=...`; теперь число аргументов соответствует шаблону. Эта правка сама по себе не означает успешный `cargo check`.

**P1: корректная постановка эксперимента.** `architecture_fingerprint` вычисляется **после построения фактического execution_graph** с BPTT-unroll, CE cotangents, reverse autodiff и (для GPU пути) общим `GpuAdamWPlan::append`; дополнительно включает профили optimizer backend, seed, role init, подписанные именами и ролями источники исходного `Model`, начальные значения входных параметров/констант, `TORUS16_VAL_LIMIT`, `TORUS16_TEST_LIMIT` и `TORUS16_EVAL_EVERY`. При resume полный v3 fingerprint и перечисленные параметры проверяются **до первого GPU replay**. Смена только длины `TORUS16_TRAIN_WINDOWS` не ломает продолжение, как и раньше. Checkpoint v1/v2 не мигрируют неявно. Fingerprint — FNV64 compatibility checksum, не криптографическое доказательство и не FP32/SASS-сертификат.

**P1: межархитектурная GPU-проверка.** `task verify-torus16-matrix-training` снимает **битовый снимок logits каждого шага BPTT2 и всех terminal recurrent states в первом training replay**, затем сравнивает их `cmp` между Matched Independent и TorusShared при одинаковых токенах и начальных параметрах. Fused/unfused output-gradient parity, независимые checkpoint/resume для каждого режима и 4-шаговая непрерывная контрольная траектория сохраняются. `task verify-torus16-matrix-gradients` проверяет **все четыре блока**, каждый — против суммы восьми role-specific VJP, с явно ограниченной FP32-погрешностью. Тест в этом режиме сравнивает один recurrent inference step; BPTT-градиенты двух архитектур не заявляются битово эквивалентными.

**P2: выбор и финальная оценка.** `holdout_bpc` оценивает интервалы одного и того же исторического validation split. Префикс длины `TORUS16_VAL_LIMIT` используется **только** для периодической validation/выбора лучшего checkpoint. Отдельный суффикс длины `TORUS16_TEST_LIMIT` используется **только** для итогового `test_reset_streaming_bpc` на параметрах **best-validation checkpoint**, а не последнего обучающего шага. Пересечение интервалов запрещено fail-closed. Значения по умолчанию у `task compare-torus16-matrix-tying`: 4096 validation + 4096 test chars; для GPU-smoke: 2 + 2. `TORUS16_FRESH` удаляет только старый best-checkpoint именно выбранного пути после успешной подготовки нового GPU-сеанса, чтобы исключить случайное использование прежнего best. Добавлены отрицательные тесты incompatibility для изменённого training IR, validation/test schedule и реально другой схемы Independent вместо синтетического `identity+1`.

Порядок пользовательской приёмки: `task check`, `task test`, `task clippy`, `task verify-torus16-matrix-initial`, `task verify-torus16-matrix-gradients`, `task verify-torus16-matrix-training`. Только затем долгий `task compare-torus16-matrix-tying`; при ошибке любого gate исследование останавливается. Реальные результаты BPC и прохождение CUDA-тестов пока **не подтверждены**; только статическая проверка опубликованных изменений.

## P0: reuse идентичных GPU kernel specialization (подготовленный срез, локальная приёмка ожидается)

`GpuEngine::compile_outputs` сопоставляет LLVM NVPTX-функции по **точному совпадению сгенерированного тела** после исключения исключительно синтетического имени `vn_node_{id}`. Таким образом, разные Semantic IR узлы с идентичным ABI, FP32-инструкциями, порядком операций и захваченными константами имеют один PTX entrypoint, сохраняя **отдельные CUDA Graph kernel nodes**, указатели, длины и зависимости. `GpuProgram::kernel_count()` продолжает возвращать число исполняемых graph nodes, `unique_kernel_count()` и `kernel_entry(node)` показывают число уникальных функций и отображение узла на владельца специализации.

`TranslationPlan` версии `v2` сохраняет `entry_node` для каждого логического узла и проверяет каждый его semantic/memory contract по LLVM/PTX-функции владельца. Missing/extra entrypoints, forward/unknown owner и нарушение FP32/shape templates отклоняются. Reader сохраняет совместимость с v1, в котором `entry_node = node`; старый v1-артефакт нельзя неявно переинтерпретировать как план с общими функциями. В опциональном `VERINEURAL_GPU_PREPARE_PROFILE` выводятся `graph_kernels` и `unique_functions` для атрибуции JIT-затрат.

Интернирование **не является kernel fusion**: число CUDA Graph nodes и потенциальная цена launch/replay остаются прежними. Цель среза — сократить модуль LLVM/PTX и работу JIT за счёт устранения идентичных entrypoints. Новые структурные и негативные регрессии находятся в `crates/verineural/tests/kernel_specialization_reuse.rs`; настоящий NVIDIA replay-тест помечен `#[ignore]` и требует отдельного запуска разработчиком. Показатели ускорения JIT, tokens/s, BPTT=16, численная GPU parity и Lean-сертификация аппаратного кода **не подтверждены**. После проверки этого среза отдельно профилировать узлы CUDA Graph и разрабатывать контролируемый fusion, не изменяющий FP32-порядок и контракты.

FILE	docs/verineural/SPEC.md
# VeriNeural
## Техническая спецификация архитектурно-независимого конструктора нейросетевых вычислений

**Тип проекта:** импортируемая Rust-библиотека, компилятор для NVIDIA GPU, минимальный CUDA runtime для запуска вычислений и система формальной верификации Lean 4.

**Назначение:** создание собственных нейросетевых архитектур, в том числе альтернативных Transformer для языкового моделирования, из математических операций, пользовательских алгоритмов и композиционных контрактов. VeriNeural предоставляет гибкий конструктор, а не готовую LLM или её инфраструктуру.

**Статус документа:** целевая спецификация без этапов/MVP. Реализованное подмножество и порядок разработки описаны в ROADMAP.md. Целевые требования ниже не означают, что всё уже реализовано.

### Границы продукта

- **Предмет разработки:** расширяемые вычислительные примитивы, Rust-контракты, вложенные блоки, параметризованные графы, Semantic Neural IR, компиляция в NVIDIA GPU, Lean-модели и композиционная проверка.
- **Уровни сборки:** операция → пользовательский блок → составной блок → полная архитектура. Модуль можно переиспользовать без копирования исходной математики на CUDA и Lean.
- **Не являются обязательными и не поставляются как готовая архитектура:** Transformer, стандартные Attention/MHA/GQA, KV Cache, специализированные MoE-роутеры, типовая LLM-инфраструктура, tokenizer, чат-сервис, serving API, распределённое обучение, оркестрация и деплой. Похожие функции автор вправе реализовать сам из универсальных примитивов.
- **Нужная исполняющая часть:** NVIDIA GPU compiler и минимальный runtime запуска/проверки GPU-кода. Отсутствие serving-инфраструктуры не означает отказ от CUDA Driver API.
- **Гарантии:** Lean доказывает только явно сформулированные свойства при их предпосылках. Корректность алгоритма не доказывает автоматически полезность, обучаемость, качество текста или производительность новой архитектуры.

## 1. Основные требования

Система должна обеспечивать:

1. Задание пользовательской математики и формальных контрактов на Rust в документированном поддерживаемом подмножестве.
2. Иерархическое построение параметризованных и переиспользуемых блоков, вложенных подграфов и произвольных поддерживаемых архитектур без LLM-шаблона.
3. Единый типизированный Semantic Neural IR, сохраняющий структуру композиции, зависимости, формы, параметры и контракты.
4. Генерацию из **одного IR** двух путей: LLVM NVPTX/PTX для NVIDIA GPU и Lean 4 моделей/теорем/обязательств доказательств.
5. Расширение вычислительного набора без ручного дублирования алгоритма на CUDA и Lean. Новый примитив должен иметь достаточную семантику и доказательства для запрашиваемого уровня гарантий.
6. Модульные доказательства и их композицию до уровня всей пользовательской архитектуры с собственными глобальными инвариантами.
7. Модели IEEE 754 binary32, точные численные доказательства или формально ограниченные погрешности при явных предпосылках.
8. Управление GPU-компиляцией: потоки, память, scheduling, fusion/tiling и FP32-политику с проверкой разрешённых преобразований.
9. Проверяемую привязку исходного IR, Lean-теорем, LLVM/PTX, параметров, профиля GPU и численно проверенных запусков к отчёту о TCB.
10. Отказ certified-build при неподдерживаемой операции, недоказанной обязательной цели или несовместимой композиции.

**Единый источник алгоритма и контракта — Rust-проект.** Это не обещание анализа произвольного Rust-кода: поддерживаемое подмножество и ограничения должны быть явными.

## 2. Общая архитектура

```text
                RUST SOURCE
          Modules + Math Contracts
                      │
                      ▼
               Rust Frontend
                      │
                      ▼
              Semantic Neural IR
                      │
           ┌──────────┴───────────┐
           │                      │
           ▼                      ▼
     GPU Compiler            Proof Compiler
           │                      │
     Fusion / Tiling         Lean 4 Models
     GPU Scheduling          Module Contracts
           │                 FP32 Semantics
           ▼                 Proof Obligations
         GPU IR                   │
           │                      ▼
           ▼                 Lean 4 Prover
        LLVM IR                   │
           │                      ▼
           ▼                 Proof Checker
       LLVM NVPTX                 │
           │                      │
           ▼                      │
          PTX                     │
           │                      │
           ▼                      │
    PTX Verification              │
           │                      │
           ▼                      │
     NVIDIA GPU                   │
           │                      │
           └──────────┬───────────┘
                      ▼
             Certificate Engine
                      │
                      ▼
     VERIFIED USER-DEFINED ARCHITECTURE
```

GPU Compiler и Proof Compiler используют один типизированный Semantic Neural IR с сохранёнными границами вложенных блоков, портами и доказательственными зависимостями.

Генерация LLVM IR и Lean 4 производится разными backend-компонентами, но пользовательские алгоритмы и контракты определяются только один раз. Lowering может разворачивать блоки для GPU, сохраняя проверяемое отображение на исходную иерархию.

## 3. Rust API и конструктор архитектур

Библиотека предоставляет архитектурно-независимый API для тензоров, вычислительных операций, параметров, явного состояния, контрактов и вложенной композиции. Обязательные требования к расширяемости операций, самостоятельным доказательствам пользовательских свойств и API без встроенных архитектурных монолитов уточнены в § 17.

Основные абстракции:

- `Tensor<T, Shape>` — тензор с проверенными размерами.
- `NeuralGraph` / `NodeId` — сборка вычислительного графа из поддерживаемых операций.
- `NeuralModule` — пользовательский или библиотечный блок с явным интерфейсом.
- `MathContract` — предусловия, постусловия и инварианты; при необходимости численные оценки.
- `FP32Policy` — требуемая численная семантика, не доказательство её соблюдения.
- **Целевое расширение конструктора:** параметризованные вложенные графы, иерархические области имён, повторно используемые блоки, экспортированные порты, состояния/переходы и пользовательские инварианты всей архитектуры.
- **Целевые типы результатов:** `Certified<T>` / `VerifiedKernel` только при наличии именно тех гарантий, которые они обещают. Ни численная проверка, ни успешная компиляция сами по себе не означают формальной сертификации GPU.

### 3.1. Пример пользовательской операции

Пример на действующем явном Rust DSL без шаблона Transformer:

```rust
use verineural::{NeuralError, NeuralGraph, NodeId};

fn custom_transition(
    graph: &mut NeuralGraph,
    state: NodeId,
    signal: NodeId,
    weights: NodeId,
) -> Result<NodeId, NeuralError> {
    let projected = graph.matmul(state, weights)?;
    let mixed = graph.add(projected, signal)?;
    graph.relu(mixed)
}
```

Реальные формы, домены и смысл `state` задаёт разработчик. Это **одно вычисление перехода**, а не уже реализованная рекуррентная машина или хранение долгосрочного состояния.

**Целевая иерархия:** такую функцию можно оформить модулем с `requires` / `ensures`, вложить много модулей в блок более высокого уровня и задать глобальный контракт архитектуры. Проверка крупного блока должна выводиться из проверенных свойств его частей, а не только из совпадения форм.

### 3.2. Пользовательская математика

- Поддерживаемые элементарные операции, включая линейную алгебру, редукции, индексацию и сравнения, образуют строительный материал, но не готовую LLM-архитектуру.
- Для новой операции явно задаются семантика, формы, домены, ограничения памяти, численная политика и обязательства доказательства. Разработчик не должен поддерживать три вручную синхронизируемые реализации алгоритма.
- Если расширение нельзя отобразить в поддерживаемые GPU IR и Lean-модель, оно получает статус `unsupported`. Это блокирует сертификацию, если соответствующая гарантия обязательна.
- Повторно используемые блоки должны иметь стабильную идентификацию и параметризацию для кеширования проверенных лемм и прослеживаемости отчёта.
- Динамические формы, ветвления, циклы, состояния и связи по времени имеют **явную семантику**. Подмножество без реализованной проверки не принимается под видом готовой сертифицированной функции.

### 3.3. Именованный frontend (реализованный узкий срез)

`ModelBuilder` предоставляет `input`, `parameter`, `block`, `output`, `proof_goal` и `finish`. `NeuralGraph::compose_inferred` выводит структурный контракт непосредственно из IR, проверяет границы и скрытые зависимости, атомарно фиксируя только корректные блоки. `Model::bind` проверяет полный набор именованных тензоров, формы и домены; `Model::plan` передаёт все выходы и явные цели в существующий `ArchitectureAutoCompiler`.

Это не отдельный IR и не Lean-доказательство без запуска checker. Роли input/parameter/state сохраняются как metadata над тем же IR, а temporal mutation реализуется только runtime-слоем из §3.5. Встроенного optimizer-а и автоматического доказательства FP32/SASS нет.

### P2 rotating-matrices: минимальные операции и подготовка consumer (код; локальная приёмка ожидается)

В `Tensor<T>` доступны `from_vec`, `from_slice`, `zeros` с общей `Shape::new`-валидацией. Host f32 reference дополнен `sub/div/exp/reduce_max` и явным правосторонним `broadcast_to`. Rust graph вводит `reduce_max(input, axis)` и `broadcast_to(input, Shape)`; `sub/div/exp` десахарятся в типизированный `PointwiseSpec` AST, в котором сохраняются идентификатор, версия и математическое выражение. Это не готовый softmax, пользователь компонует его из узлов сам.

Shape validation, обязательный `DType::F32`, детерминированная row-major перестановка и canonical IR/DOT видимость покрываются Rust-кодом и тестами. `reduce_max` сохраняет первый максимум, при NaN выдаёт NaN; broadcast повторяет только singleton-оси. Произвольный NumPy-like implicit broadcasting для арифметики не разрешается. `PointwiseExpr::Sub/Div/Exp` **не имеют** модели ideal-Int в Lean: доказательный backend отклоняет их до генерации Lean. `ReduceMax/BroadcastTo` также Lean/GPU unsupported, как и новые pointwise операции на GPU. Никакого фиктивного сертификата/заявления FP32/IEEE equivalence нет. Эти ограничения должны быть сняты отдельным доказуемым вертикальным срезом.

Лаборатория перенесена на `Tensor::from_slice`; повторная публикация certified bundle, SHA-256 и Graphviz остаётся исключительно за Stage 10 (`Model::certify`), без локального `write_architecture_manifest`, ручного SHA/copy. Structural/index routing P0 имеет узкий GPU lowering; локальная сертификация всё ещё требует реального Lean/LLVM прогона и не означает IEEE-754/JIT/SASS доказательства.

### 3.5. P1 state transition и named CUDA Graph replay (API-срез; локальные проверки ожидаются)

`ModelBuilder::state` регистрирует источник с ролью State; `next_state` объявляет один чистый переход с проверкой формы, типа и домена. Эти связи входят в identity и являются самостоятельными IR roots. `block_multi` выводит структурные контракты именованных выходов атомарно, без неявных математических доказательств.

`GpuEngine::prepare_model` принимает полные initial bindings и компилирует общий CUDA Graph. `ModelExecution` владеет копией только именованной runtime-metadata (source roles, outputs, state links), а не заимствует `Model`; поэтому consumer может владеть finished model и execution в одной структуре без self-referential lifetime. `set_input/set_parameter/set_state` обновляют только запрошенный буфер; `run` исполняет replay без изменения state; `step` после replay переносит `next_state → state` через явный `cuMemcpyDtoDAsync_v2` на non-blocking CUDA stream. Runtime ABI теперь сохраняет dtype: `TensorValue::F32` и `TensorValue::Index` используются `GpuExecution::read_value/read_values`, `GpuEngine::execute_value/execute_values` и `ModelExecution::output_value`; CUDA `Index` читается как `i32` и проверяемо преобразуется в host `usize`. Старые F32-only `read_output/read_outputs/execute/output(name)` сохранены для совместимости, но при `DType::Index` fail-closed через dtype mismatch вместо переинтерпретации битов как `f32`. `state` остаётся F32, потому что публичные source tensors текущего профиля F32. Прежний `GpuExecution` сохранён.

**Аппаратная приёмка P1, реализация теста:** `task gpu-state-replay` запускает в том же CUDA Graph модель с двумя публичными выходами и скрытым feedback-результатом. Независимые точные FP32 fixtures сравнивают результаты `run()` и пяти последовательных `step()`, проверяют накопление state после D2D, повторное использование parameters, обновления по имени, reset и fail-closed для неверных source role/shape/domain. CUDA Graph создаётся только при `prepare_model`, а не между шагами. Задача не входит в обычный `task test`, требует CUDA/LLVM и должна быть подтверждена локальным запуском.

Граница гарантий: IR остаётся чистым DAG; temporal replay не является Lean-доказательством рекуррентного алгоритма, исполнения CUDA или FP32/SASS. Unsupported GPU operations отклоняются. Для rotating-matrices добавлен узкий GPU lowering профиль structural/indexing P0: rank-2 transpose, rank-2 reverse по axis 0/1, contiguous concat по axis 0, rank-2 last-axis `ArgMax(First)` и scalar `Take` по axis 0. Для этого профиля memory contracts теперь порождают проверяемые Lean-обязательства границ фактических row-major адресов; `Take` требует явную предпосылку `selected < choices`. Остальные формы fail-closed; deterministic rotating-matrices runtime исполняет единый architecture graph через `ModelExecution`: sequence-wide parameters/dictionary загружаются именованно, token обновляется по шагам, а recurrent state переходит `next_state → state` D2D без host rebinding. Host чтение `next_state` остаётся только диагностикой Trace, не источником следующего шага. Stochastic/fixed-route training также использует named `ModelExecution`: host sampling выбирает один из восьми route-specific графов, но spatial rotation базового core строится `permute/reverse_axis` внутри IR, без host-derived `rotated_weight`. Все объявленные state sources обязательно входят в GPU execution roots, даже если `next_state` игнорирует прежнее состояние. До первого replay проверяется layout D2D feedback; публичные выходы, делящие GPU allocation с state, получают повторно используемые device snapshots до обратной связи. Поэтому `output(name)` после `step` относится к чистому вычислению до обновления state, включая `Reshape`-алиасы. Несколько feedback-копий с опасными взаимными alias-перекрытиями по-прежнему отклоняются. При ошибке CUDA D2D-очереди, переноса output snapshots либо stream synchronization `GpuExecution` становится необратимо `ExecutionPoisoned`: любые последующие replay, чтение, rebinding и feedback отклоняются до создания нового execution. Предварительная ошибка проверки формы/домена/aliased layout **не** отравляет сессию. Это fail-closed поведение, а не транзакционный rollback уже поставленных DMA: частично обновлённые значения после ошибки нельзя считать достоверными. Отдельный CUDA fault-injection не заявлен проверенным: Rust-тесты имитируют результат transfer/sync через общий health gate.

**P1 session-wide CUDA lifecycle (код, приёмка ожидается):** `ExecutionHealth` дополнен `OutputNotReady` и общей проверкой ошибок H2D, D2D, D2H, `cuGraphLaunch`, stream sync и benchmark. После успешной валидации перед началом обновления входа или GPU replay выходы становятся неготовыми; только успешно завершённый `replay()` переводит их в готовое состояние. Ошибка CUDA IO/launch/sync необратимо переводит execution в `ExecutionPoisoned`. Ошибка проверки формы/домена без обращения к CUDA не инвалидирует предыдущий результат и не отравляет сессию. Важное ограничение: CPU fault-injection тестирует health state, не драйвер NVIDIA. `output(name)` до первого replay либо после изменения входа выдаёт `OutputNotReady`, не читает неинициализированную память.

**P2 индексирование `dependency_scope()` (код, приёмка ожидается):** временный индекс `output NodeId -> declared module inputs` строится один раз на обход; обход далее идёт по обычным DAG-рёбрам и индексированным декларациям. Для нескольких module invocations с одним output зависимости объединяются, не теряются. Добавлены тесты сравнения с прежним обходом и неиспользуемых портов.

**P2 append transactions:** `NeuralGraph` заменяет полное клонирование IR при `apply_module`, `compose_inferred`, `compose_multi_inferred`, `scan_fixed` и `apply_multi_module` на контрольные длины append-only коллекций `nodes/modules/multi_modules/module_order`; RAII rollback срабатывает при `Err` и при unwind. Вложенный успешный блок откатывается вместе с ошибочным внешним. Identity графа и правила захвата сохраняются. Это не обещание асимптотической скорости GPU: сокращаются Rust CPU allocations при композиции.

**Stage 10 (реализованный API-срез, без подтверждённой приёмки):** `Model::certify(CertifiedBuildConfig::new(package_root))` и `Model::verify_certified(config, pinned_sha256)` используют те же Lean/GPU/SHA256 backend'ы, что `ArchitectureAutoCompiler`. Все явно объявленные ProofGoal обязательны; все named outputs требуют поддерживаемого lowering. `identity.txt` внутри SHA256SUMS связывает модель, роли и цели; его сериализация больше не зависит от Rust `Debug` и process-local `NodeId.graph`, а старый v1 Debug-shaped identity считается миграционно совместимым только если полные декларации совпадают после удаления исключительно allocation-specific `graph` чисел. `--artifact-root` в лабораторных примерах разрешается относительно package root. Появился Cargo external subcommand `cargo-verineural` (`build/verify --certified`, выбор package через `--manifest-path` и artifact root), который запускает единственный тонкий consumer `examples/<name>_certified.rs` (уникальное имя executable target в Cargo workspace); для использования как `cargo verineural` бинарник должен быть доступен в PATH, без установки доступна Taskfile-команда `task certified-build`. В корне выбранного package после сборки создаются относительные Unix symlink на опубликованный `auto-build/`: canonical IR, DOT, PNG, Lean, SHA256SUMS, report, identity. Существующие артефакты с проверенным id/version архивируются, чужие не заменяются. Первая миграция корневых файлов не полностью атомарна; Stage 10 нельзя считать завершённым до приёмки CLI и доказательного пути. Это не является формальным FP32/SASS proof.


## 4. Semantic Neural IR

Центральный компонент всей системы.

IR фиксирует арифметику, пользовательские блоки, иерархию композиций, контракты, параметры и их семантику. Из одного IR должны строиться и GPU-код, и Lean-модель.

### 4.1. Вычислительные средства

Целевой набор **универсальных**, расширяемых строительных операций:

- Поэлементная арифметика, линейная алгебра, преобразования форм и типов.
- Indexing, gather/scatter, slice и перестановки с проверяемыми условиями памяти.
- Редукции, агрегаты, сравнения, условные вычисления и маски.
- Пользовательские математические функции и нелинейные преобразования.
- Параметризованные подграфы, интерфейсы модулей и композиция функций.
- Явное состояние, многошаговые переходы и циклы для тех фрагментов, у которых определены семантика и правила проверки.
- При необходимости исследования: дифференцирование и обновления параметров как общие вычислительные преобразования, а не обязательный `Backward` специальной LLM.

Attention, KV Cache и другие известные архитектурные компоненты **не входят в обязательный каталог примитивов**. Пользователь вправе выразить подобный алгоритм через базовые операции, если те поддерживаются.

### 4.2. Метаданные каждой операции

Каждый узел IR содержит:

- Входные и выходные типы.
- Размерности тензоров.
- Математическое определение операции.
- Домен допустимых значений.
- FP32-семантику.
- Правила округления.
- Допустимую численную погрешность.
- Предусловия и постусловия.
- Идентификаторы проверенных теорем и ещё не разрешённых обязательств доказательства.
- Зависимости от других узлов, идентификаторы блоков и отображение входных/выходных портов.
- Параметры, состояние и условия применимости инвариантов, если заданы.
- Семантические требования к памяти, параллелизму и допустимым GPU-преобразованиям.

### 4.3. Математические модели

Каждая поддерживаемая операция должна иметь три связанных представления:

**Ideal Semantics**

Математическая операция над идеальными числовыми объектами, например действительными числами.

**FP32 Semantics**

Та же операция с определёнными IEEE 754 binary32-округлениями, порядком вычислений и обработкой специальных значений.

**GPU Semantics**

Семантика конкретной реализации GPU, включая FMA, редукции, память и выбранную последовательность инструкций.

Компилятор обязан явно проверять установленное соответствие между уровнями. При отсутствии формальной связи отчёт различает Lean-доказательство идеальной модели, численную проверку FP32-выхода и доверенную компиляцию; автоматически объявлять эти представления эквивалентными запрещено.

### 4.4. Канонический граф архитектуры в Graphviz DOT

VeriNeural обязан уметь строить из Semantic Neural IR **единый самодостаточный текстовый файл `architecture.dot`** в синтаксисе Graphviz DOT. Его назначение — дать человеку и ИИ-агенту полную картину собранной пользовательской нейросети в одном артефакте: какие экземпляры компонентов существуют, как они вложены, какие тензоры и параметры проходят между ними, какие размеры и контракты действуют на каждой границе, какие доказательства и GPU-преобразования относятся к конкретным узлам.

DOT является **проекцией единого Semantic Neural IR**, а не вторым источником истины. Архитектуру нельзя считать корректной только потому, что DOT успешно сгенерирован или визуализирован. Канонический файл обязан содержать fingerprint исходного IR и включаться в общий SHA-256 manifest, чтобы его можно было однозначно связать с доказательствами, LLVM/PTX и сертификатом.

#### Полнота и иерархия

Certified-экспорт должен описывать **весь построенный граф архитектуры**, а не только удобный или оптимизированный output slice:

- Все зарегистрированные входы, параметры, состояния, операции, составные блоки и архитектурные выходы.
- Все `ModuleInvocation` как отдельные **экземпляры** с устойчивым instance-id и полным instance path; повторное использование одного определения модуля должно быть видно как несколько разных экземпляров.
- Иерархию модулей через вложенные `subgraph cluster_*`; кластер не имеет права скрывать внутренние узлы. Иерархия нужна для читаемости, но все примитивные операции и связи остаются в том же `.dot`.
- Узлы, не достижимые от выбранных архитектурных outputs, если они присутствуют в Semantic Neural IR, не отбрасываются молча: они включаются и явно помечаются, например `vn_reachable_from_output="false"`.
- Явные state/control dependencies, циклические/переходные зависимости и ветви, если такие конструкции поддерживаются соответствующим IR-фрагментом.
- Никаких скрытых captured dependencies: связь, влияющая на вычисление или контракт модуля, должна быть видна как порт/ребро либо экспорт должен завершиться ошибкой.

#### Свойства узла

Каждый узел должен иметь стабильный `vn_id` и достаточно данных, чтобы по одному DOT-файлу восстановить его роль в архитектуре. Для применимых свойств требуется указывать как минимум:

- Тип сущности: architecture input, parameter, state, primitive operation, module boundary, architecture output или иной поддерживаемый вид.
- Имя/тип операции, definition-id и instance path составного блока.
- Идентификаторы входных/выходных портов и их порядок.
- Shape каждого входа и выхода, dtype, layout/индексацию и broadcast/reshape-семантику, если они существенны.
- Домен значений и математическое определение/краткую semantic signature операции.
- FP32 policy: rounding mode, FMA/contract policy, subnormal/FTZ policy, reduction order и обработку special values в той мере, в какой они заданы IR.
- Численный контракт: scale/диапазоны, `epsilon`, exactness либо иной поддерживаемый error contract.
- Предусловия, постусловия, инварианты и ссылки на относящиеся theorem/obligation identifiers.
- Статус гарантии для релевантных свойств: `proven`, `validated`, `trusted`, `unsupported`; неизвестное или неподдержанное свойство должно быть помечено явно, а не просто исчезать.
- Роль параметра/состояния, mutability/versioning и ограничения параметров, если это часть модели.
- GPU lowering metadata: выбранный kernel/lowering kind, fusion membership, launch/scheduling metadata, memory contract и другие свойства, которые реально зафиксированы в Semantic Neural IR или compilation evidence.
- Идентификаторы связанных артефактов/теорем, когда они нужны для перехода от архитектурной схемы к доказательству или lowering evidence.

Для читаемости разрешено использовать краткий `label` или HTML-table label, однако **полные данные не должны существовать только в визуальном label**. Канонические свойства следует дублировать структурированными DOT attributes с устойчивым префиксом `vn_*`, чтобы ИИ-агент или иной инструмент мог разбирать файл без рендеринга Graphviz.

#### Свойства рёбер

Каждое ребро должно явно описывать не только факт зависимости, но и её интерфейс:

- `vn_src_port` и `vn_dst_port`.
- Роль связи: `data`, `parameter`, `state`, `control` либо другой документированный вид.
- Shape/dtype передаваемого значения.
- Существенную трансформацию на границе: reshape/view, broadcast, indexing mapping, aliasing или state transition.
- Порядок/версию зависимости там, где от этого зависит семантика.
- Связанные numerical/memory constraints, если они относятся именно к этой границе.

Входы и выходы составного модуля должны быть визуально и структурно сопоставимы с его declared interface: по DOT должно быть возможно определить, какой внешний tensor подключён к какому порту каждого instance.

#### Метаданные всего графа

Корневой `digraph` должен содержать как минимум:

- Architecture id/version и версию формата DOT-экспорта.
- Версию/совместимость спецификации VeriNeural.
- Cryptographic fingerprint канонического Semantic Neural IR.
- Версию VeriNeural/toolchain metadata, если она входит в сертифицируемую сборку.
- Активный FP32/GPU profile.
- Идентификаторы глобальных proof obligations и итоговый assurance status, если они уже вычислены.
- Список/идентификаторы архитектурных входов и outputs.

Непроизводительные значения вроде текущего timestamp, случайных UUID или process-local адресов не должны попадать в канонический DOT, если из-за них одинаковый IR перестаёт давать одинаковый файл.

#### Детерминизм и пригодность для ИИ-анализа

Для одинакового Semantic Neural IR, одинаковой конфигурации экспорта и одинаковых proof/lowering metadata генератор обязан создавать **байтово детерминированный** `architecture.dot`:

- стабильные идентификаторы, instance paths и порядок атрибутов;
- стабильный порядок кластеров, узлов и рёбер;
- однозначное escaping строк;
- отсутствие зависимости от порядка hash-map, адресов памяти или process-global counters;
- явные значения `unknown`/`unsupported` вместо неоднозначного отсутствия критически важного свойства.

Файл должен оставаться удобным для чтения в сыром виде. Визуальные цвета, формы и стили разрешены как дополнительный слой, но семантика не должна кодироваться только цветом или геометрией.

Минимальный стиль канонического вывода может выглядеть так:

```dot
digraph VeriNeural {
  graph [
    vn_format="verineural-dot-v1",
    vn_architecture_id="example",
    vn_ir_sha256="<digest>"
  ];

  subgraph cluster_module_0 {
    label="ResidualFfn instance=module_0";
    vn_instance_path="root/module_0";

    node_10 [
      label="MatMul\\n[1,2] x [2,2] -> [1,2]",
      vn_id="node:10",
      vn_kind="operation",
      vn_op="MatMul",
      vn_output_shape="[1,2]",
      vn_rounding="RNE",
      vn_proof_status="proven"
    ];
  }

  node_0 -> node_10 [
    vn_src_port="out",
    vn_dst_port="lhs",
    vn_role="data",
    vn_tensor_shape="[1,2]",
    vn_dtype="f32"
  ];
}
```

Это только пример формы сериализации. Реальный экспорт обязан отражать фактический Semantic Neural IR, а не жёстко заданный каталог архитектурных компонентов.

`architecture.png` является **обязательным производным артефактом** той же архитектуры и должен автоматически создаваться сразу после успешной записи `architecture.dot` через Graphviz из pinned devShell/toolchain:

```bash
dot -Tpng architecture.dot -o architecture.png
```

Порядок обязателен: сначала VeriNeural самостоятельно сериализует канонический DOT, затем Graphviz рендерит PNG **только из этого сохранённого DOT**. Ошибка `dot`, отсутствие Graphviz либо отсутствие/пустой `architecture.png` считаются ошибкой выпуска архитектурных артефактов в certified build. PNG не является источником семантики и не заменяет DOT или `architecture.lean`; он нужен как готовое визуальное представление для человека и визуальных инструментов. Дополнительные SVG/PDF могут выпускаться опционально.

Для одинакового `architecture.dot` и одной и той же pinned версии Graphviz рендер должен быть воспроизводимым; `architecture.png` включается в SHA-256 manifest вместе с DOT. Генерация самого `.dot` по-прежнему не зависит от Graphviz: зависимость Graphviz начинается только на обязательном шаге PNG-rendering.

## 5. Формальные контракты архитектурных компонентов

Каждый нейросетевой модуль определяется как функция с математическими предусловиями и постусловиями.

Контракт описывает:

- Допустимые входные значения.
- Размерности входов и выходов.
- Ограничения на параметры.
- Математические свойства результата.
- Инварианты модуля.
- Численные границы FP32-погрешностей.
- Условия взаимодействия с последующими модулями.

### 5.1. Composition Verification

При объединении модулей компилятор автоматически проверяет, что выходные гарантии одного модуля удовлетворяют входным требованиям следующего.

Формальная цель композиции:

```text
Module A:
    requires P
    ensures  Q

Module B:
    requires Q
    ensures  R

Composition B(A(x)):
    requires P
    ensures  R
```

Для численных модулей свойство `Q` включает не только математические условия, но и допустимые FP32-погрешности.

Если предыдущий блок гарантирует погрешность `ε₁`, а следующий допускает максимум `ε₂`, компилятор обязан доказать совместимость этих условий.

Если требуемое свойство не следует из доступных контрактов и лемм, композиция не сертифицируется.

### 5.2. Инварианты произвольных архитектур

Конструктор должен поддерживать проверяемые свойства **без предположения о типе архитектуры**:

- Размерности, совместимость портов, диапазоны индексов, корректность адресации и объёма памяти.
- Предусловия пользовательских операторов, гарантии их результатов и корректность их повторного использования в блоках.
- Границы значений, монотонность, знаковые и алгебраические инварианты, ограничения состояний.
- Композицию вложенных вычислительных графов и передачу гарантий между блоками.
- Для повторяющихся вычислений: инвариант начального состояния, корректность одного перехода и индуктивное сохранение инварианта для всех разрешённых шагов.
- Для ветвлений или дискретных решений: условия стабильности выбора, корректность условий и согласованность путей.
- Для полной архитектуры: **пользовательские глобальные свойства**, формально сформулированные относительно её входов, выходов, параметров, состояния и конфигурации.

Ни наличие `NeuralModule`, ни успешная проверка форм не равнозначны доказательству функциональной корректности. Система должна явно перечислять доказанные цели, гипотезы и неподдерживаемые требования.

### 5.3. Иерархическая композиция и повторное использование доказательств

1. Пользователь описывает элементарный оператор с математической семантикой и контрактом.
2. Собирает **локальный блок** из операторов, формулирует инварианты и экспортируемый интерфейс.
3. Собирает **крупный блок** из экземпляров локальных блоков с конкретными параметрами и связями.
4. Собирает **полную пользовательскую архитектуру** и формулирует итоговые свойства.
5. Lean проверяет локальные свойства, условия применимости и теоремы композиции. Доказательства экземпляров можно переиспользовать лишь при подтверждённых предпосылках и совпадении семантики/параметров.

Иерархия сохраняется для proof/debug/reporting даже при разворачивании или fusion GPU-графа. Композиционный сертификат должен связывать теоремы об отдельных блоках с теоремой об архитектуре, а не представлять список локальных доказательств как доказательство всей системы.

## 6. FP32 Verification Engine

**FP32-верификация является обязательной частью архитектурной верификации, а не самостоятельной необязательной проверкой.**

### 6.1. Формальная арифметика

Lean 4 должен иметь формальную модель IEEE 754 binary32, используемую для доказательства свойств поддерживаемых операций.

Модель обязана учитывать:

- Округление Round-to-Nearest, Ties-to-Even и другие разрешённые режимы.
- FMA и отдельные Multiply/Add.
- Subnormal Values и Flush-to-Zero.
- NaN и Infinity.
- Signed Zero.
- Порядок выполнения операций.
- Ошибки накопления при редукциях.
- Погрешности математических функций, включая `exp`, `sqrt`, `tanh` и функции активации.

### 6.2. Два класса численных гарантий

**Exact FP32**

Доказательство соответствия битовой FP32-модели, включая определённые правила округления и специальные значения.

**Bounded Numerical Error**

Доказательство ограниченной погрешности относительно идеальной математической модели:

```text
For all x in ValidDomain:

    error(FP32(x), Ideal(x)) <= epsilon
```

Для сравнения с действительными числами должны быть определены условия конечности значений и корректная метрика ошибки. Неопределённые случаи, NaN и Infinity обрабатываются отдельными контрактами.

Система может использовать доказанную интервальную арифметику, оценку ошибок округления и специальные леммы для нелинейных функций.

### 6.3. Распространение погрешностей

Численная погрешность распространяется через **произвольно определённый граф** и его вложенные блоки. Иллюстрация без привязки к Transformer:

```text
Input + Parameters
       │
       ▼
Custom Block A     error ≤ ε₁
       │
       ▼
Custom Block B     error ≤ ε₂
       │
       ├──────────────┐
       ▼              ▼
Custom Branch C   State Transition D
       └──────┬───────┘
              ▼
        Architecture Output
        proven bound ε_total
```

Итоговая оценка определяется свойствами конкретных операций (чувствительностью к входным ошибкам, формой композиции, параметрами, нелинейностями). Она не обязана равняться простой сумме ε.

Для пользовательских ветвлений, маршрутизации и сравнений малое численное отклонение может изменить выбор пути. Для доказательства эквивалентности дискретного решения требуется достаточный зазор между сравниваемыми значениями, проверка граничных условий или явная процедура точного разрешения неоднозначности.

## 7. GPU Compiler

GPU Compiler переводит **любую поддерживаемую пользовательскую композицию** Semantic Neural IR в низкоуровневое GPU IR, затем в LLVM IR и PTX. Он не должен зависеть от фиксированного набора LLM-слоёв.

Обязательные функции:

- Operator Fusion.
- Kernel Fusion.
- Matrix Tiling.
- Thread Scheduling.
- Warp-Level Operations.
- Shared Memory Management.
- Memory Coalescing.
- Reduction Scheduling.
- **CUDA Graph execution:** построение графа GPU-работы из Semantic Neural IR, выделение допустимых зависимостей, инстанцирование и запуск через CUDA Graph API, а не последовательные независимые kernel launches.
- **Kernel Fusion:** контролируемое объединение совместимых вычислений с учётом повторных потребителей и семантических ограничений.
- **No CUDA Legacy Streams:** запрещены legacy/default/null streams, их неявная синхронизация и обход CUDA Graph через прямой запуск kernels; только явно выделенный non-blocking CUDA stream для graph capture/launch и передач данных.
- GPU Kernel Launch (внутри CUDA Graph).
- Явно управляемый профиль генерации: layout, размерность сетки, распределение работы, допустимые преобразования, варианты kernel и выбор ресурсов в рамках проверяемого подмножества.
- Memory Safety Verification.
- Race Freedom Verification.
- Synchronization Verification.

Цель — высокий контроль и эффективность на NVIDIA GPU без жёстко заданных алгоритмических шаблонов. Предусмотрены инспекция LLVM IR/PTX, возможность выбора/ограничения оптимизаций и сообщения о фактически применённых преобразованиях. Эффективность должна оцениваться измерениями, а не предполагаться из названия backend'а.

**Экспериментальный исполняемый срез группировки:** runtime может группировать независимые D2D feedback-копии и проверки FP32-доменов по размеру тензоров внутри отдельных CUDA Graph, используя побитовые kernel-операции над дескрипторами. Мутация feedback запрещена до успешного guard. Новая опция `GpuLaunchConfig::with_internal_pointwise_fusion()` разрешает bounded horizontal fusion двух независимых живых Add/Mul промежуточных узлов, даже если они не объявлены публичными выходами: обе записи материализуются, все ранние потребители блокируют перенос, а численный порядок операций сохраняется. Это **не** произвольный region fusion и **не** формальная сертификация CUDA/PTX/JIT. Аппаратные тесты, сравнение с unfused и benchmark необходимы перед утверждением о корректности и ускорении.

**Runtime diagnostic contract:** a reusable CUDA feedback/guard graph is preflight-checked again only when its descriptor plan changes; device allocations remain owned and immutable in address/size for the whole session. `GpuExecution::feedback_state_checked_device_profiled` is an opt-in *measurement*, not an additional mathematical proof: it times one feedback CUDA Graph with events on the explicit non-blocking stream, includes an extra synchronization, and must not be enabled when comparing end-to-end throughput. Normal checked feedback retains its previous synchronous/fail-closed behavior.

**Prepared host feedback plan:** `GpuExecution` may retain a successful metadata preflight keyed by the exact ordered feedback links and whether runtime domain validation is required. The prepared plan owns its source/target device addresses, lengths, per-source domain obligations, and transfer list. Since compiled graph bindings remain stable for one execution, reuse does not relax validation; changing the key invokes the original full shape/dtype/domain/liveness/alias preflight. No runtime FP32 verdict may be cached. `GpuFeedbackProfile::plan_host` is an additional host-wall observation of plan lookup/preflight; it is not GPU execution time or a certificate.

Оптимизации не могут свободно изменять FP32-семантику.

Каждое преобразование должно иметь проверенное правило корректности, учитывающее точность арифметики.

Если Fusion заменяет отдельные `mul` и `add` на FMA, система обязана учитывать изменение округления и доказать соответствие численному контракту.

### 7.0. Правила CUDA Graph и stream policy

1. CUDA вычислительный граф строится из достижимых узлов Semantic Neural IR. Зависимости между nodes должны сохранять результаты оригинального графа после допустимых слияний и иных преобразований.
2. `CU_STREAM_LEGACY`, `stream = 0` и любые эквивалентные default/null-stream пути **запрещены**. Для capture, `cuGraphLaunch`, host↔device transfers и ожидания используется явно созданный `CU_STREAM_NON_BLOCKING`, без неявного legacy fallback.
3. Внутри обычного пути инференса нельзя исполнять отдельные kernels вне CUDA Graph. Прямой `cuLaunchKernel` допускается **только во время stream capture**, где он формирует kernel-node графа; альтернативой является `cuGraphAddKernelNode`.
4. Память и потоковые зависимости должны иметь корректную область жизни для всего CUDA Graph. Буферы передачи с асинхронной операцией не освобождаются до её завершения; CPU/GPU конкуренция за данные запрещена.
5. Fusion — центральная стратегия сокращения числа GPU kernels и промежуточных аллокаций, а не обход математических проверок. Недоказанная FP32-эквивалентность не становится `proven` благодаря использованию CUDA Graph.
6. Если CUDA Graph API не поддерживается, соответствующий запуск отклоняется; совместимого обхода через legacy streams не существует.
7. Производительность проверяется на устройстве, отдельно различаются накладные расходы инстанцирования графа, replay и фактическое kernel execution.

### 7.1. Проверка результатов lowering

Система должна проверять соответствие:

```text
Semantic Neural IR
        ↕
    Verified GPU IR
        ↕
      LLVM IR
        ↕
        PTX
```

Для этого необходимы формальные семантики поддерживаемого подмножества инструкций, механизмы translation validation и доказательства сохранения наблюдаемого поведения.

Операции вне проверяемого подмножества отклоняются в сертифицированной сборке.

### 7.2. Граница доверия

Формальная проверка PTX не является автоматическим доказательством поведения произвольного физического GPU.

Если корректность последующей компиляции PTX в машинный код и исполнения аппаратурой не доказана, драйвер, JIT, устройство и соответствующие правила исполнения должны быть указаны как доверенные предположения.

Система не имеет права представлять условную гарантию как безусловное доказательство корректности аппаратного исполнения.

## 8. Lean 4 Proof Engine

Proof Engine генерирует формальные модели и доказательства по структуре Semantic Neural IR.

### Типы доказательств

**Module Correctness**

Соответствие реализации математической спецификации.

**Composition Correctness**

Корректность взаимодействия отдельных архитектурных блоков.

**Numerical Correctness**

FP32-эквивалентность или математически доказанные границы погрешности.

**Optimization Correctness**

Корректность Fusion, Tiling и остальных преобразований компилятора.

**Memory Correctness**

Отсутствие недопустимых обращений к памяти, гонок и нарушений заданной модели синхронизации.

**Network Correctness**

Корректность композиции всех компонентов нейросети при заданных предусловиях.

### Механизм доказательств

Предусматривается библиотека проверенных лемм для тензоров, численной арифметики, маршрутизации и композиции.

Proof Engine автоматически создаёт задачи доказательства, применяет подходящие леммы и тактики и передаёт результаты проверяющему ядру Lean.

Новая пользовательская математика может создавать дополнительные обязательства доказательства. Если автоматическая система их не разрешает, разработчик должен уточнить контракт или предоставить вспомогательные леммы в Rust-ориентированном интерфейсе спецификаций.

Ручное создание отдельной реализации алгоритма на Lean не требуется.

Использование `sorry`, непроверенных аксиом или непрозрачных доверенных вычислений без соответствующего разрешения политикой сертификации запрещается.

## 9. Верификация целой пользовательской архитектуры

Итоговый объект VeriNeural — **произвольная архитектура, собранная разработчиком** из универсальных примитивов и вложенных блоков. Языковая модель, если она создаётся поверх библиотеки, является *потребителем*, а не встроенной реализацией Transformer или сервиса инференса.

Цели проверки полной архитектуры:

- Типовая и размерностная корректность всех соединений, параметров и состояний.
- Корректность контрактов отдельных операций и их включение в контракт каждого составного блока.
- Выполнение предпосылок повторно используемых лемм и доказательств.
- Глобальные функциональные свойства архитектуры, если они заданы разработчиком: отношения входов и выходов, ограничения состояния, инварианты переходов и условий ветвления.
- Численные гарантии композиции, включая FP32-поведение и распространение ошибки в пределах объявленных доменов.
- Применимость доказательств к реально использованным параметрам, GPU-профилю, оптимизациям и конкретным запускам.

**Что именно доказывает Lean:** каждое проверенное утверждение относится к указанной модели и предпосылкам. Поузловое равенство определению в Lean или проверки интерфейсов недостаточно, чтобы автоматически заключить корректность всей архитектуры. Для глобального `proven` требуется отдельная проверенная теорема композиции об этом глобальном свойстве.

Если исследователь включает обучение, изменение параметров или пользовательское состояние, их семантика и контракты проверяются аналогично прочим вычислениям. Готовый generic Backward/optimizer **не обязателен** для завершённости самого конструктора: необходим путь для определения и проверки пользовательских обновлений в поддерживаемом подмножестве.

**Не следует из доказательств:** качество генерации, соответствие задаче, интеллект системы, способность к обобщению, сходимость оптимизации и достаточная производительность. Для этих заявлений нужны отдельные спецификации, измерения и доказательства.

## 10. Сертификация параметров и исполнения

Для итоговой нейросети сертификат должен учитывать:

- Версию архитектуры.
- Конфигурацию модулей.
- Значения или проверенные ограничения параметров.
- Размерности и динамические диапазоны форм.
- FP32-профиль.
- GPU-архитектуру.
- Версии используемых инструментов.
- Формальные предположения.

При загрузке весов система проверяет соответствие параметров условиям применимости доказательств.

Если доказательство опирается на конкретные веса, их изменение требует новой сертификации. Если доказательство универсально по всем весам, удовлетворяющим контракту, достаточно проверить этот контракт.

Для отдельного запуска система должна различать:

- Универсальную теорему о вычислениях.
- Проверку принадлежности конкретного входа допустимому домену.
- Сертификацию конкретного результата.

При необходимости допускается повторная проверка результата или специализированный проверяемый вычислительный сертификат.

## 11. Логические компоненты и организация проекта

Целевые **ответственности**, а не предписание создать отдельный crate на каждое название:

- **Rust API / Frontend:** создание пользовательских операций, параметризованных блоков и контрактов.
- **Typed Semantic Neural IR:** типы, формы, семантика, зависимости, интерфейсы и иерархия модулей, явное состояние.
- **Proof Backend:** Lean-модели, задачи доказательства, проверенные леммы и композиционные теоремы.
- **GPU Backend:** контролируемые layout/scheduling/оптимизации, LLVM NVPTX/PTX, проверки lowering.
- **CUDA Runtime:** минимальный запуск и проверка вычислений на NVIDIA GPU, без serving/деплоя/серверов.
- **Certificate Engine:** связность артефактов, доказательные зависимости, границы TCB и статусы гарантий.
- **Примеры и тесты:** пользовательские математические операторы, вложенные композиции, состояние и архитектурно-нейтральные графы, а не готовая LLM.

Реальная Rust-библиотека размещается в `crates/verineural/` внутри Cargo workspace; отдельные crates создаются лишь по фактической необходимости и правилам `AGENTS.md`. Целевая разбивка Lean-файлов определяется реализованными математическими и компиляционными доказательствами.

## 12. Сборка пользовательской архитектуры

### 12.1. Лаборатории пользовательских архитектур

Рекомендуемая организация нескольких независимых экспериментов в одном репозитории:

```text
labs/
├── atlas-cell-0.1.0/
│   ├── Cargo.toml
│   ├── src/
│   │   └── lib.rs
│   ├── semantic.ir
│   ├── architecture.dot
│   ├── architecture.png
│   ├── architecture.lean
│   ├── gpu/
│   ├── verification/
│   ├── certificates/
│   ├── reports/
│   └── SHA256SUMS
└── recurrent-field-0.3.0/
    ├── Cargo.toml
    ├── src/
    │   └── lib.rs
    └── ...
```

Каждая директория `labs/<architecture-name>-<version>/` является отдельным Rust consumer-проектом, который использует `verineural` как библиотеку и имеет собственную идентичность архитектуры, параметры, Semantic Neural IR и bundle артефактов. Переиспользуемая реализация конструктора остаётся в `crates/verineural/`; код конкретной исследовательской нейросети не переносится в библиотечный crate только ради сборки.

Имя каталога является удобной конвенцией, а не единственным источником истины. Architecture id/version должны также фиксироваться в сертифицируемых metadata; по умолчанию они могут выводиться из Cargo package name/version. Две лаборатории не должны делить неявный глобальный каталог артефактов.

### 12.2. Artifact root и выбор лаборатории

**Целевой**, ещё не реализованный полностью интерфейс должен поддерживать как минимум:

```bash
# Запуск из корня конкретной лаборатории: артефакты появляются здесь же.
cargo verineural build --certified

# Выбор лаборатории из корня workspace.
cargo verineural build --certified \
  --manifest-path labs/atlas-cell-0.1.0/Cargo.toml

# Явное переопределение каталога артефактов.
cargo verineural build --certified \
  --manifest-path labs/atlas-cell-0.1.0/Cargo.toml \
  --artifact-root /mnt/experiments/atlas-cell-run
```

Правила разрешения пути:

- **По умолчанию artifact root равен корню Cargo package пользовательской архитектуры**, то есть директории, содержащей её `Cargo.toml`. Для стандартной структуры `labs/<name>-<version>/` ключевые артефакты тем самым появляются прямо в корне лаборатории.
- `--artifact-root <path>` переопределяет этот каталог для всех backend'ов и certificate/evidence writers одной сборки. Внутренние подсистемы не имеют права самостоятельно возвращаться к repository root, общему `target/verineural/` или иному скрытому output path.
- Относительный `--artifact-root` разрешается относительно корня package выбранной архитектуры, **не** относительно process current working directory. Абсолютный путь допустим.
- Rust API certified-build должен иметь эквивалентную явную настройку artifact root; CLI и API используют одну реализацию разрешения путей.
- Физический абсолютный путь вывода является packaging/runtime detail и не входит в Semantic Neural IR, theorem statements, канонический DOT или semantic fingerprints. Перемещение неизменной лаборатории в другой каталог не должно менять её доказательную семантику и канонические хеши содержимого.
- Все генерируемые пути обязаны оставаться внутри выбранного artifact root, кроме явно названных внешних входов. Нельзя незаметно писать часть bundle в общий repository-level каталог.
- Certified build не должен молча перезаписывать bundle другой architecture id/version. Если выбранный artifact root уже содержит несовместимый manifest/identity, сборка завершается ошибкой либо требует отдельного явного режима очистки/замены.

### 12.3. Процесс сборки

Обязательный процесс:

1. Принять из Rust конструктора пользовательские операторы, составные модули, параметры и глобальные свойства.
2. Построить единый Semantic Neural IR с иерархией блоков и идентичностью их экземпляров.
3. Проверить формы, домены, состояние и совместимость локальных контрактов.
4. Сгенерировать Ideal/FP32/GPU-семантики в поддерживаемом подмножестве.
5. Сгенерировать и проверить Lean-доказательства для примитивов, блоков, связей и **глобальных требований архитектуры**.
6. Применить разрешённые контролируемые GPU-преобразования и получить LLVM IR/PTX.
7. Проверить необходимые инварианты памяти, GPU-lowering и численную семантику, если они входят в запрошенный уровень.
8. Проверить актуальность параметров, GPU-профиля и предпосылок входных доменов.
9. Из финального аннотированного Semantic Neural IR и связанных proof/lowering metadata детерминированно выпустить полный `architecture.dot`; его `vn_ir_sha256` должен соответствовать каноническому IR этой же сборки.
10. Автоматически отрендерить из сохранённого `architecture.dot` файл `architecture.png` через pinned Graphviz; выпуск архитектурных артефактов считается успешным только при наличии согласованной тройки `architecture.dot`, `architecture.lean` и `architecture.png`.
11. Проверить, что все файлы текущего bundle находятся под единым разрешённым artifact root, принадлежат выбранной architecture id/version и не конфликтуют с bundle другой лаборатории.
12. Выпустить исполняемые файлы и отчёт с уровнями `proven`, `validated`, `trusted`, `unsupported`.

Любое недоказанное **обязательное** свойство останавливает сертифицированную сборку. Отдельный диагностический запуск допустим, но не объявляется формальным сертификатом.

## 13. Выходные артефакты

**Пример целевой схемы** при стандартном lab-scoped artifact root:

```text
labs/<architecture-name>-<version>/
├── Cargo.toml
├── src/
│   └── lib.rs
├── semantic.ir
├── architecture.dot
├── architecture.png
├── architecture.lean
├── gpu/
│   ├── program.ll
│   └── program.ptx
├── verification/
│   ├── primitives.lean
│   ├── blocks.lean
│   ├── numerical.lean
│   └── lowering.lean
├── certificates/
│   └── architecture.json
├── reports/
│   ├── obligations.json
│   ├── numerical.json
│   └── trusted_base.json
└── SHA256SUMS
```

При кастомном `--artifact-root` та же внутренняя структура артефактов переносится целиком в выбранный каталог; Rust source package при этом остаётся в своей лаборатории и не копируется автоматически.

Это целевая организация, **не утверждение**, что все файлы уже создаются. Файл доказательства или статус `proven` может появляться только при реальной проверке соответствующей цели.

Отчёт должен связывать: исходный IR, `architecture.dot`, пользовательские операции и вложенные блоки, теоремы и гипотезы, входы, значения параметров либо их ограничения, численную политику, профиль NVIDIA GPU, версии инструментов, LLVM/PTX, результаты исполнения, TCB и хеши артефактов.

`architecture.dot` является обязательным человеко- и машиночитаемым индексом архитектуры, но не заменяет `semantic.ir`, Lean evidence или сертификат. Certified build должен проверять, что указанный в DOT fingerprint IR совпадает с каноническим IR текущего bundle. `architecture.png` автоматически рендерится pinned Graphviz из этого же сохранённого DOT, включается в SHA-256 manifest и служит визуальным представлением; он не является отдельным источником семантики или доказательства. `architecture.lean` остаётся формальным архитектурным артефактом той же сборки. Дополнительные SVG/PDF могут быть опциональными.

SHA-256 обеспечивает контроль целостности относительно доверенного манифеста, а не авторство. JSON, DOT или PNG не подменяют Lean-доказательство и не подтверждают корректность машинного кода сами по себе.

## 14. Обязательные условия приёмки

VeriNeural считается **готовым архитектурно-нейтральным конструктором**, когда выполнено каждое условие (включая отдельные критерии API и proof soundness из § 17.5):

1. Пользователь на Rust задаёт **собственную математическую операцию** и строит из неё несколько параметризованных, повторно используемых блоков без предписанной архитектуры LLM.
2. Блоки вкладываются друг в друга и образуют крупную пользовательскую архитектуру с явными портами, параметрами, при необходимости состоянием и глобальными контрактами.
3. Из **одного Semantic Neural IR** автоматически генерируются исполняемая NVIDIA GPU-программа и Lean 4-модели без ручного переписывания одной логики на CUDA/Lean.
4. Lean проверяет содержательные локальные математические свойства блоков, а не только формы и поузловые равенства собственным определениям.
5. Для заявленного глобального свойства архитектуры есть отдельная проверенная **композиционная теорема**, связывающая локальные леммы, интерфейсы, параметры, инварианты и предпосылки.
6. Для поддерживаемого FP32-фрагмента формально доказаны заявленные точные свойства либо ограниченная численная ошибка, распространяющаяся по композиции.
7. Поддерживаемые GPU-lowering и оптимизации имеют проверенные свидетельства сохранения нужной семантики. Оставшиеся границы доверия честно перечислены в TCB.
8. Параметры, домены входов, конфигурация архитектуры, профиль GPU, инструменты, IR/Lean/LLVM/PTX и доказательства привязаны проверяемыми артефактами.
9. Из того же Semantic Neural IR детерминированно генерируется один полный `architecture.dot`, содержащий иерархию модулей, все экземпляры и связи, формы/типы/порты, параметры/состояние, численные и proof/GPU metadata; он связан fingerprint'ом с каноническим IR и пригоден для анализа без внешних файлов.
10. Из `architecture.dot` автоматически создаётся `architecture.png` pinned Graphviz-рендером; DOT, PNG и `architecture.lean` выпускаются вместе, PNG входит в manifest и никогда не считается самостоятельным доказательством.
11. Несколько лабораторий могут независимо сосуществовать в одном workspace: каждая имеет собственный artifact root, а certified build не пишет архитектурные артефакты в общий repository-level каталог и не перезаписывает bundle другой architecture id/version без явного действия пользователя.
12. Certified-build отклоняет неподдерживаемые операции и недоказанные обязательные свойства; численная валидация не выдаётся за доказательство.
13. End-to-end собственная архитектура собирается и исполняется на NVIDIA GPU с независимой проверкой результата **без обязательных Transformer, KV Cache или serving-инфраструктуры**.

**Не являются критериями завершения:** готовые Transformer/Attention/MoE/KV Cache, типовая LLM, inference API, чат-система, сервер/деплой, распределённый тренинг, доказанное качество или скорость генерации текста.

## 15. Основные архитектурные принципы

**Architecture Neutrality**

Конструктор не навязывает Transformer либо любую другую модель. Поддержка ограничивается явными вычислительными примитивами, состояниями, композициями и формально описанной семантикой.

**Hierarchical Composition**

Составные блоки имеют проверяемые интерфейсы, параметризацию и связи. Корректность всей архитектуры требует доказательства отдельного глобального утверждения, а не простой агрегации локальных успехов.

**Single Source of Truth**

Алгоритмы, архитектурные компоненты и контракты определяются в едином Rust-проекте.

**Semantics First**

Промежуточное представление фиксирует математическую и численную семантику до GPU-оптимизаций.

**Proof-Carrying Compilation**

Оптимизации сопровождаются проверяемыми свидетельствами сохранения заданных свойств.

**Numerical-Aware Composition**

Архитектурные теоремы учитывают реальную численную точность и ограничения операций.

**Fail-Closed Certification**

Если обязательное доказательство отсутствует, итоговый сертификат не создаётся.

**Explicit Trust Boundary**

Система не скрывает непроверенные предположения о компиляторе, драйвере или GPU.

**Reusable Proofs**

Один раз доказанные математические примитивы и правила композиции повторно используются для новых архитектур.

**Inspectable Architecture**

Полная собранная архитектура должна иметь детерминированное самодостаточное DOT-представление, в котором явно видны hierarchy, instance identity, shapes, ports, зависимости, контракты и статусы доказательств/lowering. Визуальная схема является проверяемо связанной проекцией Semantic Neural IR, а не параллельной моделью.

---

## 16. Конечная цель

**VeriNeural — конструктор проверяемых вычислительных архитектур для NVIDIA GPU.** Его назначение — дать исследователю инструменты для реализации собственных алгоритмов, включая альтернативные Transformer способы построения языковых моделей, без поставки предзаданной LLM.

Разработчик на Rust:

1. Определяет математические операции и их ограничения.
2. Объединяет операции в повторно используемые малые и крупные блоки.
3. Строит из блоков архитектуру со своей логикой передачи данных, параметрами и, если требуется, состоянием.
4. Формулирует локальные контракты и отдельные глобальные утверждения об архитектуре.

VeriNeural для **поддерживаемой** семантики:

1. Создаёт единый типизированный Semantic Neural IR.
2. Генерирует из него детерминированный полный `architecture.dot`, пригодный для чтения человеком и ИИ-агентом и связанный fingerprint'ом с IR, и автоматически рендерит рядом `architecture.png` через pinned Graphviz.
3. Компилирует управляемый NVIDIA GPU-код через LLVM NVPTX → PTX.
4. Генерирует Lean 4-модели и проверяемые теоремы о примитивах и блоках.
5. Проверяет условия композиции и заявленные глобальные свойства архитектуры.
6. Доказывает доступные численные гарантии FP32 и условия применимости.
7. Проверяет допустимые оптимизации и связи между IR/LLVM/PTX в покрытом доказательствами подмножестве.
8. Выпускает проверяемый отчёт со статусами, предпосылками и TCB, **не называя неподтверждённое доказанным**.

**Результат:** одна точка разработки математической логики на Rust, масштабируемая модульная композиция и две согласованные целевые ветви компиляции, NVIDIA GPU и Lean 4. Система подтверждает определённые свойства вычислений и архитектуры, но не обещает автоматически доказать работоспособность любой новой математики, интеллект модели или безусловную корректность железа.

## 17. Ревью API: обязательные патчи для расширяемого конструктора и проверяемой композиции

Этот раздел фиксирует **нормативные требования к доработкам**, а не утверждает, что перечисленные возможности уже реализованы. Приоритеты основаны на анализе публичных Rust-интерфейсов `NeuralGraph`, `Operation`, `NeuralModule`, `MathContract`, `LeanProofEngine`, `RneRangePlan`, `GpuEngine`, `CertificateEngine` и их реализаций в `crates/verineural/src/`. Выполненный верифицированный срез и целевые возможности следует различать по фактическому коду, тестам и evidence.

### 17.1. Непересматриваемые границы API

1. **Библиотека предоставляет строительные средства, не архитектуры.** Публичное ядро обязано содержать выразительные математические примитивы, tensor/state/control IR, интерфейсы модулей, объявления контрактов, доказательные правила, GPU lowering и инструменты сертификации. Готовые архитектурные блоки уровня Transformer, Attention, FFN/Residual stack, RNN/LSTM/GRU, MoE, KV Cache и LLM не являются частью обязательного основного API; их собирает потребитель. Уже существующие демонстрационные `Dense`, `ResidualAdd` и `ResidualFfn` необходимо рассматривать как примеры композиций, не как границу расширяемости или обязательные элементы ядра. При изменении экспортов предусмотреть понятную миграцию существующих клиентов.
2. **Расширение не сводится к добавлению вариантов в закрытый `Operation`.** Автор архитектуры должен определять поддерживаемую пользовательскую операцию с одной версионируемой семантической декларацией, типизированными портами, контрактом и proof obligations. Нельзя принимать произвольную Rust-функцию за автоматически формализованную: поддерживаемый DSL/IR-фрагмент должен быть явно ограничен.
3. **Произвольные поддерживаемые композиции, включая языковые и рекуррентные архитектуры, являются потребителями одного механизма.** Нельзя добавлять архитектурные исключения в IR/proof/GPU backends ради конкретной лаборатории.
4. **Сертифицируются сформулированные свойства, не название компонента.** Результат проверки должен содержать отдельно математическую теорему, условия её применимости, доказательство композиции, численный контракт и подтверждённую либо доверенную связь с исполняемым GPU-кодом. Недоказанные обязательные условия блокируют выпуск выбранного уровня сертификата.
5. **Прагматичный объём.** Расширения вводятся рабочими вертикальными срезами: публичный Rust API → единый IR → Lean obligation/theorem → GPU lowering или явный `unsupported` → проверяемый отчёт. Не создавать самостоятельный фреймворк/каталог шаблонов/инфраструктуру до появления соответствующего реального потребителя.

### 17.2. Подтверждённые анализом кода ограничения исходного среза

- `ir.rs` / `primitive.rs`: реализован начальный P02-slice: `Operation::Pointwise(PointwiseSpec)` хранит **одну атомарную пользовательскую операцию** с декларативной `PointwiseExpr` (`input/add/mul/relu`), проверкой arity/shape, идентификатором, версией и телом в canonical IR. Lean-модель строится из AST; нет runtime Rust callbacks и непроверенной вставки Lean. При финальном `relu` доступно независимое идеальное доказательство `Nonnegative`, а остальные случаи без правила fail-closed. GPU lowering и строгая FP32-композиция для пользовательского примитива пока `unsupported`. `PrimitiveSpec` по-прежнему строит композицию обычных операций; это отдельный, не заменённый API. Полный P02 (общие dtype, reductions/indexing, backend extensibility, произвольная семантика) **не завершён**. `MathContract` поддерживает именованные `requires`/`ensures` и ограниченный набор `ContractClaim` (`Nonnegative`, `EqualsInput`); произвольных пользовательских предикатов, количественных ограничений и общего языка proof obligations пока нет.
- `ir.rs`: граница модулей теперь транзакционна, проверяет скрытые capture-зависимости и хранит полный полуоткрытый диапазон тела `[body_start, body_end)`. Есть именованные multi-output ports и единый application-order view для single/multi instances. При этом single- и multi-output декларации всё ещё представлены разными публичными contract/module типами, а общий predicate/effect/state interface ещё не сформирован.
- `ir.rs` / `tensor.rs`: формы в основном конкретны (`Vec<usize>`), graph dtype теперь имеет минимальное различение `F32`/`Index`, но layout и общий dtype-каталог остаются узкими. Есть bounded `scan_fixed` и многовыходные модули, но нет общей семантики изменяемого `State`/`Transition`, symbolic axis/index algebra и полноценного `step/scan` с индуктивными инвариантами.
- `ir.rs` / `proof.rs` (начальный relational slice): `Predicate` и типизированные `ValueRef` задают проверяемые `Nonnegative`, `Equal` и `PointwiseLe` для module contracts и architecture goals. Для `PointwiseLe` добавлена независимая Lean-лемма `pointwise_le_relu` над идеальными `Int`; настоящая Lean-проверка и аудит аксиом остаются обязательными. Ложное обратное отношение (`ReLU(x) ≤ x`) и ошибочные graph-local ссылки должны отвергаться. Это **не** полный пользовательский predicate DSL, не доказательство произвольной формулы, не численный FP32 bound и не доказательство CUDA lowering. При нехватке доказательного правила certified-сборка fail-closed. Positive/negative kernel acceptance выполняется командой `task verify-relational-predicates`.
- `proof.rs`: `node_*_semantics` по-прежнему доказывается через `rfl` относительно сгенерированного определения. Для `ContractClaim` и архитектурных целей уже генерируются отдельные содержательные обязательства, однако публичный `ProofGoalKind` остаётся ограниченным неотрицательностью и равенством; произвольного реестра пользовательских свойств нет.
- `numeric.rs`: `ExactFp32Plan`, `RneFp32Plan` и `RneRangePlan` реализуют содержательный, но ограниченный фрагмент exact-Int/dyadic-RNE и композиции. Его нельзя обобщать на любые функции, ветвления, длины рекурренции, значения FP32 и реальные CUDA kernels без дополнительных теорем и предпосылок.
- `gpu.rs` / `proof.rs`: `Sqrt` доступен через Rust `NeuralGraph` и host reference, но текущие ветви GPU/Lean не покрывают его как сертифицируемый end-to-end оператор; прочие операторы также проверяются только в перечисленном подмножестве. `certificate.rs` выпускает отчёт о конкретной проверке и SHA-256 evidence, не универсальный объект сертификата произвольного контракта.
- `architecture.rs`: snapshot и auto-DOT используют одну нормализованную иерархию module instances и один `NeuralGraph::canonical_ir()` fingerprint вместо параллельных представлений ownership. Архитектурная proof-метка при этом всё ещё связана с конкретной `architecture_global_nonnegative`; семантика дополнительных состояний/ветвлений/произвольных theorem identifiers ещё не кодируется общим механизмом.

### 17.3. Реестр патчей (приоритет и критерии приёмки)

**P0** — блокеры универсального, математически корректного API и сертификата композиции. **P1** — необходимая выразительность для независимых LLM-подобных и рекуррентных consumer-архитектур. **P2** — удобство и независимая проверка полноты. Патч считается выполненным только при выполнении его проверяемого результата, а не после добавления типов или заглушек.

#### VN-P01 · P0 · Самостоятельные пользовательские спецификации операций и модулей

- **Изменить:** расширить `MathContract` от проверки форм и грубых доменов до декларативных типизированных `requires`, `ensures`, ограничений параметров, predicate/invariant references и, когда применимо, численных оценок. Свойства задаёт потребитель на Rust в проверяемом DSL/AST. Недопустимо сочинять постусловие по факту успешного расчёта.
- **Приёмка:** намеренно ложный контракт для корректного по формам вычисления отвергается проверяющим ядром Lean либо остаётся `unproven` и блокирует certified-режим; правильный нетривиальный контракт проверяется и может быть использован другим модулем.

#### VN-P02 · P0 · Расширяемый реестр семантических примитивов

- **Изменить:** вместо необходимости править `Operation`, Tensor reference, proof engine и GPU backend при каждой новой операции предоставить versioned `PrimitiveSpec`/эквивалент: идентификатор, типизированная сигнатура, shape/dtype rules, математическое выражение IR, домен, effects, FP32 policy, proof obligations и доступные lowering capabilities. Семантический контракт задаётся один раз; backends являются трансляторами, не независимыми реализациями алгоритма.
- **Приёмка:** внешний потребитель объявляет не встроенную ранее операцию **без правки исходников `verineural`**, получает IR/Lean-представление и доказательство её пользовательского свойства в поддерживаемом DSL. GPU-экспорт либо исполняется через разрешённое lowering, либо явно `unsupported`; фиктивный kernel запрещён. Начальный `PointwiseSpec`-срез проверяется `task verify-pointwise-primitive` после запуска быстрых consumer-тестов; сертификат Lean не включает FP32/CUDA.

#### VN-P03 · P0 · Независимая связь Rust-спецификации, IR и Lean-теоремы

- **Изменить:** каждому узлу/модулю сопоставить каноническую денотационную семантику, идентификатор спецификации и список целей. Разделить `definition well-formed`, `shape proof`, `rfl` о сгенерированном терме и доказательство **независимого содержательного предиката**. Любые изменения версии семантики инвалидируют повторное применение теорем.
- **Приёмка:** из одной Rust-декларации формулируется проверяемое Lean-утверждение об отношении входов и результата, для которого `rfl` само по себе недостаточно; подмена смысла операции или тела при неизменном имени обнаруживается.

#### VN-P04 · P0 · Корректная граница составного модуля

- **Изменить:** объявить явные input/output/parameter ports и capture policy, проверять замкнутость тела относительно объявленных входов, владельца выходов и вложенных экземпляров при `apply_module` (до сохранения в основной граф). Сохранить rollback при ошибках. Не считать совпадение shapes достаточным доказательством интерфейса.
- **Приёмка:** неразрешённый доступ к внешнему узлу, выдача чужого узла как собственного выхода, некорректные связи вложенных модулей и конфликт интерфейсных контрактов отклоняются при построении/сертификации; корректный вложенный повторно используемый модуль проходит.

#### VN-P05 · P0 · Универсальный композиционный Proof API

**Первый reusable-definition срез (локальная Lean-проверка ожидается):** `LeanProofEngine::generate_reusable_module_nonnegative` принимает несколько concrete single-output `NeuralModule` instances и строит одну нормализованную ideal-Int module definition + одну generic `Nonnegative` theorem, после чего для каждого instance формирует отдельную application theorem. Reuse разрешён только при совпадении module name, semantic version, полного `MathContract` и нормализованной семантики тела; одинаковая identity при различном Add/Mul-подобном теле fail-closed через `ModuleDefinitionMismatch`. Declared `NonNegativeFinite requires` остаются обязательствами каждого concrete instance даже если выбранное свойство (например final ReLU nonnegative) математически не нуждается в них; generic theorem может пометить неиспользуемую hypothesis underscore-биндером, но instance всё равно обязан её предоставить. Это первый in-artifact definition reuse, не persistent proof cache и не универсальная композиция multi-output definitions. Developer gate: `task verify-reusable-module-proof`.

**Multi-output reusable definition theorem (код; локальная Lean-проверка ожидается):** `generate_reusable_multi_module_nonnegative` принимает несколько `MultiOutputModule` instances с одинаковыми identity/version/named `MultiOutputContract` и нормализованной семантикой каждого output. Генерируется одна tuple-definition с right-nested Product, одна generic conjunction theorem для всех выходных `Nonnegative` claims и отдельная application theorem на каждый named output каждого экземпляра. Каждая invocation независимо закрывает входные `NonNegativeFinite` premises, включая объявленные, но неиспользуемые контрактом свойства; mismatched body/contract и неподдержанная output-цель завершаются отказом. Первый профиль требует минимум два F32-output с явными `Nonnegative` claims на всех портах; отношения между портами, другие predicates и общий typed theorem dependency graph ещё не охвачены. Developer gate: `task verify-reusable-module-proof`, включая ignored real Lean kernel+axiom audit для multi-output и global reusable composition.

**Global reusable-module composition (код; локальная Lean-проверка ожидается):** `generate_global_nonnegative` теперь проходит единый application-order `ModuleInstanceRef` DAG для single- и multi-output invocations. Producer идентифицируется конкретным output port; совместимые single instances и одинаковые порты совместимых `MultiOutputModule` группируются по kind/name/version/full contract и нормализованной ideal-Int семантике выбранного выхода. Для группы генерируется одна `architecture_module_definition_*` theorem, каждый concrete output-port получает свою application theorem с собственными premises, а `architecture_global_nonnegative` строится из этих applications через fork/fan-in границы. Совпадающая identity/port с отличающимся normalized body завершается `ModuleDefinitionMismatch`; отсутствие предпосылки конкретного invocation блокирует композицию. Профиль по-прежнему ограничен свойством `Nonnegative`; persistent theorem cache и общий typed theorem-dependency graph для произвольных predicates остаются открыты.

- **Изменить:** заменить hardcoded `generate_global_nonnegative` как единственную архитектурную цель на запросы свойств от потребителя и `ProofObligation` с явными предпосылками. Вызов верифицированного `ModuleDefinition` порождает обязательства совместимости его конкретного `ModuleInstance`: порты, параметры, домены, состояния, численные bounds и theorem dependencies. Кешировать доказательство определения, а не выдавать кеш экземпляра за независимую проверку его условий.
- **Приёмка:** архитектура с fork/fan-in и общими параметрами доказывает произвольное поддерживаемое глобальное свойство через локальные теоремы; нарушение одного `requires` блокирует global `proven`; независимые свойства одной архитектуры имеют независимые статусы.

#### VN-P06 · P0 · Проверка доверенной границы Lean и происхождения доказательств

- **Изменить:** в обязательном certified-профиле фиксировать теоремы, полностью развёрнутые зависимости/гипотезы, audit используемых аксиом (в частности `sorryAx`, пользовательских `axiom`, `native_decide`/доверенных вычислений согласно pinned Lean версии) и версию Lean/библиотек. Разрешённые базовые аксиомы и остальные TCB-предпосылки задаются явной политикой. Простой exit code компиляции файла недостаточен для полной проверки политики сертификата. При выбранном повышенном уровне доверия допускается отдельная повторная kernel-проверка доказательств (`lean4checker` или эквивалент).
- **Приёмка:** theorem, прямо или транзитивно зависящая от запрещённой аксиомы/`sorry`, не получает статус `proven`; в evidence записываются проверенная theorem signature, аксиомные зависимости и source/IR fingerprints.

#### VN-P07 · P1 · Многовыходные и типизированные интерфейсы блоков

- **Изменить:** предоставить именованные и позиционные порты, несколько результатов и структурированные значения: tensor, scalar, tuple/record, state handle, а также устойчивую типовую идентичность instance. Не использовать один `NodeId` как универсальную подмену результата со множеством выходов. Представление в Lean и DOT должно сохранять отдельные порты и зависимости.
- **Приёмка:** один consumer-module выдаёт одновременно `output` и `next_state` (либо два независимых тензора); оба выхода подключаются к другим модулям и получают раздельные свойства.

#### VN-P08 · P1 · Практически достаточная библиотека **низкоуровневых** tensor-примитивов

**Реализованные частичные срезы (ожидают локальной проверки):** static `SliceAxis { axis, start, len }` добавляет rank-preserving contiguous interval с Rust-side bounds validation до изменения графа, generic host row-major reference, canonical IR параметрами и ideal-Int `sliceAxis`/nonnegative theorem. GPU/numeric lowering для slice намеренно отсутствует и fail-closed. Consumer acceptance собирает Q/K/V-подобный attention-like dataflow из `slice_axis + permute + matmul + relu` без готового Attention/Transformer компонента. Developer gate: `task verify-tensor-slice`; общий consumer gate остаётся `task p2-consumers` / `verify-p2-consumers`. Это статический slice, не dynamic gather/scatter/view.

**Реализованные частичные срезы (ожидают локальной проверки):** `Operation::ReduceSum { axis }`, `NeuralGraph::reduce_sum` и `Tensor<f32>::reduce_sum` поддерживают удаление любой существующей оси, row-major indexing, проверку `axis < rank` до изменения графа и левостороннюю свёртку. Дополнительно P0 routing/indexing slice вводит `DType::Index`, `ArgMaxTieBreak::First`, `Permute`, `ReverseAxis`, binary semantic `Concat`, `ArgMax` и `Take`; public `NeuralGraph::concat` остаётся variadic sugar поверх бинарного core. `argmax` имеет тотальную детерминированную F32-policy (First для равных максимумов; NaN не вытесняет числовой максимум, all-NaN выбирает первую lane) и выдаёт Index tensor; `take` принимает только Index, один индексный элемент и проверяет, что диапазон producer-а помещается в выбранную ось. Rotation не получает отдельного operation: rank-2 90° строится как `permute + reverse_axis`. Canonical IR `verineural-semantic-ir-v4` включает dtype/axes/tie policy и storage/layout identity, DOT сохраняет ту же структурную информацию. Host reference реализует row-major semantics и bounds checks. Lean ideal-Int модель содержит `transpose2D`, `reverseAxis`, `concatAxis`, `argMaxFirstAxis`, `takeAxis` и nonnegative lemmas для преобразований данных; arbitrary permutation за пределами identity/rank-2 transpose честно отклоняется backend-ом. GPU backend теперь имеет намеренно узкий lowering-профиль, достаточный для rotating-matrices: rank-2 transpose, rank-2 reverse по axis 0/1, contiguous concat по axis 0, rank-2 last-axis `ArgMax(First)` и scalar `Take` по axis 0. Для него формируются memory contracts, отдельный translation plan и structural LLVM/PTX audit; остальные формы остаются `unsupported`. Lean memory-address слой теперь доказывает натурально-числовые границы адресов transpose/reverse/concat/argmax/take для фактических размерностей memory contract; для `Take` граница выбранного axis-0 индекса остаётся явной предпосылкой, получаемой от проверенного Index producer-а. Reverse-row translation evidence также фиксирует число строк, потому что оно входит в LLVM-формулу `rows - 1`. Это **не** доказательство CUDA pointer safety, LLVM→PTX/SASS соответствия или IEEE-754 эквивалентности и не расширяет numeric proof profile автоматически. Полный P08 (общие gather/scatter/slice, broadcast, reduce-max и др.) **не завершён**.

- **Изменить:** расширять каталог по доказуемым вертикальным срезам: scalar/elementwise arithmetic, comparisons, masks/`select`, axis-reductions (`sum`/`max`), transpose/permute, slice/index/gather/scatter, broadcast, concat/split, shape-preserving views, batched matmul и необходимые элементарные функции (`exp`/`log`/`sqrt` — только с явным supported proof/numeric profile). Для каждой операции задать index, shape, domain, alias/memory и numeric semantics. Широкий каталог без доказательств не считать сертифицированным.
- **Приёмка:** потребитель может собрать gated recurrent update и небольшой attention-like dataflow из общих операций **без** встроенных RNN/Attention/Transformer компонентов; неподдерживаемые функции fail-closed на запрошенном уровне гарантий.

#### VN-P09 · P1 · Явное состояние, ограниченные циклы и индуктивные инварианты

**Первый arbitrary-horizon ideal-Int срез (локальная Lean-проверка ожидается):** `LeanProofEngine::generate_inductive_state_nonnegative` принимает один уже построенный consumer-defined `MultiOutputModule` transition с портами `state,input → next_state,output`. Поддерживаемый профиль намеренно узкий: два прямых F32 Input source-а с `Domain::NonNegativeFinite`, сохранение shape/dtype состояния и consumer-owned `Nonnegative` claim на `next_state`. Генератор сначала строит и проверяет локальную семантику/claim обычным proof path, затем определяет в Lean рекурсивную `Nat → state` функцию и доказывает `∀ t, Nonnegative(state t)` обычной индукцией из `h_initial` и `h_input : ∀ t`. Это не fixed unroll и не утверждение о FP32/CUDA runtime. Дополнительные hidden sources, отсутствующий invariant claim или неподходящий state/input contract fail-closed. Developer acceptance: `task verify-inductive-invariant`.

- **Изменить:** ввести отдельные сущности `State`/`Transition`/`step`/`scan` (наименование условно), различить value/data dependencies и переход состояния `s_t → s_(t+1)`; предусмотреть семантику initial state, reset/update, границы по времени и правила памяти/aliasing. Первый сертифицируемый срез может ограничиться конечным фиксированным horizon/unroll; произвольное число шагов требует Lean-теоремы инициализации и сохранения инварианта по индукции, а не проверки нескольких прогонов.
- **Приёмка:** потребитель строит без готового RNN-блока повторяемый переход `(state_t,input_t,params) ↦ (state_{t+1},output_t)`; Lean проверяет заявленное свойство состояния для `t=0` и каждого перехода, а глобальная теорема корректно определяет покрытый диапазон шагов. CUDA Graph отражает эти зависимости без legacy streams.

#### VN-P10 · P1 · Достаточная типизация тензоров и ограничений размерностей

**Реализованный layout/alias срез (локальная проверка ожидается):** `Shape::row_major_strides` задаёт единственный contiguous row-major layout текущего профиля. `NodeStorage` делает allocation semantics явной частью публичного IR API: обычные Input/compute значения имеют `OwnedContiguous { strides }`, а `Reshape` имеет `Alias { source, strides }`; `NeuralGraph::storage_root/aliases` разрешают цепочки views до владельца allocation. Canonical Semantic IR поднят до `verineural-semantic-ir-v4` и включает stable storage description, поэтому изменение alias/layout policy инвалидирует fingerprints и evidence replay. DOT также публикует `vn_storage`. GPU allocation/kernel planning использует `NodeStorage` вместо локальных проверок `Operation::Reshape`; `permute`, `slice` и остальные reordering ops остаются owned outputs, а не притворяются views. Это намеренно не поддержка произвольных strides/noncontiguous views. Developer gate: `task verify-storage-semantics`.

- **Изменить:** зафиксировать в IR dtype, ранг/оси, layout/strides, views/aliasing, symbolic dimensions с явными ограничениями и policy для static specialization. Не смешивать Rust generic `Tensor<T>` с фактической поддержкой произвольного dtype в Lean/GPU: capabilities объявлять отдельно. Ввести проверку bounds для индексации и преобразований формы.
- **Приёмка:** один параметризованный модуль применяется к двум допустимым размерам без копирования логики; нарушение равенства осей, области индексов либо предпосылки специализации обнаруживается до сертификата.

#### VN-P11 · P1 · Численная композиция и условия выбора ветвей

**Реализованный branch-stability срез (локальная Lean-проверка ожидается):** `RneRangePlan::classify_condition` обобщает прежний ReLU threshold evidence на любой reachable numeric condition. `RneSelectPlan` поддерживает намеренно узкую каноническую форму `PositiveMask(condition) → SelectPositive(mask, yes, no)`: condition/yes/no получают независимые dyadic-RNE range contracts, а итоговый select наследует **ровно** contract выбранной ветви только если интервал `observed ± ε` целиком лежит по одну сторону строгого нуля. Пересечение нуля возвращает `RneThresholdSide::Indeterminate`, `stable_contract` и Lean generation завершаются `NumericError::UnstableBranch`. В `Numeric.lean` добавлены отдельные conditional lemmas для positive/nonpositive branch; `RneSelectPlan::lean_program` формулирует теорему с явными `ApproxContract` предпосылками и margin, не заявляя CUDA/LLVM/PTX correspondence. Прямой произвольный mask producer пока unsupported. Developer acceptance: `task verify-numeric-branch`.

**Реализованный recurrent-error срез (локальная Lean-проверка ожидается):** `RneRangePlan::compile_with_source_contracts` позволяет заменить выбранный reachable Input уже установленным `RneErrorContract`, сохраняя его `q/bound/ε` вместо фиктивного сброса ошибки в ноль. `RneStateRolloutPlan::compile_fixed` использует это для одного explicit state: contract `next_state` шага `t` становится source contract состояния шага `t+1`, тогда как остальные fresh inputs остаются exact dyadic sources. Feedback требует неизменного q-scale; transition, меняющий lattice scale, fail-closed. Каждый шаг генерирует самостоятельный Lean range source с перенесённым `ApproxContract`; произвольный-horizon induction theorem **не** заявляется этим срезом. Developer acceptance: `task verify-numeric-state`.

- **Изменить:** сделать numerical pre/postconditions частью интерфейса `PrimitiveSpec`/`ModuleDefinition`: q/scale, bounds, `ε`, rounding/FMA/FTZ, special values, порядок reductions и условия стабильности `select`/`comparison`. Обобщить имеющийся доказанный dyadic-RNE срез на новые **поддерживаемые** операции, fan-out/fan-in и state transition; для нелинейностей и рекурсии задавать доказанное правило распространения ошибки либо `unsupported`.
- **Приёмка:** доказанная погрешность локального блока применяется к двум последовательным экземплярам и к ветвящейся композиции; при выходе за допустимые bounds или нестабильном условии выбора итоговая гарантия понижается/отвергается, но не объявляется точной.

#### VN-P12 · P1 · Явные возможности backend и семантическая связь с GPU

**Реализованный capability/evidence срез (локальная проверка ожидается):** каждый успешно скомпилированный `GpuProgram` обязан построить `GpuCapabilityPlan`. План fail-closed проверяет соответствие запускаемых kernel roots их `GpuMemoryContract` и `TranslationKernel` по node/reads/writes и объясняет каждый удалённый fusion kernel через `GpuOptimizationCapability`. Для fusion повторно проверяются exclusive reachable use, сохранение selected outputs и допустимая структура IR. `GpuAssuranceBoundary` отдельно фиксирует generated Lean memory obligations, обязательную structural LLVM/PTX validation при lowering, отдельную необходимость numeric proof ideal→FP32, runtime acceptance CUDA и отсутствие установленной JIT/SASS correspondence. `capability.plan` сохраняется в GPU evidence directory, входит в SHA-256 manifest и пересчитывается при offline replay. Developer gate: `task verify-gpu-capabilities`.

**P06/P12 memory-evidence closure (код; локальная Lean-проверка ожидается):** `GpuProgram::memory_lean_program` превращает каждый concrete `GpuMemoryContract` в именованные theorem obligations в `VeriNeural.Generated` вместо анонимных `example`. Certified auto-build после LLVM/PTX lowering kernel-check'ит и axiom-audit'ит `memory.lean` для каждого supported output и для shared multi-output graph, добавляет зависимости в общий `lean/audit.txt` и включает source в `SHA256SUMS`. Offline replay заново генерирует exact memory program, сравнивает source, запускает Lean checker/audit и только после GPU memory proofs сравнивает общий audit. Общий `GpuEngine` по-прежнему лишь генерирует obligation; статус `GeneratedLeanObligation` не превращается автоматически в `proven` вне certified build. Developer gate остаётся `task verify-gpu-capabilities`.

- **Изменить:** каждое lowering/optimization правило объявляет supported operations, допустимые типы/формы/профили и требуемые доказательства сохранения семантики. Отдельно документировать ideal→FP32, FP32→GPU IR, LLVM/PTX и JIT/SASS границы. Сохранить обязательные CUDA Graph, non-blocking streams, fail-closed и разрешённый fusion только при проверенных предпосылках. Не обещать theorem о CUDA kernel из доказательства `Int`-эквивалентности.
- **Приёмка:** точно описанный профиль исполняется с traceable translation/memory evidence; неподдерживаемая операция, профиль или оптимизация не может получить machine/FP32 `proven` из одного только успешного GPU-запуска.

#### VN-P13 · P2 · Удобство потребительского Rust API и диагностика ошибок

- **Изменить:** дать эргономичные вызовы над `NeuralGraph`/typed expression handles для создания примитивов, объявления модулей, привязки весов/параметров, объявления целей и выпуска evidence без ручного дублирования схемы. Публичный фасад не должен скрывать proof assumptions; ошибки обязаны указывать component path, port, violated constraint и неподтверждённую теорему. Существующие небольшие `Dense`/`ResidualFfn` можно сохранить как версии учебных consumer recipes, но их внутренняя реализация не должна быть специальным случаем в ядре.
- **Приёмка:** независимый клиент оформляет собственный модуль с проверяемыми `requires/ensures`, многократно инстанцирует его, получает понятный результат проверки без изменения `crates/verineural/src/*`.

#### VN-P14 · P2 · Сквозные архитектурно-нейтральные acceptance fixtures

- **Изменить:** поддерживать consumer-примеры за пределами core: (1) вложенный граф без состояния с fork/fan-in, (2) рекуррентный переход со state invariant, (3) attention-like граф из gather/matmul/mask/reduce/normalization или другой сопоставимой комбинации низкоуровневых операций. Цель — испытать расширяемость, не поставить готовую архитектуру. Для каждого сценария нужны позитивные и негативные proof cases, детерминированный IR, модульные и глобальные theorem identifiers, GPU/evidence status.
- **Приёмка:** хотя бы одна пользовательская операция добавлена без патча библиотеки; один корректный и один некорректный контракт демонстрируют kernel-accept/reject; recursive invariant и глобальная nested/fan-in теорема проверяются отдельно; unsupported GPU-фрагмент отражён как `unsupported` без ложного сертификата. Не создавать CI/ботов/инфраструктуру без разрешения пользователя.

### 17.4. Порядок внедрения и контрольные ворота

Рекомендуемые **содержательные пакеты**, а не требование делать отдельный коммит на каждый пункт:

1. **Сначала достоверность контрактов:** VN-P01, VN-P03, VN-P04, VN-P05, VN-P06. Пакет заканчивается независимым пользовательским функциональным свойством, его проверкой через Lean и отрицательным тестом ложной спецификации.
2. **Затем расширение математического базиса:** VN-P02, VN-P08, VN-P10 и затронутая часть VN-P12. Пакет заканчивается внешним пользовательским примитивом и общим Lean/GPU либо fail-closed маршрутом без правки ядра под пример.
3. **Затем выразительная композиция:** VN-P07, VN-P09, VN-P11. Пакет заканчивается много-выходным рекуррентным `step`, доказанным инвариантом перехода и честной численной областью применимости.
4. **После — стабильное удобство и независимые потребители:** VN-P13, VN-P14. Пакет заканчивается двумя непохожими архитектурами (recurrent и attention-like/иной tensor-heavy) из одного публичного API с явными proof obligations; без встроенных архитектурных «монолитов».

На каждом этапе допускается **доказанный узкий поднабор** вместо недоказанного полного. Все остальные операции/формы/dtypes/cycles остаются явно `unsupported` для соответствующей гарантии. Запрещено считать список успешно сгенерированных файлов, успешно собранную Rust-библиотеку или набор локальных `rfl`-теорем достаточным условием завершения.

### 17.5. Дополнительные критерии приёмки библиотечного API

В дополнение к ` 14 окончательный результат должен демонстрировать одновременно:

- **Extendability:** потребитель добавляет семантическую операцию и собирает компоненты без изменения кода VeriNeural, в пределах явно поддерживаемого подъязыка Rust DSL.
- **Compositional proofs:** содержательная локальная theorem и отдельная глобальная theorem связаны строгими условиями применимости; корректность одного модуля не подменяет корректность системы.
- **Recurrent semantics:** корректность state transition и заявленного диапазона времени определена независимо от способа GPU исполнения; конечное unroll-доказательство не выдаётся за доказательство всех временных шагов.
- **Consumer neutrality:** можно строить attention-like/LLM и recurrent модели из общего набора операций, но обязательной готовой реализации любой такой архитектуры в core нет.
- **Evidence honesty:** scope гарантий (`ideal`/`FP32`/`GPU`), все недоказанные предпосылки и границы TCB перечислены отдельно; пользовательские контракты нельзя сертифицировать на основании только структуры, генерации кода или совпадения отдельных численных примеров.

**Уточнение Stage 10 atomicity (код, без локальных тестов):** Linux-переиздание внутреннего auto-build/ требует renameat2(RENAME_EXCHANGE) с fail-closed при неподдерживаемой ФС; первый root alias migration остаётся неатомарным. Публичный certified_example_main устраняет дублирование parser/проверок в лабораторных examples. Для совместной приёмки необходимо задавать отдельный --artifact-root: исходные Stage9 файлы в корне лабораторий отслеживаются Git и миграция по умолчанию изменит рабочее дерево.

